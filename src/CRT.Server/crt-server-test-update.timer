[Unit]
Description=Classic Repair Toolbox contribution service - TEST instance - looks for a new server build every minute

# Starts crt-server-test-update.service a minute after the timer starts, and then a minute after each look
# has ended - so two looks never overlap, however long an install takes (owner request, 2026-11-09: "can it
# then update every minute?"). A minute's look is cheap: it asks GitHub's API only when its releases feed
# changed, and at least every 15 minutes (CRT.Server's ServerUpdater). INSTALLING.md, "Automatic updates from
# GitHub". Every line not about WHICH instance this is equals crt-server-update.timer's.

[Timer]
OnActiveSec=1min
OnUnitInactiveSec=1min
AccuracySec=5s
Unit=crt-server-test-update.service

[Install]
WantedBy=timers.target
