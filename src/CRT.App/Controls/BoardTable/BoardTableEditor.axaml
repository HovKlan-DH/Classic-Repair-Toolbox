<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRT.BoardTableEditor">

	<UserControl.Styles>
		<!-- One TAB per workbook sheet (owner request, 2026-09-24 - they were buttons at
		     first). A real TabControl rather than restyled buttons, so a sheet tab looks and behaves
		     exactly like the application's own tabs: the same IndianRed underline for the selected
		     one and faint one on hover (App.axaml's TabItem styles), the same keyboard handling.

		     Its items carry NO content - the one grid below shows whichever sheet is selected.

		     The font and padding are Main.axaml's own TabItem setters, repeated here and scoped to
		     this control, so the sheet tabs match the main tabs wherever this editor is hosted - the
		     Drafts tab and the Maintainer tab alike. -->
		<Style Selector="TabControl#SheetTabs TabItem">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Padding" Value="12,4" />
		</Style>

		<!-- *** THE POINTER GOES THROUGH A TOOLTIP TO WHAT IS UNDER IT (owner report, 2026-10-02:
		     "the mouse should follow the cell below, and not the tooltip"). *** A cell's tooltip
		     opens over the next row, and Avalonia keeps a tooltip open while the pointer is on it -
		     so the next row could not be reached. Not hit-testable, the pointer lands on the cell
		     beneath, whose own tooltip takes over. This only works for a tooltip drawn IN the window
		     (ToolTip.ShouldUseOverlayLayer - the cells and the row grip set it); a tooltip that is a
		     window of its own, like the toolbar's, is unaffected. -->
		<Style Selector="ToolTip">
			<Setter Property="IsHitTestVisible" Value="False" />
		</Style>

		<Style Selector="TabControl#SheetTabs TabItem:pointerover /template/ Border#PART_SelectedPipe">
			<Setter Property="IsVisible" Value="True" />
		</Style>

		<!-- The colour key beside the toolbar: ONE PILL PER KIND, in the wash its rows are painted
		     in, holding both the count and the word - "[ 2 Added ]" (2026-09-24). The count was a
		     separate badge before the word at first, and with the gaps all alike "Added 1 Modified"
		     read as easily one way as the other (reported). Count first and bold, the word plain,
		     as the Workbooks tab's counted pills are. -->
		<!-- *** THE PILLS ARE THE FILTER (owner request, 2026-10-02: "even do remove the "Show
		     changes only" so it works in the same unified way"). *** Clicking one shows only the
		     rows of its kind - more than one picked shows the rows of any of them - and clicking it
		     again shows every row (BoardTableRowFilter). A picked pill wears a firm 2px outline;
		     the padding gives back the pixel the outline takes, so the row of pills does not move
		     when one is picked. -->
		<!-- *** THREE LOOKS (owner request, 2026-10-03). *** A pill counting nothing is OUTLINED -
		     no fill, a line in its kind's colour - and DIMMED (Empty). A pill counting something is
		     FILLED with its kind's wash, at full strength. A picked pill wears the 2px outline
		     (Selected), and is at full strength even when its count has dropped to 0. Pills with
		     rows were dimmed too until picked, the same day, and were then too hard to read (owner
		     request: "make this again non-dimmed"). The classes are set in UpdateToolbar; each pill
		     names its kind with a class (Added, Modified, ...) so its fill comes from a style here -
		     a Background set on the pill itself would outrank Empty's and could never be taken off.
		     The styles are in this order on purpose: among class selectors the later one wins, so
		     Empty outranks a kind's fill and Selected outranks both. -->
		<Style Selector="Border.LegendPill">
			<Setter Property="Height" Value="22" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="CornerRadius" Value="11" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{DynamicResource Table_BorderRowLine}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Border.LegendPill.Added">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Added_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BoardTable_Added_Edge}" />
		</Style>

		<Style Selector="Border.LegendPill.Modified">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Modified_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BoardTable_Modified_Edge}" />
		</Style>

		<Style Selector="Border.LegendPill.Deleted">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Deleted_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BoardTable_Deleted_Edge}" />
		</Style>

		<!-- The Errors and Warnings pills carry the corner mark their cells carry in front of the
		     count, so the pill and the cells read as one thing; outlined in the mark's colour. -->
		<Style Selector="Border.LegendPill.Errors">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Error_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BoardTable_Error_Mark}" />
		</Style>

		<Style Selector="Border.LegendPill.Warnings">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Warning_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BoardTable_Warning_Mark}" />
		</Style>

		<!-- Counting nothing: the outline alone, on the table's own background. It cannot be
		     picked then (owner request, 2026-10-03 - it could only show an empty table), so no hand
		     cursor - unless it IS picked, its count having dropped to 0, when a click puts it back. -->
		<Style Selector="Border.LegendPill.Empty">
			<Setter Property="Background" Value="{DynamicResource Table_Bg}" />
			<Setter Property="Opacity" Value="0.4" />
		</Style>

		<Style Selector="Border.LegendPill.Empty:not(.Selected)">
			<Setter Property="Cursor" Value="Arrow" />
		</Style>

		<Style Selector="Border.LegendPill.Selected">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="Padding" Value="7,0" />
			<Setter Property="BorderBrush" Value="{DynamicResource BoardTable_Pill_Selected_Border}" />
		</Style>

		<Style Selector="Border.LegendPill TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="Border.LegendPill TextBlock.LegendCount">
			<Setter Property="FontWeight" Value="Bold" />
		</Style>

		<!-- The two notices about the draft FILE (changed underneath the table, open in Excel). -->
		<Style Selector="Border.TableNotice">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Notice_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BoardTable_Notice_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="3" />
			<!-- Roomy on purpose (owner request, 2026-09-24: 5px more than at first), so a
			     notice that matters reads as one rather than as another line of text. -->
			<Setter Property="Padding" Value="15,11" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>

		<!-- A deleted row is struck through as well as red: colour alone is not enough for the
		     roughly one man in twelve who cannot tell red from green. The row's "-" marker says
		     the same thing a third way. The class is set per row in OnLoadingRow.

		     *** :is(TextBlock), NOT TextBlock. *** Cell text is drawn by a TextBlock SUBCLASS
		     (BoardTableCellText; the marker column's is the grid's own), and a plain type selector
		     matches only the exact type - so "TextBlock" here matched nothing at all while the row
		     class looked right. -->
		<Style Selector="DataGridRow.BoardTableDeleted :is(TextBlock)">
			<Setter Property="TextDecorations" Value="Strikethrough" />
		</Style>

		<!-- *** THE ROW DRAG GRIP IS ALWAYS SHOWN, FAINTLY (2026-09-24). *** The grid template's own
		     grip, borrowed as the handle for the editor's OWN row drag (BoardTableEditor.RowDrag.cs -
		     the grid's drag is off). Full strength on hover.

		     Every selector here carries a trigger (the RowsDraggable class, set while rows can be
		     moved) on purpose: the template hides the grip with a TEMPLATE-priority value, which
		     only a style with a trigger outranks - a plain "DataGridRowHeader /template/
		     Border#DragGrip" style loses and changes nothing. -->
		<Style Selector="DataGrid#TableGrid.RowsDraggable DataGridRowHeader /template/ Border#DragGrip">
			<Setter Property="IsVisible" Value="True" />
			<Setter Property="Opacity" Value="0.45" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="ToolTip.Tip" Value="Drag to move this row (or Alt+Up / Alt+Down)" />
			<!-- In the window, so the pointer passes through it to the next row's grip - see the
			     ToolTip style above. -->
			<Setter Property="ToolTip.ShouldUseOverlayLayer" Value="True" />
			<!-- Centred in the whole header (owner request, 2026-09-24). The template puts
			     the grip in a 16px first column of a two-column grid, so on its own it sat
			     centred in that column - visibly to the left of the header's middle. -->
			<Setter Property="Grid.ColumnSpan" Value="2" />
		</Style>

		<Style Selector="DataGrid#TableGrid.RowsDraggable DataGridRowHeader:pointerover /template/ Border#DragGrip">
			<Setter Property="Opacity" Value="1" />
		</Style>

		<!-- *** THE DRAGGED ROW IS DRAWN AS AN EMPTY DASHED SLOT (owner request, 2026-09-24:
		     "like moving an image in the worklog"). *** The same red, dash and rounding as the
		     worklog's photo and file placeholders (WorklogEntryEditorWindow.axaml), drawn on the
		     row's own BackgroundRectangle with the cells and grip faded out, so what shows is the
		     space the row will take. The class follows the dragged ROW across recycled containers -
		     see ApplyDropPlaceholderClasses. -->
		<Style Selector="DataGrid#TableGrid DataGridRow.BoardTableDropPlaceholder /template/ Rectangle#BackgroundRectangle">
			<Setter Property="IsVisible" Value="True" />
			<Setter Property="Fill" Value="{DynamicResource Bg}" />
			<Setter Property="Stroke" Value="{DynamicResource Text_Fail_Fg}" />
			<Setter Property="StrokeThickness" Value="2" />
			<Setter Property="StrokeDashArray" Value="4,3" />
			<Setter Property="RadiusX" Value="3" />
			<Setter Property="RadiusY" Value="3" />
		</Style>

		<Style Selector="DataGrid#TableGrid DataGridRow.BoardTableDropPlaceholder DataGridCell">
			<Setter Property="Opacity" Value="0" />
		</Style>

		<Style Selector="DataGrid#TableGrid DataGridRow.BoardTableDropPlaceholder DataGridRowHeader">
			<Setter Property="Opacity" Value="0" />
		</Style>

		<!-- *** THE CURRENT CELL: NO FILL, A 2px DASHED RED FRAME (owner request,
		     2026-09-24). *** The grid's own look filled it with the accent colour, which could be
		     taken for "added" (and hid the cell's own colour - the cell theme now keeps that, see
		     BuildCellTheme), inside a solid frame drawn twice over: the cell's FocusVisual and the
		     grid's selection outline, with Excel's fill handle in its corner.

		     The frame is the cell template's own CurrencyVisual rectangle, restyled: a Rectangle
		     can dash its stroke, a Border cannot. The dash lengths are in multiples of the stroke
		     width, so "2,1" is a 4px dash and a 2px gap. Every selector carries :current, a
		     trigger, to outrank what the template sets itself (see the grip's note below). -->
		<Style Selector="DataGrid#TableGrid DataGridCell:current /template/ Grid#FocusVisual">
			<Setter Property="IsVisible" Value="False" />
		</Style>

		<Style Selector="DataGrid#TableGrid DataGridCell:current /template/ Rectangle#CurrencyVisual">
			<Setter Property="IsVisible" Value="True" />
			<Setter Property="Stroke" Value="{DynamicResource BoardTable_CurrentCell_Border}" />
			<Setter Property="StrokeThickness" Value="2" />
			<Setter Property="StrokeDashArray" Value="2,1" />
		</Style>

		<!-- *** SEVERAL CELLS SELECTED: A VEIL OVER EACH (owner request, 2026-10-02: "mark multiple
		     rows and then delete those in one go"). *** Shift+click and Ctrl+click select a range
		     of cells (BoardTableEditor.Selection.cs). A selected cell keeps its own colour (the cell
		     theme), so with several selected each one is shaded by a translucent veil laid over it -
		     Excel's way of showing a selected range - drawn by the same CurrencyVisual rectangle, so
		     the green, orange or red underneath still shows. One selected cell is just the
		     current cell, which its dashed frame already marks: the SeveralSelected class is set only
		     with more than one. -->
		<Style Selector="DataGrid#TableGrid.SeveralSelected DataGridCell:selected /template/ Rectangle#CurrencyVisual">
			<Setter Property="IsVisible" Value="True" />
			<Setter Property="Fill" Value="{DynamicResource BoardTable_Selection_Fill}" />
		</Style>

		<!-- The grid's selection overlay: its outline (the second solid frame) and the fill handle
		     - Excel's drag-to-fill square, which writes a whole run of cells in one gesture that
		     this table was never built or tested for. Hidden, and the handle made unclickable. -->
		<Style Selector="DataGrid#TableGrid /template/ Border#PART_SelectionOutline">
			<Setter Property="Opacity" Value="0" />
		</Style>

		<Style Selector="DataGrid#TableGrid /template/ Border#PART_FillHandle">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="IsHitTestVisible" Value="False" />
		</Style>

		<!-- THE HEADER ROW STANDS APART WITHOUT SHOUTING (owner requests, 2026-09-26). A light grey
		     band was not enough, and a black one "steals way too much focus"; so the header is set
		     apart the way a printed table is: SEMI-BOLD names, a soft band, and a FIRM 2px line
		     under the whole row. BoardTable_Header_* in BoardTableColors.axaml - the table's own
		     keys, the same in the Drafts tab and the Maintainer tab.

		     Four places, each found the hard way (pinned by BoardTableEditorTests'
		     The_header_row_is_set_apart_from_corner_to_corner):
		       - the top-left corner above the drag grips draws a Grid of its own that ignores
		         Background, and the presenter behind the headers shows past the last column;
		       - the TEXT is styled on the TextBlock itself: CRT's App.axaml gives every TextBlock the
		         theme's Fg, which outranks a colour inherited from the header;
		       - the lines between column names go through the header's SeparatorBrush: the template
		         sets the line's own colour, which outranks a plain style;
		       - the line under the row is the grid's own PART_ColumnHeadersAndRowsSeparator, set by
		         the template too - see its style below. -->
		<Style Selector="DataGrid#TableGrid DataGridColumnHeader">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Header_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource BoardTable_Header_Fg}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="SeparatorBrush" Value="{DynamicResource BoardTable_Header_Separator}" />
		</Style>

		<Style Selector="DataGrid#TableGrid DataGridColumnHeader /template/ Grid#TopLeftHeaderRoot">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Header_Bg}" />
		</Style>

		<Style Selector="DataGrid#TableGrid /template/ DataGridColumnHeadersPresenter#PART_ColumnHeadersPresenter">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Header_Bg}" />
		</Style>

		<Style Selector="DataGrid#TableGrid DataGridColumnHeader TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource BoardTable_Header_Fg}" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>

		<!-- A HEADING WRAPS LIKE ITS CELLS (owner request, 2026-10-09: "can the table header also
		     please wrap"): a column narrower than its name shows the name on more lines, and the
		     heading row grows to the tallest - the grid's ColumnHeaderHeight is left to size itself,
		     never below the 28 it was fixed at. -->
		<Style Selector="DataGrid#TableGrid DataGridColumnHeader">
			<Setter Property="MinHeight" Value="28" />
		</Style>

		<Style Selector="DataGrid#TableGrid DataGridColumnHeader TextBlock">
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<!-- *** NO ROOM KEPT FOR ICONS THE TABLE NEVER SHOWS. *** The heading's template keeps a
		     32px column right of the name for its sort and filter icons, and this table sorts and
		     filters nothing through its headings - so a name wrapped 32px early, and a column fitted
		     to its heading had a wide empty band after the name (owner report, 2026-10-09). The
		     name spans that column too; a style with a class outranks the template (the grip's
		     trick). -->
		<Style Selector="DataGrid#TableGrid.HeaderStyled DataGridColumnHeader /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Grid.ColumnSpan" Value="2" />
		</Style>

		<!-- The template sets this line's colour and height ITSELF, and a value set in a template
		     outranks a plain style - so the selector carries the grid's HeaderStyled class, which
		     makes the style a trigger, and a trigger outranks the template (the grip's trick). -->
		<Style Selector="DataGrid#TableGrid.HeaderStyled /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
			<Setter Property="Fill" Value="{DynamicResource BoardTable_Header_Line}" />
			<Setter Property="Height" Value="2" />
		</Style>

		<!-- EVERY CELL WRAPS (owner request, 2026-10-04: "always apply wrap text on cells, if the
		     column size gets reduced" - it was a "Wrap text" check box the same day). With the grid's
		     CellsWrap class a cell's text - and a cell being typed in - runs over as many lines as it
		     needs within its column, and the row grows to fit (the grid has no fixed row height).
		     :is(TextBlock) for BoardTableCellText, a subclass - see the strike-through's note. A class makes each a trigger, which outranks what the cell's own
		     text theme sets. -->
		<Style Selector="DataGrid#TableGrid.CellsWrap DataGridCell :is(TextBlock)">
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<Style Selector="DataGrid#TableGrid.CellsWrap DataGridCell TextBox">
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<!-- A row with nothing long is BoardTableEditor.MinRowHeight tall: sized to its text alone it
		     shrank to one bare line, cramped against the rows around it (seen in a render). On the
		     CELLS - a MinHeight on the row changed nothing - and above the 0 the cell theme gives
		     them (BuildCellTheme). -->
		<Style Selector="DataGrid#TableGrid.CellsWrap DataGridCell">
			<Setter Property="MinHeight" Value="26" />
		</Style>

		<!-- A deleted row cannot be dragged (BoardTableSheet.BeginRowDrag refuses it), so it offers
		     no grip. Kept AFTER the grip styles above, which it must outrank. -->
		<Style Selector="DataGridRow.BoardTableDeleted DataGridRowHeader /template/ Border#DragGrip">
			<Setter Property="IsVisible" Value="False" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,Auto,*">

		<TabControl Grid.Row="0"
					x:Name="SheetTabs"
					Padding="0"
					Margin="0,0,0,6" />

		<!-- THE TOOLBAR WRAPS rather than running off the edge (2026-09-26). In the Maintainer
		     tab the table sits in the submission panel beside the queue, and at the window's
		     default width a single row pushed "Save changes" out of sight entirely (seen in a
		     render). Save and Reload are docked right, so they always keep their place; the row
		     buttons and the colour key wrap onto a second line when there is no room. At the
		     widths the Drafts tab is used at, it is one row, as before. -->
		<DockPanel Grid.Row="1" Margin="0,0,0,6">
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="16,0,0,0">
				<Button x:Name="ReloadButton"
						Content="Reload"
						ToolTip.Tip="Read the draft again from its file, for example after editing it in Excel"
						Click="OnReloadClick" />
				<!-- The same red as the Drafts row's "Discard" button (owner request,
				     2026-09-24), so the one button that writes the draft stands out. Disabled - and
				     therefore greyed by the theme - while there is nothing to save. -->
				<Button x:Name="SaveButton"
						Content="Save changes"
						Foreground="{DynamicResource Button_Cancel_Fg}"
						Background="{DynamicResource Button_Cancel_Bg}"
						BorderBrush="{DynamicResource Button_Cancel_Border}"
						ToolTip.Tip="Write your edits into the draft"
						Click="OnSaveClick" />
			</StackPanel>

			<WrapPanel x:Name="ToolbarWrap" Orientation="Horizontal" ItemSpacing="16" LineSpacing="6">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<!-- ONE insert button (owner request, 2026-10-02: "We can of course remove one of
					     the "Insert row" buttons, as that can be moved afterwards"): the new row goes
					     below the selected one, and its grip moves it anywhere. -->
					<Button x:Name="InsertRowBelowButton"
							Content="Insert row"
							ToolTip.Tip="Add an empty row below the selected one. Drag its grip to move it."
							Click="OnInsertRowBelowClick" />
					<Button x:Name="DeleteRowButton"
							Content="Delete row"
							ToolTip.Tip="Remove the selected rows - Shift+click or Ctrl+click to select several. A published row stays visible in red, where it was. Ctrl+Z undoes it."
							Click="OnDeleteRowClick" />
					<!-- No Move up / Move down buttons (removed by the project owner, 2026-09-24): a row is
					     moved by dragging its grip at the far left, or with Alt+Up / Alt+Down. -->
				</StackPanel>

				<!-- For a board with nothing published, the Added, Modified and Deleted pills are
				     hidden (Attach): there is nothing to be added, changed or deleted against. An
				     error and a warning are what they are either way.

				     Every pill is a FILTER - see the LegendPill styles. Moving rows is off while one is
				     picked: a position among hidden rows means nothing. -->
				<StackPanel x:Name="LegendPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<Border x:Name="AddedPill"
							Classes="LegendPill Added"
							Tapped="OnLegendPillTapped"
							ToolTip.Tip="Rows that are not in the published data (marked +). Click to show only these rows, and again to show every row.">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock x:Name="AddedCountText" Classes="LegendCount" Text="0" />
							<TextBlock Text="Added" />
						</StackPanel>
					</Border>
					<Border x:Name="ModifiedPill"
							Classes="LegendPill Modified"
							Tapped="OnLegendPillTapped"
							ToolTip.Tip="Rows with at least one changed cell (marked ~). Hover an orange cell to see its published value. Click to show only these rows, and again to show every row.">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock x:Name="ModifiedCountText" Classes="LegendCount" Text="0" />
							<TextBlock Text="Modified" />
						</StackPanel>
					</Border>
					<Border x:Name="DeletedPill"
							Classes="LegendPill Deleted"
							Tapped="OnLegendPillTapped"
							ToolTip.Tip="Published rows your draft no longer has (marked -). Click to show only these rows, and again to show every row.">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock x:Name="DeletedCountText" Classes="LegendCount" Text="0" />
							<TextBlock Text="Deleted" />
						</StackPanel>
					</Border>
					<!-- THE CHECKS (owner request, 2026-10-02): a cell with a problem carries a small
					     triangle in its top-left corner - red for an error, amber for a warning - and its
					     tooltip says what is wrong. An error has to be fixed before the draft can be
					     submitted; a warning never stops anything. A duplicate row and a row the save
					     leaves out are warnings since 2026-10-03 - they had a violet "Flagged" pill of
					     their own until then (owner request: "Should flagged now be treated as
					     warnings?"). -->
					<Border x:Name="ErrorsPill"
							Classes="LegendPill Errors"
							Tapped="OnLegendPillTapped"
							ToolTip.Tip="Rows with an error (red corner) - something the server would refuse. Every error has to be fixed before the draft can be submitted. Hover the cell to see what is wrong. Click to show only these rows, and again to show every row.">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<Path Data="M0,0 L9,0 L0,9 Z"
								  Fill="{DynamicResource BoardTable_Error_Mark}"
								  VerticalAlignment="Center" />
							<TextBlock x:Name="ErrorsCountText" Classes="LegendCount" Text="0" />
							<TextBlock Text="Errors" />
						</StackPanel>
					</Border>
					<Border x:Name="WarningsPill"
							Classes="LegendPill Warnings"
							Tapped="OnLegendPillTapped"
							ToolTip.Tip="Rows with a warning (amber corner) - worth a look, but nothing stops it being submitted. Hover the cell to see what it is. Click to show only these rows, and again to show every row.">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<Path Data="M0,0 L9,0 L0,9 Z"
								  Fill="{DynamicResource BoardTable_Warning_Mark}"
								  VerticalAlignment="Center" />
							<TextBlock x:Name="WarningsCountText" Classes="LegendCount" Text="0" />
							<TextBlock Text="Warnings" />
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- THE SEARCH BOX (owner request, 2026-10-02: "the same search/filter as we have in the
				     "Workbooks" tab, where it highlights what I search for") - its grammar, its
				     placeholder and its clear button are the Workbooks tab's own. Shows only the rows
				     it finds, on every sheet, and marks the text found (BoardTableEditor.Search.cs). -->
				<Grid Width="420" VerticalAlignment="Center">
					<TextBox x:Name="SearchBox"
							 PlaceholderText="Find in the table - words are ANDed, &quot;quotes&quot; for a phrase, -minus excludes"
							 FontSize="11" />
					<Button x:Name="ClearSearchButton"
							Content="&#x2715;"
							ToolTip.Tip="Clear the search"
							IsVisible="False"
							FontSize="11"
							Width="20"
							Height="20"
							Padding="0"
							Margin="0,0,4,0"
							Background="Transparent"
							BorderThickness="0"
							Cursor="Hand"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center" />
				</Grid>

			</WrapPanel>
		</DockPanel>

		<StackPanel Grid.Row="2">
			<!-- The draft file changed underneath a table with unsaved edits - in Excel, most
			     likely (BoardTableEditor.FileWatch.cs). Stays up until the table is reloaded. -->
			<Border x:Name="ChangedOnDiskBar" Classes="TableNotice" IsVisible="False">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Grid.Column="0"
							   x:Name="ChangedOnDiskText"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"
							   Text="The draft was changed outside this table - in Excel, for example - after the table was opened. What you see here is out of date, and your unsaved edits can no longer be saved into it. Copy anything you need, then press Reload." />
					<Button Grid.Column="1"
							x:Name="ChangedOnDiskReloadButton"
							Content="Reload"
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							Click="OnReloadClick" />
				</Grid>
			</Border>

			<!-- A spreadsheet program has the draft open, going by its lock file. "Appears": a
			     program that crashed can leave the lock file behind. -->
			<Border x:Name="OpenElsewhereBar" Classes="TableNotice" IsVisible="False">
				<TextBlock x:Name="OpenElsewhereText"
						   TextWrapping="Wrap"
						   Text="This draft appears to be open in Excel (or another spreadsheet program). Edit it in one place at a time: the table follows what you save in Excel, but cannot save its own edits until the file is closed there." />
			</Border>

			<!-- What just happened (saved, refused, a paste that did not fit) or what to know about
			     this table. Collapsed when there is nothing to say. -->
			<TextBlock x:Name="StatusText"
					   TextWrapping="Wrap"
					   Margin="0,0,0,6"
					   IsVisible="False" />

			<!-- The checks' problems that are in NO sheet - highlights, drawn on the schematics
			     rather than typed into a row (BoardDataChecks; BoardTableProblemWording). Collapsed
			     when there are none. -->
			<TextBlock x:Name="OutsideProblemsText"
					   TextWrapping="Wrap"
					   Margin="0,0,0,6"
					   IsVisible="False" />

			<!-- A search that finds nothing in ANY sheet (owner request, 2026-10-03) - the table
			     then keeps only the sheet on screen, empty, and this says why
			     (BoardTableSearch.NothingFoundLine). Collapsed otherwise. -->
			<TextBlock x:Name="NoSearchMatchText"
					   TextWrapping="Wrap"
					   Margin="0,0,0,6"
					   IsVisible="False" />
		</StackPanel>

		<!-- Sorting is off on purpose: deleted rows are shown where they used to be, which only
		     means something in the sheet's own order.

		     A smaller font than the grid's default, and rows as low as Excel's unless a cell's text
		     wraps (2026-09-24 and 2026-10-04, owner requests), so a sheet shows more rows at once.
		     No RowHeight: each row is as tall as its tallest cell (CellsWrap, the styles above).

		     The grid's own double-click fit is OFF: it measures only the rows on screen. A
		     double-click on a heading's edge fits the column to EVERY row instead
		     (BoardTableEditor.TextWrap.cs).

		     The scroll bars stay FULL SIZE (ScrollViewer.AllowAutoHide off, owner request,
		     2026-09-26): the theme shrank them to a hairline until pointed at, so the columns past
		     the right edge of a wide sheet were easy to miss. The grid scrolls through a
		     ScrollViewer of its own, which takes the setting from here. -->
		<DataGrid Grid.Row="3"
				  x:Name="TableGrid"
				  Classes="HeaderStyled CellsWrap"
				  FontSize="12"
				  AutoGenerateColumns="False"
				  CanUserSortColumns="False"
				  CanUserReorderColumns="False"
				  CanUserResizeColumns="True"
				  CanUserResizeColumnsOnDoubleClick="False"
				  SelectionUnit="Cell"
				  SelectionMode="Extended"
				  CanUserDeleteRows="False"
				  HeadersVisibility="All"
				  RowHeaderWidth="22"
				  GridLinesVisibility="All"
				  FrozenColumnCount="1"
				  ScrollViewer.AllowAutoHide="False"
				  BorderThickness="1"
				  BorderBrush="{DynamicResource Table_BorderRowLine}"
				  Background="{DynamicResource Table_Bg}" />

		<!-- THE FILE HOVER CARD (BoardTableEditor.FilePreview.cs): the picture, or both pictures, or
		     a link to a PDF, shown the moment the pointer is on a file cell and gone the moment it is
		     on neither that cell nor the card (owner request, 2026-09-26).

		     A POPUP IN THE WINDOW'S OWN OVERLAY LAYER, not a flyout: a flyout closes only once the
		     pointer is about 100px away from it, which read as a delay. In the overlay layer the card
		     is part of the window, so "is the pointer on it" is known exactly. Light dismiss is OFF, or
		     the first click in the grid would be spent closing the card instead of selecting a cell.

		     BESIDE the cell, not below it: below, the card covered the next rows of the same column,
		     so moving down from one file to the next landed on the card. The colours are the Fluent
		     flyout's own, so it looks as the card always did, in both themes. -->
		<Popup Grid.Row="3"
			   x:Name="FilePreviewPopup"
			   IsLightDismissEnabled="False"
			   ShouldUseOverlayLayer="True"
			   Placement="RightEdgeAlignedTop">
			<Border x:Name="FilePreviewFrame"
					Background="{DynamicResource FlyoutPresenterBackground}"
					BorderBrush="{DynamicResource FlyoutBorderThemeBrush}"
					BorderThickness="1"
					CornerRadius="4"
					Padding="12"
					BoxShadow="0 4 12 0 #40000000" />
		</Popup>
	</Grid>
</UserControl>
