<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    THE TABLE EDITOR'S OWN COLOURS, merged by App.axaml, so the Drafts tab's table and
    the Maintainer tab's table cannot drift apart. Moved here from App.axaml (2026-09-25); a user's own theme colours still
    override them, because the app writes those into its top-level resources, which win over a
    merged dictionary.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- What a cell is compared with the published data. The project owner's colours - green
                 added, orange modified, red deleted - as pale washes, so black text stays readable
                 on all three. Not Draft_Chip_Bg's amber: that marks "a draft exists", which every
                 row in this table already is. -->
            <SolidColorBrush x:Key="BoardTable_Added_Bg">#CDEFCF</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Modified_Bg">#FFD9A8</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Deleted_Bg">#F6C4C4</SolidColorBrush>
            <!-- There was a violet for "Flagged" rows (a duplicate, or one the save leaves out)
                 until 2026-10-03, when both became warnings - the colours mean only what changed. -->
            <!-- The current cell's dashed frame. A strong red, so it still stands out on the pale
                 red of a deleted row. -->
            <SolidColorBrush x:Key="BoardTable_CurrentCell_Border">#D32F2F</SolidColorBrush>
            <!-- The table's notices about its draft FILE (changed in Excel, open in Excel): a pale
                 amber, the colour of "take note" rather than of any row state. -->
            <SolidColorBrush x:Key="BoardTable_Notice_Bg">#FFF4D6</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Notice_Border">#E0B040</SolidColorBrush>
            <!-- The header row (owner requests, 2026-09-26): a soft band under semi-bold names, the
                 lines between them, and a firm line under the whole row - set apart without the
                 weight of the black band tried first. The table's own keys, not CRT's
                 Table_Header_Bg, which also colours the Contribute window's and About tab's tables. -->
            <SolidColorBrush x:Key="BoardTable_Header_Bg">#EFEFEF</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Header_Fg">#1F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Header_Separator">#CFCFCF</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Header_Line">#8A8A8A</SolidColorBrush>
            <!-- The checks (owner request, 2026-10-02): the triangle in a problem cell's top-left
                 corner, and the sheet tab's pill counting such rows - a strong red for an error,
                 which blocks a submission, and an amber for a warning, which does not. Strong
                 colours on purpose: the mark is small, and sits on the pale change washes. -->
            <SolidColorBrush x:Key="BoardTable_Error_Mark">#D32F2F</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Error_Fg">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Warning_Mark">#E09B00</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Warning_Fg">#1F1F1F</SolidColorBrush>
            <!-- The outline of a picked pill in the colour key - the filter that is on. -->
            <SolidColorBrush x:Key="BoardTable_Pill_Selected_Border">#1F1F1F</SolidColorBrush>
            <!-- The colour key's pills (owner request, 2026-10-03): each one's outline, a stronger
                 shade of its wash - a pill counting nothing is this line alone, and the pale wash
                 as a line would all but vanish on white. The Errors and Warnings pills are outlined
                 in their corner mark's colour, and filled with a pale wash of it. -->
            <SolidColorBrush x:Key="BoardTable_Added_Edge">#5FB565</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Modified_Edge">#E89A45</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Deleted_Edge">#DE6E6E</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Error_Bg">#FCE0E0</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Warning_Bg">#FFF0C4</SolidColorBrush>
            <!-- Several cells selected (owner request, 2026-10-02: "mark multiple rows and then
                 delete those in one go"): a light blue-grey veil laid OVER each selected cell, as
                 Excel shades a selected range - translucent, so the green, orange or red
                 underneath still shows. One selected cell keeps the dashed frame alone. -->
            <SolidColorBrush x:Key="BoardTable_Selection_Fill">#330B5CAD</SolidColorBrush>
        </ResourceDictionary>

        <!-- The same meanings as deep tints the light foreground stays readable on. -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BoardTable_Added_Bg">#1F4A26</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Modified_Bg">#5A3A10</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Deleted_Bg">#5A2222</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_CurrentCell_Border">#FF6B6B</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Notice_Bg">#3D3214</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Notice_Border">#8A6D1F</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Header_Bg">#333333</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Header_Fg">#EDEDED</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Header_Separator">#4A4A4A</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Header_Line">#8A8A8A</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Error_Mark">#F44336</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Error_Fg">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Warning_Mark">#FFB300</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Warning_Fg">#1F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Pill_Selected_Border">#EDEDED</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Added_Edge">#4E9A57</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Modified_Edge">#B07A30</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Deleted_Edge">#B05050</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Error_Bg">#4A1C1C</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Warning_Bg">#4A3A0E</SolidColorBrush>
            <SolidColorBrush x:Key="BoardTable_Selection_Fill">#405A9FE0</SolidColorBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
