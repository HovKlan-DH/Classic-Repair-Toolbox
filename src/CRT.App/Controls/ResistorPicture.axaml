<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             x:Class="CRT.ResistorPicture">

	<!-- A single resistor drawn with its color bands, the value they say and each band's color in words - in the pinout's
	     place, the component popup's and the "Pinout" page's (ResistorPicture.axaml.cs). -->
	<StackPanel Spacing="4">
		<local:ResistorBandsDrawing x:Name="BandsDrawing"
									HorizontalAlignment="Left"
									Margin="0,4,0,0" />
		<TextBlock Text="Resistor value:"
				   FontSize="12"
				   Margin="0,6,0,0"
				   Foreground="{DynamicResource Fg}" />
		<TextBlock x:Name="ValueText"
				   FontSize="15"
				   FontWeight="Bold"
				   Foreground="{DynamicResource Fg}" />
		<TextBlock x:Name="PowerText"
				   FontSize="11"
				   Opacity="0.75"
				   IsVisible="False"
				   Foreground="{DynamicResource Fg}" />
		<!-- Each band's color in words, first to last, the tolerance's too (owner request, 2026-11-07: "Colors: Grey, Red,
		     Red, Gold") - a swatch of the band's color before each name. -->
		<TextBlock Text="Colors:"
				   FontSize="12"
				   Margin="0,6,0,0"
				   Foreground="{DynamicResource Fg}" />
		<StackPanel x:Name="ColorsPanel" Spacing="2" Margin="8,0,0,0" />
	</StackPanel>
</UserControl>
