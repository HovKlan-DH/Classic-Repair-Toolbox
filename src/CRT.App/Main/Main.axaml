<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRT"
        xmlns:data="clr-namespace:Handlers.DataHandling;assembly=CRT.Data"
		xmlns:shapes="clr-namespace:Avalonia.Controls.Shapes;assembly=Avalonia.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CRT.Main"
        Title="Classic Repair Toolbox"
        MinWidth="800"
        MinHeight="500">

	<Window.Styles>

		<!-- Base tab font size and reduced vertical padding -->
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Padding" Value="12,4" />
		</Style>

		<!-- Hover: show a faint underline indicator -->
		<Style Selector="TabItem:pointerover /template/ Border#PART_SelectedPipe">
			<Setter Property="IsVisible" Value="True" />
		</Style>

		<!-- The Contribute tab's title: the tab's own colour, IndianRed while a draft exists
		     (Main.ApplyContributeTabState). A style, not a local value, so the class can win. -->
		<Style Selector="TextBlock.ContributeTabTitle">
			<Setter Property="Foreground" Value="{Binding $parent[TabItem].Foreground}" />
		</Style>

		<Style Selector="TextBlock.ContributeTabTitle.hasDrafts">
			<Setter Property="Foreground" Value="{DynamicResource Main_TabHeader_Drafts_Fg}" />
		</Style>

		<!-- Banner dismiss button: subtle hover on dark background -->
		<Style Selector="Button.BannerDismissButton">
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<!-- A notice card floating over the tabs' bottom-right corner (NoticeStack) -->
		<Style Selector="Border.NoticeCard">
			<Setter Property="Background" Value="{DynamicResource Main_Banner_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Main_BannerButtonsHover_Bg}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="12,8,8,8" />
			<Setter Property="BoxShadow" Value="0 3 12 0 #59000000" />
		</Style>

		<!-- Region toggle buttons -->
		<Style Selector="Button.RegionToggle.active">
			<Setter Property="BorderThickness" Value="2" />
		</Style>

		<!-- PAL active -->
		<Style Selector="Button#PalRegionButton.RegionToggle.active">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_PAL_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>
		<Style Selector="Button#PalRegionButton.RegionToggle.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>

		<!-- NTSC active -->
		<Style Selector="Button#NtscRegionButton.RegionToggle.active">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_NTSC_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>
		<Style Selector="Button#NtscRegionButton.RegionToggle.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>

	</Window.Styles>

	<Grid x:Name="RootGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="200" MinWidth="80" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="*" MinWidth="100" />
		</Grid.ColumnDefinitions>

		<Border x:Name="LeftPanel"
			Background="{DynamicResource Bg}"
			BorderBrush="{DynamicResource Border}"
			Grid.Column="0"
			Padding="16">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!-- The device worked on (CRT 4.0 step 4, Main.Devices.cs): above Hardware, as picking one
				     selects its board and its repair. Shown while the worklog is on and the user has a
				     device; it shows the device the workbook in the worklog bar is on. -->
				<StackPanel x:Name="DevicePickerPanel"
							Grid.Row="0"
							IsVisible="False">
					<TextBlock x:Name="DevicePickerHeadingText"
							   FontSize="11"
							   Foreground="{DynamicResource Fg}" />
					<ComboBox x:Name="DevicePickerComboBox"
							  HorizontalAlignment="Stretch"
							  Margin="0,8,0,0"
							  SelectionChanged="OnDevicePickerSelectionChanged" />
				</StackPanel>

				<!-- Hardware, Board and Category selectors -->
				<Grid Grid.Row="1"
					  Margin="0,8,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
							   Text="Hardware"
							   FontSize="11" />
					<ComboBox Grid.Row="1"
							  x:Name="HardwareComboBox"
							  HorizontalAlignment="Stretch"
							  Margin="0,8,0,0" />
					<TextBlock Grid.Row="2"
							   Text="Board"
							   FontSize="11"
							   Foreground="{DynamicResource Fg}"
							   Margin="0,8,0,0" />
					<ComboBox Grid.Row="3"
							  x:Name="BoardComboBox"
							  HorizontalAlignment="Stretch"
							  Margin="0,8,0,0" />
					<TextBlock Grid.Row="4"
							   Text="Category"
							   FontSize="11"
							   Foreground="{DynamicResource Fg}"
							   Margin="0,8,0,0" />
					<ListBox Grid.Row="5"
							 x:Name="CategoryFilterListBox"
							 SelectionMode="Multiple,Toggle"
							 Margin="0,8,0,0"
							 BorderThickness="1"
							 CornerRadius="4"
							 ClipToBounds="True"
							 Padding="0"
							 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListBox.Styles>
							<Style Selector="ListBox /template/ Border">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="ClipToBounds" Value="True" />
							</Style>
							<Style Selector="ListBox /template/ ScrollViewer">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="ClipToBounds" Value="True" />
							</Style>
							<Style Selector="ListBoxItem">
								<Setter Property="Padding" Value="8,3" />
								<Setter Property="MinHeight" Value="0" />
								<Setter Property="FontSize" Value="11" />
							</Style>
						</ListBox.Styles>
					</ListBox>

					<TextBlock Grid.Row="6"
							   Text="Component"
							   FontSize="11"
							   Foreground="{DynamicResource Fg}"
							   Margin="0,8,0,0" />
					<ListBox Grid.Row="7"
							 x:Name="ComponentFilterListBox"
							 SelectionMode="Multiple,Toggle"
							 Margin="0,8,0,0"
							 BorderThickness="1"
							 CornerRadius="4"
							 ClipToBounds="True"
							 Padding="0"
							 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListBox.Styles>
							<Style Selector="ListBox /template/ Border">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="ClipToBounds" Value="True" />
							</Style>
							<Style Selector="ListBox /template/ ScrollViewer">
								<Setter Property="CornerRadius" Value="3" />
								<Setter Property="ClipToBounds" Value="True" />
							</Style>

							<!-- Default (non-selected) state -->
							<Style Selector="ListBoxItem">
								<Setter Property="Padding" Value="8,3" />
								<Setter Property="MinHeight" Value="0" />
								<Setter Property="FontSize" Value="11" />
							</Style>
						</ListBox.Styles>

						<!-- ComponentListItem.IsDrafted (NewContributeStrategy.md Phase 2, session 2b):
						     a small chip after the row's own text, for a component whose entry was
						     added or changed by a local, unpublished draft. This is the list's first
						     ItemTemplate ever - it previously rendered through bare ToString(), which a
						     single TextBlock cannot mix with a conditional chip. -->
						<ListBox.ItemTemplate>
							<DataTemplate DataType="data:ComponentListItem">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<TextBlock Text="{Binding DisplayText}"
											   VerticalAlignment="Center" />
									<!-- Styled by App.axaml's Border.DraftChip, shared with the
									     Hardware and Board drop-downs' chips. -->
									<Border Classes="DraftChip"
											IsVisible="{Binding IsDrafted}"
											ToolTip.Tip="This row is a local, unpublished draft edit">
										<TextBlock Text="Draft" />
									</Border>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>

				<!-- Action Controls -->
				<StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
					<TextBox x:Name="ComponentSearchTextBox"
							 FontSize="12"
							 MinHeight="0"
							 Padding="4"
							VerticalContentAlignment="Center"
							TextChanged="OnComponentSearchTextChanged">
					</TextBox>

					<!-- Selection Actions -->
					<Grid ColumnDefinitions="*,4,*">
						<Button Grid.Column="0"
								Content="Clear"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnClearComponentsClick" />
						<Button Grid.Column="2"
								Content="Mark all"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnMarkAllComponentsClick" />
					</Grid>

					<!-- Video standard -->
					<Grid x:Name="RegionButtonsGrid" ColumnDefinitions="*,4,*">
						<Button x:Name="PalRegionButton"
								Classes="RegionToggle"
								Grid.Column="0"
								Content="PAL"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnPalRegionClick" />
						<Button x:Name="NtscRegionButton"
								Classes="RegionToggle"
								Grid.Column="2"
								Content="NTSC"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnNtscRegionClick" />
					</Grid>

					<!-- View options -->
					<Grid ColumnDefinitions="*,4,*">
						<Button Grid.Column="0"
								Content="Fullscreen"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								FontSize="12"
								Padding="4"
								Click="OnFullscreenSchematicsClick" />

						<CheckBox x:Name="BlinkSelectedCheckBox"
							  Grid.Column="2"
							  Content="Blink selected"
							  HorizontalAlignment="Left"
							  FontSize="12"
							  VerticalAlignment="Center"
							  IsCheckedChanged="OnBlinkSelectedChanged" />
					</Grid>
				</StackPanel>

			</Grid>
		</Border>

		<!-- Left Splitter -->
		<GridSplitter x:Name="MainSplitter"
					  Grid.Column="1"
					  ResizeDirection="Columns"
					  HorizontalAlignment="Stretch" />

		<!-- Right Panel -->
		<Border x:Name="RightPanel"
				Grid.Column="2"
				Background="{DynamicResource Bg}"
				BorderBrush="{DynamicResource Border}"
				BorderThickness="1"
				Padding="0,0,0,0">
			<Grid>
				<!-- TWO ROWS: the worklog bar and the tabs - and no notice may take one (owner report,
				     2026-10-11). The notices were five Auto rows here, and each one that came or went
				     moved everything below it; on the Schematics tab it resized the image as well, which
				     is fitted to its container. They float over the tabs now (NoticeStack, below). -->
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!-- Worklog bar: shows the active repair worklog job for the selected board. Permanently
				     visible above the tabs (toggled by "Enable Worklog" in Configuration), not a
				     dismissible notice like the ones floating over the tabs. -->
				<Border x:Name="WorklogBar"
						Grid.Row="0"
						IsVisible="False"
						Background="{DynamicResource Schematics_Panels_Bg}"
						BorderBrush="{DynamicResource Schematics_Panels_Border}"
						BorderThickness="0,0,0,1"
						Padding="14,8">
					<Grid ColumnDefinitions="Auto,*">
						<StackPanel Grid.Column="0"
									Orientation="Horizontal"
									Spacing="12"
									VerticalAlignment="Center">
							<TextBlock Text="Workbook"
									   FontSize="12"
									   Foreground="{DynamicResource Schematics_Panels_Fg}"
									   VerticalAlignment="Center" />
							<TextBlock x:Name="WorklogNoJobText"
									   Text="No repairs recorded for this board"
									   FontSize="12"
									   Foreground="{DynamicResource Schematics_Panels_Fg}"
									   VerticalAlignment="Center" />
							<!-- Lets ANY workbook - any board, not just the one on screen - be picked directly
							     from the bar: selecting one that belongs to a different board first switches
							     HardwareComboBox/BoardComboBox to it (OnWorklogJobBoxSelectionChanged), then
							     calls Main.ActivateWorkbook, exactly what clicking a card on the Workbooks tab
							     does for a same-board workbook. ItemsSource is WorklogManager.GetAllWorkbooks();
							     the item template (built in code-behind, see Initialize) renders
							     "#{Id} | {Title} (hardware/board)" - a short folder-derived label
							     (HardwareBoardEntry.ShortHardwareBoardLabel), not the full Excel-sheet names,
							     since those run too long once several boards' workbooks share one dropdown -
							     so workbooks from other boards are not mistaken for ones on the board
							     currently on screen. -->
							<ComboBox x:Name="WorklogJobBox"
									  IsVisible="False"
									  FontSize="12"
									  VerticalAlignment="Center"
									  SelectionChanged="OnWorklogJobBoxSelectionChanged" />
							<StackPanel x:Name="WorklogJobStatusPanel"
										Orientation="Horizontal"
										Spacing="5"
										IsVisible="False"
										VerticalAlignment="Center">
								<!-- The workbook's Open/Closed status uses the SAME pill as a worklog entry's
								     own state (see TabSchematics.axaml and WorklogEntryEditorWindow.axaml):
								     one dot-plus-label pill, 10px corner radius, coloured by the shared
								     Worklog_Status_Open/Worklog_Status_Closed brushes. Both axes read
								     "Open"/"Closed", so they must look the same wherever they appear -
								     a different shape here would suggest a different kind of thing. -->
								<Border x:Name="WorklogJobStatusPill"
										VerticalAlignment="Center"
										Background="{DynamicResource Form_Bg}"
										BorderBrush="{DynamicResource Form_Border}"
										BorderThickness="1"
										CornerRadius="10"
										Padding="10,1">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<TextBlock x:Name="WorklogJobStatusDot" FontFamily="{DynamicResource FontAwesomeSolid}" FontSize="11" VerticalAlignment="Center" />
										<TextBlock x:Name="WorklogJobStatusPillText"
												   FontSize="12"
												   Foreground="{DynamicResource Schematics_Panels_Fg}"
												   VerticalAlignment="Center" />
									</StackPanel>
								</Border>
								<TextBlock x:Name="WorklogJobStatusText"
										   FontSize="12"
										   Foreground="{DynamicResource Schematics_Panels_Fg}"
										   VerticalAlignment="Center" />
							</StackPanel>
						</StackPanel>

						<StackPanel Grid.Column="1"
									Orientation="Horizontal"
									Spacing="8"
									HorizontalAlignment="Right"
									VerticalAlignment="Center">
							<StackPanel x:Name="WorklogShowEntriesPanel"
										Orientation="Horizontal"
										Spacing="5"
										IsVisible="False"
										VerticalAlignment="Center"
										Margin="0,0,6,0">
								<TextBlock x:Name="WorklogShowEntriesLabel"
										   Text="Show worklogs"
										   FontSize="12"
										   Foreground="{DynamicResource Schematics_Panels_Fg}"
										   VerticalAlignment="Center"
										   Cursor="Hand"
										   PointerPressed="OnWorklogShowEntriesLabelPointerPressed" />
								<CheckBox x:Name="WorklogShowEntriesCheckBox"
										  MinHeight="0"
										  Margin="0"
										  Padding="0"
										  VerticalAlignment="Center"
										  IsCheckedChanged="OnWorklogShowEntriesCheckedChanged" />
							</StackPanel>
							<Button x:Name="WorklogCancelEntryButton"
									Content="Cancel"
									IsVisible="False"
									FontSize="11"
									Padding="10,4"
									Click="OnWorklogCancelEntryClick" />
							<Button x:Name="WorklogAddEntryButton"
									Classes="Accept"
									Content="Add worklog"
									IsVisible="False"
									FontSize="11"
									Padding="10,4"
									Click="OnWorklogAddEntryClick" />
							<Button x:Name="WorklogCreateWorkbookButton"
									Classes="Accept"
									Content="Create new workbook"
									FontSize="11"
									Padding="10,4"
									Click="OnWorklogCreateWorkbookClick" />
						</StackPanel>
					</Grid>
				</Border>

				<TabControl x:Name="MainTabControl" Grid.Row="1" Padding="0">

					<TabItem x:Name="SchematicsTabItem" Header="Schematics">
						<local:TabSchematics x:Name="TabSchematicsControl" />
					</TabItem>

					<TabItem Header="Overview">
						<local:TabOverview x:Name="TabOverview" />
					</TabItem>

					<TabItem Header="Resources">
						<local:TabResources x:Name="TabResources" />
					</TabItem>

					<!-- The Workbooks tab is hidden unless "Enable Worklog" is ticked in Configuration.
					     IsVisible starts False so a launch with the worklog off never flashes the tab;
					     ApplyWorklogBarVisibility sets the real value during startup and again whenever
					     the setting is toggled, alongside the worklog bar's own visibility. -->
					<TabItem x:Name="WorkbooksTabItem" Header="Workbooks" IsVisible="False">
						<local:TabWorkbooks x:Name="TabWorkbooks" />
					</TabItem>

					<TabItem x:Name="OscilloscopeTabItem" Header="Oscilloscope">
						<local:TabOscilloscope x:Name="TabOscilloscope" />
					</TabItem>

					<!-- THE CONTRIBUTE TAB (CRT 4.0 step 2, 2026-10-25 - the plan: "One tab instead of
					     Contribute and Drafts"): always on screen, and TabDrafts underneath.
					     Its title is IndianRed while a draft exists (owner request, 2026-09-25, for the
					     Drafts tab: a draft is temporary - local work waiting to be submitted and
					     published - and the tab says so at a glance; ApplyContributeTabState sets the
					     class). Its BADGE (owner request, 2026-09-30) counts the submissions with news the
					     contributor has not seen - the same number as the "My submissions" button's
					     badge inside the tab (Main.SubmissionChecks.cs). -->
					<TabItem x:Name="ContributeTabItem">
						<TabItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock x:Name="ContributeTabHeaderText"
								           Classes="ContributeTabTitle"
								           Text="Contribute"
								           VerticalAlignment="Center" />
								<Border x:Name="ContributeTabBadge"
								        IsVisible="False"
								        Background="{DynamicResource Badge_Attention_Bg}"
								        CornerRadius="8"
								        Padding="4,0"
								        MinWidth="16"
								        VerticalAlignment="Center">
									<TextBlock x:Name="ContributeTabBadgeText"
									           FontSize="11"
									           FontWeight="SemiBold"
									           HorizontalAlignment="Center"
									           Foreground="{DynamicResource Badge_Attention_Fg}" />
								</Border>
							</StackPanel>
						</TabItem.Header>
						<local:TabDrafts x:Name="TabDrafts" />
					</TabItem>

					<!-- The Maintainer tab (2026-09-29: the separate CRT Maintainer application, now a tab)
					     is hidden unless "Enable Maintainer tab" is ticked in Configuration - it needs a
					     maintainer account, which almost nobody running CRT has. IsVisible starts False so
					     a launch with it off never flashes the tab; ApplyMaintainerTabVisibility sets the
					     real value in the constructor and whenever the setting is toggled. While it is
					     selected, Main.Maintainer.cs collapses the sidebar and the worklog bar.

					     ITS BADGE (owner request, 2026-09-30) counts what waits for the signed-in
					     maintainer - the "Contributor Submissions" and "Beta > Prod" badges added up,
					     kept current off screen too (Main.Maintainer.cs). The title binds the TabItem's
					     own Foreground: CRT's app-wide TextBlock style would otherwise paint it the one
					     text colour whether the tab is selected, pointed at or neither. -->
					<TabItem x:Name="MaintainerTabItem" IsVisible="False">
						<TabItem.Header>
							<StackPanel Orientation="Horizontal" Spacing="5">
								<TextBlock x:Name="MaintainerTabHeaderText"
								           Text="Maintainer"
								           VerticalAlignment="Center"
								           Foreground="{Binding $parent[TabItem].Foreground}" />
								<Border x:Name="MaintainerTabBadge"
								        IsVisible="False"
								        Background="{DynamicResource Badge_Attention_Bg}"
								        CornerRadius="8"
								        Padding="4,0"
								        MinWidth="16"
								        VerticalAlignment="Center">
									<TextBlock x:Name="MaintainerTabBadgeText"
									           FontSize="11"
									           FontWeight="SemiBold"
									           HorizontalAlignment="Center"
									           Foreground="{DynamicResource Badge_Attention_Fg}" />
								</Border>
							</StackPanel>
						</TabItem.Header>
						<local:TabMaintainer x:Name="TabMaintainer" />
					</TabItem>

					<TabItem x:Name="ConfigurationTabItem" Header="Configuration">
						<local:TabConfiguration x:Name="TabConfiguration" />
					</TabItem>

					<TabItem Header="Feedback" IsVisible="True">
						<local:TabFeedback x:Name="TabFeedback" />
					</TabItem>

					<TabItem Header="About">
						<local:TabAbout x:Name="TabAbout" />
					</TabItem>

				</TabControl>

				<Border x:Name="DataSyncStatusIconBorder"
						Grid.Row="1"
						ZIndex="10"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,15,15,0"
						Width="22"
						Height="22"
						Background="Transparent"
						ClipToBounds="True"
						PointerEntered="OnDataSyncStatusIconPointerEntered"
						PointerExited="OnDataSyncStatusIconPointerExited"
						PointerPressed="OnDataSyncStatusIconPointerPressed">
					<Grid Width="22"
						  Height="22"
						  ClipToBounds="True">

						<TextBlock x:Name="DataSyncStatusIconTextBlock"
								   Width="22"
								   Height="22"
								   FontFamily="{StaticResource FontAwesomeSolid}"
								   FontWeight="Black"
								   FontSize="18"
								   TextAlignment="Center"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center" />

						<Canvas x:Name="DataSyncStatusSpinnerCanvas"
								Width="22"
								Height="22"
								IsVisible="False"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								ClipToBounds="True">
							<shapes:Ellipse x:Name="DataSyncStatusSpinnerEllipse"
											Width="20"
											Height="20"
											Canvas.Left="3"
											Canvas.Top="3"
											StrokeThickness="3"
											StrokeLineCap="Round"
											StrokeDashArray="12,40" />
						</Canvas>

					</Grid>
				</Border>

				<!-- THE NOTICES (owner report, 2026-10-11): cards over the tabs' bottom-right corner,
				     stacked upwards, so one that comes or goes moves nothing else on screen.
				     Main.Notices.cs owns what they share; each card's own part shows and hides it.

				     A notice here is something to act on, a mode holding the window, or the data check:
				     its card says what it is doing while it runs, then what it found - and the spinning
				     sync icon's tooltip says the same, for whoever closed the card (Main.DataSyncStatus.cs).

				     The stack has no Background, so the gaps between cards, and an empty stack, let
				     clicks through to the tab below. Its width and margin are set in code
				     (NoticeStackGeometry): at most half the tabs' width, so on the Schematics tab it
				     stays over the thumbnail list. -->
				<StackPanel x:Name="NoticeStack"
							Grid.Row="1"
							ZIndex="20"
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Spacing="8">

					<!-- The settings file could not be read, so CRT started on defaults - and where the
					     unreadable file was kept (Main.SettingsNotice.cs). Stays until closed. -->
					<Border x:Name="SettingsUnreadableBanner"
							Classes="NoticeCard"
							IsVisible="False">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="SettingsUnreadableBannerText"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Main_Banner_Fg}"
									   FontSize="12"
									   TextWrapping="Wrap" />

							<Button x:Name="SettingsUnreadableBannerDismissButton"
									Grid.Column="1"
									Classes="BannerDismissButton"
									Content="✕"
									VerticalAlignment="Top"
									Margin="8,0,0,0"
									FontSize="11"
									Padding="6,3"
									Click="OnSettingsUnreadableBannerDismiss" />
						</Grid>
					</Border>

					<!-- Data that needs a newer CRT, and the server's "update CRT" for submissions - a
					     paragraph per reason (Main.Updates.cs). -->
					<Border x:Name="MainExcelRequiresAppUpdateBanner"
							Classes="NoticeCard"
							IsVisible="False">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="MainExcelRequiresAppUpdateBannerText"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Main_Banner_Fg}"
									   FontSize="12"
									   TextWrapping="Wrap" />

							<Button x:Name="MainExcelRequiresAppUpdateBannerDismissButton"
									Grid.Column="1"
									Classes="BannerDismissButton"
									Content="✕"
									VerticalAlignment="Top"
									Margin="8,0,0,0"
									FontSize="11"
									Padding="6,3"
									Click="OnMainExcelRequiresAppUpdateBannerDismiss" />
						</Grid>
					</Border>

					<!-- A newer CRT to install (Main.Updates.cs) - also where its download's progress
					     and a failed install are said. -->
					<Border x:Name="UpdateBanner"
							Classes="NoticeCard"
							IsVisible="False">
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
							<TextBlock x:Name="UpdateBannerText"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Main_Banner_Fg}"
									   FontSize="12"
									   TextWrapping="Wrap" />

							<Button x:Name="UpdateBannerDismissButton"
									Grid.Column="1"
									Classes="BannerDismissButton"
									Content="✕"
									VerticalAlignment="Top"
									Margin="8,0,0,0"
									FontSize="11"
									Padding="6,3"
									Click="OnUpdateBannerDismiss" />

							<StackPanel Grid.Row="1"
										Grid.ColumnSpan="2"
										Orientation="Horizontal"
										HorizontalAlignment="Right"
										Spacing="4">
								<Button x:Name="UpdateBannerViewNotesButton"
										Classes="BannerDismissButton"
										Content="View release notes"
										Margin="0,8,0,0"
										FontSize="11"
										Padding="6,3"
										Click="OnViewReleaseNotesClick" />

								<Button x:Name="UpdateBannerInstallButton"
										Classes="Accept BannerInstallButton"
										Content="Install"
										Margin="0,8,0,0"
										FontSize="11"
										Padding="10,3"
										Click="OnInstallUpdateClick" />
							</StackPanel>
						</Grid>
					</Border>

					<!-- A data check: what it is doing while it runs, then what it found - "all up to
					     date" goes by itself after a few seconds, "please refresh board" stays
					     (Main.DataSyncStatus.cs, DataCheckNotice). A click anywhere on it closes it. -->
					<Border x:Name="DataCheckBanner"
							Classes="NoticeCard"
							IsVisible="False"
							Cursor="Hand"
							PointerPressed="OnDataCheckBannerPointerPressed">
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
							<TextBlock x:Name="DataCheckBannerText"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Main_Banner_Fg}"
									   FontSize="12"
									   TextWrapping="Wrap" />

							<Button x:Name="DataCheckBannerDismissButton"
									Grid.Column="1"
									Classes="BannerDismissButton"
									Content="✕"
									VerticalAlignment="Top"
									Margin="8,0,0,0"
									FontSize="11"
									Padding="6,3"
									Click="OnDataCheckBannerDismiss" />

							<StackPanel Grid.Row="1"
										Grid.ColumnSpan="2"
										Orientation="Horizontal"
										HorizontalAlignment="Right">
								<Button x:Name="DataCheckBannerRefreshButton"
										Classes="Accept BannerInstallButton"
										Content="Refresh Board"
										IsVisible="False"
										Margin="0,8,0,0"
										FontSize="11"
										Padding="10,3"
										Click="OnRefreshBoardClick" />
							</StackPanel>
						</Grid>
					</Border>

					<!-- ONE card for two notices: launch sync turned off by a local edit
					     (Main.DataSyncStatus.cs) and the official data moving under a draft
					     (Main.DraftDrift.cs). A data check never writes here - it has its own card above.
					     A click anywhere on it closes it. -->
					<Border x:Name="SyncBanner"
							Classes="NoticeCard"
							IsVisible="False"
							Cursor="Hand"
							PointerPressed="OnSyncBannerPointerPressed">
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
							<TextBlock x:Name="SyncBannerText"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Main_Banner_Fg}"
									   FontSize="12"
									   TextWrapping="Wrap" />

							<Button x:Name="SyncBannerDismissButton"
									Grid.Column="1"
									Classes="BannerDismissButton"
									Content="✕"
									VerticalAlignment="Top"
									Margin="8,0,0,0"
									FontSize="11"
									Padding="6,3"
									Click="OnSyncBannerDismiss" />

							<StackPanel Grid.Row="1"
										Grid.ColumnSpan="2"
										Orientation="Horizontal"
										HorizontalAlignment="Right"
										Spacing="4">
								<!-- Its own button with its own handler, deliberately NOT an overload of the
								     data check's "Refresh Board" - the two do entirely different things and
								     are shown by different flows. -->
								<Button x:Name="SyncBannerDriftButton"
										Classes="Accept BannerInstallButton"
										Content="What changed"
										IsVisible="False"
										Margin="0,8,0,0"
										FontSize="11"
										Padding="10,3"
										Click="OnSyncBannerDriftClick" />
							</StackPanel>
						</Grid>
					</Border>

					<!-- "Your submission is now in the stable source - switch back from BETA" (owner
					     request, 2026-09-27). See Main.SourceSwitchNotice.cs. -->
					<Border x:Name="SourceSwitchBanner"
							Classes="NoticeCard"
							IsVisible="False">
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
							<TextBlock x:Name="SourceSwitchBannerText"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Main_Banner_Fg}"
									   FontSize="12"
									   TextWrapping="Wrap" />

							<Button x:Name="SourceSwitchBannerDismissButton"
									Grid.Column="1"
									Classes="BannerDismissButton"
									Content="✕"
									VerticalAlignment="Top"
									Margin="8,0,0,0"
									FontSize="11"
									Padding="6,3"
									ToolTip.Tip="Do not tell me about these submissions again"
									Click="OnSourceSwitchBannerDismiss" />

							<StackPanel Grid.Row="1"
										Grid.ColumnSpan="2"
										Orientation="Horizontal"
										HorizontalAlignment="Right">
								<Button x:Name="SourceSwitchBannerConfigurationButton"
										Classes="Accept BannerInstallButton"
										Content="Open Configuration"
										Margin="0,8,0,0"
										FontSize="11"
										Padding="10,3"
										Click="OnSourceSwitchBannerConfigurationClick" />
							</StackPanel>
						</Grid>
					</Border>

					<!-- The label editor holds the board: hardware, board and schematic stay put until
					     its changes are applied or discarded (TabSchematics.LabelEditor.cs). No close
					     button - it goes when the mode does. A card rather than the mode hint, which
					     clears on the first click: this lasts the whole edit, and the corner it covers
					     is mostly the thumbnail list, which is locked meanwhile anyway. -->
					<Border x:Name="SchematicsLabelEditorModeBanner"
							Classes="NoticeCard"
							IsVisible="False">
						<TextBlock Text="Component label editor mode is active. Hardware, board, and schematic navigation are temporarily locked until changes are applied or discarded."
								   VerticalAlignment="Center"
								   Foreground="{DynamicResource Main_Banner_Fg}"
								   FontSize="12"
								   TextWrapping="Wrap" />
					</Border>
				</StackPanel>

			</Grid>
		</Border>

		<!-- MODE HINT: the "what to do next" label shown while a mode is waiting for the user to
		     act on the schematic image - clicking "Add worklog" otherwise leaves them with a
		     crosshair and no instruction.

		     A direct child of RootGrid, spanning all three columns and pinned to the window's
		     UPPER-LEFT corner, so it floats above EVERYTHING - the LeftPanel sidebar included -
		     rather than being confined to the RightPanel's tab area where it used to live. It is
		     the LAST child in RootGrid, so it draws on top of every sibling without needing a
		     ZIndex to fight over; the explicit ZIndex is still set high as a safety net against
		     whatever gets added after it later.

		     The khaki fill is the same highlight the component hover label and thumbnail headers
		     use, so it reads as the app's own "look here" colour rather than a new kind of alert.
		     The border is DASHED and IndianRed (the same accent the selected-tab underline and
		     selected-workbook-card border use) at 2px, one step heavier than the app's ordinary 1px
		     borders, so the hint itself reads as clearly distinct from ordinary panel chrome.
		     The "Hint:" lead-in is bold and on its OWN line (a LineBreak, not just a leading word)
		     so it reads as a label sitting above the sentence rather than as its first word. A
		     SECOND LineBreak follows it, purely for vertical space between the label and the
		     sentence - an empty Run would not do it, since Avalonia collapses a blank inline.

		     It clears itself on the first pointer press, so it costs an experienced user one click
		     they were going to make anyway. Driven from Main.ModeHint.cs.

		     A Panel rather than a Border: only shapes carry StrokeDashArray, Border has no
		     dashed-edge option at all (see the same note beside the drag-placeholder Rectangle in
		     WorklogEntryEditorWindow.axaml) - so the dashed outline is drawn by a Rectangle sized to
		     fill the Panel, with the text on top of it.

		     The TextBlock has no StackPanel around it. A horizontal StackPanel measures its children
		     with infinite width, so a TextWrapping="Wrap" inside one never wraps at all - the text
		     just ran past the window edge no matter what MaxWidth the Panel carried. -->
		<Panel x:Name="ModeHintBorder"
			   Grid.Column="0"
			   Grid.ColumnSpan="3"
			   ZIndex="1000"
			   IsVisible="False"
			   IsHitTestVisible="False"
			   HorizontalAlignment="Left"
			   VerticalAlignment="Top"
			   MaxWidth="350"
			   Margin="10,10,0,0">
			<Rectangle Stroke="{DynamicResource Main_TabUnderline_Selected}"
					   StrokeThickness="2"
					   StrokeDashArray="4,2"
					   RadiusX="3"
					   RadiusY="3"
					   Fill="{DynamicResource Schematics_ComponentHover_Bg}" />
			<TextBlock FontSize="12"
					   TextWrapping="Wrap"
					   VerticalAlignment="Center"
					   Margin="15"
					   Foreground="{DynamicResource Schematics_ComponentHover_Fg}">
				<Run Text="&#xf059;" FontFamily="{StaticResource FontAwesomeRegular}" /><Run Text="  Hint:" FontWeight="Bold" /><LineBreak /><LineBreak /><Run x:Name="ModeHintText" />
			</TextBlock>
		</Panel>

		<!-- "Please wait" over the whole window - BusyOverlay, the one wait of the whole
		     application (owner decision, 2026-09-28: "I want this method everywhere in the entire
		     project where there is a Wait"). Every tab finds it through BusyOverlay.For, so a wait
		     anywhere in this window dims all of it. Last, and above the mode hint, so it covers
		     everything. -->
		<local:BusyOverlay x:Name="BusyOverlay"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						ZIndex="2000" />

	</Grid>

</Window>