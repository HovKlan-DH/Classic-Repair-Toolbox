				<!-- Dark, the Boards screen's read-only notice. -->
				<SolidColorBrush x:Key="Notice_Bg">#33270F</SolidColorBrush>
				<SolidColorBrush x:Key="Notice_Border">#7A5A1E</SolidColorBrush>
				<SolidColorBrush x:Key="Notice_Fg">#F7D9A0</SolidColorBrush>

				<!-- Dark, the changelog on the "About" tab: GitHub's dark alert colors, the grounds and
