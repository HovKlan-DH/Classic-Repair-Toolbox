				<SolidColorBrush x:Key="Changelog_HeadingLine">#3E342F</SolidColorBrush>
				<SolidColorBrush x:Key="Changelog_Quote_Bar">#524842</SolidColorBrush>
				<SolidColorBrush x:Key="Changelog_Quote_Fg">#B5A896</SolidColorBrush>
				<SolidColorBrush x:Key="Changelog_Alert_Note">#4493F8</SolidColorBrush>
				<SolidColorBrush x:Key="Changelog_Alert_Tip">#3FB950</SolidColorBrush>
				<SolidColorBrush x:Key="Changelog_Alert_Important">#AB7DF8</SolidColorBrush>
				<SolidColorBrush x:Key="Changelog_Alert_Warning">#D29922</SolidColorBrush>
				<SolidColorBrush x:Key="Changelog_Alert_Caution">#F85149</SolidColorBrush>

				<!-- Dark, Thumbnail -->
				<SolidColorBrush x:Key="Thumbnail_Border">LightGray</SolidColorBrush>
				<SolidColorBrush x:Key="Thumbnail_BorderSelected">IndianRed</SolidColorBrush>
				<SolidColorBrush x:Key="Thumbnail_Bg">#3D302A</SolidColorBrush>
				<SolidColorBrush x:Key="Thumbnail_Fg">LightGray</SolidColorBrush>
				<SolidColorBrush x:Key="Thumbnail_Selection_Bg">#4076A4</SolidColorBrush>
				<SolidColorBrush x:Key="Thumbnail_Selection_Fg">White</SolidColorBrush>

				<!-- Dark, Component info popup -->
				<SolidColorBrush x:Key="ComponentPopup_Name_Bg">Khaki</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_Name_Fg">Black</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_Name_Border">Black</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_Pin_Bg">Khaki</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_Pin_Fg">Black</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_Pin_Border">Black</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_OscilloscopeExpected_Bg">#B0D8EC</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_OscilloscopeExpected_Fg">Black</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_OscilloscopeExpected_Border">Black</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_OscilloscopeSyncData_Bg">#735443</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_OscilloscopeSyncData_Fg">#E8DDCF</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_OscilloscopeSyncData_Border">#B87352</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_ImageXofY_Bg">#BB000000</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_ImageXofY_Fg">White</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_ImageXofY_Border">Black</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_KeyboardTyping_Bg">Khaki</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_KeyboardTyping_Fg">DarkOliveGreen</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_KeyboardTyping_Border">Black</SolidColorBrush>
				<SolidColorBrush x:Key="ComponentPopup_ImageTransparent_Bg">#A99F99</SolidColorBrush>

				<!-- Dark, Feedback tab -->
				<SolidColorBrush x:Key="Feedback_TrashIcon_Fg">#F26C6C</SolidColorBrush>

				<!-- Dark, Maintainer tab (see the Light twin) -->
				<SolidColorBrush x:Key="Badge_NewBoard_Bg">#3D2E10</SolidColorBrush>
				<SolidColorBrush x:Key="Badge_NewBoard_Fg">#F7C873</SolidColorBrush>
				<SolidColorBrush x:Key="Badge_NewBoard_Border">#7A5A1E</SolidColorBrush>
				<SolidColorBrush x:Key="Queue_Divider">#4A4A4A</SolidColorBrush>
				<SolidColorBrush x:Key="Mode_Selected_Bg">#27384D</SolidColorBrush>
				<SolidColorBrush x:Key="Mode_Selected_Border">#6F9FD8</SolidColorBrush>
				<!-- #D9534F until 2026-11-12, 4.0:1 with its white count. -->
				<SolidColorBrush x:Key="Badge_Attention_Bg">#C74C49</SolidColorBrush>
				<SolidColorBrush x:Key="Badge_Attention_Fg">White</SolidColorBrush>
				<SolidColorBrush x:Key="Badge_Count_Bg">#3A3A3A</SolidColorBrush>
				<SolidColorBrush x:Key="Badge_Count_Fg">#C8C8C8</SolidColorBrush>

				<!-- Dark, the introduction tours (see the Light twin) -->
				<SolidColorBrush x:Key="Tour_Dim">#AF000000</SolidColorBrush>
				<SolidColorBrush x:Key="Tour_Card_Bg">#2B2623</SolidColorBrush>
				<SolidColorBrush x:Key="Tour_Card_Fg">#E8E0DA</SolidColorBrush>
				<SolidColorBrush x:Key="Tour_Card_Border">#5AFFFFFF</SolidColorBrush>

			</ResourceDictionary>
		</ResourceDictionary.ThemeDictionaries>
		<!-- A board's own regions (2026-11-09; RegionChoice): four colors they take turns with - the same in both themes, so
		     ONCE, outside the theme dictionaries (code review, 2026-11-09: word for word in each, to drift apart). -->
		<!-- SeaGreen (#2E8B57) until 2026-11-12, 4.2:1 with its white name; a shade deeper since. -->
		<SolidColorBrush x:Key="Schematics_Region_Own1_Bg">#2C8453</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own1_Fg">White</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own1_Border">Black</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own2_Bg">#7E57C2</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own2_Fg">White</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own2_Border">Black</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own3_Bg">#E0912F</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own3_Fg">Black</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own3_Border">Black</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own4_Bg">#3A7CA5</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own4_Fg">White</SolidColorBrush>
		<SolidColorBrush x:Key="Schematics_Region_Own4_Border">Black</SolidColorBrush>
		<!-- The bar that takes a person back where they came from (Controls/ReturnBar; owner request, 2026-11-11: "2px black
		     dashed border, to give it some attention", and white, not lightgray, the same day) - the same in both themes, to
		     stand out from either. -->
		<SolidColorBrush x:Key="ReturnBar_Bg">White</SolidColorBrush>
		<SolidColorBrush x:Key="ReturnBar_Fg">Black</SolidColorBrush>
		<SolidColorBrush x:Key="ReturnBar_Border">Black</SolidColorBrush>
		<!-- The introduction tours' frame round what a step shows, and its dots (Main/TourOverlay, 2026-11-11) - amber,
		     the same in both themes: IndianRed says "danger" in CRT and green "go ahead", so a tour has a color of its own. -->
		<SolidColorBrush x:Key="Tour_Frame">#FFB400</SolidColorBrush>
		<SolidColorBrush x:Key="Tour_Dot_Off">#46808080</SolidColorBrush>
	</ResourceDictionary>
</Application.Resources>

	<Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- The light theme's accent - a ticked box, a picked radio button, a slider, a focused text box - CRT's own
                     blue (the chart's, near Windows' default), never whatever accent Windows is set to: until 2026-11-12 it
                     was, and only this theme's controls changed with it. The "User preference" theme shares it. -->
                <ColorPaletteResources x:Key="Light"
                                       Accent="#2A78D6" />
                <!-- Native Avalonia controls themed towards brown/copper -->
                <ColorPaletteResources x:Key="Dark"
                                       RegionColor="#201C1A"
                                       BaseHigh="#E8E0DA"
                                       BaseLow="#3E342F"
                                       BaseMedium="#A3938A"
                                       ChromeLow="#1E1815"
                                       ChromeMedium="#261E1A"
                                       ChromeWhite="White"
                                       Accent="#B87352" />
            </FluentTheme.Palettes>
        </FluentTheme>

		<!-- ### -->

		<!-- Tab, Hover -->
		<Style Selector="TabItem:pointerover /template/ Border#PART_SelectedPipe">
			<Setter Property="Background" Value="{DynamicResource Main_TabUnderline_Hover}" />
		</Style>

		<!-- Tab, Selected -->
		<Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
			<Setter Property="Background" Value="{DynamicResource Main_TabUnderline_Selected}" />
		</Style>

		<!--
		THE ADMINISTRATOR'S PADLOCK, EVERYWHERE IN CRT (owner request, 2026-10-04: "Mark all admin
		locked things (generally everywhere in application) with the Font Awesome "fa-lock" icon, so it
		is clear which things are applicable only for the admin. No title/helper text on this icon").
		Font Awesome's solid "lock", U+F023, written as <TextBlock Classes="AdminLock" Text="&#xf023;" />
		right after the name of anything only the administrator can use - today the administrator's
		entries on the Maintainer tab's Account screen - and, deliberately, with NO tooltip.

		The 1px top padding is not decoration: the padlock is drawn 32 units (of 512) taller than the
		font's declared ascent, and without the room the top of its shackle is clipped. 1px is what
		FontAwesomeGlyphMetrics works out for it at 11px; change the size and
		TabMaintainerModesTests' padlock test says the new figure.
		-->
		<Style Selector="TextBlock.AdminLock">
			<Setter Property="FontFamily" Value="{DynamicResource FontAwesomeSolid}" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Padding" Value="0,1,0,0" />
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--
		THE AMBER NOTICE PANEL - why something cannot be done right now, as a panel of its own (owner
		requests, 2026-10-09: "please highlight the text ... as its own panel", and then of the queue's
		"why Approve is off" line: "I think this should look the same ... The UI should have a uniform
		and consistent look"). ONE look, so every such panel stays the same: a Border.Notice holding
		a Grid of a TextBlock.NoticeIcon (Font Awesome's "circle-info", U+F05A - not the padlock, which
		marks what only the administrator can use) and the words in TextBlock.NoticeText. Used by the
		Boards screen's ReadOnlyNotice and the queue's BeforeApprovingNotice.
		The words are not bold and the icon stands in the middle of them (owner request, 2026-10-30, of
		the Contribute tab's local-draft notice: "please do not bold the text and vertically middle-align
		the info-icon").
		-->
		<Style Selector="Border.Notice">
			<Setter Property="Background" Value="{DynamicResource Notice_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Notice_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="12,8" />
		</Style>

		<Style Selector="TextBlock.NoticeIcon">
			<Setter Property="FontFamily" Value="{DynamicResource FontAwesomeSolid}" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="Foreground" Value="{DynamicResource Notice_Fg}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,0,10,0" />
		</Style>

		<Style Selector="TextBlock.NoticeText">
			<Setter Property="Foreground" Value="{DynamicResource Notice_Fg}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<!--
		EVERY BUTTON KEEPS ITS COLOR UNDER THE POINTER AND WHILE PRESSED, A SHADE DEEPER (2026-11-12, the theme color review).
		Fluent's own looks REPLACED the fill: a plain button turned lighter under the pointer in the light theme and darker
		than at rest in the dark one, and a green or red button went grey, its words black. A button whose background is
		Transparent - an icon, a link - keeps Fluent's faint wash: a fill of its own would be a box it never had. Here, BEFORE
		every button style below that sets its own look under the pointer (a notice card's, a tab strip's, a joined switch's
		chosen one), so those still win - Avalonia applies the later of two matching styles.
		NOT a note box's format buttons (RichNoteTheme.axaml): their theme has a look of its own under the pointer, and one
		that is "On" keeps it there - an App style outranks a control theme's, so this took it away (code review, 2026-11-13;
		ButtonStatesTests).
		-->
		<Style Selector="Button:not(Button[Background=Transparent]):not(Button.FormatTool):pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Hover_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Hover_Border}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Fg}" />
		</Style>
		<Style Selector="Button:not(Button[Background=Transparent]):not(Button.FormatTool):pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Pressed_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Hover_Border}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Fg}" />
		</Style>
		<Style Selector="Button.Accept:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Ok_Hover_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Ok_Border}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Ok_Fg}" />
		</Style>
		<Style Selector="Button.Accept:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Ok_Pressed_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Ok_Border}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Ok_Fg}" />
		</Style>
		<Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Cancel_Hover_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Cancel_Border}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Cancel_Fg}" />
		</Style>
		<Style Selector="Button.Danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Cancel_Pressed_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Cancel_Border}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Cancel_Fg}" />
		</Style>

		<!-- A notice card's action button (Install, Refresh Board, ...): green like every Accept
		     button, and staying green under the pointer and while pressed. -->
		<Style Selector="Button.Accept.BannerInstallButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Ok_Bg}" />
		</Style>
		<Style Selector="Button.Accept.BannerInstallButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Ok_Bg}" />
		</Style>

		<!-- Banner dismiss button: subtle hover on dark background -->
		<Style Selector="Button.BannerDismissButton">
			<Setter Property="Foreground" Value="{DynamicResource Main_Banner_Fg}" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.BannerDismissButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Main_BannerButtonsHover_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Main_BannerButtonsHover_Fg}" />
		</Style>

		<Style Selector="ListBox">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
		</Style>

		<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Bg}" />
		</Style>
		<Style Selector="ListBoxItem:selected">
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>
		<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>
		<Style Selector="ListBoxItem:selected:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<Style Selector="ListBoxItem">
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
		</Style>

		<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>

		<!-- Selected state -->
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Bg}" />
		</Style>
		<Style Selector="ListBoxItem:selected">
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<!-- Selected hover state -->
		<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>
		<Style Selector="ListBoxItem:selected:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<!-- This is INPUT field. Its edge is Form_Border, as a drop-down list's is (2026-11-12 - Fluent's own until then:
		     another grey in the light theme, a far brighter one in the dark). The same three for the boxes that hold a
		     TextBox of their own, whose rest look was Fluent's half-transparent ground: a filter box and a number box. -->
		<Style Selector="TextBox, AutoCompleteBox, NumericUpDown">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
		</Style>

		<!-- Prevent Background and Border changes on Hover -->
		<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
		</Style>

		<!-- Prevent Background changes on Click/Focus -->
		<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
		</Style>

		<!-- Prevent Foreground changes on Hover and Focus -->
		<Style Selector="TextBox:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
		</Style>

		<Style Selector="TextBox:focus">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
		</Style>

		<Style Selector="ComboBox">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
		</Style>

		<Style Selector="ComboBoxItem">
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
		</Style>

		<Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>

		<Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Bg}" />
		</Style>

		<Style Selector="ComboBoxItem:selected">
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>

		<Style Selector="ComboBoxItem:selected:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="{DynamicResource Splitter}" />
		</Style>

		<Style Selector="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
		</Style>

		<Style Selector="Button">
			<Setter Property="Background" Value="{DynamicResource Button_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Border}" />
		</Style>

		<!-- A toggle button (the label editor's components not marked yet) and a drop-down button (the table's "Columns",
		     a color picker's swatch) look as a button does, at rest and under the pointer (2026-11-12): a style names an
		     exact type, so "Button" never reached them, and they kept Fluent's half-transparent grey - in the "User
		     preference" theme a darker grey than every button beside them. A toggle turned on keeps Fluent's accent. -->
		<Style Selector="ToggleButton, DropDownButton">
			<Setter Property="Background" Value="{DynamicResource Button_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Border}" />
		</Style>
		<Style Selector="ToggleButton:not(:checked):pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Hover_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Hover_Border}" />
		</Style>
		<Style Selector="ToggleButton:not(:checked):pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Button_Pressed_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Hover_Border}" />
		</Style>
		<Style Selector="DropDownButton:pointerover /template/ Border#RootBorder">
			<Setter Property="Background" Value="{DynamicResource Button_Hover_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Hover_Border}" />
		</Style>
		<Style Selector="DropDownButton:pressed /template/ Border#RootBorder">
			<Setter Property="Background" Value="{DynamicResource Button_Pressed_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Hover_Border}" />
		</Style>

		<!-- *** A BUTTON'S COLOUR SAYS WHAT IT DOES, AND ONLY TWO DO (owner decision, 2026-10-13:
		     "Throw-away and danger equals this IndianRed, while Accept/save/update is a green'ish
		     button"). ***
		       Accept - green: saves, submits, sends, adds, creates, applies, approves, publishes,
		                installs or updates - the button that goes ahead;
		       Danger - IndianRed: deletes, removes, discards, rejects, withdraws, pushes back or
		                resets - the button that throws something away or turns it down.
		     Every other button stays plain. Before this, IndianRed also meant "the main action"
		     ("Save changes", the Contribute tab's three buttons), so red could not be read as a
		     warning. A button gets its colour from one of these CLASSES, never from brushes set on the
		     button itself, and ButtonColourTests holds every label to it. Declared after the plain
		     Button style above so they win over it. -->
		<Style Selector="Button.Accept">
			<Setter Property="Background" Value="{DynamicResource Button_Ok_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Ok_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Ok_Border}" />
		</Style>

		<Style Selector="Button.Danger">
			<Setter Property="Background" Value="{DynamicResource Button_Cancel_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Cancel_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Cancel_Border}" />
		</Style>

		<!-- A LABEL OF ITS OWN IN A GREEN OR RED BUTTON IS WRITTEN AS THE BUTTON'S TEXT IS (owner report, 2026-11-07: "Replace
		     all" read black on green - "make sure to have same text colors (everywhere) for buttons (matching its background
		     color)"). The TextBlock style above gives every TextBlock the page's color, which outranks what it would take
		     from its button, so a TextBlock in a button's content - alone, or in a panel there - is given the color a label
		     of plain text has: its class's, under the pointer and pressed too (the button keeps its color then, a shade
		     deeper - 2026-11-12), and the theme's greyed out, as the theme colors the button's presenter then. Only the
		     content: a tooltip's text is no child of these panels. -->
		<Style Selector="Button.Accept > TextBlock, Button.Accept > :is(Panel) > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Button_Ok_Fg}" />
		</Style>
		<Style Selector="Button.Danger > TextBlock, Button.Danger > :is(Panel) > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Button_Cancel_Fg}" />
		</Style>
		<Style Selector="Button.Accept:disabled > TextBlock, Button.Accept:disabled > :is(Panel) > TextBlock, Button.Danger:disabled > TextBlock, Button.Danger:disabled > :is(Panel) > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
		</Style>

		<!-- "LEARN MORE" (CRT 4.0 step 5 - the plan: "The remaining help buttons read 'Learn more'"):
		     a button that opens a page of CRT's Wiki, beside the setting or the tool it explains. It
		     looks like a link - the link colour, underlined, no box - so it reads as "a page about
		     this", not as an action on the setting. Its pages are AppConfig's WikiPage* names, which
		     WikiHelpPageNamesTests holds to real pages. The "?" icon stays only where it shows a
		     tooltip and opens nothing. -->
		<!--
		A TAB STRIP (owner request, 2026-10-01): the Maintainer tab's four screens, and a component's pages
		on the Contribute tab. Drawn as tabs under CRT's own: plain text on the strip's line, the chosen one
		with CRT's red underline (Main_TabUnderline_Selected) and the others greyed, a faint underline under
		the pointer (Main_TabUnderline_Hover) - the main tabs' own colours, so the rows read as one family.
		The label is not made bold when chosen: a bolder label is wider, and every tab after it would move.
		Every look under the pointer is set here, in the TAB's styles, so the theme's button hover (a grey
		fill) never shows.
		-->
		<Style Selector="Border.ScreenTabStrip">
			<Setter Property="BorderBrush" Value="{DynamicResource Queue_Divider}" />
			<Setter Property="BorderThickness" Value="0,0,0,1" />
		</Style>

		<!-- The underline sits ON the strip's line: 1px down, over it. -->
		<Style Selector="Button.ScreenTab">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0,0,0,3" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="Padding" Value="10,6,10,6" />
			<Setter Property="Margin" Value="0,0,0,-1" />
		</Style>

		<Style Selector="Button.ScreenTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="{DynamicResource Main_TabUnderline_Hover}" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
		</Style>

		<Style Selector="Button.ScreenTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
		</Style>

		<Style Selector="Button.ScreenTab.Selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="BorderBrush" Value="{DynamicResource Main_TabUnderline_Selected}" />
		</Style>

		<!-- A tab not chosen is greyed - its LABEL only, so a red badge on it keeps its colour. -->
		<Style Selector="Button.ScreenTab:not(.Selected) TextBlock.ScreenTabLabel">
			<Setter Property="Opacity" Value="0.65" />
		</Style>

		<Style Selector="Button.ScreenTab:not(.Selected):pointerover TextBlock.ScreenTabLabel">
			<Setter Property="Opacity" Value="1" />
		</Style>

		<!--
		A JOINED SWITCH (2026-10-01): a submission's views and a board's on the Maintainer tab, and "UI" or
		"Table" on the Contribute tab (owner request, 2026-11-04: "a button-group instead, as those circles
		looks just wrong"). Square inner corners, rounded outer ones, neighbours sharing one border line (each
		after the first pulled 1px left); the chosen one is filled and outlined in front of its neighbours,
		and stays so under the pointer.
		-->
		<Style Selector="Button.Segment">
			<Setter Property="Padding" Value="12,4" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
			<Setter Property="Margin" Value="-1,0,0,0" />
		</Style>

		<Style Selector="Button.Segment.First">
			<Setter Property="CornerRadius" Value="4,0,0,4" />
			<Setter Property="Margin" Value="0" />
		</Style>

		<Style Selector="Button.Segment.Last">
			<Setter Property="CornerRadius" Value="0,4,4,0" />
		</Style>

		<Style Selector="Button.Segment.Selected">
			<Setter Property="ZIndex" Value="1" />
		</Style>

		<Style Selector="Button.Segment.Selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Mode_Selected_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Mode_Selected_Border}" />
		</Style>

		<!-- A draft's errors and warnings on the Contribute tab (TabDrafts.Problems.cs): on an entry of its left
		     column, on a component in the list on the far left, and the word on a line of the panel over a
		     page. In the colours of the table's pills, so the views read alike. -->
		<Style Selector="Border.NavBadge">
			<Setter Property="CornerRadius" Value="9" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.NavBadge TextBlock">
			<Setter Property="FontSize" Value="10" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="Border.NavBadge.error">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Error_Mark}" />
		</Style>
		<Style Selector="Border.NavBadge.error TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource BoardTable_Error_Fg}" />
		</Style>
		<Style Selector="Border.NavBadge.warning">
			<Setter Property="Background" Value="{DynamicResource BoardTable_Warning_Mark}" />
		</Style>
		<Style Selector="Border.NavBadge.warning TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource BoardTable_Warning_Fg}" />
		</Style>

		<!-- The color dropper and its lens (Controls/ColorDropperButton.cs) - in a color picker's list
		     (ColorPickerDropper), and beside the "Draw trace" palette's colors. A subclass, so :is() - a
		     style names an exact type. -->
		<Style Selector=":is(Button).ColorDropper">
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector=":is(Button).ColorDropper.InColorList">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="Margin" Value="8" />
		</Style>

		<!-- Font Awesome's eye-dropper - by a class of its own: a style on the button's TextBlocks reached
		     its tooltip too, which is a child of the button, and read as symbols (owner report, 2026-11-03). -->
		<Style Selector="TextBlock.ColorDropperIcon">
			<Setter Property="FontFamily" Value="{DynamicResource FontAwesomeSolid}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Padding" Value="0,1,0,0" />
		</Style>

		<Style Selector="Border.ColorDropperLens">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="BoxShadow" Value="0 4 10 0 #40000000" />
		</Style>

		<Style Selector="Border.ColorDropperSwatch">
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="Button.LearnMore">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="2,0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource Link_Fg}" />
		</Style>

		<Style Selector="Button.LearnMore /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Button.LearnMore:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource LinkHover_Fg}" />
		</Style>

		<Style Selector="Button.LearnMore:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- ### -->

		<!-- Give the ColorPicker in "Schematics" tab its visual layout -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

		<!-- ###########################################################################################
		     A COLOR PICKER'S LIST IS BUILT WHEN IT FIRST OPENS (2026-11-13, measured): Avalonia 12.1.4's own ColorPicker
		     template (Avalonia.Controls.ColorPicker's Themes/Fluent/ColorPicker.xaml; 12.1.6 changed only the copy in its
		     flyout, which CRT does not use - compared 2026-11-13) - its theme's swatch, sizes and palette
		     kept, as only the template is set here - less the copy of the ColorView it holds inline in its flyout, which was
		     built with every picker, opened or not: on "Board: Schematic images", four per picture card, it was the largest
		     single cost of showing the page. The flyout is empty here, and ColorPickerDropper fills it as it opens - a ColorView
		     drawn as that copy was, and the dropper under it. When Avalonia is updated, compare this with its ColorPicker.xaml.
		     ########################################################################################### -->
		<Style Selector="ColorPicker">
			<Setter Property="Template">
				<ControlTemplate>
					<DropDownButton CornerRadius="{TemplateBinding CornerRadius}"
									MinHeight="{TemplateBinding MinHeight}"
									MinWidth="{TemplateBinding MinWidth}"
									Height="{TemplateBinding Height}"
									Width="{TemplateBinding Width}"
									Content="{TemplateBinding Content}"
									HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
									VerticalAlignment="{TemplateBinding VerticalAlignment}"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									ContentTemplate="{TemplateBinding ContentTemplate}"
									Padding="0,0,10,0"
									UseLayoutRounding="False">
						<DropDownButton.Styles>
							<Style Selector="FlyoutPresenter.nopadding">
								<Setter Property="Padding" Value="0" />
							</Style>
						</DropDownButton.Styles>
						<DropDownButton.Flyout>
							<Flyout FlyoutPresenterClasses="nopadding"
									Placement="{DynamicResource ColorPickerFlyoutPlacement}" />
						</DropDownButton.Flyout>
					</DropDownButton>
				</ControlTemplate>
			</Setter>
		</Style>

		<!-- Give the Contribute tab's table editor (ProDataGrid, an MIT fork of Avalonia's own
		     DataGrid, whose assembly keeps the original name) its visual layout. -->
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.v2.xaml" />

		<!-- ### -->

		<!-- The amber "Draft" chip - ONE definition for every place that marks something as a local,
		     unpublished draft: the component list's rows (Main.axaml) and the Hardware and Board
		     drop-downs (Main.DraftBadges.cs, which builds it in code). It used to be spelled out
		     inline on the component list; the drop-downs asking for "the same badge" is what made a
		     shared style worth having, since two hand-copied chips drift apart one setter at a time.

		     Kept LAST: Avalonia applies matching styles in declaration order rather than by
		     specificity, and the global "TextBlock" style above would otherwise repaint the chip's
		     text in the ordinary foreground colour. -->
		<Style Selector="Border.DraftChip">
			<Setter Property="Background" Value="{DynamicResource Draft_Chip_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Draft_Chip_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="5,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="Border.DraftChip > TextBlock">
			<Setter Property="FontSize" Value="9" />
			<Setter Property="Foreground" Value="{DynamicResource Draft_Chip_Fg}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- THE REGION BUTTONS - under Main's component list and on the component popup, ONE copy for both (code review,
		     2026-11-09: word for word in each window, to drift apart). The one picked is lit in its region's colors:
		     PAL's and NTSC's buttons by name, a board's own regions in one of four (2026-11-09; RegionChoice.ColorsOf,
		     RegionButtonGrid.UseOwnColors). The words' color is set on the presenter too: the plain button's hover style sets
		     it there, and the lit button's own was lost under the pointer (code review, 2026-11-13; ButtonStatesTests). -->
		<Style Selector="Button.RegionToggle.active">
			<Setter Property="BorderThickness" Value="2" />
		</Style>
		<Style Selector="Button#PalRegionButton.RegionToggle.active">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_PAL_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>
		<Style Selector="Button#PalRegionButton.RegionToggle.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_PAL_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>
		<Style Selector="Button#NtscRegionButton.RegionToggle.active">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_NTSC_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>
		<Style Selector="Button#NtscRegionButton.RegionToggle.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_NTSC_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.Own1">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own1_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own1_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.Own1 /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_Own1_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own1_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own1_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.Own2">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own2_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own2_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.Own2 /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_Own2_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own2_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own2_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.Own3">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own3_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own3_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.Own3 /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_Own3_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own3_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own3_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.Own4">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own4_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own4_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.Own4 /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_Own4_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own4_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own4_Bg}" />
		</Style>
		<!-- A region the board gives colors of its own (owner request, 2026-11-11; RegionColors, RegionPaint.UseBoardColors): read
		     from the button's own resources - after the styles above, so these win over them. -->
		<Style Selector="Button.RegionToggle.active.BoardColors">
			<Setter Property="Foreground" Value="{DynamicResource Region_Board_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Region_Board_Bg}" />
		</Style>
		<Style Selector="Button.RegionToggle.active.BoardColors /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Region_Board_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Region_Board_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Region_Board_Bg}" />
		</Style>

    </Application.Styles>
</Application>