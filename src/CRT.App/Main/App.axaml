				<SolidColorBrush x:Key="Draft_ReferenceBadge_Used_Fg">White</SolidColorBrush>

				<!-- Dark, the table editor: see Controls/BoardTable/BoardTableColors.axaml. -->

				<!-- Dark, Workbooks tab. Surfaces only - see the light block above for why the
				     category and state colours are not here. -->

				<!-- The selected card a step darker, and the faint text a step lighter (2026-11-12 - #33403F and #8F8578, 3.0:1
				     on it): the faint text reads at 4.5:1 on every card, still dimmer than the muted. -->
				<SolidColorBrush x:Key="Workbooks_SelectedCard_Bg">#2C3837</SolidColorBrush>
