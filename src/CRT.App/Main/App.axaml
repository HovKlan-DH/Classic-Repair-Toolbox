<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRT.App"
             RequestedThemeVariant="Default">

	<Application.Resources>
		<ResourceDictionary>

			<!-- The table editor's own colours, shared by the Contribute tab and the Maintainer tab (Controls/BoardTable). -->
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Classic-Repair-Toolbox/Controls/BoardTable/BoardTableColors.axaml" />
				<!-- The formatted note box's look - Fluent's TextBox with its format row (RichNoteTextBox, 2026-11-07). -->
				<ResourceInclude Source="avares://Classic-Repair-Toolbox/Controls/RichNote/RichNoteTheme.axaml" />
			</ResourceDictionary.MergedDictionaries>

			<FontFamily x:Key="FontAwesomeSolid">
				avares://Classic-Repair-Toolbox/Assets/Fonts/Font Awesome 7 Free-Solid-900.otf#Font Awesome 7 Free Solid
			</FontFamily>

			<FontFamily x:Key="FontAwesomeRegular">
				avares://Classic-Repair-Toolbox/Assets/Fonts/Font Awesome 7 Free-Regular-400.otf#Font Awesome 7 Free Regular
			</FontFamily>

			<ResourceDictionary.ThemeDictionaries>

				<!-- ########################################################################### -->
				<!-- LIGHT                                                                       -->
				<!-- ########################################################################### -->

				<ResourceDictionary x:Key="Light">

					<!-- Light, Generic colors -->
					<SolidColorBrush x:Key="Bg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Form_Bg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Form_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Form_Border">Gray</SolidColorBrush>
					<SolidColorBrush x:Key="Form_Selected_Bg">LightBlue</SolidColorBrush>
					<!-- Black, not the White it was until 2026-11-12: white on LightBlue is 1.5:1, unreadable wherever a
					     selected row's text follows its row (a button's own words do). -->
					<SolidColorBrush x:Key="Form_Selected_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Form_Selected_Hover_Bg">SkyBlue</SolidColorBrush>
					<SolidColorBrush x:Key="Splitter">Gray</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Bg">LightGray</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Border">DarkGray</SolidColorBrush>
					<!-- THE COLORS OF A BUTTON WITH TEXT ON IT ARE HELD TO WCAG's 4.5:1 (2026-11-12, the theme color review): the
					     green was #4F8A5B (4.1:1 with its white text) and the red IndianRed itself (4.0:1) - each the same hue,
					     a shade deeper. -->
					<SolidColorBrush x:Key="Button_Ok_Bg">#497F54</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Ok_Fg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Ok_Border">#3E6E48</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Cancel_Bg">#BC5454</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Cancel_Fg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Cancel_Border">#A34747</SolidColorBrush>
					<!-- A button under the pointer and pressed (2026-11-12): a shade deeper than its own color, never Fluent's
					     look - which turned a plain button LIGHTER under the pointer here, and a green or red one grey with
					     black text. See the "Button:pointerover" styles below. -->
					<SolidColorBrush x:Key="Button_Hover_Bg">#C4C4C4</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Pressed_Bg">#B3B3B3</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Hover_Border">#8A8A8A</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Ok_Hover_Bg">#3F7049</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Ok_Pressed_Bg">#355F3D</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Cancel_Hover_Bg">#A84848</SolidColorBrush>
					<SolidColorBrush x:Key="Button_Cancel_Pressed_Bg">#943E3E</SolidColorBrush>
					<SolidColorBrush x:Key="Panel_Border">Gray</SolidColorBrush>
					<SolidColorBrush x:Key="Link_Fg">Blue</SolidColorBrush>
					<SolidColorBrush x:Key="LinkHover_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Table_Header_Bg">LightGray</SolidColorBrush>
					<SolidColorBrush x:Key="Table_Header_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Table_Bg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Table_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Table_BorderRowLine">#EEEEEE</SolidColorBrush>
					<SolidColorBrush x:Key="Table_RowHover_Bg">#E1F0FA</SolidColorBrush>
					<!-- THE TEXT COLORS BELOW READ AT 4.5:1 OR MORE ON THIS THEME'S GROUNDS AND ON THE "User preference" THEME'S
					     TINTED ONE (#E0E4D9), which takes them from here (2026-11-12; ThemeContrastTests). The success green was
					     #547131 (4.3:1 there), the failure red IndianRed (4.0:1 on white, 3.1:1 there). -->
					<SolidColorBrush x:Key="Text_Success_Fg">#516C2F</SolidColorBrush>
					<SolidColorBrush x:Key="Text_Fail_Fg">#B53535</SolidColorBrush>
					<!-- A line that is neither good nor bad news, and one that only informs (2026-11-12): the Maintainer tab's
					     messages and review notes, the IC test's "NOT TESTED" - until then a fixed Gray and SteelBlue, the same
					     in both themes. -->
					<SolidColorBrush x:Key="Text_Muted_Fg">#5A5A5A</SolidColorBrush>
					<SolidColorBrush x:Key="Text_Info_Fg">#2F6497</SolidColorBrush>

					<!-- A surface ONE STEP off the window background, for cards that must read as
					     their own panel. Table_Bg is plain White here, so a card using it is
					     invisible against the window - which is exactly what was reported for the
					     "My submissions" list. -->
					<SolidColorBrush x:Key="Card_Bg">#F7F7F7</SolidColorBrush>

					<!-- "Waiting on somebody else" - neither good nor bad. Amber rather than grey
					     so a pending row still reads as a STATUS rather than as disabled text. -->
					<!-- #B07A1E until 2026-10-13: 3.4:1 on Card_Bg, too faint for the 10-11px state
					     text it colours (WCAG wants 4.5:1). The same colour scaled darker, so its
					     green-to-red ratio (0.69 - see Text_Warning_Fg below) is unchanged: 5.0:1.
					     #8D6218 until 2026-11-12: 4.2:1 on the "User preference" theme's ground - scaled darker again, the
					     ratio kept. -->
					<SolidColorBrush x:Key="Text_Waiting_Fg">#845C17</SolidColorBrush>

					<!-- "THIS ONE IS WAITING ON YOU" - a warning, not a failure (owner
					     request, 2026-09-23). "Changes requested" used to share Text_Fail_Fg with
					     "Not accepted", which made a submission that is still very much alive look
					     identical to one that had been turned down - reported as exactly that.

					     ORANGE, and deliberately not the amber above: a genuinely waiting row is
					     passive and this one is a call to act, so the two must not be confusable
					     either.

					     *** THE FIRST ATTEMPT AT THIS COLOUR WAS STILL TOO RED *** and was
					     reported again. It was #C2570A, and the reason it read as red beside
					     IndianRed is worth writing down, because hue does NOT explain it: the two
					     were 25 degrees apart and still looked the same.

					     What actually matched was the RED AND GREEN CHANNELS - IndianRed is
					     205,92,92 and that orange was 194,87,10. Practically identical in R and G,
					     differing only in blue. The eye reads "the same colour, less washed out",
					     not "a different hue". So the axis that matters here is the GREEN-TO-RED
					     RATIO, and both colours sat at 0.45.

					     This one is 200,120,0 - a ratio of 0.60, between IndianRed's 0.45 and the
					     waiting amber's 0.69, and clear of both.

					     *** DARKENED, NOT RE-HUED (code review, 2026-10-13). *** At 200,120,0 it was
					     3.1:1 on Card_Bg - "Changes requested", the one state a contributor must act
					     on, was the faintest text on the card. Every channel is scaled by 0.75, so
					     the 0.60 ratio above - the thing that keeps it apart from IndianRed and the
					     waiting amber - is exactly what it was: 150,90,0, 5.2:1.
					     #965A00 until 2026-11-12 (4.3:1 on the "User preference" theme's ground) - scaled once more. -->
					<SolidColorBrush x:Key="Text_Warning_Fg">#905600</SolidColorBrush>

					<!-- Light, Main -->
					<!-- The Contribute tab's title: a draft is temporary, so its tab stands out in the
					     same red the selected-tab underline uses (owner request, 2026-09-25). IndianRed until 2026-11-12, 4.0:1
					     for 12px text; the failure text's red since, the underline with it. -->
					<SolidColorBrush x:Key="Main_TabHeader_Drafts_Fg">#B53535</SolidColorBrush>
					<SolidColorBrush x:Key="Main_TabUnderline_Selected">#B53535</SolidColorBrush>
					<SolidColorBrush x:Key="Main_TabUnderline_Hover">#ecc3c3</SolidColorBrush>
					<SolidColorBrush x:Key="Main_Banner_Bg">#4C1515</SolidColorBrush>
					<SolidColorBrush x:Key="Main_Banner_Fg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Main_BannerButtonsHover_Bg">#4F3528</SolidColorBrush>
					<SolidColorBrush x:Key="Main_BannerButtonsHover_Fg">#DDE0DA</SolidColorBrush>

					<!-- Light, Schematics tab -->
					<SolidColorBrush x:Key="Schematics_Name_Bg">Khaki</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Name_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Name_Border">Black</SolidColorBrush>
					<!-- The Danger button's red (IndianRed until 2026-11-12 - see Button_Cancel_Bg). -->
					<SolidColorBrush x:Key="Schematics_Region_PAL_Bg">#BC5454</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Region_PAL_Fg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Region_PAL_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Region_NTSC_Bg">#CBD6E5</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Region_NTSC_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Region_NTSC_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_ComponentHover_Bg">Khaki</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_ComponentHover_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_ComponentHover_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Panels_Bg">#F2F2F2</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Panels_Fg">Black</SolidColorBrush>
					<!-- A state that is there only for the moment - the Contribute tab's several components picked (it was
					     "Back to Contribute"'s too until 2026-11-11, now a ReturnBar's ReturnBar_*) -->
					<SolidColorBrush x:Key="Schematics_TemporaryBar_Bg">Khaki</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_TemporaryBar_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_TemporaryBar_Border">#8C7E2E</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Panels_Border">Gray</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_ComponentLabel_Bg">#222113</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_ComponentLabel_Fg">#ECEEEF</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_ComponentLabel_Border">Gray</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_Panel_TracesVisible_Trace_Border">Gray</SolidColorBrush>
					<SolidColorBrush x:Key="Schematics_FirstPin">Orange</SolidColorBrush>
					<Color x:Key="Schematics_TracePalette_Color1">#F40000</Color>
					<Color x:Key="Schematics_TracePalette_Color2">#1564F4</Color>
					<Color x:Key="Schematics_TracePalette_Color3">#0BC419</Color>
					<Color x:Key="Schematics_TracePalette_Color4">#E6E600</Color>

					<!-- Light, Worklog. Each is the text of a pill on Form_Bg and a card AND the fill under a badge's "#N", so each
					     reads at 4.5:1 with white both ways (2026-11-12: the amber was #C8880E, 3.0:1; the red IndianRed; the green
					     #4C8C31, 4.1:1). The text on a fill is white or black by ThemeResources.TextOn, so the dark theme's lighter
					     colors take black. -->
					<SolidColorBrush x:Key="Worklog_Category_Note">#2F6FB5</SolidColorBrush>
					<SolidColorBrush x:Key="Worklog_Category_Cosmetic">#97670B</SolidColorBrush>
					<SolidColorBrush x:Key="Worklog_Category_Issue">#B53535</SolidColorBrush>
					<SolidColorBrush x:Key="Worklog_Status_Open">#B53535</SolidColorBrush>
					<SolidColorBrush x:Key="Worklog_Status_Closed">#447D2C</SolidColorBrush>

					<!-- Light, Drafts (NewContributeStrategy.md Phase 2) - a local, unpublished edit.
					     Deliberately its own amber, not Worklog_Category_Cosmetic (that key names a
					     worklog category, a different concept that happens to share a similar hue) and
					     not IndianRed (already means "selected" or "fail" everywhere else). -->
					<SolidColorBrush x:Key="Draft_Chip_Bg">#F2D98A</SolidColorBrush>
					<SolidColorBrush x:Key="Draft_Chip_Fg">#5A4300</SolidColorBrush>
					<SolidColorBrush x:Key="Draft_Chip_Border">#C8960E</SolidColorBrush>
					<Color x:Key="Draft_Highlight_Tint">#E0A800</Color>

					<!-- One component reference in BoardFilesWindow's KiCad match report. A plain
					     light grey, not the amber above: a reference there is a LIST ITEM, not a
					     draft edit, and amber would mark every one of several hundred as "changed". -->
					<SolidColorBrush x:Key="Draft_ReferenceBadge_Bg">#E6E6E6</SolidColorBrush>
					<SolidColorBrush x:Key="Draft_ReferenceBadge_Border">#C8C8C8</SolidColorBrush>
					<!-- A component the KiCad data has and the board has no label for yet - the to-do
					     list, highlighted in the IndianRed CRT's own Remove buttons use (owner request,
					     2026-10-10) - the Danger button's red since 2026-11-12 (white on IndianRed was 4.0:1). -->
					<SolidColorBrush x:Key="Draft_ReferenceBadge_Todo_Bg">#BC5454</SolidColorBrush>
					<SolidColorBrush x:Key="Draft_ReferenceBadge_Todo_Border">#A34747</SolidColorBrush>
					<SolidColorBrush x:Key="Draft_ReferenceBadge_Todo_Fg">White</SolidColorBrush>
					<!-- A KiCad net name an important signal already uses - FILLED green with white text, as
					     the to-do badges are filled red (owner report, 2026-10-29: green text on the grey
					     badge was "almost impossible to see"). -->
					<SolidColorBrush x:Key="Draft_ReferenceBadge_Used_Bg">#3F7A4B</SolidColorBrush>
					<SolidColorBrush x:Key="Draft_ReferenceBadge_Used_Border">#356A40</SolidColorBrush>
					<SolidColorBrush x:Key="Draft_ReferenceBadge_Used_Fg">White</SolidColorBrush>

					<!-- Light, the table editor's colours (BoardTable_*) now live in
					     Controls/BoardTable/BoardTableColors.axaml, merged above, so the Maintainer tab's
					     table uses the very same ones. -->

					<!-- Light, Workbooks tab: the surfaces the tab actually paints.

					     There used to be sixteen more keys here - a Workbooks_Category_* /
					     Workbooks_State_* set plus badge, chip, placeholder, scope-capture and pin
					     colours - carried over from the mockup and referenced by nothing but the
					     palette test asserting they resolved. They encoded the mockup's
					     Note/Cosmetic/Suspected/Confirmed and Pending/Fixed/Ruled-out vocabulary,
					     which is NOT the shipped WorklogManager model (Note/Cosmetic/Issue,
					     Open/Closed); the real tab resolves its category and state colours through
					     the Worklog_Category_* and Worklog_Status_* keys above, shared with the
					     Schematics tab and the entry editor so an entry looks the same everywhere.
					     Adding a category here would have produced a wrong-coloured chip that the
					     palette test could not catch. Add new worklog colours to Worklog_*. -->
					<SolidColorBrush x:Key="Workbooks_SelectedCard_Bg">#EAF3F8</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_Panel_Bg">#FAFAFA</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_Separator">#C8C8C8</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_RowSeparator">#E6E6E6</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_Muted_Fg">#5A5A5A</SolidColorBrush>
					<!-- #7A7A7A until 2026-11-12: 3.8:1 on the selected card, 3.3:1 on the "User preference" theme's ground. -->
					<SolidColorBrush x:Key="Workbooks_Faint_Fg">#636363</SolidColorBrush>

					<!-- A device's condition in stars (ConditionStars; owner request, 2026-11-06: "more 'depth' and
					     coloring"): a lit star gold, light at its top and deeper at its foot, its edge a darker
					     amber; an unlit one a quiet grey outline on the faintest fill. -->
					<SolidColorBrush x:Key="Workbooks_Star_Lit_Top">#FFE27A</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_Star_Lit_Bottom">#F4A30C</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_Star_Lit_Edge">#B06E00</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_Star_Dim_Fill">#F2F2F2</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_Star_Dim_Edge">#B4B4B4</SolidColorBrush>

					<!-- The summary strip's ZERO-count category/state pills (WorklogInfoPillBuilder's
					     MutedPillBrush) - deliberately its OWN, lighter token rather than reusing
					     Muted_Fg or Faint_Fg above: both of those are body-text greys, tuned to stay
					     readable as PROSE (a card's meta line, an empty-state message), and both were
					     tried here and reported as "still looks black" on a small bold pill. A zero
					     count needs to look closer to disabled/washed-out than to muted body text. -->
					<SolidColorBrush x:Key="Workbooks_ZeroCount_Fg">#BBBBBB</SolidColorBrush>

					<!-- The run of text matched by the "Find a previous repair" search box. A
					     background wash rather than a foreground colour, so it reads as a marker pen
					     over the text and stays legible on the muted/faint greys above as well as on
					     ordinary body text - a recoloured foreground would fight those. -->
					<SolidColorBrush x:Key="Workbooks_SearchHit_Bg">#FFE58A</SolidColorBrush>
					<SolidColorBrush x:Key="Workbooks_SearchHit_Fg">#1A1A1A</SolidColorBrush>

					<!-- Light, the Maintainer tab's graph of views per day (BoardViewsChart, 2026-10-09). One
					     blue, checked against this white for its lightness band and 3:1 contrast; the darker
					     step marks the day pointed at. Grid and baseline one step off the ground, the dates
					     and numbers in muted ink - never in the bar's colour. -->
					<SolidColorBrush x:Key="Chart_Bar">#2A78D6</SolidColorBrush>
					<SolidColorBrush x:Key="Chart_BarHover">#17549F</SolidColorBrush>
					<SolidColorBrush x:Key="Chart_Grid">#E1E0D9</SolidColorBrush>
					<SolidColorBrush x:Key="Chart_Baseline">#C3C2B7</SolidColorBrush>
					<!-- #6F6D67 until 2026-11-12 (4.0:1 on the "User preference" theme's ground). -->
					<SolidColorBrush x:Key="Chart_Label">#65635E</SolidColorBrush>

					<!-- Light, the Boards screen (2026-10-09): the panel saying why a board's BETA table cannot
					     be changed - amber, the colour of waiting. -->
					<SolidColorBrush x:Key="Notice_Bg">#FFF4DC</SolidColorBrush>
					<SolidColorBrush x:Key="Notice_Border">#E8B866</SolidColorBrush>
					<SolidColorBrush x:Key="Notice_Fg">#5C3A00</SolidColorBrush>

					<!-- Light, the changelog on the "About" tab (MarkdownRenderer, 2026-11-06): GitHub's own
					     light colors - its inline code ground, the bar of a thematic break, the line under
					     a heading, a quote's bar and muted text, and the five alerts' colors - each alert's a shade deeper
					     since 2026-11-12, so it reads at 4.5:1 on the "User preference" theme's tinted ground too. -->
					<SolidColorBrush x:Key="Changelog_Code_Bg">#EFF1F3</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_Rule">#D1D9E0</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_HeadingLine">#DDE3E9</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_Quote_Bar">#D1D9E0</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_Quote_Fg">#59636E</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_Alert_Note">#0860C8</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_Alert_Tip">#177332</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_Alert_Important">#7548C9</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_Alert_Warning">#875B00</SolidColorBrush>
					<SolidColorBrush x:Key="Changelog_Alert_Caution">#C1212B</SolidColorBrush>

					<!-- Light, Thumbnail -->
					<SolidColorBrush x:Key="Thumbnail_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Thumbnail_BorderSelected">IndianRed</SolidColorBrush>
					<SolidColorBrush x:Key="Thumbnail_Bg">Khaki</SolidColorBrush>
					<SolidColorBrush x:Key="Thumbnail_Fg">Black</SolidColorBrush>
					<!-- SteelBlue (#4682B4) until 2026-11-12, 4.1:1 with its white text. -->
					<SolidColorBrush x:Key="Thumbnail_Selection_Bg">#4076A4</SolidColorBrush>
					<SolidColorBrush x:Key="Thumbnail_Selection_Fg">White</SolidColorBrush>

					<!-- Light, Component info popup -->
					<SolidColorBrush x:Key="ComponentPopup_Name_Bg">Khaki</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_Name_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_Name_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_Pin_Bg">Khaki</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_Pin_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_Pin_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_OscilloscopeExpected_Bg">#B0D8EC</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_OscilloscopeExpected_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_OscilloscopeExpected_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_OscilloscopeSyncData_Bg">LightGray</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_OscilloscopeSyncData_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_OscilloscopeSyncData_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_ImageXofY_Bg">#BB000000</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_ImageXofY_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_ImageXofY_Fg">White</SolidColorBrush>
					<!-- #778461 until 2026-11-12, 4.0:1 with its white text. -->
					<SolidColorBrush x:Key="ComponentPopup_KeyboardTyping_Bg">#6B7657</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_KeyboardTyping_Fg">White</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_KeyboardTyping_Border">Black</SolidColorBrush>
					<SolidColorBrush x:Key="ComponentPopup_ImageTransparent_Bg">White</SolidColorBrush>

					<!-- Light, Feedback tab -->
					<SolidColorBrush x:Key="Feedback_TrashIcon_Fg">#B53535</SolidColorBrush>

					<!-- Light, Maintainer tab (2026-09-29; the values CRT Maintainer's own theme carried): the
					     queue's "New board" badge and the line between its boards, and the four screen
					     buttons with their badges -->
					<SolidColorBrush x:Key="Badge_NewBoard_Bg">#FFF1D6</SolidColorBrush>
					<SolidColorBrush x:Key="Badge_NewBoard_Fg">#8A5200</SolidColorBrush>
					<SolidColorBrush x:Key="Badge_NewBoard_Border">#E8B866</SolidColorBrush>
					<SolidColorBrush x:Key="Queue_Divider">#D0D0D0</SolidColorBrush>
					<SolidColorBrush x:Key="Mode_Selected_Bg">#DCE7F3</SolidColorBrush>
					<SolidColorBrush x:Key="Mode_Selected_Border">#4F7FBF</SolidColorBrush>
					<SolidColorBrush x:Key="Badge_Attention_Bg">#C0392B</SolidColorBrush>
					<SolidColorBrush x:Key="Badge_Attention_Fg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Badge_Count_Bg">#E2E2E2</SolidColorBrush>
					<SolidColorBrush x:Key="Badge_Count_Fg">#505050</SolidColorBrush>

					<!-- Light, the introduction tours (Main/TourOverlay, 2026-11-11): the window dimmed, the card -->
					<SolidColorBrush x:Key="Tour_Dim">#96000000</SolidColorBrush>
					<SolidColorBrush x:Key="Tour_Card_Bg">White</SolidColorBrush>
					<SolidColorBrush x:Key="Tour_Card_Fg">Black</SolidColorBrush>
					<SolidColorBrush x:Key="Tour_Card_Border">#3C000000</SolidColorBrush>

				</ResourceDictionary>

			<!-- ########################################################################### -->
			<!-- DARK                                                                        -->
			<!-- ########################################################################### -->

			<ResourceDictionary x:Key="Dark">

				<!-- Dark, Generic colors -->
				<SolidColorBrush x:Key="Bg">#201C1A</SolidColorBrush>
				<SolidColorBrush x:Key="Fg">#E8E0DA</SolidColorBrush>
				<SolidColorBrush x:Key="Border">LightGray</SolidColorBrush>
				<SolidColorBrush x:Key="Form_Bg">#2A2421</SolidColorBrush>
				<SolidColorBrush x:Key="Form_Fg">#E8DDCF</SolidColorBrush>
				<!-- The edge of a text box, drop-down list or list: 3:1 on Form_Bg, as WCAG asks of an input's edge
				     (2026-11-12 - #524842 until then, 1.7:1, while a text box took Fluent's far brighter #A3938A). -->
				<SolidColorBrush x:Key="Form_Border">#776F6A</SolidColorBrush>
				<SolidColorBrush x:Key="Form_Selected_Bg">#735443</SolidColorBrush>
				<SolidColorBrush x:Key="Form_Selected_Fg">White</SolidColorBrush>
				<SolidColorBrush x:Key="Form_Selected_Hover_Bg">#5E4334</SolidColorBrush>
				<SolidColorBrush x:Key="Splitter">Gray</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Bg">#3E342F</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Fg">#E8E0D4</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Border">#524842</SolidColorBrush>
				<!-- The light theme's green and red (2026-11-12 - see there). -->
				<SolidColorBrush x:Key="Button_Ok_Bg">#497F54</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Ok_Fg">White</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Ok_Border">#3E6E48</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Cancel_Bg">#BC5454</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Cancel_Fg">White</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Cancel_Border">#A34747</SolidColorBrush>
				<!-- Under the pointer and pressed (see the light twin): a plain button a step LIGHTER, as this theme's surfaces
				     step lighter - Fluent's made it darker than at rest; a green or red one a shade deeper, its white text
				     kept at 4.5:1. -->
				<SolidColorBrush x:Key="Button_Hover_Bg">#4C413B</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Pressed_Bg">#5A4D46</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Hover_Border">#776F6A</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Ok_Hover_Bg">#3F7049</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Ok_Pressed_Bg">#355F3D</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Cancel_Hover_Bg">#A84848</SolidColorBrush>
				<SolidColorBrush x:Key="Button_Cancel_Pressed_Bg">#943E3E</SolidColorBrush>
				<SolidColorBrush x:Key="Panel_Border">#524842</SolidColorBrush>
				<!-- A link in a soft blue, the complement of this theme's browns (2026-11-12): White until then, which a link
				     could not be told from the text beside it by. -->
				<SolidColorBrush x:Key="Link_Fg">#8AB4F8</SolidColorBrush>
				<SolidColorBrush x:Key="LinkHover_Fg">#E8DDCF</SolidColorBrush>
				<SolidColorBrush x:Key="Table_Header_Bg">#3E342F</SolidColorBrush>
				<SolidColorBrush x:Key="Table_Header_Fg">#E8DDCF</SolidColorBrush>
				<SolidColorBrush x:Key="Table_Bg">#2A2421</SolidColorBrush>
				<SolidColorBrush x:Key="Table_Fg">#E8DDCF</SolidColorBrush>
				<SolidColorBrush x:Key="Table_BorderRowLine">#3E342F</SolidColorBrush>
				<SolidColorBrush x:Key="Table_RowHover_Bg">#3C2F28</SolidColorBrush>
				<SolidColorBrush x:Key="Text_Success_Fg">#4ADE80</SolidColorBrush>
				<!-- #EF4444 until 2026-11-12: 3.7:1 on Card_Bg. -->
				<SolidColorBrush x:Key="Text_Fail_Fg">#F26C6C</SolidColorBrush>
				<SolidColorBrush x:Key="Text_Muted_Fg">#B5A896</SolidColorBrush>
				<SolidColorBrush x:Key="Text_Info_Fg">#8FB4DA</SolidColorBrush>

				<!-- The dark theme's twin of Card_Bg: one step LIGHTER than this theme's
				     background, where the light theme steps darker. Same intent, opposite
				     direction - a hardcoded grey would work in one theme and glare in the other. -->
				<SolidColorBrush x:Key="Card_Bg">#332B27</SolidColorBrush>

				<SolidColorBrush x:Key="Text_Waiting_Fg">#E0B050</SolidColorBrush>

				<!-- The dark theme's twin of Text_Warning_Fg, moved with it for the same reason
				     and measured the same way: a green-to-red ratio of 0.67, between this theme's
				     failure red (0.28) and its waiting amber (0.79). A matching pair has to move
				     together or the two themes stop agreeing about what "warning" looks like. -->
				<SolidColorBrush x:Key="Text_Warning_Fg">#FFAA40</SolidColorBrush>

				<!-- Dark, Main, banners. The Contribute tab's title and the underline in this theme's failure red (IndianRed
				     until 2026-11-12, 4.2:1 for 12px text); under the pointer a faint red, as the light theme's is - it was
				     #ECC3C3 here, brighter than the underline of the tab chosen. -->
				<SolidColorBrush x:Key="Main_TabHeader_Drafts_Fg">#F26C6C</SolidColorBrush>
				<SolidColorBrush x:Key="Main_TabUnderline_Selected">#F26C6C</SolidColorBrush>
				<SolidColorBrush x:Key="Main_TabUnderline_Hover">#5D3231</SolidColorBrush>
				<SolidColorBrush x:Key="Main_Banner_Bg">#38241A</SolidColorBrush>
				<SolidColorBrush x:Key="Main_Banner_Fg">#E8E0DA</SolidColorBrush>
				<SolidColorBrush x:Key="Main_BannerButtonsHover_Bg">#4F3528</SolidColorBrush>
				<SolidColorBrush x:Key="Main_BannerButtonsHover_Fg">#DDE0DA</SolidColorBrush>

				<!-- Dark, Schematics tab -->
				<SolidColorBrush x:Key="Schematics_Name_Bg">Khaki</SolidColorBrush>
				<SolidColorBrush x:Key="Schematics_Name_Fg">Black</SolidColorBrush>
				<SolidColorBrush x:Key="Schematics_Name_Border">Black</SolidColorBrush>
				<SolidColorBrush x:Key="Schematics_Region_PAL_Bg">#BC5454</SolidColorBrush>
				<SolidColorBrush x:Key="Schematics_Region_PAL_Fg">White</SolidColorBrush>
				<SolidColorBrush x:Key="Schematics_Region_PAL_Border">Black</SolidColorBrush>
				<SolidColorBrush x:Key="Schematics_Region_NTSC_Bg">#CBD6E5</SolidColorBrush>
				<SolidColorBrush x:Key="Schematics_Region_NTSC_Fg">Black</SolidColorBrush>
