				<!-- The dark twin of the light theme's reference badge: one step LIGHTER than the
				     Form_Bg the report sits on, where the light one steps darker. -->
				<SolidColorBrush x:Key="Draft_ReferenceBadge_Bg">#3E342F</SolidColorBrush>
