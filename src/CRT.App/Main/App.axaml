				<Color x:Key="Schematics_TracePalette_Color4">#E6E600</Color>

				<!-- Dark, Worklog: the light theme's hues, light enough to read at 4.5:1 as a pill's text on Card_Bg
				     (2026-11-12 - they were the light theme's own: the blue 2.7:1 there). A badge on one writes black. -->
				<SolidColorBrush x:Key="Worklog_Category_Note">#6F9CCC</SolidColorBrush>
