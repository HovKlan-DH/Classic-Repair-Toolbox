<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRT"
        x:Class="CRT.CollectionWindow"
        x:DataType="local:CollectionWindow"
        Title="Oscilloscope collection"
        Width="980"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<!-- AN OSCILLOSCOPE COLLECTION ON THIS COMPUTER (2026-11-26; CollectionWindow.axaml.cs says what each part does). -->
	<Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto,Auto" Margin="16">

		<!-- What it is about, and how long it is kept once shared. -->
		<Grid Grid.Row="0" ColumnDefinitions="*,16,300" Margin="0,0,0,12">
			<StackPanel Grid.Column="0" Spacing="4">
				<TextBlock Text="Title" FontWeight="SemiBold" />
				<TextBox x:Name="TitleBox" LostFocus="OnEditLeft" />

				<TextBlock Text="What is wrong, and what was tried so far" FontWeight="SemiBold" Margin="0,8,0,0" />
				<TextBox x:Name="DescriptionBox"
						 AcceptsReturn="True"
						 TextWrapping="Wrap"
						 Height="90"
						 LostFocus="OnEditLeft" />

				<TextBlock Text="Forum threads it is posted in - one link a line" FontWeight="SemiBold" Margin="0,8,0,0" />
				<TextBox x:Name="ForumLinksBox"
						 AcceptsReturn="True"
						 Height="54"
						 LostFocus="OnEditLeft" />
			</StackPanel>

			<StackPanel Grid.Column="2" Spacing="4">
				<TextBlock x:Name="BoardText" FontWeight="SemiBold" TextWrapping="Wrap" />

				<TextBlock Text="Delete in" FontWeight="SemiBold" Margin="0,8,0,0" />
				<ComboBox x:Name="LifetimeComboBox"
						  HorizontalAlignment="Stretch"
						  SelectionChanged="OnLifetimePicked" />
				<TextBlock x:Name="DeleteDateText" TextWrapping="Wrap" FontSize="12" />

				<TextBlock x:Name="SharedStateText" TextWrapping="Wrap" Margin="0,10,0,0" />
			</StackPanel>
		</Grid>

		<!-- Its captures, in the page's order. -->
		<Border Grid.Row="1"
				BorderBrush="{DynamicResource Form_Border}"
				BorderThickness="1"
				CornerRadius="3">
			<Grid RowDefinitions="Auto,*">
				<TextBlock x:Name="CapturesHeading" Margin="10,8" FontWeight="SemiBold" />

				<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl x:Name="CapturesList">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:CollectionCaptureRow">
								<Border BorderBrush="{DynamicResource Form_Border}" BorderThickness="0,1,0,0" Padding="10,8">
									<Grid ColumnDefinitions="200,12,*,6,Auto">
										<Image Source="{Binding Thumbnail}"
											   Width="200"
											   Stretch="Uniform"
											   VerticalAlignment="Top" />

										<StackPanel Grid.Column="2" Spacing="4">
											<TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
											<TextBlock Text="{Binding Settings}" FontSize="12" TextWrapping="Wrap" />
											<TextBlock Text="{Binding BaselineSettings}"
													   FontSize="12"
													   TextWrapping="Wrap"
													   IsVisible="{Binding HasBaseline}" />
											<CheckBox Content="Looks wrong"
													  IsChecked="{Binding LooksWrong}"
													  IsCheckedChanged="OnCaptureMarkChanged" />
											<TextBox Text="{Binding Caption}"
													 PlaceholderText="A note on this capture"
													 AcceptsReturn="True"
													 TextWrapping="Wrap"
													 LostFocus="OnEditLeft" />

											<!-- Its comments on the page (step 3), once the collection is shared and they are read. -->
											<Border IsVisible="{Binding ShowsComments}"
													BorderBrush="{DynamicResource Form_Border}"
													BorderThickness="0,1,0,0"
													Padding="0,6,0,0"
													Margin="0,4,0,0">
												<StackPanel Spacing="6">
													<TextBlock Text="{Binding CommentsHeading}" FontWeight="SemiBold" />
													<ItemsControl ItemsSource="{Binding Comments}">
														<ItemsControl.ItemTemplate>
															<DataTemplate x:DataType="local:CollectionCommentRow">
																<StackPanel Spacing="2" Margin="0,0,0,8">
																	<TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
																	<TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
																	<StackPanel Orientation="Horizontal" Spacing="6">
																		<Button Content="Hide"
																				FontSize="11"
																				Padding="6,2"
																				IsVisible="{Binding CanHide}"
																				Tag="{Binding Id}"
																				Click="OnHideCommentClick" />
																		<Button Content="Show again"
																				FontSize="11"
																				Padding="6,2"
																				IsVisible="{Binding CanShow}"
																				Tag="{Binding Id}"
																				Click="OnShowCommentClick" />
																		<Button Classes="Danger"
																				Content="Delete"
																				FontSize="11"
																				Padding="6,2"
																				IsVisible="{Binding CanDelete}"
																				Tag="{Binding Id}"
																				Click="OnDeleteCommentClick" />
																	</StackPanel>
																</StackPanel>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
													<Grid ColumnDefinitions="*,6,Auto">
														<TextBox Text="{Binding Answer}"
																 PlaceholderText="Answer on this capture"
																 AcceptsReturn="True"
																 TextWrapping="Wrap" />
														<Button Grid.Column="2"
																Classes="Accept"
																Content="Answer"
																VerticalAlignment="Top"
																Tag="{Binding Sha256}"
																Click="OnAnswerClick" />
													</Grid>
												</StackPanel>
											</Border>
										</StackPanel>

										<Button Grid.Column="4"
												Classes="Danger"
												Content="Take out"
												VerticalAlignment="Top"
												Tag="{Binding Sha256}"
												Click="OnTakeOutClick" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>

		<!-- What came of the last action, in words. -->
		<TextBlock x:Name="StatusText"
				   Grid.Row="2"
				   TextWrapping="Wrap"
				   Margin="0,10,0,0" />

		<!-- The buttons - or, while a delete is being asked, the question. -->
		<Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
			<Button x:Name="DeleteButton"
					Grid.Column="0"
					Classes="Danger"
					Content="Delete collection"
					Click="OnDeleteClick" />

			<StackPanel x:Name="ButtonsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6">
				<Button x:Name="ShareButton" Classes="Accept" Content="Share" Click="OnShareClick" />
				<Button x:Name="OpenPageButton" Content="Open web page" Click="OnOpenPageClick" />
				<Button x:Name="CopyForForumButton" Content="Copy for forum" Click="OnCopyForForumClick" />
				<Button x:Name="CopyForRedditButton" Content="Copy for Reddit" Click="OnCopyForRedditClick" />
				<Button Content="Close" Click="OnCloseClick" />
			</StackPanel>

			<Border x:Name="DeleteQuestion"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					Classes="Notice"
					IsVisible="False">
				<Grid ColumnDefinitions="*,6,Auto,6,Auto">
					<TextBlock x:Name="DeleteQuestionText" Classes="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" />
					<Button Grid.Column="2" Content="Keep it" Click="OnKeepClick" />
					<Button x:Name="ConfirmDeleteButton" Grid.Column="4" Classes="Danger" Content="Delete collection" Click="OnConfirmDeleteClick" />
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
