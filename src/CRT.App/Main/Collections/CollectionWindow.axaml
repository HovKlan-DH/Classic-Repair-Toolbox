<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRT"
        x:Class="CRT.CollectionWindow"
        x:DataType="local:CollectionWindow"
        Title="Oscilloscope collection"
        Width="980"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<!-- AN OSCILLOSCOPE COLLECTION ON THIS COMPUTER (2026-11-26; CollectionWindow.axaml.cs says what each part does). -->
	<Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto,Auto" Margin="16">

		<!-- What it is about, and how long it is kept once shared. -->
		<Grid Grid.Row="0" ColumnDefinitions="*,16,300" Margin="0,0,0,12">
			<StackPanel Grid.Column="0" Spacing="4">
				<TextBlock Text="Title" FontWeight="SemiBold" />
				<TextBox x:Name="TitleBox" LostFocus="OnEditLeft" />

				<!-- Grows with what is typed, up to a height that leaves the captures their room - then it scrolls (owner request,
				     2026-11-27: "a textarea that auto-expands"). -->
				<TextBlock Text="What is wrong, and what was tried so far" FontWeight="SemiBold" Margin="0,8,0,0" />
				<TextBox x:Name="DescriptionBox"
						 AcceptsReturn="True"
						 TextWrapping="Wrap"
						 MinHeight="90"
						 MaxHeight="220"
						 VerticalContentAlignment="Top"
						 LostFocus="OnEditLeft" />

				<TextBlock Text="Forum threads it is posted in - one link a line" FontWeight="SemiBold" Margin="0,8,0,0" />
				<TextBox x:Name="ForumLinksBox"
						 AcceptsReturn="True"
						 Height="54"
						 LostFocus="OnEditLeft" />
			</StackPanel>

			<StackPanel Grid.Column="2" Spacing="4">
				<TextBlock x:Name="BoardText" FontWeight="SemiBold" TextWrapping="Wrap" />

				<TextBlock Text="Delete in" FontWeight="SemiBold" Margin="0,8,0,0" />
				<ComboBox x:Name="LifetimeComboBox"
						  HorizontalAlignment="Stretch"
						  SelectionChanged="OnLifetimePicked" />
				<!-- Its date bold (BoldRuns.ShowMarked - CollectionWindow.DeleteDateLine). -->
				<TextBlock x:Name="DeleteDateText" TextWrapping="Wrap" FontSize="12" />

				<TextBlock x:Name="SharedStateText" TextWrapping="Wrap" Margin="0,10,0,0" />

				<!-- Its page offline, kept under its link until "Share" brings it back (owner decision, 2026-11-27: "Offline, same
				     link back"). Only while the page is up. -->
				<Button x:Name="StopSharingButton"
						Classes="Danger"
						Content="Stop sharing"
						HorizontalAlignment="Left"
						Margin="0,6,0,0"
						Click="OnStopSharingClick" />
			</StackPanel>
		</Grid>

		<!-- Its captures, in the page's order. -->
		<Border Grid.Row="1"
				BorderBrush="{DynamicResource Form_Border}"
				BorderThickness="1"
				CornerRadius="3">
			<Grid RowDefinitions="Auto,*">
				<TextBlock x:Name="CapturesHeading" Margin="10,8" FontWeight="SemiBold" />

				<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl x:Name="CapturesList">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:CollectionCaptureRow">
								<Border BorderBrush="{DynamicResource Form_Border}" BorderThickness="0,1,0,0" Padding="10,8">
									<Grid ColumnDefinitions="200,12,*,6,Auto">
										<!-- Clicked, the capture large in the worklogs' zooming viewer, as every small picture in CRT
										     opens (owner request, 2026-11-27). -->
										<Image Source="{Binding Thumbnail}"
											   Width="200"
											   Stretch="Uniform"
											   VerticalAlignment="Top"
											   Cursor="Hand"
											   ToolTip.Tip="Click to see it larger"
											   Tapped="OnThumbnailTapped" />

										<StackPanel Grid.Column="2" Spacing="4">
											<TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
											<TextBlock Text="{Binding Settings}" FontSize="12" TextWrapping="Wrap" />
											<!-- Several lines from the start, and growing with what is typed (owner request, 2026-11-27: "a textarea that
											     auto-expands") - no height of its own, so the list scrolls instead. -->
											<TextBox Text="{Binding Caption}"
													 PlaceholderText="A note on this capture"
													 AcceptsReturn="True"
													 TextWrapping="Wrap"
													 MinHeight="64"
													 VerticalContentAlignment="Top"
													 LostFocus="OnEditLeft" />
										</StackPanel>

										<Button Grid.Column="4"
												Classes="Danger"
												Content="Delete image"
												VerticalAlignment="Top"
												Tag="{Binding Sha256}"
												Click="OnTakeOutClick" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>

		<!-- What came of the last action, in words. -->
		<TextBlock x:Name="StatusText"
				   Grid.Row="2"
				   TextWrapping="Wrap"
				   Margin="0,10,0,0" />

		<!-- The buttons - or, while a delete is being asked, the question. The right-hand ones wrap onto a second line in a
		     narrow window, so every one stays in reach. -->
		<Grid Grid.Row="3" ColumnDefinitions="Auto,6,*" Margin="0,10,0,0">
			<StackPanel x:Name="LeftButtonsPanel" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
				<Button x:Name="DeleteButton"
						Classes="Danger"
						Content="Delete collection"
						Click="OnDeleteClick" />
				<Button x:Name="AttachToWorklogButton"
						Classes="Accept"
						Content="Attach collection to worklog"
						Click="OnAttachToWorklogClick" />
			</StackPanel>

			<WrapPanel x:Name="ButtonsPanel" Grid.Column="2" HorizontalAlignment="Right" ItemSpacing="6" LineSpacing="6">
				<Button x:Name="ShareButton" Classes="Accept" Content="Share" Click="OnShareClick" />
				<Button x:Name="OpenPageButton" Content="Open shared page" Click="OnOpenPageClick" />
				<!-- "Copy link" (owner decision, 2026-11-28): a click copies in the format picked last, its arrow lists the
				     three - BBCode, Markdown and a plain link, each saying where it works (CollectionLinkFormats). -->
				<SplitButton x:Name="CopyLinkButton" Content="Copy link" Click="OnCopyLinkClick">
					<SplitButton.Flyout>
						<MenuFlyout Placement="TopEdgeAlignedRight" />
					</SplitButton.Flyout>
				</SplitButton>
				<Button Content="Close" Click="OnCloseClick" />
			</WrapPanel>

			<Border x:Name="DeleteQuestion"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					Classes="Notice"
					IsVisible="False">
				<Grid ColumnDefinitions="*,6,Auto,6,Auto">
					<TextBlock x:Name="DeleteQuestionText" Classes="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" />
					<Button Grid.Column="2" Content="Keep it" Click="OnKeepClick" />
					<Button x:Name="ConfirmDeleteButton" Grid.Column="4" Classes="Danger" Content="Delete collection" Click="OnConfirmDeleteClick" />
				</Grid>
			</Border>
		</Grid>

		<!-- Sharing (each step said on it), deleting an image from the page and taking the page down are waits the owner
		     watches (BusyOverlay). The -16 margin covers the root grid's own. -->
		<local:BusyOverlay Grid.RowSpan="4" Margin="-16" />
	</Grid>
</Window>
