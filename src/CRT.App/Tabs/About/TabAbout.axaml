<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             xmlns:theme="clr-namespace:Handlers.Theming;assembly=Classic-Repair-Toolbox"
             x:Class="CRT.TabAbout">

	<UserControl.Styles>
		<!-- Minimal hyperlink button style -->
		<Style Selector="Button.LinkButton">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource Link_Fg}" />
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="Button.LinkButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.LinkButton:pointerover TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource LinkHover_Fg}" />
		</Style>

		<Style Selector="Button.LinkButton:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Border.ResourceRow">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Border.ResourceRow:pointerover">
			<Setter Property="Background" Value="{DynamicResource Table_RowHover_Bg}" />
		</Style>
	</UserControl.Styles>

	<!--
	The whole tab is ONE virtualized list: its first item is the page as it always was (name, version,
	links, the board's credits), and every block of the changelog under it is an item of its own,
	built only as it scrolls into view (TabAbout.Changelog.cs). Measured with real text: the
	changelog drawn at once was some 1,100 controls, 0.4-0.7 s to show the first time and 0.15-0.2 s
	to lay out again at every change of the window's width.
	-->
	<ItemsControl x:Name="AboutItems">
		<ItemsControl.Template>
			<ControlTemplate>
				<ScrollViewer VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<ItemsPresenter Name="PART_ItemsPresenter"
									ItemsPanel="{TemplateBinding ItemsPanel}"
									Margin="16" />
				</ScrollViewer>
			</ControlTemplate>
		</ItemsControl.Template>
		<ItemsControl.ItemsPanel>
			<ItemsPanelTemplate>
				<VirtualizingStackPanel />
			</ItemsPanelTemplate>
		</ItemsControl.ItemsPanel>

		<StackPanel x:Name="AboutPage">

			<StackPanel Orientation="Horizontal"
                        Spacing="16"
                        VerticalAlignment="Center">

				<Image Source="avares://Classic-Repair-Toolbox/Assets/CRT_icon.png"
                       Width="96"
                       Height="96" />

				<StackPanel VerticalAlignment="Center"
                            Spacing="4">
					<TextBlock x:Name="AboutAssemblyTitleText"
                               FontSize="24"
                               FontWeight="SemiBold" />

					<StackPanel Orientation="Horizontal"
                                Spacing="0">
						<TextBlock Text="Version "
                                   FontSize="14" />
						<TextBlock x:Name="AppVersionText"
                                   FontSize="14"
                                   FontWeight="Bold" />
					</StackPanel>
				</StackPanel>
			</StackPanel>

			<TextBlock Margin="0,16,0,0"
                       VerticalAlignment="Center">
				<Run Text="Orchestrator for this vibe-coded application is" />
				<Run x:Name="AuthorNameRun" Text="Dennis Helligsø" FontWeight="SemiBold" />
			</TextBlock>

			<StackPanel Orientation="Horizontal"
                        Margin="0,16,0,0"
                        Spacing="6">
				<TextBlock Text="GitHub project page:"
                           VerticalAlignment="Center" />
				<Button Content="https://github.com/HovKlan-DH/Classic-Repair-Toolbox"
                        Padding="0"
                        BorderThickness="0"
						Cursor="Hand"
                        Background="Transparent"
                        Foreground="{DynamicResource Link_Fg}"
                        Click="OnGitHubProjectPageClick" />
			</StackPanel>

			<StackPanel Orientation="Horizontal"
            Margin="0,6,0,0"
            Spacing="6">
				<TextBlock Text="Fun-facts page:"
						   VerticalAlignment="Center" />
				<Button Content="https://classic-repair-toolbox.dk/funfacts/"
						Padding="0"
						BorderThickness="0"
						Cursor="Hand"
						Background="Transparent"
						Foreground="{DynamicResource Link_Fg}"
						Click="OnFunFactsPageClick" />
			</StackPanel>

			<StackPanel Orientation="Horizontal"
            Margin="0,6,0,0"
            Spacing="6">
				<TextBlock Text="YouTube videos:"
						   VerticalAlignment="Center" />
				<Button Content="https://www.youtube.com/@HovKlan-DH"
						Padding="0"
						BorderThickness="0"
						Cursor="Hand"
						Background="Transparent"
						Foreground="{DynamicResource Link_Fg}"
						Click="OnYouTubeChannelClick" />
			</StackPanel>

			<StackPanel Orientation="Horizontal"
            Margin="0,6,0,0"
            Spacing="6">
				<TextBlock Text="Connect directly with developer on Discord:"
						   VerticalAlignment="Center" />
				<Button Content="Retro Hardware 2.0"
						Padding="0"
						BorderThickness="0"
						Cursor="Hand"
						Background="Transparent"
						Foreground="{DynamicResource Link_Fg}"
						Click="OnDiscordServerClick" />
				<TextBlock Text="(accept invite on page)"
						   VerticalAlignment="Center" />
			</StackPanel>

			<!-- Board revision date section -->
			<StackPanel x:Name="RevisionDatePanel"
						Orientation="Horizontal"
						Spacing="4"
						Margin="0,16,0,0"
						IsVisible="False">
				<TextBlock Text="Board data last revisioned:"
						   FontSize="14" />
				<TextBlock x:Name="RevisionDateText"
						   FontSize="14"
						   FontWeight="Bold" />
			</StackPanel>

			<!-- Credits section - shown only when the loaded board contains credits. ALSO THE BOARD'S CHANGES IN THE ORDER
			     THEY CAME (owner request, 2026-11-14: "this is both a list to honor the authors of data, but also a cronological
			     list of changes done"): oldest first by the date each was published (CreditOrder), its main contribution, a
			     note with formatting, under each row. -->
			<Border x:Name="CreditsSectionBorder"
					IsVisible="False"
					Margin="0,16,0,0">
				<StackPanel Spacing="8">
					<TextBlock Text="Credits and history for this board:"
							   FontSize="14"
							   Margin="0,0,0,12" />

					<Border BorderBrush="{DynamicResource Table_BorderRowLine}" BorderThickness="1">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!-- Header -->
							<Grid Grid.Row="0" Background="{DynamicResource Table_Header_Bg}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="150" />
									<ColumnDefinition Width="190" />
									<ColumnDefinition Width="190" />
									<ColumnDefinition Width="220" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Date" FontWeight="Bold" Padding="8,4" Foreground="{DynamicResource Table_Header_Fg}" />
								<TextBlock Grid.Column="1" Text="Category" FontWeight="Bold" Padding="8,4" Foreground="{DynamicResource Table_Header_Fg}" />
								<TextBlock Grid.Column="2" Text="Sub-category" FontWeight="Bold" Padding="8,4" Foreground="{DynamicResource Table_Header_Fg}" />
								<TextBlock Grid.Column="3" Text="Author / contributor" FontWeight="Bold" Padding="8,4" Foreground="{DynamicResource Table_Header_Fg}" />
								<TextBlock Grid.Column="4" Text="Contact for author / contributor" FontWeight="Bold" Padding="8,4" Foreground="{DynamicResource Table_Header_Fg}" />
							</Grid>

							<!-- Items -->
							<ItemsControl Grid.Row="1"
										  Background="{DynamicResource Table_Bg}"
										  x:Name="CreditsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="local:CreditDisplayItem">
										<Border Classes="ResourceRow" BorderBrush="{DynamicResource Table_BorderRowLine}" BorderThickness="0,0,0,1">
											<Grid RowDefinitions="Auto,Auto">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="150" />
													<ColumnDefinition Width="190" />
													<ColumnDefinition Width="190" />
													<ColumnDefinition Width="220" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<TextBlock Grid.Column="0"
														   Text="{Binding Date}"
														   Foreground="{DynamicResource Table_Fg}"
														   Padding="8,4"
														   VerticalAlignment="Center"
														   TextTrimming="CharacterEllipsis" />
												<!-- What the contribution was, under its row - its formatting and links drawn (TextLinkRenderer). -->
												<TextBlock Grid.Row="1"
														   Grid.Column="1"
														   Grid.ColumnSpan="4"
														   theme:TextLinkRenderer.LinkText="{Binding MainContribution}"
														   IsVisible="{Binding HasMainContribution}"
														   Foreground="{DynamicResource Table_Fg}"
														   Padding="8,0,8,6"
														   TextWrapping="Wrap" />
												<TextBlock Grid.Column="1"
														   Text="{Binding Category}"
														   Foreground="{DynamicResource Table_Fg}"
														   Padding="8,4"
														   VerticalAlignment="Center"
														   TextTrimming="CharacterEllipsis" />
												<TextBlock Grid.Column="2"
														   Text="{Binding SubCategory}"
														   Foreground="{DynamicResource Table_Fg}"
														   Padding="8,4"
														   VerticalAlignment="Center"
														   TextTrimming="CharacterEllipsis" />
												<TextBlock Grid.Column="3"
														   Text="{Binding Name}"
														   Foreground="{DynamicResource Table_Fg}"
														   Padding="8,4"
														   VerticalAlignment="Center"
														   TextTrimming="CharacterEllipsis" />
												<Panel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
													<TextBlock Text="{Binding Contact}"
															   Foreground="{DynamicResource Table_Fg}"
															   Padding="8,4"
															   VerticalAlignment="Center"
															   IsVisible="{Binding !IsLink}"
															   TextTrimming="CharacterEllipsis" />
													<Button Classes="LinkButton"
															Command="{Binding OpenContactCommand}"
															IsVisible="{Binding IsLink}">
														<TextBlock Text="{Binding Contact}" TextTrimming="CharacterEllipsis" />
													</Button>
												</Panel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</Border>
				</StackPanel>
			</Border>

			<!-- What the list is (owner request, 2026-11-14: "mention this is both a list to honor the authors of data, but also a
			     cronological list of changes done (rephrase this to sound more professional)"). -->
			<TextBlock Margin="0,16,0,0"
					   TextWrapping="Wrap"
                       Text="This list serves two purposes: it acknowledges the people who created and improved this board's data, and it records the board's history - each contribution listed in the order it was published, oldest first, with a short description of its main changes. The descriptions cover the most important updates rather than every detail. Contributions from before the history was recorded have no date and may have no description. Not every small contribution is listed; a place here is for a substantial part of the data."
					   Foreground="{DynamicResource Fg}"
					   />

			<!-- The changelog of the version running, as GitHub shows it - its blocks are the list's
			     items after this page (TabAbout.Changelog.cs) -->
			<TextBlock x:Name="ChangelogTitle"
					   Text="Full changelog for application"
					   FontSize="14"
					   FontWeight="SemiBold"
					   Margin="0,32,0,16" />

		</StackPanel>
	</ItemsControl>
</UserControl>