<!--
THE MAINTAINER TAB (2026-09-29): what was the separate CRT Maintainer application's main window,
now a tab in CRT's own window - shown only when "Enable Maintainer tab" is ticked in the
Configuration tab (Main.Maintainer.cs). While it is selected, Main collapses the sidebar and the
worklog bar so the four screens get the window's full width.

A UserControl, not a Window: the window's title, its place on screen, its "please wait" overlay and
its closing prompt are all CRT's window's now (TabMaintainer.axaml.cs explains where each went).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             xmlns:data="clr-namespace:Handlers.DataHandling;assembly=CRT.Data"
             x:Class="CRT.TabMaintainer">

    <UserControl.Styles>
        <!-- THE QUEUE, GROUPED BY BOARD (2026-09-26, TabMaintainer.QueueItems.cs). -->

        <!-- "New system" on a board's heading - the one badge left: a published system is the
             ordinary case. Colours from CRT's App.axaml, per theme. -->
        <Style Selector="Border.Badge">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Badge_NewSystem_Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Badge_NewSystem_Border}" />
        </Style>

        <Style Selector="Border.Badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Badge_NewSystem_Fg}" />
        </Style>

        <!-- A board's heading: a disabled item, so it cannot be selected - drawn in the ordinary
             text colour rather than the theme's greyed-out one, since it is a heading, not an
             option that is off. -->
        <Style Selector="ListBoxItem.QueueHeading">
            <Setter Property="Padding" Value="10,8,10,2" />
        </Style>

        <Style Selector="ListBoxItem.QueueHeading:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <!-- The line above every heading but the first, keeping the boards apart. -->
        <Style Selector="Border.QueueDivider">
            <Setter Property="BorderBrush" Value="{DynamicResource Queue_Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,8,0,0" />
        </Style>

        <!-- A submission under its board's heading, indented beneath it. -->
        <Style Selector="ListBoxItem.QueueEntry">
            <Setter Property="Padding" Value="22,5,10,6" />
        </Style>

        <!-- A row in the BETA, Systems and Account lists: not under a heading, so not indented. -->
        <Style Selector="ListBoxItem.ListEntry">
            <Setter Property="Padding" Value="10,6,10,7" />
        </Style>

        <!--
        THE FOUR SCREENS' TAB STRIP (owner request, 2026-10-01; TabMaintainer.Modes.cs). Drawn as
        tabs under CRT's own: plain text on the strip's line, the chosen one with CRT's red
        underline (Main_TabUnderline_Selected) and the others greyed, a faint underline under the
        pointer (Main_TabUnderline_Hover) - the main tabs' own colours, so the two rows read as one
        family. The label is not made bold when chosen: a bolder label is wider, and every tab after
        it would move. Every look under the pointer is set here, in the TAB's styles, so the
        theme's button hover (a grey fill) never shows. Colours from CRT's App.axaml, per theme.
        -->
        <Style Selector="Border.ScreenTabStrip">
            <Setter Property="BorderBrush" Value="{DynamicResource Queue_Divider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <!-- The underline sits ON the strip's line: 1px down, over it. -->
        <Style Selector="Button.ScreenTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="Margin" Value="0,0,0,-1" />
        </Style>

        <Style Selector="Button.ScreenTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Main_TabUnderline_Hover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <Style Selector="Button.ScreenTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <Style Selector="Button.ScreenTab.Selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Main_TabUnderline_Selected}" />
        </Style>

        <!-- A tab not chosen is greyed - its LABEL only, so a red badge on it keeps its colour. -->
        <Style Selector="Button.ScreenTab:not(.Selected) TextBlock.ScreenTabLabel">
            <Setter Property="Opacity" Value="0.65" />
        </Style>

        <Style Selector="Button.ScreenTab:not(.Selected):pointerover TextBlock.ScreenTabLabel">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!--
        A SUBMISSION'S THREE VIEWS, AS ONE JOINED SWITCH (2026-10-01; TabMaintainer.SubmissionViews.cs)
        - a different look from the tab strip on purpose. Square inner corners, rounded outer ones,
        neighbours sharing one border line (each after the first pulled 1px left); the chosen one is
        filled and outlined in front of its neighbours, and stays so under the pointer.
        -->
        <Style Selector="Button.Segment">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
            <Setter Property="Margin" Value="-1,0,0,0" />
        </Style>

        <Style Selector="Button.Segment.First">
            <Setter Property="CornerRadius" Value="4,0,0,4" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="Button.Segment.Last">
            <Setter Property="CornerRadius" Value="0,4,4,0" />
        </Style>

        <Style Selector="Button.Segment.Selected">
            <Setter Property="ZIndex" Value="1" />
        </Style>

        <Style Selector="Button.Segment.Selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Mode_Selected_Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Mode_Selected_Border}" />
        </Style>

        <!--
        The count on a button. ATTENTION (Review, BETA) is filled and only there when something waits
        for this account; COUNT (Systems) is the discreet one the owner asked for - grey, always there
        once the list is read.
        -->
        <Style Selector="Border.ModeBadge">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.ModeBadge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.ModeBadge.Attention">
            <Setter Property="Background" Value="{DynamicResource Badge_Attention_Bg}" />
        </Style>

        <Style Selector="Border.ModeBadge.Attention TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Badge_Attention_Fg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.ModeBadge.Count">
            <Setter Property="Background" Value="{DynamicResource Badge_Count_Bg}" />
        </Style>

        <Style Selector="Border.ModeBadge.Count TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Badge_Count_Fg}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </UserControl.Styles>

    <!--
    TWO PANELS, ONE AT A TIME: sign in, then the queue.

    The sign-in panel is a PANEL rather than a modal dialog, deliberately. A modal would have to be
    dismissed and re-shown on every expiry and every "not permitted" answer, and a maintainer whose
    session lapsed mid-session would get a dialog over a window still showing stale rows. Swapping
    the whole surface means what is on screen is always the thing that is actually true.
    -->
    <Grid Margin="16">

        <!-- ================= Sign in ================= -->
        <!--
        TWO VIEWS, ONE AT A TIME (owner request, 2026-10-04): the sign-in form, or - after "I have an
        invitation" - the invitation ALONE. Shown under the form, the invitation sat below a second
        set of email and password boxes and a "Sign in" button that had nothing to do with it, which
        was confusing. Cancel goes back to the form as it was (TabMaintainer.Invitation.cs).
        -->
        <StackPanel x:Name="SignInPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360">

            <StackPanel x:Name="SignInFormPanel"
                        Spacing="8">

                <!--
                *** WHAT THIS TAB IS, said before anything is asked of the reader. ***

                Somebody who ticked "Enable Maintainer tab" out of curiosity finds a sign-in screen for an
                account they do not have and cannot create. Saying so here costs a few lines and saves
                that person guessing - and tells them how to put the tab away again.

                No "CRT Maintainer" heading any more (2026-09-29): the tab's own header already says
                "Maintainer", and the application that heading named is now this tab.

                It sits ABOVE the fields rather than below them, because an explanation under a form is
                read after the reader has already decided they are in the wrong place.
                -->
                <Border Background="#20808080"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,4,0,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="For maintainers of the hardware data only."
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   Text="This tab reviews and publishes contributions to the shared hardware data. It needs a maintainer account, given by the administrator through an invitation, and does nothing without one." />

                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   Text="You can hide this tab again in the Configuration tab." />
                    </StackPanel>
                </Border>

                <!--
                NO SERVER FIELD. The Maintainer tab talks to exactly one service and always will, so asking
                for it on every launch was a question whose answer never changes - and one that broke
                the moment somebody typed a trailing slash or omitted the scheme. The address is
                ReviewApiRoutes.DefaultBaseAddress.
                -->

                <TextBlock Text="Email"
                           Opacity="0.7"
                           Margin="0,4,0,0" />
                <TextBox x:Name="EmailTextBox" />

                <TextBlock Text="Password"
                           Opacity="0.7"
                           Margin="0,4,0,0" />
                <!--
                PasswordChar, so a shoulder-surfer at a bench cannot read a maintainer credential -
                this account can publish to every user of a system.
                -->
                <TextBox x:Name="PasswordTextBox"
                         PasswordChar="*"
                         KeyDown="OnPasswordKeyDown" />

                <Button x:Name="SignInButton"
                        Content="Sign in"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0"
                        Click="OnSignInClick" />

                <!--
                FORGOT PASSWORD. A plain text button rather than a second screen: the whole interaction
                is one request and one sentence, and a maintainer locked out of the only tool that can
                publish should not have to go looking for how to get back in.
                -->
                <Button x:Name="ForgotPasswordButton"
                        Content="I forgot my password"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="SteelBlue"
                        Click="OnForgotPasswordClick" />

                <!--
                ACCEPTING AN INVITATION (2026-09-27). The one way a new maintainer's account is made: the
                administrator invites an address, the mail carries a code, and it is redeemed here. Same
                plain text button as the one above; it REPLACES this form with the invitation view rather
                than opening a panel under it (2026-10-04).
                -->
                <Button x:Name="HaveInvitationButton"
                        Content="I have an invitation"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="SteelBlue"
                        Click="OnHaveInvitationClick" />

                <!--
                The failure message. Its own block rather than a dialog, so a wrong password does not
                cost a click to dismiss before trying again.

                NOT always red: the password-reset answer is good news, and colouring it as an error
                would read as a failure to somebody who has just asked for help.
                -->
                <TextBlock x:Name="SignInMessageText"
                           Foreground="IndianRed"
                           TextWrapping="Wrap"
                           IsVisible="False" />

                <!--
                ================= Completing a password reset =================

                HIDDEN UNTIL A CODE HAS BEEN ASKED FOR, so the ordinary sign-in screen stays two
                fields and a button. It is revealed by "I forgot my password" - the moment the code
                is on its way and the next thing the person needs is somewhere to put it.

                *** THE MAIL CARRIES A CODE, NOT A LINK, AND THIS PANEL IS WHY. *** Completing a reset
                needs the new PASSWORD, so it cannot be a click: the URL the mail used to print
                ("/api/accounts/reset?token=...") was mapped to nothing and 404'd for every user who
                clicked it. A pasted code is also the safer shape, since a prefetching mail client
                cannot burn a single-use token by following a link.
                -->
                <StackPanel x:Name="ResetPanel"
                            IsVisible="False"
                            Spacing="4"
                            Margin="0,12,0,0">

                    <Border Background="#1F4F7FBF"
                            BorderBrush="#4F7FBF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Check your email for a reset code"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <TextBlock TextWrapping="Wrap"
                                       Opacity="0.85"
                                       Text="Paste the code below and choose the password you want. The code works for 2 hours and can only be used once." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Reset code"
                               Opacity="0.7"
                               Margin="0,4,0,0" />
                    <TextBox x:Name="ResetCodeTextBox" />

                    <TextBlock Text="New password"
                               Opacity="0.7"
                               Margin="0,4,0,0" />
                    <TextBox x:Name="NewPasswordTextBox"
                             PasswordChar="*"
                             KeyDown="OnNewPasswordKeyDown" />

                    <Button x:Name="SetPasswordButton"
                            Content="Set password"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,8,0,0"
                            Click="OnSetPasswordClick" />
                </StackPanel>
            </StackPanel>

            <!--
            ================= Accepting an invitation =================

            Hidden until "I have an invitation" is pressed, and then shown INSTEAD of the sign-in form
            above, never under it. The code comes from the invitation mail; the name is what other
            maintainers and contributors see. Accepting makes the account - the address is the one
            invited, so it is not asked for - and goes back to the sign-in form with its fields
            filled, one click from signing in (TabMaintainer.Invitation.cs).

            Its OWN message line, under its buttons: the form's one is hidden with the form.
            -->
            <StackPanel x:Name="InvitationPanel"
                        IsVisible="False"
                        Spacing="4"
                        Margin="0,4,0,0">

                <Border Background="#1F4F7FBF"
                        BorderBrush="#4F7FBF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Accept your invitation"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   Text="Paste the code from the invitation email, then choose the name others will see and a password. Your account is made for the address the invitation was sent to." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Invitation code"
                           Opacity="0.7"
                           Margin="0,4,0,0" />
                <TextBox x:Name="InvitationCodeTextBox" />

                <TextBlock Text="Your name"
                           Opacity="0.7"
                           Margin="0,4,0,0" />
                <TextBox x:Name="InvitationNameTextBox" />

                <TextBlock Text="Password"
                           Opacity="0.7"
                           Margin="0,4,0,0" />
                <TextBox x:Name="InvitationPasswordTextBox"
                         PasswordChar="*"
                         KeyDown="OnInvitationPasswordKeyDown" />

                <!-- Cancel first and the action last, as in CRT's dialogs. -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Margin="0,8,0,0">

                    <Button x:Name="CancelInvitationButton"
                            Content="Cancel"
                            Click="OnCancelInvitationClick" />

                    <Button x:Name="AcceptInvitationButton"
                            Content="Create my account"
                            Click="OnAcceptInvitationClick" />
                </StackPanel>

                <TextBlock x:Name="InvitationMessageText"
                           Foreground="IndianRed"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           IsVisible="False" />
            </StackPanel>
        </StackPanel>

        <!-- ================= The queue ================= -->
        <!--
        The four screens' TAB STRIP across the whole width, then the list (370 wide) on the left and
        the chosen item on the right.
        -->
        <Grid x:Name="QueuePanel"
              IsVisible="False"
              RowDefinitions="Auto,*"
              ColumnDefinitions="370,4,*">

            <!--
            THE FOUR SCREENS (owner request, 2026-09-27: "it has these buttons in the top-left:
            Review, BETA, Systems, Admin"; since named Systems, Contributor Submissions, BETA > Stable
            and Admin, in that order - and since 2026-10-04 "Queue: Contributor submissions", "Queue:
            Awaiting push from BETA to stable" and "Administrator activities", from CRT.Data's
            MaintainerScreenWording, which every message naming a screen reads too - and the last
            renamed "Account" later that day, when it became every maintainer's). Each changes the list below AND the panel on the right
            (TabMaintainer.Modes.cs); the "Production", "Maintainers" and "Unused files" windows they
            replace opened over the queue instead.

            *** A TAB STRIP ACROSS THE WHOLE TAB, NOT BUTTONS IN THE LEFT COLUMN (owner request,
            2026-10-01: "It looks like bad UX design - do you have any better ideas"). *** They were
            grey buttons wrapped onto two rows of the 370-wide list column, looking exactly like the
            submission's Board data / Files / Contributor buttons beside them - two levels of choice
            that could not be told apart. Now each level has its own look: CRT's tabs, these screens
            as tabs under them (the same red underline, ScreenTab), and a submission's views as one
            joined switch (Segment). Still Buttons, so the screens and their tests are unchanged.

            Review and BETA carry a badge counting the SYSTEMS that wait for this account; Systems a
            discreet one counting all systems. Account is every maintainer's since 2026-10-04 (owner
            request: "make this tab available to all maintainers") - it was "Admin", hidden from all
            but the administrator. Its administrator's entries still are hidden from everybody else,
            the server refusing them anyway (isAdministrator in the queue answer).
            -->
            <Border Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Classes="ScreenTabStrip"
                    Margin="0,0,0,12">
                <!-- A WrapPanel only so a window narrower than CRT's own minimum can never clip a
                     tab off the end; at any width CRT opens at, the four sit on one line. -->
                <WrapPanel x:Name="ModeBar"
                           Orientation="Horizontal"
                           ItemSpacing="4">

                    <!-- Systems FIRST (owner request, 2026-09-27); Review is still the screen a
                         sign-in opens on. -->
                    <Button x:Name="SystemsModeButton" Classes="ScreenTab" Click="OnModeClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="ScreenTabLabel" Text="{x:Static data:MaintainerScreenWording.Systems}" VerticalAlignment="Center" />
                            <Border x:Name="SystemsBadge" Classes="ModeBadge Count" IsVisible="False">
                                <TextBlock x:Name="SystemsBadgeText" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReviewModeButton" Classes="ScreenTab Selected" Click="OnModeClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="ScreenTabLabel" Text="{x:Static data:MaintainerScreenWording.ContributorQueue}" VerticalAlignment="Center" />
                            <Border x:Name="ReviewBadge" Classes="ModeBadge Attention" IsVisible="False">
                                <TextBlock x:Name="ReviewBadgeText" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BetaModeButton" Classes="ScreenTab" Click="OnModeClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="ScreenTabLabel" Text="{x:Static data:MaintainerScreenWording.BetaQueue}" VerticalAlignment="Center" />
                            <Border x:Name="BetaBadge" Classes="ModeBadge Attention" IsVisible="False">
                                <TextBlock x:Name="BetaBadgeText" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AccountModeButton" Classes="ScreenTab" Click="OnModeClick">
                        <TextBlock Classes="ScreenTabLabel" Text="{x:Static data:MaintainerScreenWording.Account}" />
                    </Button>
                </WrapPanel>
            </Border>

            <DockPanel Grid.Row="1" Grid.Column="0">
                <!--
                WHO IS LOGGED IN, AND NOTHING ELSE (owner request, 2026-10-04: "only show "Logged in
                as:<br /><b>Dennis</b> (dennis@...dk)" in the bottom-left corner"). The name is bold,
                on a line of its own under the words, so somebody with both a maintainer and an
                administrator account sees which one is acting before publishing anything.

                The "Account" and "Sign out" buttons that sat here (2026-10-03) are gone: both are
                "My account", the first entry under the Account screen (MyAccountView).
                -->
                <StackPanel DockPanel.Dock="Bottom"
                            x:Name="SignedInAsPanel"
                            Opacity="0.6"
                            Margin="0,8,0,0">
                    <TextBlock Text="Logged in as:" />
                    <TextBlock x:Name="SignedInAsText" TextWrapping="Wrap" />
                </StackPanel>

                <!--
                ONE LIST PER SCREEN, one shown at a time. Each keeps its selection while another screen
                is shown, so coming back finds it as it was - an open submission's table included,
                unsaved changes and all.

                The empty/error state sits ABOVE each list rather than below it, because an empty
                list leaves the bottom of the panel far from where the maintainer is looking.
                -->
                <Panel>
                    <DockPanel x:Name="ReviewList">
                        <TextBlock DockPanel.Dock="Top"
                                   x:Name="QueueMessageText"
                                   TextWrapping="Wrap"
                                   IsVisible="False"
                                   Margin="0,0,0,8" />

                        <!-- Each row is several lines (TabMaintainer.QueueItems.cs), and wraps to
                             the column rather than scrolling sideways. -->
                        <ListBox x:Name="QueueList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnQueueSelectionChanged" />
                    </DockPanel>

                    <!-- BETA: the systems waiting for production that this account may publish
                         (TabMaintainer.Beta.cs). -->
                    <DockPanel x:Name="BetaListPanel" IsVisible="False">
                        <TextBlock DockPanel.Dock="Top"
                                   x:Name="BetaListMessageText"
                                   TextWrapping="Wrap"
                                   IsVisible="False"
                                   Margin="0,0,0,8" />

                        <ListBox x:Name="BetaList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnBetaSelectionChanged" />
                    </DockPanel>

                    <!-- Systems: every system (TabMaintainer.Systems.cs). -->
                    <DockPanel x:Name="SystemsListPanel" IsVisible="False">
                        <TextBlock DockPanel.Dock="Top"
                                   x:Name="SystemsListMessageText"
                                   TextWrapping="Wrap"
                                   IsVisible="False"
                                   Margin="0,0,0,8" />

                        <ListBox x:Name="SystemsList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnSystemsSelectionChanged" />
                    </DockPanel>

                    <!--
                    ACCOUNT (TabMaintainer.Account.cs): "My account" and "Server version" for every
                    maintainer, then the administrator's own entries - each with the class AdminOnly,
                    taken OUT of the list for everybody else (ShowAdministratorEntries - not
                    IsVisible, which the list's panel sets back to true), and each marked with the
                    padlock after its name (owner request, 2026-10-04; App.axaml's AdminLock style,
                    CRT's one padlock for anything only the administrator can use). It was "Admin", the administrator's
                    alone, until then. Maintainers are set here again since 2026-10-04 (owner
                    request) - they were on the Systems screen from 2026-09-27.
                    -->
                    <ListBox x:Name="AccountList"
                             IsVisible="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnAccountSelectionChanged">

                        <!-- First, and what the screen opens on: the name, the address, the
                             password and signing out (the "Your account" window and the two buttons
                             under the lists until 2026-10-04). -->
                        <ListBoxItem x:Name="MyAccountItem" Classes="ListEntry">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Static data:MaintainerScreenWording.MyAccount}" FontSize="13" />
                                <TextBlock Text="Your name, email address and password, and signing out" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>

                        <!-- What is deployed (owner request, 2026-10-04 - it was a line above the
                             account row until then; every maintainer's since the same day). -->
                        <ListBoxItem x:Name="ServerVersionItem" Classes="ListEntry">
                            <StackPanel Spacing="1">
                                <TextBlock Text="Server version" FontSize="13" />
                                <TextBlock Text="What is deployed, and the API revision it and this CRT speak" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>

                        <!-- ===== The administrator's own, each AdminOnly and padlocked ===== -->

                        <ListBoxItem x:Name="MaintainersItem" Classes="ListEntry AdminOnly">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Maintainers" FontSize="13" />
                                    <TextBlock Classes="AdminLock" Text="&#xf023;" />
                                </StackPanel>
                                <TextBlock Text="Who maintains each system - add, invite or remove" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>

                        <!-- The order of CRT's drop-down lists, in BETA and the stable source
                             (owner request, 2026-10-04). -->
                        <ListBoxItem x:Name="SystemOrderItem" Classes="ListEntry AdminOnly">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Order of systems" FontSize="13" />
                                    <TextBlock Classes="AdminLock" Text="&#xf023;" />
                                </StackPanel>
                                <TextBlock Text="The order of CRT's drop-down lists, in BETA and the stable source" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem x:Name="UnusedFilesItem" Classes="ListEntry AdminOnly">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Unused files" FontSize="13" />
                                    <TextBlock Classes="AdminLock" Text="&#xf023;" />
                                </StackPanel>
                                <TextBlock Text="Files no workbook uses, in the BETA or the stable data" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem x:Name="RebuildManifestsItem" Classes="ListEntry AdminOnly">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Rebuild checksum manifests" FontSize="13" />
                                    <TextBlock Classes="AdminLock" Text="&#xf023;" />
                                </StackPanel>
                                <TextBlock Text="After data files were changed on the server by hand" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Deleting a system completely (owner request, 2026-10-03). -->
                        <ListBoxItem x:Name="DeleteSystemItem" Classes="ListEntry AdminOnly">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Delete a system" FontSize="13" />
                                    <TextBlock Classes="AdminLock" Text="&#xf023;" />
                                </StackPanel>
                                <TextBlock Text="From the BETA and the stable data and the database, for good" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Which CRT versions call which route (owner request, 2026-10-04). -->
                        <ListBoxItem x:Name="ApiUsageItem" Classes="ListEntry AdminOnly">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="API usage" FontSize="13" />
                                    <TextBlock Classes="AdminLock" Text="&#xf023;" />
                                </StackPanel>
                                <TextBlock Text="Which CRT versions still call each route of the server" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>

                        <!-- Resetting the contribution data for going live (owner request,
                             2026-10-04). Last: it is used once, and it deletes the most. -->
                        <ListBoxItem x:Name="ResetDataItem" Classes="ListEntry AdminOnly">
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Reset contribution data" FontSize="13" />
                                    <TextBlock Classes="AdminLock" Text="&#xf023;" />
                                </StackPanel>
                                <TextBlock Text="For going live: every submission, account, maintainer and the history, for good" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Panel>
            </DockPanel>

            <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

            <!--
            THE RIGHT-HAND SIDE, one panel per screen - "will show everything in the right-side menu"
            for each of the four. Only the chosen screen's is shown; the others keep what they hold.
            -->
            <Panel Grid.Row="1" Grid.Column="2" Margin="12,0,0,0">

                <DockPanel x:Name="ReviewPanel">
                    <!--
                    Said until a submission is chosen. The submission's details - badges, system, what
                    the contributor wrote - are in its queue row (TabMaintainer.QueueItems.cs), not
                    repeated here, so the table gets the room (owner request, 2026-09-26).
                    -->
                    <TextBlock DockPanel.Dock="Top"
                               x:Name="NoSubmissionText"
                               Text="Select a submission"
                               FontSize="16"
                               Opacity="0.7"
                               Margin="0,0,0,10" />

                    <!--
                    THE DECISION BAR (task 5), docked to the BOTTOM so it cannot scroll away. A
                    maintainer scrolls through the changes and then decides; a bar that scrolled with
                    them would mean scrolling back to a button whose context they have just left.

                    The COMMENT box comes first and is always visible, because it is required for two
                    of the three outcomes and a box that appeared only after pressing a button would
                    make the maintainer press, read a refusal, type, and press again.
                    -->
                    <StackPanel DockPanel.Dock="Bottom"
                                x:Name="DecisionPanel"
                                IsVisible="False"
                                Spacing="6"
                                Margin="0,12,0,0">

                        <TextBlock x:Name="DecisionMessageText"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />

                        <!--
                        WHO MUST APPROVE (2026-09-25): shown only for a submission that changes a shared
                        file, which needs the board's maintainer AND the administrator. Written by
                        ApprovalWording from the server's ApprovalStatus.
                        -->
                        <TextBlock x:Name="ApprovalStatusText"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   IsVisible="False" />

                        <!--
                        WHAT APPROVING REMOVES (2026-09-25): files the board stops citing that nothing
                        else uses are removed by the publish. Said here, beside the button, as well as
                        in the file list - "It must be, so it is clear what will happen".
                        -->
                        <TextBlock x:Name="RemovalStatusText"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Foreground="IndianRed"
                                   IsVisible="False" />

                        <!--
                        CHANGED IN THE TABLE (2026-09-25): who last changed this submission in "View in
                        table format", so a second maintainer - or the administrator giving the second
                        approval - knows it is not exactly what the contributor sent.
                        -->
                        <TextBlock x:Name="AmendmentText"
                                   TextWrapping="Wrap"
                                   FontStyle="Italic"
                                   IsVisible="False" />

                        <TextBox x:Name="DecisionCommentTextBox"
                                 AcceptsReturn="True"
                                 MinHeight="60"
                                 MaxHeight="120"
                                 TextWrapping="Wrap"
                                 PlaceholderText="Why? This is the only message the contributor receives." />

                        <!--
                        APPROVE IS LAST AND SEPARATED - at the far RIGHT (owner request, 2026-09-26), the
                        other two at the left. It is the only irreversible action on this screen: it
                        publishes, and with no retained revision the only way back is a correction.
                        Putting it first, where a reflexive click lands, would be the wrong default for
                        the one button that cannot be undone.

                        THE COLOUR SAYS WHICH WAY THE DECISION GOES (owner request, 2026-09-26: "then
                        there are two red ones, either requesting for changes or rejecting it, and then
                        one accepting it, being green. Should be logical"). All three were CRT's red,
                        which made the one accepting action look like the two that send the submission
                        back. So Approve takes CRT's own green (Button_Ok_*, the keys its "OK" buttons
                        use) and "Request changes" and "Reject" keep the red (Button_Cancel_*, the
                        table's "Save changes" colours). Greyed by the theme while off.

                        The colour is NOT a licence to move it: Approve stays last and separated for the
                        reason above - green marks which way it goes, not that it is safe to click
                        without reading.
                        -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    x:Name="ApproveButton"
                                    Content="Approve and publish to BETA"
                                    Foreground="{DynamicResource Button_Ok_Fg}"
                                    Background="{DynamicResource Button_Ok_Bg}"
                                    BorderBrush="{DynamicResource Button_Ok_Border}"
                                    Click="OnApproveClick" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RequestChangesButton"
                                    Content="Request changes"
                                    Foreground="{DynamicResource Button_Cancel_Fg}"
                                    Background="{DynamicResource Button_Cancel_Bg}"
                                    BorderBrush="{DynamicResource Button_Cancel_Border}"
                                    Click="OnRequestChangesClick" />

                            <Button x:Name="RejectButton"
                                    Content="Reject"
                                    Foreground="{DynamicResource Button_Cancel_Fg}"
                                    Background="{DynamicResource Button_Cancel_Bg}"
                                    BorderBrush="{DynamicResource Button_Cancel_Border}"
                                    Click="OnRejectClick" />
                        </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!--
                    THE SUBMISSION, IN THREE VIEWS (owner request, 2026-09-30: "The "Files..." button
                    ... can easily be missed ... Maybe one row with "Contributor info", "Board data",
                    and then "Files"?"). TabMaintainer.SubmissionViews.cs; the words are
                    SubmissionViews'.

                      Board data  - THE TABLE (owner request, 2026-09-26: "make the table the default
                                    first view, as this is the most helpful one"), and above it, only
                                    when there is something to say, what the table CANNOT show:
                                    highlights, calibration points, the automatic checks' warnings
                                    (ReviewNotInTable). A submission always opens on it.
                      Files       - the system's files after approving (TabMaintainer.Files.cs). Its
                                    button counts the files the submission adds, replaces or removes.
                      Contributor - who sent it and everything they sent before
                                    (TabMaintainer.Contributor.cs).

                    Who sent it is the Contributor view's alone (owner request, 2026-09-30) - there was
                    a one-line summary beside the buttons until then. The decision bar stays below all
                    three.

                    SWITCHING VIEW HIDES, IT NEVER CLOSES - the tab's own rule: the table, unsaved
                    changes and all, is exactly where it was on coming back to Board data.

                    *** NEITHER THE TABLE NOR THE FILE TREE IS INSIDE A SCROLLVIEWER. *** A list
                    measured with unlimited height realises every row - the Drafts tab's rule, for the
                    same grid, and FileTreeView's own.
                    -->
                    <DockPanel x:Name="TablePanel" IsVisible="False">
                        <TextBlock DockPanel.Dock="Top"
                                   x:Name="TableLoadMessageText"
                                   TextWrapping="Wrap"
                                   IsVisible="False"
                                   Margin="0,0,0,8" />

                        <!-- WHAT TO SETTLE BEFORE APPROVING, above all three views (code review,
                             2026-10-01): why Approve is off (ApprovalGate) and the contributor's
                             discarded draft. They were the first lines above the TABLE, inside the
                             Board data view - so on Files or Contributor, Approve was greyed out
                             with no reason anywhere. Still above everything else, as the owner
                             asked of the discarded-draft warning (2026-09-28). -->
                        <StackPanel DockPanel.Dock="Top"
                                    x:Name="BeforeApprovingPanel"
                                    Spacing="2"
                                    IsVisible="False"
                                    Margin="0,0,0,8" />

                        <!-- No one-line "From ... - [4] other submissions" beside the buttons any
                             more (owner request, 2026-09-30: "I do not need to see highlighted
                             data, as this should be available under "Contributor""). -->
                        <!-- ONE JOINED SWITCH (2026-10-01) - a different look from the screens' tab
                             strip above, so the two levels of choice cannot be mistaken for each
                             other (see the tab strip's note). Spacing 0 and each segment after the
                             first pulled 1px left, so neighbouring borders are one line. -->
                        <StackPanel DockPanel.Dock="Top"
                                    x:Name="SubmissionViewBar"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Spacing="0"
                                    Margin="0,0,0,10">
                                <Button x:Name="BoardDataViewButton"
                                        Classes="Segment First Selected"
                                        Content="Board data"
                                        Click="OnSubmissionViewClick" />

                                <Button x:Name="FilesViewButton" Classes="Segment" Click="OnSubmissionViewClick">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="Files" VerticalAlignment="Center" />
                                        <Border x:Name="FilesViewBadge" Classes="ModeBadge Count" IsVisible="False">
                                            <TextBlock x:Name="FilesViewBadgeText" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ContributorViewButton"
                                        Classes="Segment Last"
                                        Content="Contributor"
                                        Click="OnSubmissionViewClick" />
                        </StackPanel>

                        <Panel>
                            <DockPanel x:Name="BoardDataView">
                                <StackPanel DockPanel.Dock="Top"
                                            x:Name="NotInTablePanel"
                                            Spacing="2"
                                            IsVisible="False"
                                            Margin="0,0,0,8" />

                                <local:BoardTableEditor x:Name="SubmissionTable" />
                            </DockPanel>

                            <DockPanel x:Name="FilesView" IsVisible="False">
                                <TextBlock DockPanel.Dock="Top"
                                           x:Name="FilesViewHeadingText"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,0,0,8" />

                                <local:FileTreeView x:Name="SubmissionFileTree" />
                            </DockPanel>

                            <ScrollViewer x:Name="ContributorView"
                                          IsVisible="False"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ContributorSection"
                                            Spacing="10"
                                            Margin="0,0,12,0" />
                            </ScrollViewer>
                        </Panel>
                    </DockPanel>
                </DockPanel>

                <!-- BETA: one system's way to production, or back to the queue. -->
                <local:BetaView x:Name="BetaDetailView" IsVisible="False" />

                <!-- Systems: one system's maintainers, contributors and submissions. -->
                <local:SystemView x:Name="SystemDetailView" IsVisible="False" />

                <!-- Account: whichever is chosen on the left - "My account" for everybody, then the
                     administrator's own panels. -->
                <local:MyAccountView x:Name="MyAccountPanel" IsVisible="False" />
                <local:MaintainerPoolView x:Name="MaintainerPoolAdminView" IsVisible="False" />
                <local:SystemOrderView x:Name="SystemOrderAdminView" IsVisible="False" />
                <local:UnusedFilesView x:Name="UnusedFilesAdminView" IsVisible="False" />
                <local:RebuildManifestsView x:Name="RebuildManifestsAdminView" IsVisible="False" />
                <local:SystemDeletionView x:Name="SystemDeletionAdminView" IsVisible="False" />
                <local:ApiUsageView x:Name="ApiUsageAdminView" IsVisible="False" />
                <local:DataResetView x:Name="DataResetAdminView" IsVisible="False" />

                <!-- "Server version" (owner request, 2026-10-04; every maintainer's since the same
                     day): three lines, each value bold in brackets - ServerVersionDisplay words them,
                     TabMaintainer.Account.cs reads them. -->
                <StackPanel x:Name="ServerVersionView" IsVisible="False">
                    <TextBlock Text="Server version"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />

                    <TextBlock TextWrapping="Wrap"
                               Opacity="0.8"
                               Margin="0,0,0,12"
                               Text="What is deployed on the server, and the API revision it and this CRT speak. The API revision changes only when the server changes in a way an older CRT cannot follow: when the server's is higher, CRT is behind and has to be updated - the server turns it away from submitting and from this tab, saying so - and when this CRT's is higher, the newer server has not been deployed yet." />

                    <StackPanel x:Name="ServerVersionLines" Spacing="4" />
                </StackPanel>
            </Panel>
        </Grid>

        <!--
        NO "please wait" overlay of its own (2026-09-29). Every wait in this tab runs under CRT's
        window's one BusyOverlay (Main.axaml) - BusyOverlay.For and ServerWait find it up the tree. A
        second overlay here would dim only the tab and block nothing above it: the update banner,
        the other tabs' headers and the data-sync icon would all stay clickable.
        -->
    </Grid>
</UserControl>
