<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRT.ApiUsageView">

    <!--
    API USAGE (owner request, 2026-10-04: "how about tracking the API end-points, to see if it is
    possible to retire any, if almost no versions uses it any more"). ADMINISTRATOR ONLY, like
    every padlocked entry on the Account screen (the Admin screen until 2026-10-04).

    Every route the server maps, grouped by who uses it, the least-called first in each group, with
    the CRT versions that called it in the days chosen; and, above them, how many installations
    launched each CRT version (the launch check-ins). It decides nothing - retiring a route is the
    project owner's decision, made in the server's code (CLAUDE.md, "Installed CRTs keep working").

    The words and the order are ApiUsageDisplay's. The routes sit in a ScrollViewer: a list of about a
    hundred, not the thousands a file tree has.
    -->
    <DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   x:Name="HeadingText"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top"
                   x:Name="ExplanationText"
                   TextWrapping="Wrap"
                   Opacity="0.8"
                   Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,12">

            <ComboBox x:Name="DaysBox"
                      MinWidth="160"
                      SelectionChanged="OnDaysChanged" />

            <Button x:Name="RefreshButton"
                    Content="Refresh"
                    Click="OnRefreshClick" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   x:Name="MessageText"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   Margin="0,0,0,8" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="UsagePanel"
                        Spacing="4"
                        Margin="0,0,12,0" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
