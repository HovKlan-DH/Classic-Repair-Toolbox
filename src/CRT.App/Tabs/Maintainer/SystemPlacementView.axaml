<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CRT"
             x:Class="CRT.SystemPlacementView">

    <!--
    PLACING A NEW SYSTEM IN CRT's DROP-DOWN LISTS (owner request, 2026-09-27: "The maintainer should
    order the new system, so it becomes visible in the right location for the drop-down lists. This
    must be done before it can be pushed to BETA.").

    Shown at the top of a system on the Systems screen while that system is not in BETA's main Excel
    data file. The names CRT shows, then BETA's whole list in CRT's order with this system as the one
    panel that can be dragged - the same dashed placeholder as the Drafts tab's schematic images, by
    the same code (CRT.UI's ListRowDrag) - then where CRT will show it, and Save. The rules and words
    are SystemPlacementDisplay's.
    -->
    <UserControl.Styles>
        <!-- The north/south cursor only where a drag is allowed: a maintainer who cannot place the
             system sees the panel, but is not told it moves. -->
        <Style Selector="Grid.PlacementDragHandle.Movable">
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="8">

        <TextBlock Text="Place it in the drop-down lists"
                   FontSize="14"
                   FontWeight="SemiBold" />

        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" />

        <TextBlock x:Name="SavedStateText"
                   FontSize="12"
                   Opacity="0.7"
                   TextWrapping="Wrap" />

        <!-- The names CRT shows in its two drop-downs, and the hardware notes on its Overview tab. -->
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hardware name" VerticalAlignment="Center" Margin="0,0,12,6" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HardwareNameBox" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Board name" VerticalAlignment="Center" Margin="0,0,12,6" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BoardNameBox" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hardware notes" VerticalAlignment="Top" Margin="0,6,12,0" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     x:Name="NotesBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="52"
                     PlaceholderText="Shown in CRT's Overview tab - optional" />
        </Grid>

        <TextBlock x:Name="DragHintText"
                   Text="Drag it up or down to where it belongs in CRT's list:"
                   Margin="0,4,0,0" />

        <!--
        The whole list, in a box of its own height with its own scroll bar, so the drag can scroll it
        (holding the panel near the top or bottom edge) without scrolling the page around it.
        -->
        <Border BorderBrush="{DynamicResource Table_BorderRowLine}"
                BorderThickness="1"
                Height="360">
            <ScrollViewer x:Name="PlacementScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <!-- Spaced by the PANEL rather than a margin per row, so a row's container is exactly
                     the row and the placeholder takes its height - see ListRowDrag. -->
                <ItemsControl x:Name="PlacementItemsControl" Margin="4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="local:PlacementListRow">
                            <Grid>

                                <!-- Where a drop will land, while the panel is dragged. -->
                                <Panel IsVisible="{Binding IsDropPlaceholder}"
                                       Height="{Binding PlaceholderHeight}">
                                    <Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
                                               StrokeThickness="2"
                                               StrokeDashArray="4,3"
                                               RadiusX="3"
                                               RadiusY="3"
                                               Fill="{DynamicResource Bg}" />
                                    <TextBlock Text="Release the mouse button to place it here"
                                               FontSize="11"
                                               Opacity="0.7"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Panel>

                                <!-- A system already listed: its two names, as the lists carry them. -->
                                <Grid IsVisible="{Binding ShowsAsListed}"
                                      ColumnDefinitions="200,*"
                                      Margin="6,2">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding HardwareName}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BoardName}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- The system being placed: its own panel, marked like the queue's new
                                     systems, and the only row that moves. -->
                                <Border IsVisible="{Binding ShowsAsNewSystem}"
                                        Background="{DynamicResource Badge_NewSystem_Bg}"
                                        BorderBrush="{DynamicResource Badge_NewSystem_Border}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,6">

                                    <!-- The drag handle is the whole panel. Background set, or the
                                         blank space in it is not hit-testable. -->
                                    <!-- Columns sized so the board name lines up with the listed
                                         rows' (6 + 200 there; 1 + 4 + 24 + 177 here). -->
                                    <Grid Classes="PlacementDragHandle"
                                          ColumnDefinitions="24,177,*"
                                          Background="Transparent"
                                          Classes.Movable="{Binding CanDrag}"
                                          PointerPressed="OnRowPointerPressed">

                                        <!-- Font Awesome "grip-vertical", as on the schematic images:
                                             says at a glance that the panel moves. -->
                                        <TextBlock Grid.Column="0"
                                                   Classes="PlacementDragGrip"
                                                   Text="&#xf58e;"
                                                   FontFamily="{DynamicResource FontAwesomeSolid}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Badge_NewSystem_Fg}"
                                                   IsVisible="{Binding CanDrag}"
                                                   Margin="2,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Drag up or down to place it" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding HardwareName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding BoardName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Where CRT will show it - what the position really decides. -->
        <TextBlock x:Name="WhereInCrtText" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       x:Name="MessageText"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       IsVisible="False" />

            <Button Grid.Column="1"
                    x:Name="SaveButton"
                    Content="Save its place"
                    Foreground="{DynamicResource Button_Ok_Fg}"
                    Background="{DynamicResource Button_Ok_Bg}"
                    BorderBrush="{DynamicResource Button_Ok_Border}"
                    IsEnabled="False"
                    Click="OnSaveClick" />
        </Grid>
    </StackPanel>
</UserControl>
