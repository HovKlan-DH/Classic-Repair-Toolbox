<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:maintainer="clr-namespace:Handlers.MaintainerHandling;assembly=Classic-Repair-Toolbox"
             x:Class="CRT.ServerVersionView">

    <!--
    "SERVER VERSION" - THE SECOND ENTRY OF THE MAINTAINER TAB'S "ACCOUNT" SCREEN (ServerVersionView.axaml.cs).
    Panels saying how the server stands, and the server's own changelog under them (owner requests, 2026-11-24).
    The panels are drawn as "Board status" draws its own on the "Contribute" tab: a card with a 4px edge in the
    color of how it stands, an icon of its own shape for each, its title and a line in words, then its facts in
    two columns - the label quiet, the value bold.
    -->
    <UserControl.Styles>
        <Style Selector="Border.ServerPanel">
            <Setter Property="Background" Value="{DynamicResource Card_Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Table_BorderRowLine}" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,10" />
            <!-- Two side by side in a pane of some 900px, the updater's sentence still on a few lines. -->
            <Setter Property="Width" Value="440" />
        </Style>
        <Style Selector="Border.ServerPanel.Good">
            <Setter Property="BorderBrush" Value="{DynamicResource Text_Success_Fg}" />
        </Style>
        <Style Selector="Border.ServerPanel.Waiting">
            <Setter Property="BorderBrush" Value="{DynamicResource Text_Waiting_Fg}" />
        </Style>
        <Style Selector="Border.ServerPanel.Problem">
            <Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
        </Style>

        <Style Selector="TextBlock.ServerPanelIcon">
            <Setter Property="FontFamily" Value="{DynamicResource FontAwesomeSolid}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,2,10,0" />
        </Style>
        <Style Selector="TextBlock.ServerPanelIcon.Good">
            <Setter Property="Foreground" Value="{DynamicResource Text_Success_Fg}" />
        </Style>
        <Style Selector="TextBlock.ServerPanelIcon.Waiting">
            <Setter Property="Foreground" Value="{DynamicResource Text_Waiting_Fg}" />
        </Style>
        <Style Selector="TextBlock.ServerPanelIcon.Problem">
            <Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
        </Style>
        <Style Selector="TextBlock.ServerPanelIcon.Neutral">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="TextBlock.ServerPanelTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.ServerPanelSummary">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.ServerPanelSummary.Good">
            <Setter Property="Foreground" Value="{DynamicResource Text_Success_Fg}" />
        </Style>
        <Style Selector="TextBlock.ServerPanelSummary.Waiting">
            <Setter Property="Foreground" Value="{DynamicResource Text_Waiting_Fg}" />
        </Style>
        <Style Selector="TextBlock.ServerPanelSummary.Problem">
            <Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
        </Style>
        <Style Selector="TextBlock.ServerPanelSummary.Neutral">
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <Style Selector="TextBlock.ServerFactLabel">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="TextBlock.ServerFactValue">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <!--
    ONE virtualized list, as the "About" tab: the page first, then every block of the changelog as an item of its
    own, built only as it scrolls into view - the changelog of every server version is some hundreds of blocks.
    -->
    <ItemsControl x:Name="PageItems">
        <ItemsControl.Template>
            <ControlTemplate>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Margin="0,0,12,12" />
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <StackPanel x:Name="PageTop">
            <TextBlock Text="{x:Static maintainer:ServerVersionDisplay.Heading}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,4" />

            <TextBlock Text="{x:Static maintainer:ServerVersionDisplay.Introduction}"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       Margin="0,0,0,14" />

            <!-- One card per thing asked about, side by side while the pane has the room (ServerVersionView.ShowPanels). -->
            <WrapPanel x:Name="PanelsHost"
                       Orientation="Horizontal"
                       ItemSpacing="12"
                       LineSpacing="12" />

            <!-- The server's changelog - its blocks are the list's items after this page. -->
            <TextBlock x:Name="ChangelogTitle"
                       Text="{x:Static maintainer:ServerVersionDisplay.ChangelogTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,32,0,16"
                       IsVisible="False" />

            <TextBlock x:Name="NoChangelogText"
                       Text="{x:Static maintainer:ServerVersionDisplay.NoChangelog}"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       IsVisible="False" />
        </StackPanel>
    </ItemsControl>
</UserControl>
