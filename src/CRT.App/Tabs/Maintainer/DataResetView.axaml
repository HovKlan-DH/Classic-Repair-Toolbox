<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CRT.DataResetView">

    <!--
    RESET CONTRIBUTION DATA (owner request, 2026-10-04: "When I go-live with this, it should not have
    old data visible, so it should be deleted. Of course the real sources of BETA and stable must not
    be touched, but all contributor and maintainer data should go away"). ADMINISTRATOR ONLY, like
    every padlocked entry on the Account screen (the Admin screen until 2026-10-04) - and on the server, only while its AllowDataReset setting is on.

    What a reset would delete, counted by the server when this item is chosen; what it leaves; and the
    red button, which works only once the confirmation word (RESET) is typed - a reset cannot be
    undone, so it is never one click. While the server's switch is off the counts still show, with the server's words for how
    to switch it on, and the button stays off.

    The words are DataResetWording's.

    IT SCROLLS, AND THE CONFIRMATION WRAPS (2026-11-25, after the owner's report of the "Maintainer" tab's sign-in out of
    reach on Linux): a dozen count lines and the server's sentences are taller than a low window gives this panel, and
    at CRT's narrowest the prompt, the box and the button ran past its right edge.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,0">

        <TextBlock x:Name="HeadingText"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,8" />

        <TextBlock x:Name="ExplanationText"
                   TextWrapping="Wrap"
                   Opacity="0.8"
                   Margin="0,0,0,12" />

        <!-- One line per kind of thing deleted, each count bold. -->
        <StackPanel x:Name="CountLines"
                    Spacing="4"
                    Margin="0,0,0,12" />

        <TextBlock x:Name="KeptText"
                   TextWrapping="Wrap"
                   Opacity="0.8"
                   Margin="0,0,0,12" />

        <!-- The server's words while its switch is off. -->
        <TextBlock x:Name="SwitchedOffText"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Text_Fail_Fg}"
                   IsVisible="False"
                   Margin="0,0,0,12" />

        <WrapPanel ItemSpacing="8"
                   LineSpacing="8"
                   Margin="0,0,0,12">

            <TextBlock x:Name="ConfirmPromptText"
                       VerticalAlignment="Center" />

            <TextBox x:Name="ConfirmBox"
                     Width="120"
                     IsEnabled="False" />

            <Button x:Name="ResetButton"
                    Classes="Danger"
                    IsEnabled="False"
                    Click="OnResetClick" />
        </WrapPanel>

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   Margin="0,0,0,8" />

        <TextBlock x:Name="DoneText"
                   TextWrapping="Wrap"
                   IsVisible="False" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
