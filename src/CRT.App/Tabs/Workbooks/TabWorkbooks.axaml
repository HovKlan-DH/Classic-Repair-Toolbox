<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             x:Class="CRT.TabWorkbooks">

	<!-- ###########################################################################################
	     THE WORKBOOKS TAB - originally concept "C; Worklog tab" from
	     Assets/UI mockups/worklog-mockup.html, laid out as markup so it could be tweaked in the
	     running app; real behaviour has since landed on top of that layout piece by piece and this
	     file is no longer a static mockup. See TabWorkbooks.axaml.cs and
	     TabWorkbooks.BoardPreviews.cs for what each part actually does - both carry their own
	     up-to-date class-header comments, which is the source of truth over this one.

	     Sizing carried over from the original mockup pass: it was drawn at 1.5x (a 150% DPI
	     screenshot), so a number here that still traces back to it is the mockup's divided by 1.5 -
	     16.5px becomes FontSize 11, 12px padding becomes 8. Colours are the Workbooks_* theme keys
	     in App.axaml, never a hex code, so the tab follows the light/dark theme like everything else.

	     The tab is only reachable when "Enable Worklog" is ticked in Configuration - Main.axaml.cs's
	     ApplyWorklogBarVisibility shows and hides its TabItem along with the worklog bar.
	     ########################################################################################### -->

	<UserControl.Styles>

		<!-- A workbook card in the left list. The cards themselves are built in the code-behind
		     (see BuildWorkbookCard), which adds this class to each one. .Selected is the currently
		     activated workbook - a tinted fill, applied/removed by SelectWorkbook. -->
		<Style Selector="Border.WorkbooksJobCard">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="7" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Border.WorkbooksJobCard.Selected">
			<Setter Property="Background" Value="{DynamicResource Workbooks_SelectedCard_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
		</Style>

		<Style Selector="TextBlock.WorkbooksMuted">
			<Setter Property="FontSize" Value="10" />
			<Setter Property="Foreground" Value="{DynamicResource Workbooks_Muted_Fg}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style Selector="TextBlock.WorkbooksFaint">
			<Setter Property="FontSize" Value="10" />
			<Setter Property="Foreground" Value="{DynamicResource Workbooks_Faint_Fg}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- The workbook summary strip's expand/collapse line: a Button stripped back to plain
		     text, so it reads as a line in the header rather than as a control sitting in one.
		     A Button and not an Expander because Expander brings a border, a background and its
		     own padding, all of which would have to be undone here anyway - see the strip's own
		     comment in the header row below. -->
		<Style Selector="Button.WorkbooksSummaryToggle">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource Workbooks_Muted_Fg}" />
		</Style>

		<!-- Hover and pressed both stay transparent: the default Button chrome paints a filled
		     rectangle behind the text, which on this line looks like a stray highlight rather
		     than a hover state. The Hand cursor already says it is clickable. -->
		<Style Selector="Button.WorkbooksSummaryToggle:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<Style Selector="Button.WorkbooksSummaryToggle:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<!-- The four workbook-header action buttons (Edit/Delete workbook, Export to PDF/ZIP) -
		     all four share ONE width so their edges line up across the two rows, rather than each
		     sizing to its own label.

		     That width is MEASURED at runtime (TabWorkbooks.EqualiseHeaderActionButtonWidths) and
		     deliberately NOT set here. It used to be a hardcoded Width="100", which was narrower
		     than "Delete workbook" actually needs and clipped its final character to "Delete
		     workboo" - a hardcoded width is a guess about text the font decides the size of, and it
		     silently goes wrong when a label, the font or the font size changes. The code sizes them
		     to whichever button is genuinely widest instead, so the label can never be cut off.

		     HorizontalContentAlignment centers the shorter labels within that shared width instead
		     of leaving them flush left. -->
		<Style Selector="Button.WorkbookHeaderAction">
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<!-- The whole tab is one filter field above the two panels. The field is deliberately OUTSIDE
	     the split so it reads as filtering both sides at once - workbooks on the left, worklogs on
	     the right - rather than belonging to whichever panel it sat in. -->
	<Grid RowDefinitions="Auto,*">

		<Border Grid.Row="0"
				BorderBrush="{DynamicResource Workbooks_Separator}"
				BorderThickness="0,0,0,1"
				Padding="9,7">
			<!-- Filters the workbook list AND the entry list as you type (OnFindRepairTextChanged),
			     matching against every user-typed text field on a workbook and on each of its
			     entries - see Handlers/Data/WorklogSearchIndex.cs for exactly which, and
			     WorklogSearchQuery.cs for the query grammar the placeholder summarises. Matched runs
			     are highlighted wherever the filtered results are drawn.

			     The query survives EVERYTHING until the user clears it here - including a board
			     change, which used to wipe it. In "Show all workbooks" scope a search routinely
			     finds a workbook on another board, and clicking that result is how you follow the
			     search to it; clearing on the board switch that follows meant the filter vanished at
			     the exact moment it had done its job, and the search had to be retyped to see where
			     the match was.

			     Because nothing clears it implicitly any more, there has to be an obvious way to
			     clear it explicitly - hence the button, overlaid on the right-hand end of the box
			     and shown only while there is something to clear. -->
			<Grid>
				<TextBox x:Name="FindRepairTextBox"
						 PlaceholderText="Find a previous repair - words are ANDed, &quot;use quotes&quot; for a phrase, -minus excludes"
						 FontSize="11"
						 TextChanged="OnFindRepairTextChanged" />

				<!-- Right-aligned INSIDE the box rather than beside it, so the field keeps the full
				     width of the panel. The TextBox's own right padding (set in the code-behind
				     alongside this button's visibility) keeps typed text from running underneath it.

				     A plain "✕" rather than a Font Awesome glyph: an icon-font character that is
				     missing from the shipped subset renders as a blank box, which has bitten this
				     project before (see the export buttons, which carry no icon for that reason),
				     and this one has to be unmistakable. -->
				<Button x:Name="ClearSearchButton"
						Content="&#x2715;"
						ToolTip.Tip="Clear the filter"
						IsVisible="False"
						FontSize="11"
						Width="20"
						Height="20"
						Padding="0"
						Margin="0,0,4,0"
						Background="Transparent"
						BorderThickness="0"
						Cursor="Hand"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						HorizontalContentAlignment="Center"
						VerticalContentAlignment="Center"
						Click="OnClearSearchClick" />
			</Grid>
		</Border>

		<!-- Left = the board's workbooks, right = the selected workbook. The splitter matches the
		     main window and the Schematics tab: a fixed 4px column so the global GridSplitter style
		     colours it. Column 0's width is restored from UserSettings.WorkbooksLeftPanelWidth in
		     the code-behind (Initialize) and saved back on OnOuterSplitterPointerReleased - the
		     same pattern Main.axaml.cs uses for its own LeftPanelWidth.

		     Both panel columns carry a live-drag MinWidth, the same protection Main.axaml's own
		     splitter columns use - without it GridSplitter would let either panel be dragged down
		     to nothing, which ClampPanelWidth's own floor only guards on RESTORE, not while
		     actually dragging. The right-hand column's is 400px rather than the left's 200px: its
		     top-line packs a title/pill/note beside FOUR buttons (Edit/Delete workbook, Export to
		     PDF/ZIP across two rows - see WorkbookHeaderActionsPanel below), and below 400px those
		     buttons start overlapping the title text rather than wrapping cleanly under it. -->
		<Grid x:Name="OuterSplitGrid" Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="200" MinWidth="200" />
				<ColumnDefinition Width="4" />
				<ColumnDefinition Width="*" MinWidth="400" />
			</Grid.ColumnDefinitions>

		<!-- ===================================================================================
		     LEFT: the workbooks recorded for the currently selected board.

		     This panel is REAL, unlike the rest of the tab - it lists what WorklogManager actually
		     has on disk for the current board, rebuilt by RefreshWorkbooks in the code-behind. The
		     three hardcoded sample cards it replaced are gone.
		     =================================================================================== -->
		<Border x:Name="WorkbookListBorder"
				Grid.Column="0"
				Background="{DynamicResource Workbooks_Panel_Bg}"
				BorderBrush="{DynamicResource Workbooks_Separator}"
				BorderThickness="0,0,1,0">
			<Grid RowDefinitions="Auto,*" Margin="9">

				<TextBlock Grid.Row="0"
						   x:Name="WorkbookCountText"
						   Text="0 workbooks"
						   FontSize="11"
						   FontWeight="Bold"
						   VerticalAlignment="Center"
						   Margin="0,0,0,7" />

				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="5">

						<!-- Shown instead of the list when the board has no workbooks at all. The
						     count above still reads "0 workbooks", so this only has to say what to
						     do about it. -->
						<TextBlock x:Name="NoWorkbooksText"
								   Text="No repairs recorded for this board yet.&#10;Use &quot;Create new workbook&quot; above the tabs to start one."
								   Classes="WorkbooksFaint"
								   FontSize="10"
								   TextWrapping="Wrap"
								   IsVisible="False" />

						<!-- One card per workbook, built in code rather than by an ItemsControl
						     DataTemplate: each card's status pill needs its brush resolved through
						     Application.Current with an explicit ThemeVariant (see
						     BuildWorkbookCard), which a template binding cannot express. -->
						<StackPanel x:Name="WorkbookListPanel" Spacing="5" />

					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>

		<GridSplitter x:Name="OuterSplitter" Grid.Column="1" />

		<!-- ===================================================================================
		     RIGHT: the selected workbook - its top-line, the board with numbered pins, and the
		     entry list.
		     =================================================================================== -->
		<Grid Grid.Column="2" RowDefinitions="Auto,*">

			<!-- The workbook's top-line: "#{N} · {Title}", its status pill and note, then the
				     Edit/Delete workbook actions right-aligned. It spans the FULL width of this
				     side, above the board/entry-list split below, so it reads as naming the whole
				     right-hand side rather than belonging to either pane.

				     The board ID, the hardware line and the Add entry / Open job folder buttons the
				     mockup drew here are gone: the hardware and board are already chosen in the main
				     window's sidebar, so repeating them made the line long enough to wrap without
				     saying anything new.

				     Two columns rather than one WrapPanel: the title/pill/note side still needs to
				     wrap on a narrow window (a WrapPanel), but the actions must stay put at the
				     right edge rather than wrapping in among them - a single WrapPanel could not
				     keep both. -->
			<Border Grid.Row="0"
					BorderBrush="{DynamicResource Workbooks_Separator}"
					BorderThickness="0,0,0,1"
					Padding="11,9">
				<Grid ColumnDefinitions="*,Auto">
					<!-- Line 1: "#{N} · {Title}" and the status pill. Line 2: the Note, below rather
					     than crowded onto line 1 - a WrapPanel with a long title and a long note
					     could interleave the two in a way that read as one run-on line. Collapsed
					     as a whole (see ApplyHeaderForWorkbook) when the note is blank, which most
					     workbooks are. -->
					<StackPanel Grid.Column="0" Spacing="4">
						<WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="5" VerticalAlignment="Center">
							<!-- Text is set from code (ApplyHeaderForWorkbook) to "#{N} · {Title}" of
							     whichever workbook is active. The literal is the real empty state, NOT
							     sample data: it used to read "#0042 · No picture, black screen", invented
							     content that any layout-timing change would have shown to a user as though
							     it were their own workbook. -->
							<TextBlock x:Name="WorkbookHeaderTitleText"
									   Text="No workbook selected"
									   FontSize="16"
									   FontWeight="Bold"
									   VerticalAlignment="Center" />

							<!-- Same pill as the workbook cards in the left panel and the worklog bar,
							     and NOT by having the same values typed here: border, glyph, label and
							     the padlock's overshoot padding are all applied by
							     WorklogInfoPillBuilder.ApplyStatePillVisual (from ApplyHeaderForWorkbook),
							     which is the one place the informational pill visual is decided. The
							     attributes below are only what the designer shows before that runs. -->
							<Border x:Name="WorkbookHeaderStatusPill"
									Background="{DynamicResource Form_Bg}"
									BorderBrush="{DynamicResource Worklog_Status_Open}"
									BorderThickness="2"
									CornerRadius="10"
									Padding="10,1"
									VerticalAlignment="Center">
								<StackPanel Orientation="Horizontal" Spacing="5">
									<!-- The padlocks are drawn taller than the font's declared ascent, so their
									     top pixel row is clipped without a reserved one. That reservation is
									     applied from the constructor, computed from this control's own font
									     size - a literal Padding here would be right only for the size it
									     was written against. Hence the x:Name. -->
									<TextBlock x:Name="WorkbookHeaderStatusGlyph"
											   Text="&#xf3c1;"
											   FontFamily="{DynamicResource FontAwesomeSolid}"
											   FontSize="11"
											   Foreground="{DynamicResource Worklog_Status_Open}"
											   VerticalAlignment="Center" />
									<TextBlock x:Name="WorkbookHeaderStatusText"
											   Text="Open"
											   FontSize="11"
											   FontWeight="SemiBold"
											   Foreground="{DynamicResource Worklog_Status_Open}"
											   VerticalAlignment="Center" />
								</StackPanel>
							</Border>
						</WrapPanel>

						<!-- The workbook's Note field (the create dialog's optional free-text box,
						     WorkbookRecord.Note) - not shown anywhere else on this tab, so a workbook
						     created with one had no way to see it again without opening the edit
						     dialog. -->
						<TextBlock x:Name="WorkbookHeaderNoteText"
								   Classes="WorkbooksMuted"
								   Text=""
								   TextWrapping="Wrap"
								   IsVisible="False" />

						<!-- The workbook summary strip: one always-visible headline line
						     ("7 worklogs - 12.5 h - 430 - 4 open") with a chevron that expands the
						     full breakdown below it. Everything in it is set from code
						     (ApplySummaryForWorkbook) off WorkbookSummary.Summarize, so the app and
						     an exported PDF report the same numbers from the one computation.

						     A strip here rather than a panel docked under the entry list: this is a
						     property of the WORKBOOK, and the workbook's identity, status, note and
						     Edit/Delete/Export actions are all already on this row. The expanded
						     state persists (UserSettings.WorkbooksSummaryExpanded) so a user who
						     wants the detail does not re-open it on every board change.

						     A Button rather than an Expander: Expander brings its own border,
						     padding and background, none of which suit a line inside an existing
						     header row, and its header would need restyling into a plain line of
						     text anyway. Classes="WorkbooksSummaryToggle" strips the button chrome
						     back to that plain line - the style is in this file's own
						     UserControl.Styles, above. -->
						<StackPanel x:Name="WorkbookSummaryPanel"
									Spacing="3"
									Margin="0,2,0,0"
									IsVisible="False">
							<Button x:Name="WorkbookSummaryToggleButton"
									Classes="WorkbooksSummaryToggle"
									HorizontalAlignment="Left"
									Click="OnWorkbookSummaryToggleClick">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<!-- fa-solid chevron-right / chevron-down, swapped in code with
									     the expanded state. Its overshoot padding is applied from
									     code too, computed from this control's own font size - see
									     FontAwesomeGlyphMetrics. -->
									<TextBlock x:Name="WorkbookSummaryChevron"
											   Text="&#xf054;"
											   FontFamily="{DynamicResource FontAwesomeSolid}"
											   FontSize="9"
											   VerticalAlignment="Center" />
									<!-- Filled from code as Runs, not Text: the numbers are bold and
									     the words around them are not, which one Text cannot express.
									     A TextBlock carrying both renders the Text and silently
									     ignores the Inlines, so nothing is set here. -->
									<TextBlock x:Name="WorkbookSummaryHeadlineText"
											   FontSize="11"
											   VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<!-- The breakdown rows, one line each, indented to sit under the
							     headline's text rather than under its chevron. Each is filled and
							     shown or collapsed individually by ApplySummaryForWorkbook - the
							     components line is hidden entirely for a workbook that scopes
							     none, which is most workbooks of plain notes. -->
							<StackPanel x:Name="WorkbookSummaryDetailPanel"
										Spacing="2"
										Margin="15,0,0,0"
										IsVisible="False">
								<!-- The category and state counts are drawn as the same non-selectable
								     pills the rest of the app uses, each carrying its count - built in
								     code (ApplySummaryForWorkbook) by WorklogInfoPillBuilder, since
								     their brushes need the two-step theme lookup markup cannot express.

								     Both groups share ONE ROW rather than two stacked ones - asked for
								     directly, since five short pills on their own lines read as more
								     vertical space than the information needed. Two separate WrapPanels
								     (not one shared one) so the two groups can still be told apart and
								     each keeps wrapping onto its own next line if the row runs out of
								     room, rather than a state pill wrapping in among the categories. -->
								<WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="4">
									<WrapPanel x:Name="WorkbookSummaryCategoryPanel"
											   Orientation="Horizontal"
											   ItemSpacing="5"
											   LineSpacing="4" />
									<WrapPanel x:Name="WorkbookSummaryStatePanel"
											   Orientation="Horizontal"
											   ItemSpacing="5"
											   LineSpacing="4" />
								</WrapPanel>
								<TextBlock x:Name="WorkbookSummaryAttachmentsText"
										   Classes="WorkbooksMuted"
										   FontSize="11"
										   TextWrapping="Wrap" />
								<TextBlock x:Name="WorkbookSummaryComponentsText"
										   Classes="WorkbooksMuted"
										   FontSize="11"
										   TextWrapping="Wrap" />
							</StackPanel>
						</StackPanel>
					</StackPanel>

					<!-- Edit/Delete act on whichever workbook the top-line and board pane currently
					     show (thisSelectedWorkbookId), so they stay right beside the thing they
					     affect rather than living in the left-hand list. Hidden together with the
					     rest of this row's real content when no workbook is selected - see
					     ApplyHeaderForWorkbook.

					     Top-aligned rather than centered: the left column is now two lines (title/
					     pill, then the note), and centering against both made the buttons drift
					     down off the title line whenever a note was showing. Pinning them to the
					     top keeps them level with line 1 always. -->
					<StackPanel x:Name="WorkbookHeaderActionsPanel"
								Grid.Column="1"
								Orientation="Vertical"
								Spacing="4"
								VerticalAlignment="Top"
								Margin="8,0,0,0"
								IsVisible="False">

						<!-- TWO ROWS, not one: four buttons across a single line crowded the
						     workbook title beside them and pushed the whole header wider than a
						     narrow window could hold. The managing actions lead, the exports sit
						     under them - the exports are the ones read as a pair, so they are the
						     row that can be scanned as a group.

						     Each row is right-aligned (HorizontalAlignment="Right" on the rows
						     rather than on the panel), so the two rows line up on their right edge
						     against the panel's own edge even though they hold different total
						     widths. Aligning left instead would leave a ragged right edge against
						     the window border they sit next to.

						     All four buttons share one width, measured from the widest of them by
						     EqualiseHeaderActionButtonWidths - without it each button sized to its
						     own content and the four edges did not line up between the two rows,
						     which read as untidy. See the Button.WorkbookHeaderAction style for why
						     that width is measured rather than hardcoded. -->
						<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
							<Button x:Name="EditWorkbookButton"
									Classes="WorkbookHeaderAction"
									Content="Edit workbook"
									FontSize="11"
									Click="OnEditWorkbookClick" />
							<Button x:Name="DeleteWorkbookButton"
									Classes="WorkbookHeaderAction"
									Content="Delete workbook"
									FontSize="11"
									Foreground="{DynamicResource Button_Cancel_Fg}"
									Background="{DynamicResource Button_Cancel_Bg}"
									BorderBrush="{DynamicResource Button_Cancel_Border}"
									Click="OnDeleteWorkbookClick" />
						</StackPanel>

						<!-- Export acts on the same workbook Edit/Delete do, which is why it lives
						     in this panel rather than in the left-hand list.

						     TWO buttons, not one with a format dropdown: the ZIP was originally
						     offered only as a second file type inside the save dialog, which made
						     it invisible from the tab - reported as "I do not see the Export to ZIP
						     anywhere". A format the user cannot see is a format that does not
						     exist, so each now has its own button.

						     Deliberately NO icon on either: the fa-regular file-pdf glyph rendered
						     as a blank box in the shipped font subset. Plain text labels say what
						     these do without depending on a glyph being present. -->
						<StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
							<Button x:Name="ExportWorkbookButton"
									Classes="WorkbookHeaderAction"
									Content="Export to PDF"
									FontSize="11"
									Click="OnExportWorkbookClick" />
							<Button x:Name="ExportWorkbookZipButton"
									Classes="WorkbookHeaderAction"
									Content="Export to ZIP"
									FontSize="11"
									Click="OnExportWorkbookZipClick" />
						</StackPanel>
					</StackPanel>
				</Grid>
			</Border>

			<!-- Board pane on the left of this row, entry list on the right. Another fixed-4px
			     splitter, so the user can trade board size against list width. Column 2's width is
			     restored from UserSettings.WorkbooksEntryListWidth in the code-behind (Initialize)
			     and saved back on OnBoardEntrySplitterPointerReleased.

			     Both panel columns carry a 200px MinWidth, matching OuterSplitGrid's own - see its
			     comment for why a live drag floor is needed in addition to ClampPanelWidth's
			     restore-time one. -->
			<Grid x:Name="BoardEntrySplitGrid" Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MinWidth="200" />
					<ColumnDefinition Width="4" />
					<ColumnDefinition Width="347" MinWidth="200" />
				</Grid.ColumnDefinitions>

				<!-- ===========================================================================
				     THE BOARD: every schematic image that has one or more worklog entries in
				     the SELECTED workbook, each with its entries drawn on it - a coloured,
				     dashed bounds rectangle for an entry with "show marked area" on, a plain
				     "#N" pill for one without. Real data and real rendering, built by
				     RefreshBoardPreviews reusing WorklogEntriesOverlay and the same badge
				     control TabSchematics.Worklog.cs builds - see that method's header for why.
				     Clicking a preview (not a pill) selects that schematic, highlighting its
				     border and switching the entry list on the right to its entries - see
				     SelectSchematic in TabWorkbooks.BoardPreviews.cs.

				     The filter chips, the Top/Bottom side toggle, the "board image" placeholder
				     and the legend the mockup drew here are all gone: a scrollable list of
				     possibly several schematic images does not have a single "side" to toggle,
				     the chips filtered a single image's pins that no longer exists in this
				     shape, and the legend was dropped as unneeded once entries were real and
				     the categories were already named on their own pills.
				     =========================================================================== -->
				<Grid Grid.Column="0">

					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel x:Name="BoardPreviewPanel" Spacing="12" Margin="12" />
					</ScrollViewer>

					<!-- Shown instead of the panel above when the selected workbook has no entries
					     at all, or none with a recognised schematic image.

					     VerticalAlignment="Top", not the Grid default of Stretch: a lone line of
					     text in a full-height cell otherwise floats in the vertical middle of an
					     empty pane, far from the heading it belongs to. -->
					<TextBlock x:Name="NoBoardPreviewsText"
							   Text="No worklogs recorded yet for any schematics in this board"
							   Classes="WorkbooksFaint"
							   FontSize="11"
							   TextWrapping="Wrap"
							   Margin="12"
							   VerticalAlignment="Top"
							   IsVisible="False" />
				</Grid>


				<GridSplitter x:Name="BoardEntrySplitter" Grid.Column="1" />

				<!-- ===========================================================================
				     THE ENTRY LIST: entries for the schematic selected in the board pane to the
				     left. Real data, built entirely in TabWorkbooks.BoardPreviews.cs
				     (RefreshSelectedSchematicEntries) - clicking a schematic image there selects it
				     (highlighted border) and this list switches to that schematic's entries. Each
				     entry is ONE 1px-bordered card holding three stacked rows: "#{N} {Title}" (the
				     "#N" a small filled badge exactly like WorklogEntryEditorWindow's EditorIdBadge,
				     coloured by category), the description, then the category chip and status pill
				     in the SAME filled/white-text visual the editor's own selected chip/pill use -
				     see BuildEntryDetailCard.
				     =========================================================================== -->
				<Border x:Name="SelectedSchematicEntriesBorder" Grid.Column="2" Background="{DynamicResource Workbooks_Panel_Bg}">
					<Grid RowDefinitions="Auto,*">

						<Border Grid.Row="0"
								BorderBrush="{DynamicResource Workbooks_RowSeparator}"
								BorderThickness="0,0,0,1"
								Padding="9,7">
							<TextBlock x:Name="SelectedSchematicEntriesHeaderText" Text="Select a schematic" Classes="WorkbooksMuted" />
						</Border>

						<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
							<StackPanel x:Name="SelectedSchematicEntriesPanel" Margin="9" Spacing="12" />
						</ScrollViewer>

						<!-- Shown instead of the panel above when no schematic is selected, or the
						     selected one has no entries. Top-aligned for the same reason
						     NoBoardPreviewsText is - see its comment. -->
						<TextBlock x:Name="NoSelectedSchematicEntriesText"
								   Text="No worklogs recorded yet for any schematics in this board"
								   Classes="WorkbooksFaint"
								   FontSize="11"
								   TextWrapping="Wrap"
								   Margin="9"
								   Grid.Row="1"
								   VerticalAlignment="Top"
								   IsVisible="False" />
					</Grid>
				</Border>
			</Grid>
		</Grid>
		</Grid>
	</Grid>
</UserControl>
