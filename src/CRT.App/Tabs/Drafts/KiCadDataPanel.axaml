<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             x:Class="CRT.KiCadDataPanel">

	<!-- "KiCad DATA" ON THE RIGHT OF THE CONTRIBUTE TAB - a window until 2026-10-30 (owner request: "it
	     should just show up in the 'normal' content area, and not in a new window"). Laid out as the
	     component pane is: a title with Close, then what the part holds. -->
	<UserControl.Styles>
		<Style Selector="Border.DropTarget">
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="Padding" Value="12" />
		</Style>

		<!-- One component reference in the match report. Each reference is its own badge rather
		     than a run in a comma-separated sentence: a board runs to hundreds of them, and in
		     prose "C1, C10, C100, C101" blurs into one line of text where no single reference
		     can be picked out by eye. -->
		<Style Selector="Border.ReferenceBadge">
			<Setter Property="Background" Value="{DynamicResource Draft_ReferenceBadge_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Draft_ReferenceBadge_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="Padding" Value="6,1" />
		</Style>

		<!-- The components left to label: IndianRed (owner request, 2026-10-10), so the to-do list
		     stands out from the components that already match. -->
		<Style Selector="Border.ReferenceBadge.Todo">
			<Setter Property="Background" Value="{DynamicResource Draft_ReferenceBadge_Todo_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Draft_ReferenceBadge_Todo_Border}" />
		</Style>
		<Style Selector="Border.ReferenceBadge.Todo > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Draft_ReferenceBadge_Todo_Fg}" />
		</Style>

		<!-- A KiCad net name an "Important signals" row already uses: filled green, white text - the
		     to-do badges' look in green (owner report, 2026-10-29: green text on the grey badge was
		     "almost impossible to see"). -->
		<Style Selector="Border.ReferenceBadge.Used">
			<Setter Property="Background" Value="{DynamicResource Draft_ReferenceBadge_Used_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Draft_ReferenceBadge_Used_Border}" />
		</Style>
		<Style Selector="Border.ReferenceBadge.Used > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Draft_ReferenceBadge_Used_Fg}" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
	</UserControl.Styles>

	<UserControl.Resources>
		<!-- Shared by the component lists (not labelled / will not light up / match), so they cannot
		     drift into looking different. -->
		<DataTemplate x:Key="ReferenceBadgeTemplate">
			<Border Classes="ReferenceBadge">
				<TextBlock Text="{Binding}" FontSize="12" />
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="TodoReferenceBadgeTemplate">
			<Border Classes="ReferenceBadge Todo">
				<TextBlock Text="{Binding}" FontSize="12" />
			</Border>
		</DataTemplate>

		<!-- One KiCad net - nothing to click since 2026-11-01 (owner request): every net has its "Add" in
		     the Important KiCad signals part. -->
		<DataTemplate x:Key="NetNameBadgeTemplate" DataType="local:KiCadNetNameBadge">
			<Border Classes="ReferenceBadge NetName"
					Classes.Used="{Binding IsUsed}"
					ToolTip.Tip="{Binding ToolTipText}">
				<TextBlock Text="{Binding Name}" FontSize="12" />
			</Border>
		</DataTemplate>

		<ItemsPanelTemplate x:Key="ReferenceBadgePanel">
			<WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" />
		</ItemsPanelTemplate>
	</UserControl.Resources>

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- The part's headline, as the component pane's. -->
		<Border Grid.Row="0"
				BorderBrush="{DynamicResource Table_BorderRowLine}"
				BorderThickness="0,0,0,1"
				Padding="4,0,0,8">
			<Grid ColumnDefinitions="*,Auto">
				<StackPanel Grid.Column="0" Spacing="2">
					<TextBlock x:Name="HeaderText"
							   Text="KiCad: Files"
							   FontSize="16"
							   FontWeight="Bold" />
					<TextBlock x:Name="IntroText"
							   TextWrapping="Wrap"
							   FontSize="11"
							   Opacity="0.75"
							   Text="Add the KiCad project that backs this board's pictures. The files are copied into your own local draft - your original project is left where it is." />
				</StackPanel>
				<!-- No Close (2026-10-30) - the left column's "Board status" goes back. -->
			</Grid>
		</Border>

		<ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="18" Margin="4,12,12,12" MaxWidth="980" HorizontalAlignment="Left">

				<!-- KiCad data, with the summary and the match report below it - the panel's only part
				     since the "Schematic images" half moved to the Contribute tab's Schematic images part (step 3). -->
				<StackPanel x:Name="KiCadSection" Spacing="6">
					<TextBlock TextWrapping="Wrap"
							   FontSize="12"
							   Opacity="0.8"
							   Text="Optional. Pick the folder holding the project's .kicad_pcb and .kicad_sch files. Sub-folders are searched too, so a multi-sheet project keeps its pages - footprint libraries, 3D models and gerbers are left behind." />

					<Border Classes="DropTarget" x:Name="KiCadDropTarget">
						<StackPanel Spacing="8">
							<TextBlock Text="Drag the KiCad folder here, or use the button below."
									   HorizontalAlignment="Center"
									   Opacity="0.75"
									   FontSize="12" />
							<Button x:Name="ImportKiCadButton"
									Content="Choose KiCad folder"
									HorizontalAlignment="Center"
									Click="OnImportKiCadClick" />

							<!-- An import adds the KiCad board's components too (owner request, 2026-11-01: "it
							     should add all components when importing the KiCad data ... Have checkbox if it
							     should add all data automatically also?") - ticked until unticked, remembered. -->
							<CheckBox x:Name="AddComponentsCheckBox"
									  IsChecked="True"
									  HorizontalAlignment="Center"
									  ToolTip.Tip="Every component of the KiCad board that this board does not have yet is added - with its package and pins where the footprint says them. One step, so &quot;Undo&quot; takes them all back."
									  IsCheckedChanged="OnAddComponentsCheckedChanged">
								<TextBlock Text="Add the KiCad components to the board" />
							</CheckBox>
						</StackPanel>
					</Border>

					<TextBlock x:Name="KiCadStateText"
							   FontSize="12"
							   TextWrapping="Wrap"
							   Opacity="0.75" />

					<!-- The files themselves. A count alone ("25 KiCad files imported") said nothing
					     about WHICH project had been imported, so a contributor reopening this
					     window could not tell the right folder from the wrong one.

					     Every file is shown, at full height, with NO scroller of its own. It used to
					     be capped at 150px inside its own ScrollViewer, which put a scroll area
					     inside the window's scroll area - the wheel scrolled whichever one the
					     pointer happened to be over, and the list's own bar sat hard against the
					     window's (owner report, 2026-09-24). The window's ScrollViewer already
					     carries anything that does not fit, so a long list only means scrolling
					     the window further. -->
					<Border x:Name="KiCadFilesPanel"
							IsVisible="False"
							BorderBrush="{DynamicResource Form_Border}"
							BorderThickness="1"
							Background="{DynamicResource Form_Bg}"
							Padding="8,6">
						<ItemsControl x:Name="KiCadFilesItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="local:BoardKiCadFileRow">
									<!-- Remove is per file, like a schematic image's - but compact, since a
									     multi-sheet project lists 25+ of these and a full-size button on
									     every line would crowd out the file names. Same destructive
									     colours as the schematic Remove, so the two read as one action. -->
									<Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
										<TextBlock Grid.Column="0"
												   Text="{Binding RelativePath}"
												   FontSize="11"
												   FontFamily="Consolas,Menlo,monospace"
												   TextWrapping="NoWrap"
												   VerticalAlignment="Center" />
										<TextBlock Grid.Column="1"
												   Text="{Binding SizeText}"
												   FontSize="11"
												   Opacity="0.6"
												   Margin="12,0,0,0"
												   VerticalAlignment="Center" />
										<Button Grid.Column="2"
												Classes="Danger"
												Content="Remove"
												FontSize="11"
												Padding="8,1"
												Margin="12,0,0,0"
												VerticalAlignment="Center"
												Tag="{Binding}"
												Click="OnRemoveKiCadFileClick" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Border>
				</StackPanel>

				<!-- What the KiCad data holds, what an import left out, and what is left to do (CRT 4.0
				     step 3, slice 3e - the plan: "drop the project folder and get a summary of what was
				     found, what was ignored, and what is left to do"; KiCadImportSummary). -->
				<Border x:Name="KiCadSummaryPanel"
						BorderBrush="{DynamicResource Form_Border}"
						BorderThickness="1"
						Background="{DynamicResource Form_Bg}"
						Padding="12"
						IsVisible="False">
					<StackPanel Spacing="6">
						<TextBlock Text="Summary" FontWeight="Bold" />
						<!-- The board's KiCad files by kind - where the count beside "KiCad data" comes from
						     (owner request, 2026-10-30). -->
						<TextBlock x:Name="KiCadFilesText" TextWrapping="Wrap" IsVisible="False" />
						<TextBlock x:Name="KiCadFoundText" TextWrapping="Wrap" />
						<!-- What the import's "Add the KiCad components" did (2026-11-01). -->
						<TextBlock x:Name="KiCadComponentsAddedText" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="False" />
						<TextBlock x:Name="KiCadLeftOutText"
								   TextWrapping="Wrap"
								   FontSize="12"
								   Opacity="0.8"
								   IsVisible="False" />
						<TextBlock x:Name="KiCadOlderText"
								   TextWrapping="Wrap"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource Text_Fail_Fg}"
								   IsVisible="False" />
						<StackPanel x:Name="KiCadLeftToDoPanel" Spacing="2" IsVisible="False">
							<TextBlock Text="Left to do" FontWeight="SemiBold" Margin="0,4,0,0" />
							<TextBlock x:Name="KiCadLeftToDoText" TextWrapping="Wrap" />

							<!-- The KiCad components the board still lacks - imported with the check box
							     unticked, or deleted since - added in one go (Board status's "Add N from KiCad"
							     until 2026-11-01). -->
							<Button x:Name="AddKiCadComponentsButton"
									Classes="Accept"
									HorizontalAlignment="Left"
									Margin="0,6,0,0"
									IsVisible="False"
									ToolTip.Tip="Add every component of the KiCad board that this board does not have yet - one step, so &quot;Undo&quot; takes them all back"
									Click="OnAddKiCadComponentsClick" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- The matched/unmatched report -->
				<Border x:Name="ReportPanel"
						BorderBrush="{DynamicResource Form_Border}"
						BorderThickness="1"
						Background="{DynamicResource Form_Bg}"
						Padding="12"
						IsVisible="False">
					<StackPanel Spacing="8">
						<TextBlock Text="What the KiCad data lines up with" FontWeight="Bold" />

						<!-- Which KiCad data the report read, when it is more than the draft's own files
						     (KiCadImportedFiles.ReportSourceLine). -->
						<TextBlock x:Name="ReportSourceText"
								   TextWrapping="Wrap"
								   FontSize="11"
								   Opacity="0.8"
								   IsVisible="False" />

						<TextBlock x:Name="ReportSummaryText"
								   TextWrapping="Wrap"
								   FontWeight="SemiBold" />

						<!-- The headline. Shown first and on its own, because a component in this
						     list highlights on the image and lights up no copper, with nothing
						     anywhere else in the app to say so. -->
						<StackPanel x:Name="UnmatchedPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="UnmatchedHeaderText" FontWeight="SemiBold" />
							<TextBlock TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8"
									   Text="These component labels have no component of the same name in the KiCad data. Rename them to match the KiCad reference (U17, not PLA/U17) or the traces will never appear." />
							<ItemsControl x:Name="UnmatchedList"
										  ItemTemplate="{StaticResource ReferenceBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>

						<StackPanel x:Name="MatchedPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="MatchedHeaderText" FontWeight="SemiBold" />
							<ItemsControl x:Name="MatchedList"
										  ItemTemplate="{StaticResource ReferenceBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>

						<StackPanel x:Name="UnusedPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="UnusedHeaderText" FontWeight="SemiBold" />
							<TextBlock TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8"
									   Text="Components the KiCad data knows about that this board has no label for yet - in other words, what is left to label." />
							<ItemsControl x:Name="UnusedList"
										  ItemTemplate="{StaticResource TodoReferenceBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>

						<StackPanel x:Name="ViewNamesPanel" Spacing="3" IsVisible="False">
							<TextBlock Text="KiCad views a picture can show" FontWeight="SemiBold" />
							<!-- Its text is ComponentPaneWording.KiCadViewsHint, set with the report - it names the
							     part as the Contribute tab's left column does. -->
							<TextBlock x:Name="ViewNamesHintText"
									   TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8" />
							<TextBlock x:Name="ViewNamesListText" TextWrapping="Wrap" FontSize="12" />
						</StackPanel>

						<!-- The "Important signals" rows naming a net the KiCad data does not have -
						     each one silently left out of the Schematics tab's panel, the same kind of
						     silent failure as a component that will not light up. -->
						<StackPanel x:Name="UnresolvedSignalsPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="UnresolvedSignalsHeaderText" FontWeight="SemiBold" />
							<TextBlock TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8"
									   Text="These rows of the board's &quot;Important signals&quot; sheet (display name: KiCad net name) name a net the KiCad data does not have, so the &quot;Schematics&quot; tab leaves them out. Use one of the nets below." />
							<ItemsControl x:Name="UnresolvedSignalsList"
										  ItemTemplate="{StaticResource ReferenceBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>

						<!-- Every net of the KiCad data (owner request, 2026-10-10) - what the logfile
						     listed as "normalized KiCad net name [...]". -->
						<StackPanel x:Name="NetNamesPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="NetNamesHeaderText" FontWeight="SemiBold" />
							<TextBlock x:Name="NetNamesIntroText"
									   TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8" />
							<ItemsControl x:Name="NetNamesList"
										  ItemTemplate="{StaticResource NetNameBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- What the last import or removal did. Its "please wait" is CRT's own (BusyOverlay.For finds
		     Main's) since the panel left its window. -->
		<TextBlock x:Name="StatusText"
				   Grid.Row="2"
				   Margin="4,8,0,0"
				   TextWrapping="Wrap"
				   FontSize="12" />
	</Grid>
</UserControl>
