<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRT"
        x:Class="CRT.DraftDriftWindow"
        Title="What changed in the published data"
        Width="700"
        Height="640"
        MinWidth="560"
        MinHeight="440"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<Grid RowDefinitions="Auto,*,Auto" Margin="18">

		<StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
			<TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Bold" />

			<TextBlock x:Name="SummaryText"
					   TextWrapping="Wrap"
					   Margin="0,4,0,0" />

			<!-- The two revisions, side by side and verbatim - a contributor comparing these
			     against the board's own revision line needs to see the same text the workbook
			     says, not a reformatted version of it. -->
			<Border Margin="0,10,0,0"
					Padding="10,8"
					Background="{DynamicResource Form_Bg}"
					BorderBrush="{DynamicResource Form_Border}"
					BorderThickness="1">
				<Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,4,Auto">
					<TextBlock Grid.Row="0" Grid.Column="0" Text="You started from:" Opacity="0.8" />
					<TextBlock Grid.Row="0" Grid.Column="2" x:Name="BaseRevisionText" FontWeight="SemiBold" />

					<TextBlock Grid.Row="2" Grid.Column="0" Text="Published data now:" Opacity="0.8" />
					<TextBlock Grid.Row="2" Grid.Column="2" x:Name="OfficialRevisionText" FontWeight="SemiBold" />
				</Grid>
			</Border>

			<!-- What the lists below compare - different for a draft with a base and one without. -->
			<TextBlock x:Name="ComparedText"
					   Margin="0,10,0,0"
					   TextWrapping="Wrap"
					   FontSize="11"
					   Opacity="0.75" />
		</StackPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="14">

				<!-- Rows the update AND the contributor changed - the only ones worth a look before
				     bringing the draft up to date (code review, 2026-10-13). -->
				<StackPanel x:Name="AttentionPanel" Spacing="6" IsVisible="False">
					<TextBlock x:Name="AttentionHeaderText" FontWeight="Bold" />
					<ItemsControl x:Name="AttentionItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="local:DriftRowItem">
								<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
										BorderThickness="0,0,0,1"
										Padding="4,6">
									<StackPanel Spacing="2">
										<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
										<TextBlock Text="{Binding Explanation}"
												   TextWrapping="Wrap"
												   FontSize="11"
												   Opacity="0.8" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<!-- The contributor's own changes. -->
				<StackPanel x:Name="OtherPanel" Spacing="6" IsVisible="False">
					<TextBlock x:Name="OtherHeaderText" FontWeight="Bold" />
					<ItemsControl x:Name="OtherItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="local:DriftRowItem">
								<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
										BorderThickness="0,0,0,1"
										Padding="4,6">
									<StackPanel Spacing="2">
										<TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
										<TextBlock Text="{Binding Explanation}"
												   TextWrapping="Wrap"
												   FontSize="11"
												   Opacity="0.8" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<!-- What the published update changed since the draft was copied. -->
				<StackPanel x:Name="UpdatePanel" Spacing="6" IsVisible="False">
					<TextBlock x:Name="UpdateHeaderText" FontWeight="Bold" />
					<ItemsControl x:Name="UpdateItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="local:DriftRowItem">
								<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
										BorderThickness="0,0,0,1"
										Padding="4,6">
									<StackPanel Spacing="2">
										<TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
										<TextBlock Text="{Binding Explanation}"
												   TextWrapping="Wrap"
												   FontSize="11"
												   Opacity="0.8" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<TextBlock x:Name="NoRowsText"
						   IsVisible="False"
						   TextWrapping="Wrap"
						   Opacity="0.8"
						   Text="You have not changed any rows of this board in your draft." />

			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
			<TextBlock x:Name="StatusText"
					   Grid.Column="0"
					   VerticalAlignment="Center"
					   TextWrapping="Wrap"
					   Margin="0,0,12,0"
					   FontSize="12" />

			<Button Grid.Column="1"
					Classes="Accept"
					x:Name="RebaseButton"
					Margin="0,0,8,0"
					Click="OnRebaseClick" />

			<Button Grid.Column="2"
					Content="Close"
					Click="OnCloseClick" />
		</Grid>

		<!-- Bringing a draft up to date reads two workbooks and may copy pictures - a wait the
		     contributor watches (CLAUDE.md: every such wait runs under BusyOverlay). The -18 margin
		     covers the grid's own margin. -->
		<local:BusyOverlay Grid.RowSpan="3" Margin="-18" />
	</Grid>
</Window>
