<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRT"
        x:Class="CRT.BoardFilesWindow"
        Title="Schematic images"
        Width="760"
        Height="640"
        MinWidth="620"
        MinHeight="480"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<Window.Styles>
		<Style Selector="Border.DropTarget">
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="Padding" Value="12" />
		</Style>

		<!-- One component reference in the match report. Each reference is its own badge rather
		     than a run in a comma-separated sentence: a board runs to hundreds of them, and in
		     prose "C1, C10, C100, C101" blurs into one line of text where no single reference
		     can be picked out by eye. -->
		<Style Selector="Border.ReferenceBadge">
			<Setter Property="Background" Value="{DynamicResource Draft_ReferenceBadge_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Draft_ReferenceBadge_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="Padding" Value="6,1" />
		</Style>

		<!-- The components left to label: IndianRed (owner request, 2026-10-10), so the to-do list
		     stands out from the components that already match. -->
		<Style Selector="Border.ReferenceBadge.Todo">
			<Setter Property="Background" Value="{DynamicResource Draft_ReferenceBadge_Todo_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Draft_ReferenceBadge_Todo_Border}" />
		</Style>
		<Style Selector="Border.ReferenceBadge.Todo > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Draft_ReferenceBadge_Todo_Fg}" />
		</Style>

		<!-- A KiCad net name an "Important signals" row already uses. -->
		<Style Selector="Border.ReferenceBadge.Used">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Success_Fg}" />
		</Style>
		<Style Selector="Border.ReferenceBadge.Used > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Text_Success_Fg}" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
	</Window.Styles>

	<Window.Resources>
		<!-- Shared by the component lists (not labelled / will not light up / match), so they cannot
		     drift into looking different. -->
		<DataTemplate x:Key="ReferenceBadgeTemplate">
			<Border Classes="ReferenceBadge">
				<TextBlock Text="{Binding}" FontSize="12" />
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="TodoReferenceBadgeTemplate">
			<Border Classes="ReferenceBadge Todo">
				<TextBlock Text="{Binding}" FontSize="12" />
			</Border>
		</DataTemplate>

		<!-- One KiCad net name: a click copies it (owner request, 2026-10-10), for pasting into the
		     "Important signals" sheet. -->
		<DataTemplate x:Key="NetNameBadgeTemplate" DataType="local:KiCadNetNameBadge">
			<!-- Focusable, and Enter or Space copies it too (code review, 2026-10-13). -->
			<Border Classes="ReferenceBadge NetName"
					Classes.Used="{Binding IsUsed}"
					Cursor="Hand"
					Focusable="True"
					ToolTip.Tip="{Binding ToolTipText}"
					Tapped="OnNetNameTapped"
					KeyDown="OnNetNameKeyDown">
				<TextBlock Text="{Binding Name}" FontSize="12" />
			</Border>
		</DataTemplate>

		<ItemsPanelTemplate x:Key="ReferenceBadgePanel">
			<WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4" />
		</ItemsPanelTemplate>
	</Window.Resources>

	<Grid RowDefinitions="Auto,*,Auto" Margin="18">

		<StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
			<TextBlock x:Name="HeaderText"
					   FontSize="16"
					   FontWeight="Bold" />
			<!-- Worded per section in code (Initialize) - the window shows ONE of the two. -->
			<TextBlock x:Name="IntroText" TextWrapping="Wrap" />
		</StackPanel>

		<!-- Named for the schematic row drag, which scrolls it when a row is held near its top or
		     bottom edge (BoardFilesWindow.SchematicOrder.cs). -->
		<ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="18">

				<!-- Schematic images - shown for BoardFilesSection.SchematicImages only -->
				<StackPanel x:Name="SchematicsSection" Spacing="6">
					<TextBlock Text="Schematic images" FontWeight="Bold" FontSize="14" />
					<TextBlock TextWrapping="Wrap"
							   FontSize="12"
							   Opacity="0.8"
							   Text="A photo, a scan or a PCB render - one per view you want to look at. The KiCad traces are drawn on top of these, so no image means no overlay. Drag an image up or down to change the order the views are listed in." />
					<TextBlock TextWrapping="Wrap"
							   FontSize="12"
							   Opacity="0.8"
							   Text="Under each image you can change its name - what the view is called in CRT - and pick its CAD name, the KiCad view its traces are drawn from. Each name can be used by one image only, so a picked CAD name disappears from the other images' lists." />

					<!-- Whether there are CAD names to pick (BoardFilesWindow.CadNames.cs). -->
					<TextBlock x:Name="CadNamesStateText"
							   TextWrapping="Wrap"
							   FontSize="12"
							   FontStyle="Italic"
							   Opacity="0.75"
							   IsVisible="False" />

					<Border Classes="DropTarget" x:Name="SchematicDropTarget">
						<StackPanel Spacing="8">
							<TextBlock Text="Drag image files here, or use the button below."
									   HorizontalAlignment="Center"
									   Opacity="0.75"
									   FontSize="12" />
							<Button x:Name="AddSchematicsButton"
									Content="Choose image files"
									HorizontalAlignment="Center"
									Click="OnAddSchematicsClick" />
						</StackPanel>
					</Border>

					<ItemsControl x:Name="SchematicsItemsControl">
						<!-- The rows are spaced by the PANEL rather than by a margin on each row, so a
						     row's container is exactly the row: the drag's placeholder takes the
						     container's height and fills the same gap, no more. -->
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="4" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="local:BoardSchematicRow">
								<Grid>

									<!-- Shown in place of the row while it is dragged: an empty dashed slot
									     the height of the row, marking where a drop will land - the worklog
									     photo rows' placeholder, drawn the same way. A Rectangle because only
									     shapes can dash their edge. -->
									<Panel IsVisible="{Binding IsDropPlaceholder}"
										   Height="{Binding PlaceholderHeight}">
										<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
												   StrokeThickness="2"
												   StrokeDashArray="4,3"
												   RadiusX="3"
												   RadiusY="3"
												   Fill="{DynamicResource Bg}" />
										<TextBlock Text="Move the image up/down and release mouse button for new location"
												   FontSize="11"
												   Opacity="0.7"
												   TextWrapping="Wrap"
												   TextAlignment="Center"
												   Margin="14,0"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center" />
									</Panel>

									<!-- Each image is its own panel (owner request, 2026-09-27), like a
									     worklog photo row. -->
									<Border IsVisible="{Binding IsNotDropPlaceholder}"
											Background="{DynamicResource Form_Bg}"
											BorderBrush="{DynamicResource Form_Border}"
											BorderThickness="1"
											CornerRadius="3"
											Padding="8,6">
										<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

											<!-- The drag handle: the whole row but its Remove button, which
											     handles its own press and so never starts a drag, and the CAD
											     name line under it. Background must be set, or the blank space
											     between the texts is not hit-testable. No tooltip, as on the
											     worklog rows: the north/south cursor already says the row can
											     be moved. -->
											<Grid Grid.Column="0"
												  Grid.Row="0"
												  Classes="SchematicDragHandle"
												  ColumnDefinitions="Auto,Auto,*"
												  Background="Transparent"
												  Cursor="SizeNorthSouth"
												  PointerPressed="OnSchematicRowPointerPressed">

												<!-- The grip: says at a glance that the panel can be moved
												     (owner request, 2026-09-27) - the cursor alone only says
												     so once the pointer is on it. Font Awesome "grip-vertical",
												     whose outline fits the font's ascent exactly, so it is not
												     clipped at the top. Faint, like the table editor's grip:
												     it marks the handle without competing with the image. -->
												<TextBlock Grid.Column="0"
														   Classes="SchematicDragGrip"
														   Text="&#xf58e;"
														   FontFamily="{DynamicResource FontAwesomeSolid}"
														   FontSize="16"
														   Opacity="0.55"
														   Margin="2,0,12,0"
														   VerticalAlignment="Center"
														   ToolTip.Tip="Drag up or down to change the order" />

												<!-- The preview. A fixed 80x60 box whichever way the image is
												     shaped, so the names beside it line up down the list
												     instead of stepping in and out with each aspect ratio.
												     Uniform keeps the picture undistorted inside it. -->
												<Border Grid.Column="1"
														Width="80"
														Height="60"
														Margin="0,0,10,0"
														VerticalAlignment="Center"
														BorderBrush="{DynamicResource Table_BorderRowLine}"
														BorderThickness="1"
														Background="{DynamicResource Bg}">
													<Panel>
														<Image Source="{Binding Thumbnail}"
															   Stretch="Uniform"
															   Margin="2"
															   IsVisible="{Binding HasThumbnail}" />

														<!-- A draft can name an image whose file was moved or
														     deleted by hand. Saying so is more use than an
														     empty box. -->
														<TextBlock Text="No preview"
																   FontSize="10"
																   Opacity="0.6"
																   TextWrapping="Wrap"
																   TextAlignment="Center"
																   HorizontalAlignment="Center"
																   VerticalAlignment="Center"
																   IsVisible="{Binding IsMissing}" />
													</Panel>
												</Border>

												<StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
													<TextBlock Text="{Binding SchematicName}" FontWeight="SemiBold" />
													<TextBlock Text="{Binding DetailText}"
															   FontSize="11"
															   Opacity="0.75"
															   TextWrapping="Wrap" />
												</StackPanel>
											</Grid>

											<Button Grid.Column="1"
													Classes="Danger"
													Grid.Row="0"
													Content="Remove"
													Margin="10,0,0,0"
													VerticalAlignment="Center"
													Tag="{Binding}"
													Click="OnRemoveSchematicClick" />

											<!-- The image's NAME and its CAD name (owner requests, 2026-10-10), one under the
											     other with their boxes lined up, under the image's name. OUTSIDE the drag handle,
											     so typing a name or opening the list never starts a drag.

											     Name: the "Schematic name" column. Saved on Enter or on leaving the box, Escape
											     puts it back (BoardFilesWindow.SchematicNames.cs).

											     CAD name: the KiCad view this image's traces are drawn from, picked from the
											     board's KiCad data. A name another image has is not listed at all
											     (SchematicCadNameChoices). -->
											<Grid Grid.Column="0"
											      Grid.ColumnSpan="2"
											      Grid.Row="1"
											      ColumnDefinitions="Auto,Auto"
											      RowDefinitions="Auto,Auto"
											      ColumnSpacing="8"
											      RowSpacing="6"
											      HorizontalAlignment="Left"
											      Margin="120,6,0,0">
												<TextBlock Grid.Row="0"
														   Grid.Column="0"
														   Text="Name"
														   FontSize="12"
														   Opacity="0.75"
														   VerticalAlignment="Center" />
												<TextBox Grid.Row="0"
														 Grid.Column="1"
														 Classes="SchematicNameBox"
														 Width="300"
														 FontSize="12"
														 Text="{Binding NameDraft}"
														 KeyDown="OnSchematicNameKeyDown"
														 LostFocus="OnSchematicNameLostFocus" />
												<TextBlock Grid.Row="1"
														   Grid.Column="0"
														   Text="CAD name"
														   FontSize="12"
														   Opacity="0.75"
														   VerticalAlignment="Center" />
												<ComboBox Grid.Row="1"
														  Grid.Column="1"
														  Classes="CadNamePicker"
														  Width="300"
														  FontSize="12"
														  ItemsSource="{Binding CadNameChoices}"
														  SelectedItem="{Binding SelectedCadNameChoice}">
													<ComboBox.ItemTemplate>
														<DataTemplate DataType="local:CadNameChoiceItem">
															<TextBlock Text="{Binding Label}" />
														</DataTemplate>
													</ComboBox.ItemTemplate>
												</ComboBox>
											</Grid>
										</Grid>
									</Border>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock x:Name="NoSchematicsText"
							   Text="No schematic images yet."
							   FontSize="12"
							   Opacity="0.75" />
				</StackPanel>

				<!-- KiCad data - shown for BoardFilesSection.KiCadData only, together with the match
				     report below it -->
				<StackPanel x:Name="KiCadSection" Spacing="6">
					<TextBlock Text="KiCad data" FontWeight="Bold" FontSize="14" />
					<TextBlock TextWrapping="Wrap"
							   FontSize="12"
							   Opacity="0.8"
							   Text="Optional. Pick the folder holding the project's .kicad_pcb and .kicad_sch files. Sub-folders are searched too, so a multi-sheet project keeps its pages - footprint libraries, 3D models and gerbers are left behind." />

					<Border Classes="DropTarget" x:Name="KiCadDropTarget">
						<StackPanel Spacing="8">
							<TextBlock Text="Drag the KiCad folder here, or use the button below."
									   HorizontalAlignment="Center"
									   Opacity="0.75"
									   FontSize="12" />
							<Button x:Name="ImportKiCadButton"
									Content="Choose KiCad folder"
									HorizontalAlignment="Center"
									Click="OnImportKiCadClick" />
						</StackPanel>
					</Border>

					<TextBlock x:Name="KiCadStateText"
							   FontSize="12"
							   TextWrapping="Wrap"
							   Opacity="0.75" />

					<!-- The files themselves. A count alone ("25 KiCad files imported") said nothing
					     about WHICH project had been imported, so a contributor reopening this
					     window could not tell the right folder from the wrong one.

					     Every file is shown, at full height, with NO scroller of its own. It used to
					     be capped at 150px inside its own ScrollViewer, which put a scroll area
					     inside the window's scroll area - the wheel scrolled whichever one the
					     pointer happened to be over, and the list's own bar sat hard against the
					     window's (owner report, 2026-09-24). The window's ScrollViewer already
					     carries anything that does not fit, so a long list only means scrolling
					     the window further. -->
					<Border x:Name="KiCadFilesPanel"
							IsVisible="False"
							BorderBrush="{DynamicResource Form_Border}"
							BorderThickness="1"
							Background="{DynamicResource Form_Bg}"
							Padding="8,6">
						<ItemsControl x:Name="KiCadFilesItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="local:BoardKiCadFileRow">
									<!-- Remove is per file, like a schematic image's - but compact, since a
									     multi-sheet project lists 25+ of these and a full-size button on
									     every line would crowd out the file names. Same destructive
									     colours as the schematic Remove, so the two read as one action. -->
									<Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
										<TextBlock Grid.Column="0"
												   Text="{Binding RelativePath}"
												   FontSize="11"
												   FontFamily="Consolas,Menlo,monospace"
												   TextWrapping="NoWrap"
												   VerticalAlignment="Center" />
										<TextBlock Grid.Column="1"
												   Text="{Binding SizeText}"
												   FontSize="11"
												   Opacity="0.6"
												   Margin="12,0,0,0"
												   VerticalAlignment="Center" />
										<Button Grid.Column="2"
												Classes="Danger"
												Content="Remove"
												FontSize="11"
												Padding="8,1"
												Margin="12,0,0,0"
												VerticalAlignment="Center"
												Tag="{Binding}"
												Click="OnRemoveKiCadFileClick" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Border>
				</StackPanel>

				<!-- The matched/unmatched report -->
				<Border x:Name="ReportPanel"
						BorderBrush="{DynamicResource Form_Border}"
						BorderThickness="1"
						Background="{DynamicResource Form_Bg}"
						Padding="12"
						IsVisible="False">
					<StackPanel Spacing="8">
						<TextBlock Text="What the KiCad data lines up with" FontWeight="Bold" />

						<!-- Which KiCad data the report read, when it is more than the draft's own files
						     (KiCadImportedFiles.ReportSourceLine). -->
						<TextBlock x:Name="ReportSourceText"
								   TextWrapping="Wrap"
								   FontSize="11"
								   Opacity="0.8"
								   IsVisible="False" />

						<TextBlock x:Name="ReportSummaryText"
								   TextWrapping="Wrap"
								   FontWeight="SemiBold" />

						<!-- The headline. Shown first and on its own, because a component in this
						     list highlights on the image and lights up no copper, with nothing
						     anywhere else in the app to say so. -->
						<StackPanel x:Name="UnmatchedPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="UnmatchedHeaderText" FontWeight="SemiBold" />
							<TextBlock TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8"
									   Text="These component labels have no component of the same name in the KiCad data. Rename them to match the KiCad reference (U17, not PLA/U17) or the traces will never appear." />
							<ItemsControl x:Name="UnmatchedList"
										  ItemTemplate="{StaticResource ReferenceBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>

						<StackPanel x:Name="MatchedPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="MatchedHeaderText" FontWeight="SemiBold" />
							<ItemsControl x:Name="MatchedList"
										  ItemTemplate="{StaticResource ReferenceBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>

						<StackPanel x:Name="UnusedPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="UnusedHeaderText" FontWeight="SemiBold" />
							<TextBlock TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8"
									   Text="Components the KiCad data knows about that this board has no label for yet - in other words, what is left to label." />
							<ItemsControl x:Name="UnusedList"
										  ItemTemplate="{StaticResource TodoReferenceBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>

						<StackPanel x:Name="ViewNamesPanel" Spacing="3" IsVisible="False">
							<TextBlock Text="CAD names you can use" FontWeight="SemiBold" />
							<TextBlock TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8"
									   Text="Each of these can back one schematic image with the KiCad data. Pick it as the image's CAD name in the &quot;Schematic images&quot; window - &quot;Pictures&quot; on the left of the Contribute tab." />
							<TextBlock x:Name="ViewNamesListText" TextWrapping="Wrap" FontSize="12" />
						</StackPanel>

						<!-- The "Important signals" rows naming a net the KiCad data does not have -
						     each one silently left out of the Schematics tab's panel, the same kind of
						     silent failure as a component that will not light up. -->
						<StackPanel x:Name="UnresolvedSignalsPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="UnresolvedSignalsHeaderText" FontWeight="SemiBold" />
							<TextBlock TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8"
									   Text="These rows of the board's &quot;Important signals&quot; sheet (display name: KiCad net name) name a net the KiCad data does not have, so the Schematics tab leaves them out. Use one of the net names below." />
							<ItemsControl x:Name="UnresolvedSignalsList"
										  ItemTemplate="{StaticResource ReferenceBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>

						<!-- Every net name of the KiCad data (owner request, 2026-10-10) - what the
						     logfile listed as "normalized KiCad net name [...]", each one copied by a
						     click for the "Important signals" sheet. -->
						<StackPanel x:Name="NetNamesPanel" Spacing="3" IsVisible="False">
							<TextBlock x:Name="NetNamesHeaderText" FontWeight="SemiBold" />
							<TextBlock x:Name="NetNamesIntroText"
									   TextWrapping="Wrap"
									   FontSize="11"
									   Opacity="0.8" />
							<ItemsControl x:Name="NetNamesList"
										  ItemTemplate="{StaticResource NetNameBadgeTemplate}"
										  ItemsPanel="{StaticResource ReferenceBadgePanel}" />
						</StackPanel>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
			<TextBlock x:Name="StatusText"
					   Grid.Column="0"
					   VerticalAlignment="Center"
					   TextWrapping="Wrap"
					   FontSize="12" />
			<Button Grid.Column="1"
					Content="Close"
					Click="OnCloseClick" />
		</Grid>

		<!-- "Please wait" over this window while images or KiCad files are copied and checked
		     (2026-09-28) - see BusyOverlay. The -18 margin covers the grid's own margin. -->
		<local:BusyOverlay Grid.RowSpan="3" Margin="-18" />
	</Grid>
</Window>
