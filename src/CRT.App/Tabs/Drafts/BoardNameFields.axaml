<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="clr-namespace:Handlers.DataHandling;assembly=CRT.Data"
             x:Class="CRT.BoardNameFields">

	<!-- A board's manufacturer, hardware, board and notes - ONE form for "Add a new board"
	     (NewBoardWindow) and the Contribute tab's "Board name" (BoardNamePanel). -->
	<StackPanel Spacing="4">
		<TextBlock Text="Manufacturer" FontWeight="SemiBold" />
		<TextBlock Text="The company that made it, for example Commodore. This becomes the top folder your board is stored in."
				   TextWrapping="Wrap"
				   FontSize="11"
				   Opacity="0.75"
				   Margin="0,0,0,2" />
		<AutoCompleteBox x:Name="ManufacturerBox"
						 FilterMode="ContainsOrdinal"
						 MinimumPrefixLength="0"
						 PlaceholderText="Commodore" />

		<!-- "Did you mean Commodore?" (CRT 4.0 step 3, slice 3e - the plan: "Did you mean Commodore?
		     when a typed name is close to an existing one"): offered under the box, never in the way -
		     the name typed may be a new one. SimilarNames decides. -->
		<StackPanel x:Name="ManufacturerDidYouMeanPanel" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="False">
			<TextBlock x:Name="ManufacturerDidYouMeanText" VerticalAlignment="Center" FontWeight="SemiBold" />
			<Button x:Name="ManufacturerDidYouMeanButton" />
		</StackPanel>

		<TextBlock Text="Hardware" FontWeight="SemiBold" Margin="0,10,0,0" />
		<TextBlock Text="The machine itself, as CRT's hardware list names it - for example Commodore 64 or Amiga 500."
				   TextWrapping="Wrap"
				   FontSize="11"
				   Opacity="0.75"
				   Margin="0,0,0,2" />
		<TextBox x:Name="HardwareBox" PlaceholderText="Commodore 64" />

		<StackPanel x:Name="HardwareDidYouMeanPanel" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" IsVisible="False">
			<TextBlock x:Name="HardwareDidYouMeanText" VerticalAlignment="Center" FontWeight="SemiBold" />
			<Button x:Name="HardwareDidYouMeanButton" />
		</StackPanel>

		<TextBlock Text="Board" FontWeight="SemiBold" Margin="0,10,0,0" />
		<TextBlock Text="The board revision, for example 250407. If you do not know it, use something that identifies the board to you."
				   TextWrapping="Wrap"
				   FontSize="11"
				   Opacity="0.75"
				   Margin="0,0,0,2" />
		<TextBox x:Name="BoardBox" PlaceholderText="250407" />

		<TextBlock x:Name="NotesHeading" Text="Notes (optional)" FontWeight="SemiBold" Margin="0,10,0,0" />
		<!-- Sent with the submission (owner request, 2026-10-05): the maintainer's placement of the
		     board starts with it, and the placement saved is what goes into the main Excel data
		     file's notes column - so the maintainer may still change it. At most that column's
		     length (MaxLength below; the server refuses more). -->
		<TextBlock x:Name="NotesHint"
				   Text="Anything worth knowing about this hardware. Sent with the submission - the maintainer checks it when adding the board to CRT's list of hardware and boards, and it is then shown on the &quot;Overview&quot; tab."
				   TextWrapping="Wrap"
				   FontSize="11"
				   Opacity="0.75"
				   Margin="0,0,0,2" />
		<TextBox x:Name="NotesBox"
				 MaxLength="{x:Static data:MasterListing.MaximumNotesLength}"
				 AcceptsReturn="True"
				 TextWrapping="Wrap"
				 Height="60" />
	</StackPanel>
</UserControl>
