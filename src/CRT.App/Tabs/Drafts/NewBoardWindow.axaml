<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRT"
        x:Class="CRT.NewBoardWindow"
        Title="Add a new board"
        Width="560"
        MinWidth="480"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">
		<TextBlock Text="Add a new board"
				   FontSize="16"
				   FontWeight="Bold"
				   Margin="0,0,0,10" />

		<TextBlock TextWrapping="Wrap"
				   Text="This creates a new, empty board in your own local drafts. It appears in the hardware and board lists straight away, and you build it up exactly like editing any other board - add schematic images, label the components, attach files." />

		<TextBlock TextWrapping="Wrap"
				   Margin="0,8,0,12"
				   Text="Nothing is shared with anyone until you submit it. A board you never submit stays yours and keeps working locally." />

		<!-- Manufacturer, hardware, board and notes, with every rule about them - the Contribute tab's
		     "Board name" shows the same (2026-11-01). -->
		<local:BoardNameFields x:Name="Fields" />

		<!-- A live preview of what is about to be created, so the folder layout is never a surprise
		     and a typo in a name is visible before it becomes a folder on disk. -->
		<Border Margin="0,14,0,0"
				Padding="10,8"
				Background="{DynamicResource Form_Bg}"
				BorderBrush="{DynamicResource Form_Border}"
				BorderThickness="1">
			<StackPanel Spacing="3">
				<TextBlock Text="This will create"
						   FontSize="11"
						   FontWeight="SemiBold"
						   Opacity="0.75" />
				<TextBlock x:Name="PreviewText"
						   TextWrapping="Wrap"
						   FontSize="12" />
			</StackPanel>
		</Border>

		<!-- Hidden until there is something to say - an always-present empty line would push the
		     buttons down and read as a rendering fault. -->
		<TextBlock x:Name="ValidationText"
				   TextWrapping="Wrap"
				   Margin="0,10,0,0"
				   IsVisible="False"
				   FontWeight="Bold"
				   Foreground="{DynamicResource Text_Fail_Fg}" />

		<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Cancel" Click="OnCancelClick" />
			<Button x:Name="CreateButton"
					Classes="Accept"
					Content="Create board"
					IsEnabled="False"
					Click="OnCreateClick" />
		</StackPanel>
	</StackPanel>
</Window>
