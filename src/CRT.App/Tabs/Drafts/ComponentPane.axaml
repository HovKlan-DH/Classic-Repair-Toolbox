<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             xmlns:data="clr-namespace:Handlers.DataHandling;assembly=CRT.Data"
             x:Class="CRT.ComponentPane">

	<!-- THE COMPONENT PANE (CRT 4.0 step 2, 2026-10-25 - the plan: "A component opens in a pane, never
	     in a maximized window"). On the right of the Contribute tab; every change goes into the draft
	     as it is made (ComponentPane.axaml.cs). -->
	<UserControl.Styles>
		<Style Selector="TextBlock.PaneHeading">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>

		<Style Selector="TextBlock.PaneIntro">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>

		<Style Selector="TextBlock.FieldLabel">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Margin" Value="0,6,0,2" />
		</Style>

		<Style Selector="TextBlock.EmptyLine">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<!-- The counter under the short description - the warning colour once it is over the limit. -->
		<Style Selector="TextBlock.Counter">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>

		<Style Selector="TextBlock.Counter.over">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource Text_Warning_Fg}" />
		</Style>

		<!-- A file of the board, opened by a click on its name - a link, not a button's box. -->
		<Style Selector="Button.PaneLink">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Button.PaneLink /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Button.PaneLink:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">

		<!-- What is open, whether the draft changed it, and the ways out. -->
		<Border Grid.Row="0"
				BorderBrush="{DynamicResource Table_BorderRowLine}"
				BorderThickness="0,0,0,1"
				Padding="4,0,0,8">
			<Grid ColumnDefinitions="*,Auto">
				<StackPanel Grid.Column="0" Spacing="2">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock x:Name="TitleText"
								   FontSize="16"
								   FontWeight="Bold"
								   TextWrapping="Wrap"
								   VerticalAlignment="Center" />

						<!-- The draft holds a change to this component - the published board reads otherwise. -->
						<Border x:Name="ChangedMark"
								IsVisible="False"
								Background="{DynamicResource Draft_Chip_Bg}"
								BorderBrush="{DynamicResource Draft_Chip_Border}"
								BorderThickness="1"
								CornerRadius="3"
								Padding="5,1"
								VerticalAlignment="Center"
								ToolTip.Tip="Your draft changes this component - the published board reads otherwise until your draft is submitted and published">
							<TextBlock Text="Changed" FontSize="11" Foreground="{DynamicResource Draft_Chip_Fg}" />
						</Border>
					</StackPanel>
					<TextBlock x:Name="RegionText"
							   FontSize="11"
							   Opacity="0.75"
							   TextWrapping="Wrap" />

					<!-- What an action could not do - a picked file CRT cannot show, a capture that brought nothing. -->
					<TextBlock x:Name="PaneMessageText"
							   IsVisible="False"
							   FontSize="12"
							   Foreground="{DynamicResource Text_Warning_Fg}"
							   TextWrapping="Wrap" />

					<!-- What can be done with the component as a whole (slice 3c - the plan: "[Show on board]
					     [Preview popup] [Undo changes]"). -->
					<WrapPanel x:Name="ActionsPanel" Orientation="Horizontal" Margin="0,6,0,0">
						<Button x:Name="ShowOnBoardButton"
								Content="Show on board"
								Margin="0,0,8,4"
								ToolTip.ShowOnDisabled="True"
								Click="OnShowOnBoardClick" />
						<!-- The same part's data from another board on this machine (slice 5). -->
						<Button x:Name="CopyFromOtherBoardButton"
								Content="Copy from another board"
								Margin="0,0,8,4"
								ToolTip.Tip="Take the package, pins, replacement parts, notes or links from the same part - the same part number - on another board"
								Click="OnCopyFromOtherBoardClick" />
						<!-- What this draft changed of the part, on the same part of the other boards (slice 5). -->
						<Button x:Name="AlsoOnOtherBoardsButton"
								Content="Also on other boards"
								Margin="0,0,8,4"
								IsVisible="False"
								ToolTip.Tip="Make the same change on the other boards, each in its own draft - to the same part (the same part number), and to the files you replaced where another board has the same file"
								Click="OnAlsoOnOtherBoardsClick" />
						<!-- The popup as it will look once the draft is published - from the draft, now. -->
						<Button x:Name="PreviewPopupButton"
								Content="Preview popup"
								Margin="0,0,8,4"
								ToolTip.Tip="Open the popup this component gets when it is pointed at on the board - as your draft has it now, which is what will be published"
								Click="OnPreviewPopupClick" />
						<!-- One component back as published - one step, so Undo brings the changes back. -->
						<Button x:Name="UndoChangesButton"
								Classes="Danger"
								IsVisible="False"
								Margin="0,0,8,4"
								ToolTip.Tip="Put this component back as it is published - every change your draft makes to it. Undo brings them back."
								Click="OnUndoChangesClick" />
						<!-- The component taken off the board - one step, so Undo brings it back. -->
						<Button x:Name="DeleteComponentButton"
								Classes="Danger"
								Margin="0,0,8,4"
								Click="OnDeleteComponentClick" />
					</WrapPanel>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
					<Button x:Name="CloseButton"
							Content="Close"
							ToolTip.Tip="Close the component - every change is in your draft already"
							Click="OnCloseClick" />
				</StackPanel>
			</Grid>
		</Border>

		<!-- The component is gone from the draft - deleted, or an undo took away the change that added it. -->
		<StackPanel Grid.Row="1" x:Name="GonePanel" IsVisible="False" Margin="4,12,0,0" Spacing="6">
			<TextBlock x:Name="GoneText" TextWrapping="Wrap" />
			<!-- Offered while the step that deleted it is the latest one - Undo of that step. -->
			<Button x:Name="BringBackButton"
					Classes="Accept"
					IsVisible="False"
					HorizontalAlignment="Left"
					Click="OnBringBackClick" />
		</StackPanel>

		<!-- A NEW COMPONENT (slice 3c): named first - its label is what every other row of it is filed
		     under - and added to the draft as one step; then the pane shows it like any other. -->
		<ScrollViewer Grid.Row="1" x:Name="NewComponentPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="4,12,12,12" MaxWidth="560" HorizontalAlignment="Left">
				<TextBlock Classes="PaneIntro"
						   Text="Name the component as it is printed on the board - its label. Everything else is filled in once it is added, and Undo takes it away again." />

				<TextBlock Classes="FieldLabel" Text="Board label" />
				<TextBox x:Name="NewLabelBox" Watermark="U8, C12, R3" />
				<TextBlock x:Name="NewLabelProblemText"
						   IsVisible="False"
						   Margin="0,4,0,0"
						   Foreground="{DynamicResource Text_Warning_Fg}"
						   TextWrapping="Wrap" />

				<!-- Only on a board with components of their own per region. -->
				<StackPanel x:Name="NewRegionPanel">
					<TextBlock Classes="FieldLabel" Text="Region" />
					<ComboBox x:Name="NewRegionBox" Width="200" />
				</StackPanel>

				<TextBlock Classes="FieldLabel" Text="Category" />
				<AutoCompleteBox x:Name="NewCategoryBox"
								 FilterMode="Contains"
								 MinimumPrefixLength="0"
								 IsTextCompletionEnabled="False"
								 PlaceholderText="Capacitor, IC, Resistor"
								 HorizontalAlignment="Stretch" />
				<TextBlock x:Name="NewCategoryNoteText"
						   Classes="EmptyLine"
						   Margin="0,4,0,0"
						   IsVisible="False" />

				<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
					<Button x:Name="AddNewComponentButton"
							Classes="Accept"
							Content="Add component"
							IsEnabled="False"
							Click="OnAddNewComponentClick" />
					<Button x:Name="CancelNewComponentButton"
							Content="Cancel"
							ToolTip.Tip="Add nothing and close"
							Click="OnCloseClick" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<!-- The sections take the room there is, up to a readable width, from the left: a star column
		     with a MaxWidth (a left-aligned panel would shrink to its widest content). -->
		<ScrollViewer Grid.Row="1" x:Name="SectionsScrollViewer" HorizontalScrollBarVisibility="Disabled">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MaxWidth="980" />
					<ColumnDefinition Width="0.001*" />
				</Grid.ColumnDefinitions>
			<StackPanel x:Name="SectionsPanel" Grid.Column="0" Spacing="18" Margin="4,12,12,12">

				<!-- ==== Copy from another board (slice 5) - open while picking ==== -->
				<Border x:Name="CopyPanel"
						IsVisible="False"
						BorderBrush="{DynamicResource Form_Border}"
						BorderThickness="1"
						CornerRadius="3"
						Padding="12,10">
					<StackPanel Spacing="6">
						<TextBlock Classes="PaneHeading" Text="Copy from another board" />
						<TextBlock x:Name="CopyIntroText" Classes="PaneIntro" />
						<ComboBox x:Name="CopySourceBox"
								  HorizontalAlignment="Stretch"
								  SelectionChanged="OnCopySourceChanged" />
						<StackPanel x:Name="CopyPartsPanel" Spacing="2" />
						<TextBlock x:Name="CopyNothingText"
								   Classes="EmptyLine"
								   IsVisible="False"
								   Text="That component has nothing to copy - no package, notes, pins, replacement parts or links." />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button x:Name="CopyButton"
									Classes="Accept"
									Content="Copy"
									ToolTip.Tip="Put what is ticked into this component - one step, so Undo takes it back"
									Click="OnCopyClick" />
							<Button x:Name="CancelCopyButton"
									Content="Cancel"
									Click="OnCancelCopyClick" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ==== Also on other boards (slice 5) - open while picking ==== -->
				<Border x:Name="AlsoPanel"
						IsVisible="False"
						BorderBrush="{DynamicResource Form_Border}"
						BorderThickness="1"
						CornerRadius="3"
						Padding="12,10">
					<StackPanel Spacing="6">
						<TextBlock Classes="PaneHeading" Text="Also on other boards" />
						<!-- The same part - the same part number - on the other boards. -->
						<StackPanel x:Name="AlsoPartsSection" Spacing="6">
							<TextBlock x:Name="AlsoIntroText" Classes="PaneIntro" />
							<TextBlock Classes="FieldLabel" Text="The boards" />
							<StackPanel x:Name="AlsoBoardsPanel" Spacing="2" />
							<TextBlock Classes="FieldLabel" Text="What to change there" />
							<StackPanel x:Name="AlsoPartsPanel" Spacing="2" />
						</StackPanel>
						<!-- The files the draft replaced, on the boards with the same file (the plan: "This
						     datasheet is also used by 11 other boards - change it there too?"). -->
						<StackPanel x:Name="AlsoFilesSection" Spacing="6" Margin="0,8,0,0">
							<TextBlock x:Name="AlsoFilesIntroText" Classes="PaneIntro" />
							<StackPanel x:Name="AlsoFilesPanel" Spacing="2" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button x:Name="AlsoChangeButton"
									Classes="Accept"
									Content="Change them too"
									ToolTip.Tip="Put what is ticked into each ticked board's own draft - one step there, reviewed by that board's maintainers"
									Click="OnAlsoChangeClick" />
							<Button x:Name="CancelAlsoButton"
									Content="Cancel"
									Click="OnCancelAlsoClick" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ==== Basics ==== -->
				<StackPanel>
					<TextBlock Classes="PaneHeading" Text="Basics" />
					<TextBlock Classes="PaneIntro"
							   Text="What the component is. The popup on the board shows these when the component is pointed at." />

					<Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto">
						<StackPanel Grid.Row="0" Grid.Column="0">
							<TextBlock Classes="FieldLabel" Text="Friendly name" />
							<TextBox x:Name="FriendlyNameBox" Watermark="VIC-II, SID, Kernal ROM" />
						</StackPanel>
						<StackPanel Grid.Row="0" Grid.Column="2">
							<TextBlock Classes="FieldLabel" Text="Technical name or value" />
							<TextBox x:Name="TechnicalNameBox" Watermark="6569, 74LS08, 10uF" />
						</StackPanel>
						<StackPanel Grid.Row="1" Grid.Column="0">
							<TextBlock Classes="FieldLabel" Text="Part number" />
							<TextBox x:Name="PartNumberBox" Watermark="The number printed on it" />
						</StackPanel>
						<StackPanel Grid.Row="1" Grid.Column="2">
							<TextBlock Classes="FieldLabel" Text="Category" />
							<!-- The board's own categories as you type - the component list groups by the exact
							     word, so "Capacitors" beside "Capacitor" would split one group in two. -->
							<AutoCompleteBox x:Name="CategoryBox"
											 FilterMode="Contains"
											 MinimumPrefixLength="0"
											 IsTextCompletionEnabled="False"
											 PlaceholderText="Capacitor, IC, Resistor"
											 HorizontalAlignment="Stretch" />
						</StackPanel>
						<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
							<TextBlock Classes="FieldLabel" Text="Short description" />
							<TextBox x:Name="DescriptionBox"
									 Watermark="One line - what the popup shows first" />
							<TextBlock x:Name="DescriptionCounter" Classes="Counter" />
						</StackPanel>
						<StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
							<TextBlock Classes="FieldLabel" Text="Repair notes" />
							<TextBox x:Name="RepairNotesBox"
									 AcceptsReturn="True"
									 TextWrapping="Wrap"
									 MinHeight="80"
									 Watermark="What usually goes wrong with it, how to test it, what to look out for - links are fine" />
						</StackPanel>
					</Grid>
				</StackPanel>

				<!-- ==== Pinout ==== -->
				<StackPanel>
					<TextBlock Classes="PaneHeading" Text="Pinout" />
					<TextBlock Classes="PaneIntro"
							   Text="The case and what each pin is for. Pick the case, and CRT draws it from above, notch at the top." />

					<StackPanel Orientation="Horizontal" Spacing="8">
						<StackPanel Width="200">
							<TextBlock Classes="FieldLabel" Text="Package" />
							<AutoCompleteBox x:Name="PackageBox"
											 FilterMode="Contains"
											 MinimumPrefixLength="0"
											 IsTextCompletionEnabled="False"
											 PlaceholderText="DIP-40, TO-92"
											 HorizontalAlignment="Stretch" />
						</StackPanel>
						<!-- Every pin number of the case not listed yet, added - offered once a case with
						     a known count is picked and some of its pins are missing. -->
						<Button x:Name="AddCasePinsButton"
								Classes="Accept"
								VerticalAlignment="Bottom"
								IsVisible="False"
								Click="OnAddCasePinsClick" />
						<!-- The pins the board's KiCad data has for the component, with their names - offered
						     while it has any (ComponentPane.KiCadPins.cs). -->
						<Button x:Name="FillFromKiCadButton"
								Classes="Accept"
								Content="Fill from KiCad"
								VerticalAlignment="Bottom"
								IsVisible="False"
								ToolTip.ShowOnDisabled="True"
								Click="OnFillFromKiCadClick" />
					</StackPanel>

					<Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
						<local:PinoutDrawing x:Name="PinoutPicture"
											 Grid.Column="0"
											 Margin="0,0,16,0"
											 VerticalAlignment="Top"
											 IsVisible="False" />

						<!-- The headings' button column as wide as the rows' (a shared size group). -->
						<StackPanel Grid.Column="1" Spacing="4" Grid.IsSharedSizeScope="True">
							<TextBlock x:Name="NoPinsText"
									   Classes="EmptyLine"
									   Text="No pins yet. Pick the case above and add its pins, or add them one by one." />

							<Grid x:Name="PinsHeading">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="60" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="140" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="PinNets" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="PinButtons" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Pin" />
								<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Signal name" />
								<TextBlock Grid.Column="4" Classes="FieldLabel" Text="Direction" />
								<!-- The net of each pin on this board, from its KiCad data - shown, never stored. -->
								<TextBlock x:Name="PinNetHeading"
										   Grid.Column="6"
										   Classes="FieldLabel"
										   Margin="0,0,8,0"
										   Text="Net on this board"
										   IsVisible="False" />
							</Grid>

							<ItemsControl x:Name="PinsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ComponentPanePinRow">
										<Grid Margin="0,0,0,4">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="60" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="PinNets" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="PinButtons" />
											</Grid.ColumnDefinitions>
											<TextBox Grid.Column="0" Text="{Binding Pin, Mode=TwoWay}" />
											<TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" Watermark="VCC, A0, ~RESET" />
											<ComboBox Grid.Column="4"
													  HorizontalAlignment="Stretch"
													  ItemsSource="{Binding DirectionChoices}"
													  SelectedItem="{Binding Direction, Mode=TwoWay}"
													  PlaceholderText="Direction" />
											<TextBlock Grid.Column="6"
													   Text="{Binding Net}"
													   IsVisible="{Binding HasNet}"
													   MaxWidth="180"
													   Margin="0,0,8,0"
													   VerticalAlignment="Center"
													   FontSize="11"
													   Opacity="0.75"
													   TextTrimming="CharacterEllipsis"
													   ToolTip.Tip="{Binding Net}" />
											<Button Grid.Column="7"
													Classes="Danger"
													Content="Remove"
													Tag="{Binding}"
													ToolTip.Tip="Remove this pin"
													Click="OnRemovePinClick" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Button x:Name="AddPinButton"
									Classes="Accept"
									Content="Add pin"
									HorizontalAlignment="Left"
									Click="OnAddPinClick" />
						</StackPanel>
					</Grid>
				</StackPanel>

				<!-- ==== Scope baselines (slice 3b) ==== -->
				<StackPanel Spacing="4">
					<TextBlock x:Name="BaselinesHeading" Classes="PaneHeading" Text="Scope baselines" />
					<TextBlock Classes="PaneIntro"
							   Text="What a working board shows on the scope at each pin - the screenshot and how the scope was set, so the next person can compare theirs." />

					<!-- How the board's baselines were measured: its "Scope measurements" files (owner decision,
					     2026-10-26 - ScopeMeasurementFiles), each a link that opens it. -->
					<StackPanel x:Name="MeasuringNotesPanel" Spacing="2" Margin="0,0,0,6">
						<TextBlock x:Name="MeasuringNotesIntro" Classes="EmptyLine" />
						<ItemsControl x:Name="MeasuringNotesItemsControl">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="data:BoardLocalFileEntry">
									<Button Classes="PaneLink"
											Tag="{Binding}"
											Margin="0,0,14,0"
											ToolTip.Tip="Open this file of the board"
											Click="OnMeasuringNoteClick">
										<TextBlock Text="{Binding Name}"
												   FontSize="12"
												   Foreground="{DynamicResource Link_Fg}"
												   TextDecorations="Underline" />
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<TextBlock x:Name="NoBaselinesText" Classes="EmptyLine" Text="No scope baselines yet." />

					<ItemsControl x:Name="BaselinesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneBaselineRow">
								<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
										BorderThickness="0,0,0,1"
										Padding="0,0,0,8"
										Margin="0,0,0,8">
									<Grid ColumnDefinitions="168,12,*">
										<Border Grid.Column="0"
												Width="168"
												Height="112"
												VerticalAlignment="Top"
												Background="{DynamicResource Card_Bg}">
											<Image Source="{Binding Thumbnail}" Stretch="Uniform" />
										</Border>

										<StackPanel Grid.Column="2">
											<Grid ColumnDefinitions="70,8,*,8,*">
												<StackPanel Grid.Column="0">
													<TextBlock Classes="FieldLabel" Text="Pin" />
													<TextBox Text="{Binding Pin, Mode=TwoWay}" />
												</StackPanel>
												<StackPanel Grid.Column="2">
													<TextBlock Classes="FieldLabel" Text="Signal name" />
													<TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="PA3, ~IRQ, PHI2" />
												</StackPanel>
												<StackPanel Grid.Column="4">
													<TextBlock Classes="FieldLabel" Text="Expected reading" />
													<TextBox Text="{Binding ExpectedReading, Mode=TwoWay}" Watermark="Pulsing, high, 1 MHz clock" />
												</StackPanel>
											</Grid>
											<Grid ColumnDefinitions="*,8,*,8,*">
												<StackPanel Grid.Column="0">
													<TextBlock Classes="FieldLabel" Text="T/DIV" />
													<AutoCompleteBox ItemsSource="{x:Static data:ComponentVocabulary.TimeDivisions}"
																	 Text="{Binding TimeDiv, Mode=TwoWay}"
																	 FilterMode="StartsWith"
																	 MinimumPrefixLength="0"
																	 IsTextCompletionEnabled="False"
																	 PlaceholderText="50us"
																	 HorizontalAlignment="Stretch" />
												</StackPanel>
												<StackPanel Grid.Column="2">
													<TextBlock Classes="FieldLabel" Text="V/DIV" />
													<AutoCompleteBox ItemsSource="{x:Static data:ComponentVocabulary.VoltDivisions}"
																	 Text="{Binding VoltsDiv, Mode=TwoWay}"
																	 FilterMode="StartsWith"
																	 MinimumPrefixLength="0"
																	 IsTextCompletionEnabled="False"
																	 PlaceholderText="1V"
																	 HorizontalAlignment="Stretch" />
												</StackPanel>
												<StackPanel Grid.Column="4">
													<TextBlock Classes="FieldLabel" Text="Trigger level" />
													<TextBox Text="{Binding TriggerLevel, Mode=TwoWay}" Watermark="1.5V" />
												</StackPanel>
											</Grid>
											<Grid ColumnDefinitions="*,8,*">
												<StackPanel Grid.Column="0">
													<TextBlock Classes="FieldLabel" Text="Machine state" />
													<TextBox Text="{Binding MachineState, Mode=TwoWay}" Watermark="At the READY prompt, running a game" />
												</StackPanel>
												<StackPanel Grid.Column="2">
													<TextBlock Classes="FieldLabel" Text="Where it comes from" />
													<ComboBox HorizontalAlignment="Stretch"
															  ItemsSource="{Binding SourceChoices}"
															  SelectedItem="{Binding Source, Mode=TwoWay}"
															  PlaceholderText="Where it comes from" />
												</StackPanel>
											</Grid>
											<TextBlock Classes="FieldLabel" Text="Note" />
											<TextBox Text="{Binding Note, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />

											<TextBlock Text="{Binding Problem}"
													   IsVisible="{Binding HasProblem}"
													   Margin="0,4,0,0"
													   Foreground="{DynamicResource Text_Warning_Fg}"
													   TextWrapping="Wrap" />

											<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
												<Button Content="Change screenshot"
														Tag="{Binding}"
														ToolTip.Tip="Pick another screenshot for this baseline"
														Click="OnChangeBaselineScreenshotClick" />
												<Button Classes="Danger"
														Content="Remove"
														Tag="{Binding}"
														ToolTip.Tip="Remove this scope baseline"
														Click="OnRemoveBaselineClick" />
											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- A new baseline, held here until it can be one - its pin, a screenshot and one scope
					     setting (ComponentImageKinds; the plan: "a screenshot, which is required"). -->
					<Border x:Name="NewBaselinePanel"
							IsVisible="False"
							BorderBrush="{DynamicResource Table_BorderRowLine}"
							BorderThickness="1"
							CornerRadius="3"
							Padding="8">
						<StackPanel Spacing="4">
							<TextBlock Classes="PaneHeading" FontSize="12" Text="New scope baseline" />
							<Grid ColumnDefinitions="168,12,*">
								<Border Grid.Column="0"
										Width="168"
										Height="112"
										VerticalAlignment="Top"
										Background="{DynamicResource Card_Bg}">
									<Image x:Name="NewBaselineThumbnail" Stretch="Uniform" />
								</Border>
								<StackPanel Grid.Column="2">
									<Grid ColumnDefinitions="70,8,*">
										<StackPanel Grid.Column="0">
											<TextBlock Classes="FieldLabel" Text="Pin" />
											<TextBox x:Name="NewBaselinePinBox" />
										</StackPanel>
										<StackPanel Grid.Column="2">
											<TextBlock Classes="FieldLabel" Text="Signal name" />
											<TextBox x:Name="NewBaselineNameBox" Watermark="PA3, ~IRQ, PHI2" />
										</StackPanel>
									</Grid>
									<Grid ColumnDefinitions="*,8,*,8,*">
										<StackPanel Grid.Column="0">
											<TextBlock Classes="FieldLabel" Text="T/DIV" />
											<AutoCompleteBox x:Name="NewBaselineTimeDivBox"
															 FilterMode="StartsWith"
															 MinimumPrefixLength="0"
															 IsTextCompletionEnabled="False"
															 PlaceholderText="50us"
															 HorizontalAlignment="Stretch" />
										</StackPanel>
										<StackPanel Grid.Column="2">
											<TextBlock Classes="FieldLabel" Text="V/DIV" />
											<AutoCompleteBox x:Name="NewBaselineVoltsDivBox"
															 FilterMode="StartsWith"
															 MinimumPrefixLength="0"
															 IsTextCompletionEnabled="False"
															 PlaceholderText="1V"
															 HorizontalAlignment="Stretch" />
										</StackPanel>
										<StackPanel Grid.Column="4">
											<TextBlock Classes="FieldLabel" Text="Trigger level" />
											<TextBox x:Name="NewBaselineTriggerBox" Watermark="1.5V" />
										</StackPanel>
									</Grid>
									<TextBlock x:Name="NewBaselineProblemText"
											   Margin="0,4,0,0"
											   Foreground="{DynamicResource Text_Warning_Fg}"
											   TextWrapping="Wrap" />
									<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
										<Button x:Name="NewBaselineChooseButton"
												Content="Choose screenshot"
												ToolTip.Tip="Pick the screenshot from a file"
												Click="OnChooseNewBaselineScreenshotClick" />
										<Button x:Name="NewBaselineCaptureButton"
												Content="Capture from my oscilloscope"
												IsVisible="False"
												ToolTip.Tip="Take the screenshot from the oscilloscope connected on the Oscilloscope tab"
												Click="OnCaptureNewBaselineClick" />
										<Button x:Name="AddNewBaselineButton"
												Classes="Accept"
												Content="Add this baseline"
												IsEnabled="False"
												Click="OnAddNewBaselineClick" />
										<Button x:Name="CancelNewBaselineButton"
												Content="Cancel"
												Click="OnCancelNewBaselineClick" />
									</StackPanel>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>

					<StackPanel x:Name="AddBaselineButtons" Orientation="Horizontal" Spacing="8">
						<Button x:Name="AddBaselineButton"
								Classes="Accept"
								Content="Add baseline"
								Click="OnAddBaselineClick" />
						<Button x:Name="CaptureBaselineButton"
								Content="Capture from my oscilloscope"
								IsVisible="False"
								ToolTip.Tip="Start a new baseline with the screen of the oscilloscope connected on the Oscilloscope tab"
								Click="OnCaptureBaselineClick" />
					</StackPanel>
				</StackPanel>

				<!-- ==== Pictures (slice 3b) ==== -->
				<StackPanel Spacing="4">
					<TextBlock x:Name="PicturesHeading" Classes="PaneHeading" Text="Pictures" />
					<TextBlock Classes="PaneIntro"
							   Text="Photos and drawings of the component - its markings, its pinout, where it sits on the board." />

					<TextBlock x:Name="NoPicturesText" Classes="EmptyLine" Text="No pictures yet." />

					<ItemsControl x:Name="PicturesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPanePictureRow">
								<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
										BorderThickness="0,0,0,1"
										Padding="0,0,0,8"
										Margin="0,0,0,8">
									<Grid ColumnDefinitions="168,12,*">
										<Border Grid.Column="0"
												Width="168"
												Height="112"
												VerticalAlignment="Top"
												Background="{DynamicResource Card_Bg}">
											<Image Source="{Binding Thumbnail}" Stretch="Uniform" />
										</Border>
										<StackPanel Grid.Column="2">
											<TextBlock Classes="FieldLabel" Text="Name" />
											<TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Top, Pinout, Markings" />
											<TextBlock Classes="FieldLabel" Text="Note" />
											<TextBox Text="{Binding Note, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
											<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
												<Button Content="Change picture"
														Tag="{Binding}"
														ToolTip.Tip="Pick another file for this picture"
														Click="OnChangePictureClick" />
												<Button Classes="Danger"
														Content="Remove"
														Tag="{Binding}"
														ToolTip.Tip="Remove this picture"
														Click="OnRemovePictureClick" />
											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddPictureButton"
							Classes="Accept"
							Content="Add picture"
							HorizontalAlignment="Left"
							Click="OnAddPictureClick" />
				</StackPanel>

				<!-- ==== Replacement parts ==== -->
				<StackPanel Spacing="4">
					<TextBlock Classes="PaneHeading" Text="Replacement parts" />
					<TextBlock Classes="PaneIntro"
							   Text="Parts that can stand in for this one - and what has to change for one that does not simply drop in." />

					<TextBlock x:Name="NoReplacementsText" Classes="EmptyLine" Text="No replacement parts yet." />

					<ItemsControl x:Name="ReplacementsItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneReplacementRow">
								<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
										BorderThickness="0,0,0,1"
										Padding="0,0,0,8"
										Margin="0,0,0,8">
									<Grid ColumnDefinitions="*,8,160,8,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
										<TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Part number" />
										<TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PartNumber, Mode=TwoWay}" />
										<TextBlock Grid.Row="0" Grid.Column="2" Classes="FieldLabel" Text="Kind" />
										<ComboBox Grid.Row="1" Grid.Column="2"
												  HorizontalAlignment="Stretch"
												  ItemsSource="{Binding KindChoices}"
												  SelectedItem="{Binding Kind, Mode=TwoWay}"
												  PlaceholderText="Kind" />
										<Button Grid.Row="1" Grid.Column="4"
												Classes="Danger"
												Content="Remove"
												Tag="{Binding}"
												ToolTip.Tip="Remove this replacement part"
												Click="OnRemoveReplacementClick" />
										<Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" ColumnDefinitions="*,8,*">
											<TextBlock Grid.Column="0" Classes="FieldLabel" Text="What to change" />
											<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Where the advice comes from" />
										</Grid>
										<Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" ColumnDefinitions="*,8,*">
											<TextBox Grid.Column="0" Text="{Binding Changes, Mode=TwoWay}" Watermark="Nothing, for a drop-in" />
											<TextBox Grid.Column="2" Text="{Binding Source, Mode=TwoWay}" Watermark="A forum thread, a magazine, tried on my own board" />
										</Grid>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddReplacementButton"
							Classes="Accept"
							Content="Add replacement part"
							HorizontalAlignment="Left"
							Click="OnAddReplacementClick" />
				</StackPanel>

				<!-- ==== Files (slice 3b) ==== -->
				<StackPanel Spacing="4">
					<TextBlock x:Name="FilesHeading" Classes="PaneHeading" Text="Files" />
					<TextBlock Classes="PaneIntro"
							   Text="Documents kept with the board about this component - a datasheet, a service note, a ROM dump." />

					<TextBlock x:Name="NoFilesText" Classes="EmptyLine" Text="No files yet." />

					<ItemsControl x:Name="FilesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneFileRow">
								<Grid ColumnDefinitions="*,8,*,8,Auto,8,Auto" Margin="0,0,0,4">
									<TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Watermark="Datasheet" />
									<TextBlock Grid.Column="2"
											   Text="{Binding File}"
											   VerticalAlignment="Center"
											   FontSize="11"
											   Opacity="0.75"
											   TextTrimming="CharacterEllipsis" />
									<Button Grid.Column="4"
											Content="Change file"
											Tag="{Binding}"
											ToolTip.Tip="Pick another file for this entry"
											Click="OnChangeFileClick" />
									<Button Grid.Column="6"
											Classes="Danger"
											Content="Remove"
											Tag="{Binding}"
											ToolTip.Tip="Remove this file"
											Click="OnRemoveFileClick" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddFileButton"
							Classes="Accept"
							Content="Add file"
							HorizontalAlignment="Left"
							Click="OnAddFileClick" />
				</StackPanel>

				<!-- ==== Links ==== -->
				<StackPanel Spacing="4" Grid.IsSharedSizeScope="True">
					<TextBlock Classes="PaneHeading" Text="Links" />
					<TextBlock Classes="PaneIntro"
							   Text="Pages about this component - a datasheet online, a forum thread, a video." />

					<TextBlock x:Name="NoLinksText" Classes="EmptyLine" Text="No links yet." />

					<Grid x:Name="LinksHeading">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="LinkButtons" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Name" />
						<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Address" />
					</Grid>

					<ItemsControl x:Name="LinksItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneLinkRow">
								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="Auto" SharedSizeGroup="LinkButtons" />
									</Grid.ColumnDefinitions>
									<TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Watermark="Datasheet" />
									<TextBox Grid.Column="2" Text="{Binding Url, Mode=TwoWay}" Watermark="https://" />
									<Button Grid.Column="4"
											Classes="Danger"
											Content="Remove"
											Tag="{Binding}"
											ToolTip.Tip="Remove this link"
											Click="OnRemoveLinkClick" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddLinkButton"
							Classes="Accept"
							Content="Add link"
							HorizontalAlignment="Left"
							Click="OnAddLinkClick" />
				</StackPanel>

			</StackPanel>
			</Grid>
		</ScrollViewer>

		<!-- THE BOARD'S OWN LISTS (slice 4a - the plan: "Board > Files and links, grouped by category ...
		     Board > Credits ... Board > Important signals"): one at a time, in place of a component
		     (ComponentPane.Board.cs). Every change goes into the draft as the component's do. -->
		<ScrollViewer Grid.Row="1" x:Name="BoardPartPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MaxWidth="980" />
					<ColumnDefinition Width="0.001*" />
				</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Spacing="18" Margin="4,12,12,12">

				<!-- ==== Pictures (slice 4b; step 3 moved "Schematic images" here) - every picture of the
				     board: added, named, matched to its KiCad view, ordered, removed, and how a marked
				     component is drawn on it (ComponentPane.BoardPictures.cs, .BoardPictureList.cs) ==== -->
				<StackPanel x:Name="PicturesPart" Spacing="4">
					<TextBlock x:Name="BoardPicturesHeading" Classes="PaneHeading" Text="Pictures" />
					<TextBlock Classes="PaneIntro"
							   Text="Photos of the board's sides and its schematic sheets - everything else is marked on them. Name each one, say which KiCad view it shows, put them in order, and choose how a marked component is drawn on it." />
					<Button x:Name="AddPicturesButton"
							Classes="Accept"
							Content="Add pictures"
							HorizontalAlignment="Left"
							Margin="0,0,0,8"
							ToolTip.Tip="Pick photos of the board's sides, or its schematic sheets - each is copied into your draft, your own file left where it is. They can be dragged onto the tab too."
							Click="OnAddPicturesClick" />

					<!-- What "Mark all automatically" did, or why it could not (step 3, slice 3c). -->
					<TextBlock x:Name="BoardPicturesNoteText" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="False" />

					<TextBlock x:Name="NoBoardPicturesText" Classes="EmptyLine" Text="No pictures yet." />

					<ItemsControl x:Name="BoardPicturesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneBoardPictureRow">
								<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
										BorderThickness="0,0,0,1"
										Padding="0,0,0,10"
										Margin="0,0,0,10">
									<Grid ColumnDefinitions="320,16,*">
										<Border Grid.Column="0"
												Width="320"
												Height="200"
												VerticalAlignment="Top"
												Background="{DynamicResource Card_Bg}">
											<local:PicturePreview Source="{Binding Thumbnail}"
																  ImageSize="{Binding ImageSize}"
																  Highlights="{Binding Highlights}"
																  HighlightColor="{Binding HighlightColor}"
																  HighlightOpacity="{Binding HighlightFraction}" />
										</Border>

										<StackPanel Grid.Column="2" Spacing="6">
											<!-- The name, saved on Enter or leaving the box (Escape puts it back). -->
											<TextBox Text="{Binding NameDraft, Mode=TwoWay}"
													 FontWeight="Bold"
													 ToolTip.Tip="The picture's name - its thumbnail on the Schematics tab says it. Enter or leaving the box saves it."
													 KeyDown="OnPictureNameKeyDown"
													 LostFocus="OnPictureNameLostFocus" />
											<TextBlock Text="{Binding File}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />

											<!-- The KiCad view the picture shows - once the board's views are read. -->
											<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowsCadNames}">
												<TextBlock Text="Shows KiCad view" VerticalAlignment="Center" />
												<ComboBox ItemsSource="{Binding CadNameChoices}"
														  SelectedItem="{Binding SelectedCadNameChoice, Mode=TwoWay}"
														  MinWidth="220"
														  ToolTip.Tip="Which view of the board's KiCad data this picture shows - its traces are drawn on it from that view, and Align KiCad lines them up" />
											</StackPanel>

											<Grid ColumnDefinitions="Auto,8,Auto,12,*,8,40" RowDefinitions="Auto,6,Auto,6,Auto">
												<TextBlock Grid.Row="0" Grid.Column="0" Text="Marked components" VerticalAlignment="Center" />
												<ColorPicker Grid.Row="0" Grid.Column="2" Color="{Binding HighlightColor, Mode=TwoWay}" />
												<Slider Grid.Row="0" Grid.Column="4" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
														Value="{Binding HighlightOpacity, Mode=TwoWay}"
														ToolTip.Tip="How strongly a marked component shows on the picture" />
												<TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding HighlightOpacityText}" VerticalAlignment="Center" />

												<TextBlock Grid.Row="2" Grid.Column="0" Text="On the thumbnail" VerticalAlignment="Center" />
												<ColorPicker Grid.Row="2" Grid.Column="2" Color="{Binding ThumbnailColor, Mode=TwoWay}" />
												<Slider Grid.Row="2" Grid.Column="4" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
														Value="{Binding ThumbnailOpacity, Mode=TwoWay}"
														ToolTip.Tip="How strongly a marked component shows on the picture's thumbnail" />
												<TextBlock Grid.Row="2" Grid.Column="6" Text="{Binding ThumbnailOpacityText}" VerticalAlignment="Center" />

												<TextBlock Grid.Row="4" Grid.Column="0" Text="Trace on the other side" VerticalAlignment="Center"
														   ToolTip.Tip="With KiCad data: the colour of a trace on the board's other side" />
												<ColorPicker Grid.Row="4" Grid.Column="2" Color="{Binding OppositeTraceColor, Mode=TwoWay}" />
											</Grid>

											<Button Classes="Accept"
													Content="Use for all pictures"
													Tag="{Binding}"
													HorizontalAlignment="Left"
													ToolTip.Tip="Give every picture of the board these colours"
													Click="OnUseColoursForAllClick" />

											<!-- The picture's tools on the Schematics tab, with a bar and Done (slice 6 -
											     contributor mode went): its components' rectangles, and the KiCad copper
											     lined up with it - the latter for a board with KiCad data and a picture with
											     a CAD name (PictureToolWording). -->
											<WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" Margin="0,4,0,0">
												<Button Content="Mark components"
														Tag="{Binding}"
														ToolTip.Tip="Opens the Schematics tab on this picture, to draw a rectangle around each component"
														Click="OnMarkComponentsClick" />
												<Button Content="Align KiCad"
														Tag="{Binding}"
														IsEnabled="{Binding CanAlignKiCad}"
														ToolTip.Tip="{Binding AlignTip}"
														ToolTip.ShowOnDisabled="True"
														Click="OnAlignKiCadClick" />
												<!-- Every component's rectangle from its footprint, on a picture aligned with
												     KiCad (step 3, slice 3c) - it adds marks, so green. -->
												<Button Content="Mark all automatically"
														Classes="Accept"
														Tag="{Binding}"
														IsEnabled="{Binding CanMarkAutomatically}"
														ToolTip.Tip="{Binding MarkAutomaticallyTip}"
														ToolTip.ShowOnDisabled="True"
														Click="OnMarkAutomaticallyClick" />
											</WrapPanel>

											<!-- The picture's place among the board's pictures, and taking it away (step 3 -
											     the "Schematic images" window's, moved here). -->
											<WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
												<Button Content="Move up"
														Tag="{Binding}"
														IsEnabled="{Binding CanMoveUp}"
														ToolTip.Tip="Move this picture up - the order every user of the board sees the pictures in"
														Click="OnMovePictureUpClick" />
												<Button Content="Move down"
														Tag="{Binding}"
														IsEnabled="{Binding CanMoveDown}"
														ToolTip.Tip="Move this picture down - the order every user of the board sees the pictures in"
														Click="OnMovePictureDownClick" />
												<Button Content="Remove"
														Classes="Danger"
														Tag="{Binding}"
														ToolTip.Tip="Take this picture off the board - it asks first when components are marked on it"
														Click="OnRemoveBoardPictureClick" />
											</WrapPanel>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<!-- ==== Files and links ==== -->
				<StackPanel x:Name="FilesAndLinksPart" Spacing="18" Grid.IsSharedSizeScope="True">
					<StackPanel Spacing="4">
						<TextBlock x:Name="BoardFilesHeading" Classes="PaneHeading" Text="Files" />
						<TextBlock Classes="PaneIntro"
								   Text="Documents kept with the board - a service manual, a troubleshooting guide, measurements. The Resources tab lists them by category." />

						<TextBlock x:Name="NoBoardFilesText" Classes="EmptyLine" Text="No files yet." />

						<Grid x:Name="BoardFilesHeadings">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="160" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="Auto" SharedSizeGroup="BoardFileChange" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="Auto" SharedSizeGroup="BoardFileRemove" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Category" />
							<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Name" />
							<TextBlock Grid.Column="4" Classes="FieldLabel" Text="File" />
						</Grid>

						<ItemsControl x:Name="BoardFilesItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentPaneBoardFileRow">
									<Grid Margin="0,0,0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="160" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="BoardFileChange" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="BoardFileRemove" />
										</Grid.ColumnDefinitions>
										<AutoCompleteBox Grid.Column="0"
														 Text="{Binding Category, Mode=TwoWay}"
														 ItemsSource="{Binding CategoryChoices}"
														 FilterMode="Contains"
														 MinimumPrefixLength="0"
														 IsTextCompletionEnabled="False"
														 PlaceholderText="Resources" />
										<TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" Watermark="Service manual" />
										<TextBlock Grid.Column="4"
												   Text="{Binding File}"
												   VerticalAlignment="Center"
												   FontSize="11"
												   Opacity="0.75"
												   TextTrimming="CharacterEllipsis" />
										<Button Grid.Column="6"
												Content="Change file"
												Tag="{Binding}"
												ToolTip.Tip="Pick another file for this entry"
												Click="OnChangeBoardFileClick" />
										<Button Grid.Column="8"
												Classes="Danger"
												Content="Remove"
												Tag="{Binding}"
												ToolTip.Tip="Remove this file"
												Click="OnRemoveBoardFileClick" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
							<Button x:Name="AddBoardFileButton"
									Classes="Accept"
									Content="Add file"
									Click="OnAddBoardFileClick" />
							<!-- The files replaced here, on the other boards with the same file. -->
							<Button x:Name="BoardFilesAlsoButton"
									Content="Also on other boards"
									IsVisible="False"
									ToolTip.Tip="Put the files you replaced on the other boards that have the same file, each in its own draft"
									Click="OnBoardFilesAlsoClick" />
						</StackPanel>

						<Border x:Name="BoardAlsoPanel"
								IsVisible="False"
								Margin="0,8,0,0"
								BorderBrush="{DynamicResource Form_Border}"
								BorderThickness="1"
								CornerRadius="3"
								Padding="12,10">
							<StackPanel Spacing="6">
								<TextBlock Classes="PaneHeading" Text="Also on other boards" />
								<TextBlock x:Name="BoardAlsoIntroText" Classes="PaneIntro" />
								<StackPanel x:Name="BoardAlsoFilesPanel" Spacing="2" />
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Button x:Name="BoardAlsoChangeButton"
											Classes="Accept"
											Content="Change them too"
											ToolTip.Tip="Put your new file into each ticked board's own draft, in place of the old one - reviewed by that board's maintainers"
											Click="OnBoardAlsoChangeClick" />
									<Button x:Name="CancelBoardAlsoButton"
											Content="Cancel"
											Click="OnCancelBoardAlsoClick" />
								</StackPanel>
							</StackPanel>
						</Border>
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock x:Name="BoardLinksHeading" Classes="PaneHeading" Text="Links" />
						<TextBlock Classes="PaneIntro"
								   Text="Pages about the board - a forum, a wiki, a repair guide, a video." />

						<TextBlock x:Name="NoBoardLinksText" Classes="EmptyLine" Text="No links yet." />

						<Grid x:Name="BoardLinksHeadings">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="160" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="2*" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="Auto" SharedSizeGroup="BoardLinkButtons" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Category" />
							<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Name" />
							<TextBlock Grid.Column="4" Classes="FieldLabel" Text="Address" />
						</Grid>

						<ItemsControl x:Name="BoardLinksItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentPaneBoardLinkRow">
									<Grid Margin="0,0,0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="160" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="2*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="BoardLinkButtons" />
										</Grid.ColumnDefinitions>
										<AutoCompleteBox Grid.Column="0"
														 Text="{Binding Category, Mode=TwoWay}"
														 ItemsSource="{Binding CategoryChoices}"
														 FilterMode="Contains"
														 MinimumPrefixLength="0"
														 IsTextCompletionEnabled="False"
														 PlaceholderText="Forums" />
										<TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" Watermark="Lemon64" />
										<TextBox Grid.Column="4" Text="{Binding Url, Mode=TwoWay}" Watermark="https://" />
										<Button Grid.Column="6"
												Classes="Danger"
												Content="Remove"
												Tag="{Binding}"
												ToolTip.Tip="Remove this link"
												Click="OnRemoveBoardLinkClick" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Button x:Name="AddBoardLinkButton"
								Classes="Accept"
								Content="Add link"
								HorizontalAlignment="Left"
								Click="OnAddBoardLinkClick" />
					</StackPanel>
				</StackPanel>

				<!-- ==== Credits ==== -->
				<StackPanel x:Name="CreditsPart" Spacing="4" Grid.IsSharedSizeScope="True">
					<TextBlock x:Name="CreditsHeading" Classes="PaneHeading" Text="Credits" />
					<TextBlock Classes="PaneIntro"
							   Text="Who made the board's data - the pictures, the labelling, the measurements. The About tab shows them; a name or a handle is fine, and the contact is shown to everybody." />

					<TextBlock x:Name="NoCreditsText" Classes="EmptyLine" Text="No credits yet." />

					<Grid x:Name="CreditsHeadings">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="CreditButtons" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Classes="FieldLabel" Text="What" />
						<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Which part of it" />
						<TextBlock Grid.Column="4" Classes="FieldLabel" Text="Name or handle" />
						<TextBlock Grid.Column="6" Classes="FieldLabel" Text="Contact" />
					</Grid>

					<ItemsControl x:Name="CreditsItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneCreditRow">
								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="Auto" SharedSizeGroup="CreditButtons" />
									</Grid.ColumnDefinitions>
									<AutoCompleteBox Grid.Column="0"
													 Text="{Binding Category, Mode=TwoWay}"
													 ItemsSource="{Binding CategoryChoices}"
													 FilterMode="Contains"
													 MinimumPrefixLength="0"
													 IsTextCompletionEnabled="False"
													 PlaceholderText="Schematic image" />
									<TextBox Grid.Column="2" Text="{Binding SubCategory, Mode=TwoWay}" Watermark="PAL, Top, CPU" />
									<TextBox Grid.Column="4" Text="{Binding NameOrHandle, Mode=TwoWay}" />
									<TextBox Grid.Column="6" Text="{Binding Contact, Mode=TwoWay}" Watermark="A forum, a Discord, a web page" />
									<Button Grid.Column="8"
											Classes="Danger"
											Content="Remove"
											Tag="{Binding}"
											ToolTip.Tip="Remove this credit"
											Click="OnRemoveCreditClick" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button x:Name="AddCreditButton"
								Classes="Accept"
								Content="Add credit"
								Click="OnAddCreditClick" />
						<!-- A credit for yourself, by the name and contact CRT remembers (2026-10-26). -->
						<Button x:Name="AddMeButton"
								Classes="Accept"
								Content="Add me"
								ToolTip.Tip="Add a credit for yourself - by the name and contact you were credited by last time. Pick what it is for."
								Click="OnAddMeClick" />
					</StackPanel>
					<TextBlock x:Name="CreditMeHintText"
							   Classes="EmptyLine"
							   IsVisible="False"
							   Text="Type the name or handle you want in credits - CRT remembers it, with the contact, for the next time." />
				</StackPanel>

				<!-- ==== Important signals ==== -->
				<StackPanel x:Name="ImportantSignalsPart" Spacing="4" Grid.IsSharedSizeScope="True">
					<TextBlock x:Name="SignalsHeading" Classes="PaneHeading" Text="Important signals" />
					<TextBlock Classes="PaneIntro"
							   Text="The signals worth checking first on this board. Each lights up its KiCad net on the Schematics tab - pick the net from the board's KiCad data." />

					<TextBlock x:Name="KiCadNetsLineText" Classes="EmptyLine" IsVisible="False" />
					<TextBlock x:Name="NoSignalsText" Classes="EmptyLine" Text="No important signals yet." />

					<Grid x:Name="SignalsHeadings">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="SignalButtons" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Name shown" />
						<TextBlock Grid.Column="2" Classes="FieldLabel" Text="KiCad net" />
					</Grid>

					<ItemsControl x:Name="SignalsItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneSignalRow">
								<StackPanel Margin="0,0,0,4">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="SignalButtons" />
										</Grid.ColumnDefinitions>
										<TextBox Grid.Column="0" Text="{Binding DisplayName, Mode=TwoWay}" Watermark="Clock, Reset, Video" />
										<AutoCompleteBox Grid.Column="2"
														 Text="{Binding KiCadNetName, Mode=TwoWay}"
														 ItemsSource="{Binding NetChoices}"
														 FilterMode="Contains"
														 MinimumPrefixLength="0"
														 IsTextCompletionEnabled="False"
														 PlaceholderText="PHI2, /RESET" />
										<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
											<!-- Click-to-light-up: the net lit on the Schematics tab. -->
											<Button Content="Show on board"
													Tag="{Binding}"
													IsEnabled="{Binding CanShowOnBoard}"
													ToolTip.Tip="Light this net up on the Schematics tab"
													ToolTip.ShowOnDisabled="True"
													Click="OnShowSignalOnBoardClick" />
											<Button Classes="Danger"
													Content="Remove"
													Tag="{Binding}"
													ToolTip.Tip="Remove this signal"
													Click="OnRemoveSignalClick" />
										</StackPanel>
									</Grid>
									<TextBlock Text="{Binding Problem}"
											   IsVisible="{Binding HasProblem}"
											   Margin="0,2,0,0"
											   FontSize="11"
											   Foreground="{DynamicResource Text_Warning_Fg}"
											   TextWrapping="Wrap" />
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddSignalButton"
							Classes="Accept"
							Content="Add signal"
							HorizontalAlignment="Left"
							Click="OnAddSignalClick" />

					<!-- Signals suggested from the board's KiCad net names (ComponentPane.SignalSuggestions.cs). -->
					<StackPanel x:Name="SignalSuggestionsPanel" Spacing="4" Margin="0,14,0,0" IsVisible="False">
						<TextBlock x:Name="SignalSuggestionsHeading" Classes="PaneHeading" />
						<TextBlock x:Name="SignalSuggestionsIntroText" Classes="PaneIntro" />

						<ItemsControl x:Name="SignalSuggestionsItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentPaneSignalSuggestion">
									<Grid Margin="0,0,0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="SignalButtons" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
										<TextBlock Grid.Column="2" Text="{Binding KiCadNetName}" VerticalAlignment="Center" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
										<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
											<Button Content="Show on board"
													Tag="{Binding}"
													ToolTip.Tip="Light this net up on the Schematics tab"
													Click="OnShowSuggestionOnBoardClick" />
											<Button Classes="Accept"
													Content="Add"
													Tag="{Binding}"
													ToolTip.Tip="Add this signal"
													Click="OnAddSuggestionClick" />
										</StackPanel>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Button x:Name="AddAllSuggestionsButton"
								Classes="Accept"
								Content="Add all suggestions"
								HorizontalAlignment="Left"
								ToolTip.Tip="Add every suggested signal - one step, so Undo takes them all back"
								Click="OnAddAllSuggestionsClick" />
					</StackPanel>
				</StackPanel>

			</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
