<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             xmlns:theme="clr-namespace:Handlers.Theming"
             xmlns:data="clr-namespace:Handlers.DataHandling;assembly=CRT.Data"
             x:Class="CRT.ComponentPane">

	<!-- THE COMPONENT PANE (CRT 4.0 step 2, 2026-10-25 - the plan: "A component opens in a pane, never
	     in a maximized window"). On the right of the Contribute tab; every change goes into the draft
	     as it is made (ComponentPane.axaml.cs). -->
	<UserControl.Styles>
		<Style Selector="TextBlock.PaneHeading">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>

		<Style Selector="TextBlock.PaneIntro">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>

		<Style Selector="TextBlock.FieldLabel">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Margin" Value="0,6,0,2" />
		</Style>

		<Style Selector="TextBlock.EmptyLine">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<!-- A schematic image card's KiCad option name, faded with its controls while they are off. -->
		<Style Selector="TextBlock.KiCadOption.off">
			<Setter Property="Opacity" Value="0.45" />
		</Style>

		<!-- The counter under the short description - the warning colour once it is over the limit. -->
		<Style Selector="TextBlock.Counter">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>

		<Style Selector="TextBlock.Counter.over">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource Text_Warning_Fg}" />
		</Style>

		<!-- A file of the board, opened by a click on its name - a link, not a button's box. -->
		<Style Selector="Button.PaneLink">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Button.PaneLink /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Button.PaneLink:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- A row's drag handle (files, links, credits, important signals - owner request, 2026-10-30: "a
		     North/South icon and then drag the whole line up/down"): Font Awesome's up-down,
		     U+F338 (yMax 448, inside the declared ascent - no room reserved), under the HAND cursor (owner
		     request, 2026-11-01: the north/south one did not say it can be grabbed); the row moves by
		     ListRowDrag. -->
		<Style Selector="Border.RowDragHandle">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Width" Value="28" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Border.RowDragHandle > TextBlock">
			<Setter Property="FontFamily" Value="{DynamicResource FontAwesomeSolid}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Opacity" Value="0.6" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.RowDragHandle:pointerover > TextBlock">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<!-- A handle that takes the keyboard (a region's - its row has nothing else that always can) shows it has it. -->
		<Style Selector="Border.RowDragHandle:focus-visible">
			<Setter Property="BorderBrush" Value="{DynamicResource Fg}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="3" />
		</Style>
		<Style Selector="Border.RowDragHandle:focus-visible > TextBlock">
			<Setter Property="Opacity" Value="1" />
		</Style>

		<!-- One entry of a component's replacement parts, pictures or oscilloscope baselines in a frame of its own
		     (owner request, 2026-11-01: "a darkgrey border around it") - the schematic images' cards' look. -->
		<Style Selector="Border.PaneEntry">
			<Setter Property="BorderBrush" Value="DarkGray" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="12" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>

		<!-- One entry of a list that MOVES up and down - files, links, credits, important signals, categories - in a frame
		     of its own (owner request, 2026-11-08: "everything that can be moved up/down must have its own panel with a
		     border ... so it makes it easier to view its boundaries"): PaneEntry's look, set closer, as these lists run long.
		     The headings over such a list stand in by the frame's edge and padding, so each stays over its box. Every drag
		     handle of the tab stands in one (ContributeMovableRowsTests). -->
		<Style Selector="Border.MovableRow">
			<Setter Property="BorderBrush" Value="DarkGray" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
		<Style Selector="Grid.MovableRowHeadings">
			<Setter Property="Margin" Value="9,0,9,0" />
		</Style>

		<!-- A field a row of the board's lists needs, left empty (BoardRowRequired - owner request,
		     2026-11-01: "highlight the problematic cell with a helper what is missing"): a red frame on
		     its box - at rest, under the pointer and with the keyboard in it - and the helper under it.
		     It was a line under the whole row until then, which was easily missed. -->
		<Style Selector="TextBox.Missing, AutoCompleteBox.Missing, ComboBox.Missing">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>

		<!-- A value of the list under a field the components picked differ in (DiffersPopup): a line of the list, as a
		     drop-down's, lit under the pointer and by the arrow keys. It takes no focus: the field keeps it, so what is
		     typed there goes on narrowing the list, and a click is no box left. -->
		<Style Selector="Button.DifferingValue">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="6,3" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="Focusable" Value="False" />
		</Style>
		<Style Selector="Button.DifferingValue.Lit /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>

		<!-- A region on "Board: Regions" as its button looks (owner request, 2026-11-09: "list all regions and its colors"):
		     the colors RegionChoice.ColorsOf names, by a class per set - the buttons' resources, so a theme or a color set
		     for PAL and NTSC shows here too. -->
		<!-- As the region's button looks when picked (owner request, 2026-11-11: "you should not show the regional name in bold -
		     it must be identical to what the user will see in the region buttons"): the button's font size and weight, a 2px edge
		     in its background color (App.axaml's Button.RegionToggle.active). -->
		<Style Selector="Border.RegionPill">
			<Setter Property="Height" Value="{x:Static local:ComponentPaneRegionRow.LineHeight}" />
			<Setter Property="MinWidth" Value="90" />
			<Setter Property="Padding" Value="12,4" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<!-- A region's two color pickers as tall as its pill, on its line (owner request, 2026-11-11: "have the size of the two
		     color-picker boxes have the same size/height as the region button"). -->
		<Style Selector="ColorPicker.RegionColor">
			<Setter Property="Height" Value="{x:Static local:ComponentPaneRegionRow.LineHeight}" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="ColorPicker.RegionColor /template/ DropDownButton">
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Height" Value="{x:Static local:ComponentPaneRegionRow.LineHeight}" />
		</Style>
		<Style Selector="Border.RegionPill > TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="HorizontalAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.RegionPill.PAL">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>
		<Style Selector="Border.RegionPill.PAL > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_PAL_Fg}" />
		</Style>
		<Style Selector="Border.RegionPill.NTSC">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>
		<Style Selector="Border.RegionPill.NTSC > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_NTSC_Fg}" />
		</Style>
		<Style Selector="Border.RegionPill.Own1">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_Own1_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own1_Bg}" />
		</Style>
		<Style Selector="Border.RegionPill.Own1 > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own1_Fg}" />
		</Style>
		<Style Selector="Border.RegionPill.Own2">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_Own2_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own2_Bg}" />
		</Style>
		<Style Selector="Border.RegionPill.Own2 > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own2_Fg}" />
		</Style>
		<Style Selector="Border.RegionPill.Own3">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_Own3_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own3_Bg}" />
		</Style>
		<Style Selector="Border.RegionPill.Own3 > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own3_Fg}" />
		</Style>
		<Style Selector="Border.RegionPill.Own4">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_Own4_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_Own4_Bg}" />
		</Style>
		<Style Selector="Border.RegionPill.Own4 > TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_Own4_Fg}" />
		</Style>
		<Style Selector="TextBox.Missing /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>
		<Style Selector="AutoCompleteBox.Missing /template/ TextBox#PART_TextBox">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>
		<Style Selector="TextBlock.Required">
			<Setter Property="Text" Value="Required before submitting" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="2,2,0,0" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">

		<StackPanel Grid.Row="0">
		<!-- What is open, whether the draft changed it, and the ways out. -->
		<Border x:Name="PaneHeader"
				BorderBrush="{DynamicResource Table_BorderRowLine}"
				BorderThickness="0,0,0,1"
				Padding="4,0,0,8">
			<Grid ColumnDefinitions="*,Auto">
				<StackPanel Grid.Column="0" Spacing="2">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock x:Name="TitleText"
								   FontSize="16"
								   FontWeight="Bold"
								   TextWrapping="Wrap"
								   VerticalAlignment="Center" />

						<!-- The draft holds a change to this component - the published board reads otherwise. -->
						<Border x:Name="ChangedMark"
								IsVisible="False"
								Background="{DynamicResource Draft_Chip_Bg}"
								BorderBrush="{DynamicResource Draft_Chip_Border}"
								BorderThickness="1"
								CornerRadius="3"
								Padding="5,1"
								VerticalAlignment="Center"
								ToolTip.Tip="Your draft changes this component - the published board reads otherwise until your draft is submitted and published">
							<TextBlock Text="Draft" FontSize="11" Foreground="{DynamicResource Draft_Chip_Fg}" />
						</Border>
					</StackPanel>
					<TextBlock x:Name="RegionText"
							   FontSize="11"
							   Opacity="0.75"
							   TextWrapping="Wrap" />

					<!-- What an action could not do - a picked file CRT cannot show, a capture that brought nothing. -->
					<TextBlock x:Name="PaneMessageText"
							   IsVisible="False"
							   FontSize="12"
							   Foreground="{DynamicResource Text_Warning_Fg}"
							   TextWrapping="Wrap" />

					<!-- SEVERAL COMPONENTS PICKED, EDITED AS ONE (owner request, 2026-11-08: "It must be very clear for the
					     user, that whatever the user changes will affect all selected components"; ComponentPane.Several.cs):
					     in the khaki of every temporary state, who they are and that each change reaches all of them - and
					     "Make all like", the page shown made the same on all of them as one picked has it. -->
					<Border x:Name="SeveralBar"
							IsVisible="False"
							Margin="0,6,0,0"
							Background="{DynamicResource Schematics_TemporaryBar_Bg}"
							BorderBrush="{DynamicResource Schematics_TemporaryBar_Border}"
							BorderThickness="1"
							CornerRadius="6"
							Padding="12,8">
						<StackPanel Spacing="6">
							<TextBlock x:Name="SeveralText"
									   TextWrapping="Wrap"
									   Foreground="{DynamicResource Schematics_TemporaryBar_Fg}" />
							<TextBlock x:Name="SeveralPageText"
									   TextWrapping="Wrap"
									   FontSize="12"
									   Foreground="{DynamicResource Schematics_TemporaryBar_Fg}" />
							<StackPanel x:Name="MakeAllLikePanel" Orientation="Horizontal" Spacing="6">
								<ComboBox x:Name="MakeAllLikeSourceBox"
										  MinWidth="110"
										  VerticalAlignment="Center"
										  SelectionChanged="OnMakeAllLikeSourceChanged" />
								<Button x:Name="MakeAllLikeButton"
										Classes="Accept"
										VerticalAlignment="Center"
										Click="OnMakeAllLikeClick" />
							</StackPanel>
							<!-- What the button's "*1" points at: it changes the page shown alone (owner request, 2026-11-09:
							     "it should make it clear, that if you click the "Make all like RP7" that it then will affect only
							     this data on this page, and not everything for the component"). -->
							<TextBlock x:Name="MakeAllLikeNote"
									   TextWrapping="Wrap"
									   FontSize="12"
									   Foreground="{DynamicResource Schematics_TemporaryBar_Fg}" />
						</StackPanel>
					</Border>

					<!-- A field that differs between the components picked lists their values under it WHILE IT HAS THE FOCUS,
					     never under the pointer, each with whose it is, narrowed to what is typed - a value clicked, or lit by
					     Down/Up and picked by Enter, is set on all of them (owner requests, 2026-11-09: "show the values in a
					     drop-down when I hover that field", then "I do not want that mouse hover will trigger that list ... Only
					     when cursor is active in a field it should show the list"; ComponentPane.Several.cs). -->
					<Popup x:Name="DiffersPopup"
						   Placement="BottomEdgeAlignedLeft"
						   IsLightDismissEnabled="False">
						<Border x:Name="DiffersPopupContent"
								Background="{DynamicResource Table_Bg}"
								BorderBrush="{DynamicResource Table_BorderRowLine}"
								BorderThickness="1"
								CornerRadius="4"
								Padding="4"
								MaxWidth="480">
							<StackPanel Spacing="2">
								<TextBlock x:Name="DiffersPopupHeading"
										   Margin="6,2,6,4"
										   FontSize="11"
										   Opacity="0.75"
										   TextWrapping="Wrap"
										   Foreground="{DynamicResource Fg}" />
								<!-- As tall as it may be, then scrolled (code review, 2026-11-09: forty values ran off the screen,
								     the ones below its edge out of reach) - a line lit by the keys brought into view. -->
								<ScrollViewer x:Name="DiffersScroller"
											  MaxHeight="320"
											  HorizontalScrollBarVisibility="Disabled"
											  VerticalScrollBarVisibility="Auto">
									<ItemsControl x:Name="DiffersItems">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="local:ComponentPaneDifferingValue">
												<Button Classes="DifferingValue"
														HorizontalAlignment="Stretch"
														HorizontalContentAlignment="Left"
														Tag="{Binding}"
														Click="OnDifferingValueClick">
													<StackPanel Spacing="1">
														<TextBlock Text="{Binding Shown}" TextWrapping="Wrap" />
														<TextBlock Text="{Binding Whose}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
													</StackPanel>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</StackPanel>
						</Border>
					</Popup>

					<!-- What can be done with the component as a whole (slice 3c - the plan: "[Show on board]
					     [Preview popup] [Undo changes]"). -->
					<WrapPanel x:Name="ActionsPanel" Orientation="Horizontal" Margin="0,6,0,0">
						<Button x:Name="ShowOnBoardButton"
								Content="Show on board"
								Margin="0,0,6,4"
								ToolTip.ShowOnDisabled="True"
								Click="OnShowOnBoardClick" />
						<!-- Everything of a component on another board, picked there (owner request, 2026-11-04). -->
						<Button x:Name="CloneFromOtherBoardButton"
								Content="Clone component from another board"
								Margin="0,0,6,4"
								ToolTip.Tip="Pick a hardware, a board and a component - this component takes over everything it has but the board label"
								Click="OnCloneFromOtherBoardClick" />
						<!-- The popup as it will look once the draft is published - from the draft, now. -->
						<Button x:Name="PreviewPopupButton"
								Content="Preview component info popup"
								Margin="0,0,6,4"
								ToolTip.Tip="Open the popup this component gets when it is pointed at on the board - as your draft has it now, which is what will be published"
								Click="OnPreviewPopupClick" />
					</WrapPanel>
				</StackPanel>

				<!-- No Close (owner request, 2026-10-30: "remove those Close buttons on all those pages, as
				     they are not needed anymore") - the left column's "Board status" goes back. -->
			</Grid>
		</Border>

		<!-- What the checks found on this page, under its headline (TabDrafts.Problems.cs). -->
		<Decorator x:Name="ProblemsHost" />
		</StackPanel>

		<!-- The component is gone from the draft - deleted, or an undo took away the change that added it. -->
		<StackPanel Grid.Row="1" x:Name="GonePanel" IsVisible="False" Margin="4,12,0,0" Spacing="6">
			<TextBlock x:Name="GoneText" TextWrapping="Wrap" />
			<!-- Offered while the step that deleted it is the latest one - Undo of that step. -->
			<Button x:Name="BringBackButton"
					Classes="Accept"
					IsVisible="False"
					HorizontalAlignment="Left"
					Click="OnBringBackClick" />
		</StackPanel>

		<!-- A NEW COMPONENT (slice 3c): named first - its label is what every other row of it is filed
		     under - and added to the draft as one step; then the pane shows it like any other. -->
		<ScrollViewer Grid.Row="1" x:Name="NewComponentPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="4,12,12,12" MaxWidth="560" HorizontalAlignment="Left">
				<TextBlock Classes="PaneIntro"
						   Text="Name the component as it is printed on the board - its label. Everything else is filled in once it is added, and &quot;Undo&quot; takes it away again." />

				<TextBlock Classes="FieldLabel" Text="Board label" />
				<TextBox x:Name="NewLabelBox" Watermark="U8, C12, R3" />
				<TextBlock x:Name="NewLabelProblemText"
						   IsVisible="False"
						   Margin="0,4,0,0"
						   Foreground="{DynamicResource Text_Warning_Fg}"
						   TextWrapping="Wrap" />

				<!-- Only on a board with components of their own per region. -->
				<StackPanel x:Name="NewRegionPanel">
					<TextBlock Classes="FieldLabel" Text="Applies to" />
					<ComboBox x:Name="NewRegionBox" Width="200" />
				</StackPanel>

				<TextBlock Classes="FieldLabel" Text="Category" />
				<!-- Picked, never typed: "Board: Categories" is where one is made (owner request, 2026-11-03). -->
				<ComboBox x:Name="NewCategoryBox"
						  PlaceholderText="Pick a category"
						  HorizontalAlignment="Stretch" />
				<TextBlock x:Name="NewCategoryNoteText"
						   Classes="EmptyLine"
						   Margin="0,4,0,0"
						   IsVisible="False" />

				<!-- Owner request, 2026-11-01: "highlight that an added component must be manually marked in at
				     least one of the schematic images, as it otherwise will be flagged as an orphan component". -->
				<Border Classes="Notice" Margin="0,12,0,0">
					<Grid ColumnDefinitions="Auto,*">
						<TextBlock Grid.Column="0" Classes="NoticeIcon" Text="&#xf05a;" />
						<TextBlock Grid.Column="1" Classes="NoticeText" x:Name="NewComponentMarkNoteText" />
					</Grid>
				</Border>

				<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
					<Button x:Name="AddNewComponentButton"
							Classes="Accept"
							Content="Add component"
							IsEnabled="False"
							Click="OnAddNewComponentClick" />
					<Button x:Name="CancelNewComponentButton"
							Content="Cancel"
							ToolTip.Tip="Add nothing and close"
							Click="OnCancelNewComponentClick" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<!-- The sections take the room there is, up to a readable width, from the left: a star column
		     with a MaxWidth (a left-aligned panel would shrink to its widest content). -->
		<ScrollViewer Grid.Row="1" x:Name="SectionsScrollViewer" HorizontalScrollBarVisibility="Disabled">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MaxWidth="980" />
					<ColumnDefinition Width="0.001*" />
				</Grid.ColumnDefinitions>
			<StackPanel x:Name="SectionsPanel" Grid.Column="0" Spacing="18" Margin="4,12,12,12">

				<!-- Which region the page shows, on a page that depends on it (ShowRegionShown). -->
				<TextBlock x:Name="RegionShownText" Classes="EmptyLine" IsVisible="False" TextWrapping="Wrap" />

				<!-- ==== Clone component from another board - open while picking (owner request, 2026-11-04) ==== -->
				<Border x:Name="ClonePanel"
						IsVisible="False"
						BorderBrush="{DynamicResource Form_Border}"
						BorderThickness="1"
						CornerRadius="3"
						Padding="12,10">
					<StackPanel Spacing="6">
						<TextBlock Classes="PaneHeading" Text="Clone component from another board" />
						<TextBlock x:Name="CloneIntroText" Classes="PaneIntro" />
						<Grid ColumnDefinitions="*,8,*,8,*">
							<StackPanel Grid.Column="0">
								<TextBlock Classes="FieldLabel" Text="Hardware" />
								<ComboBox x:Name="CloneHardwareBox"
										  PlaceholderText="Pick a hardware"
										  HorizontalAlignment="Stretch"
										  SelectionChanged="OnCloneHardwareChanged" />
							</StackPanel>
							<StackPanel Grid.Column="2">
								<TextBlock Classes="FieldLabel" Text="Board" />
								<ComboBox x:Name="CloneBoardBox"
										  PlaceholderText="Pick a board"
										  HorizontalAlignment="Stretch"
										  SelectionChanged="OnCloneBoardChanged" />
							</StackPanel>
							<StackPanel Grid.Column="4">
								<TextBlock Classes="FieldLabel" Text="Component" />
								<ComboBox x:Name="CloneComponentBox"
										  PlaceholderText="Pick a component"
										  MaxDropDownHeight="420"
										  HorizontalAlignment="Stretch"
										  SelectionChanged="OnCloneComponentChanged" />
							</StackPanel>
						</Grid>
						<TextBlock x:Name="CloneNoteText" Classes="EmptyLine" IsVisible="False" />
						<!-- What the component picked is - the lines ComponentPaneWording.CloneFacts says. -->
						<Border x:Name="CloneFactsPanel" Classes="PaneEntry" IsVisible="False" Margin="0">
							<StackPanel x:Name="CloneFactsLines" Spacing="2" />
						</Border>
						<StackPanel Orientation="Horizontal" Spacing="6">
							<Button x:Name="CloneButton"
									Classes="Accept"
									Content="Clone"
									IsEnabled="False"
									ToolTip.ShowOnDisabled="True"
									ToolTip.Tip="This component takes over everything the one picked has, but its board label - one step, so &quot;Undo&quot; takes it back"
									Click="OnCloneClick" />
							<Button x:Name="CancelCloneButton"
									Content="Cancel"
									Click="OnCancelCloneClick" />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- ==== Basics ==== -->
				<StackPanel x:Name="BasicsSection">
					<TextBlock Classes="PaneIntro"
							   Text="What the component is. The popup on the board shows these when the component is pointed at." />

					<!-- A row of its own per region - the VIC-II is a 6569 in one and a 6567 in the other. -->
					<CheckBox x:Name="BasicsRegionalCheck"
							  Content="This data is different per region"
							  IsVisible="False"
							  Margin="0,0,0,4"
							  ToolTip.Tip="The component is another part in each region, so each has these fields of its own. Off, one set of fields is for every region."
							  Click="OnBasicsRegionalClick" />

					<!-- The order is the owner's (2026-11-04): what names the component down the left, what sorts
					     it on the right, and every box one column wide - "Purpose or note" under "Part number" (owner request,
					     2026-11-09), as tall as what it holds. Each column a stack of its own, so that box grows down its
					     column and leaves the left one as it is. -->
					<Grid ColumnDefinitions="*,16,*">
						<!-- Each column as tall as what it holds (VerticalAlignment="Top"), so a change of either is a change of
						     its size - what has "Purpose or note" aligned again (AlignPurposeWithDescription). -->
						<StackPanel x:Name="BasicsLeftColumn" Grid.Column="0" VerticalAlignment="Top">
						<!-- Its label renames it on Enter or when left, never on a pause in typing: every row
						     of the component moves with it (owner report, 2026-11-01: "unable to rename"). -->
						<StackPanel>
							<TextBlock Classes="FieldLabel" Text="Board label" />
							<TextBox x:Name="BoardLabelBox"
									 Watermark="U8, C12, R3"
									 ToolTip.Tip="The label printed on the board. Enter or leaving the box renames the component, with everything filed under it."
									 KeyDown="OnBoardLabelKeyDown" />
							<TextBlock x:Name="BoardLabelProblemText"
									   IsVisible="False"
									   Margin="0,4,0,0"
									   Foreground="{DynamicResource Text_Warning_Fg}"
									   TextWrapping="Wrap" />
							<!-- Told apart per region, the label still is not (owner report, 2026-11-04: it read as
							     if the region switch had lost what was typed - ShowRegionChoices). -->
							<TextBlock x:Name="BoardLabelOneText"
									   Classes="EmptyLine"
									   IsVisible="False"
									   Margin="2,2,0,0" />
						</StackPanel>
						<StackPanel>
							<TextBlock Classes="FieldLabel" Text="Friendly name" />
							<TextBox x:Name="FriendlyNameBox" Watermark="What will people also know this as" />
						</StackPanel>
						<StackPanel>
							<TextBlock Classes="FieldLabel" Text="Technical name or value" />
							<TextBox x:Name="TechnicalNameBox" Watermark="Details printed on the component or its value" />
						</StackPanel>
						<StackPanel>
							<!-- "Short description" until 2026-11-09 (owner request); stored as the description still. -->
							<TextBlock Classes="FieldLabel" Text="Other technical details" />
							<TextBox x:Name="DescriptionBox"
									 Watermark="Other relevant details" />
							<!-- Said in words as well as by the counter's color (owner report, 2026-11-03: "I cannot
							     see any warning anywhere for this?") - a warning, never a refusal (BoardDataChecks).
							     Right under the box, the counter beside it: on a line of its own the counter left
							     what read as an empty line between them (owner request, 2026-11-04). -->
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock x:Name="DescriptionTooLongText"
										   Grid.Column="0"
										   IsVisible="False"
										   Margin="2,2,8,0"
										   FontSize="11"
										   Foreground="{DynamicResource Text_Warning_Fg}"
										   TextWrapping="Wrap" />
								<TextBlock x:Name="DescriptionCounter" Grid.Column="1" Classes="Counter" Margin="0,2,0,0" />
							</Grid>
						</StackPanel>
						</StackPanel>

						<StackPanel x:Name="BasicsRightColumn" Grid.Column="2" VerticalAlignment="Top">
						<StackPanel>
							<TextBlock Classes="FieldLabel" Text="Category" />
							<!-- Picked from the board's own categories, never typed (owner request, 2026-11-03: "Only in
							     the 'Board: Category' we should allow for an input field") - the component list groups by
							     the exact word, so "Capacitors" beside "Capacitor" would split one group in two. -->
							<ComboBox x:Name="CategoryBox"
									  PlaceholderText="Pick a category"
									  HorizontalAlignment="Stretch" />
							<TextBlock x:Name="CategoryRequiredText" Classes="Required" IsVisible="False" />
						</StackPanel>
						<StackPanel>
							<TextBlock Classes="FieldLabel" Text="Part number" />
							<TextBox x:Name="PartNumberBox" Watermark="Orderable part number from the manufacturer" />
						</StackPanel>
						<StackPanel>
							<!-- Why the component is there, with formatting (owner request, 2026-11-09: "a new textfield (with
							     formatting possibility) named "Purpose or note" ... it should always auto-expand so it is
							     possible to see all text"): a RichNoteTextBox with no height cap, shown in the popup. -->
							<TextBlock Classes="FieldLabel" Text="Purpose or note" />
							<local:RichNoteTextBox x:Name="PurposeBox"
												   MinHeight="64"
												   Watermark="What the component is there for, and anything else worth knowing" />
						</StackPanel>
						</StackPanel>
					</Grid>

					<!-- What throws the component's work away, on "Basics" alone and under "Short description" (owner
					     request, 2026-11-07: "only when in "Basics" I want to see the two red buttons ... below the "Short
					     description"") - each one step, so "Undo" brings it back. -->
					<WrapPanel x:Name="BasicsDangerPanel" Orientation="Horizontal" Margin="0,12,0,0">
						<!-- One component back as published. -->
						<Button x:Name="UndoChangesButton"
								Classes="Danger"
								IsVisible="False"
								Margin="0,0,6,4"
								ToolTip.Tip="Put this component back as it is published - every change your draft makes to it. &quot;Undo&quot; brings them back."
								Click="OnUndoChangesClick" />
						<!-- The component taken off the board. -->
						<Button x:Name="DeleteComponentButton"
								Classes="Danger"
								Margin="0,0,6,4"
								Click="OnDeleteComponentClick" />
					</WrapPanel>
				</StackPanel>

				<!-- ==== Pinout ==== -->
				<StackPanel x:Name="PinoutSection">
					<TextBlock Classes="PaneIntro"
							   Text="The case and what each pin is for. Pick the case, and CRT draws it: a chip from above, notch at the top, a leaded part as it looks, each lead with its pin." />

					<!-- One set of pins for every region, or a set of each's own (2026-11-01). -->
					<CheckBox x:Name="PinsRegionalCheck"
							  Content="This data is different per region"
							  IsVisible="False"
							  Margin="0,0,0,4"
							  ToolTip.Tip="The pins are not the same in each region, so each has a set of its own. Off, one set of pins is for every region."
							  Click="OnPinsRegionalClick" />

					<StackPanel Orientation="Horizontal" Spacing="8">
						<StackPanel Width="200">
							<TextBlock Classes="FieldLabel" Text="Package" />
							<!-- Its list opens with the focus, every case in it, and narrows as it is typed in
							     (owner request, 2026-11-03; ComponentPane.Pages.cs, PackageShowsAll). -->
							<AutoCompleteBox x:Name="PackageBox"
											 FilterMode="Custom"
											 MinimumPrefixLength="0"
											 IsTextCompletionEnabled="False"
											 PlaceholderText="DIP-40, TO-92"
											 HorizontalAlignment="Stretch" />
						</StackPanel>
						<!-- Every pin number of the case not listed yet, added - offered once a case with
						     a known count is picked and some of its pins are missing. -->
						<Button x:Name="AddCasePinsButton"
								Classes="Accept"
								VerticalAlignment="Bottom"
								IsVisible="False"
								Click="OnAddCasePinsClick" />
						<!-- The pins the board's KiCad data has for the component, with their names - offered
						     while it has any (ComponentPane.KiCadPins.cs). -->
						<Button x:Name="FillFromKiCadButton"
								Classes="Accept"
								Content="Fill pins from KiCad"
								VerticalAlignment="Bottom"
								IsVisible="False"
								ToolTip.ShowOnDisabled="True"
								Click="OnFillFromKiCadClick" />
					</StackPanel>

					<!-- Its columns and rows never change (RegionButtonLayout's header: Avalonia's Grid throws on a lost one).
					     The pins - held back for several components whose packages differ, the package box above staying, so one
					     package can be given to all of them here (ComponentPane.Several.cs, HoldBackPagesOfOne). -->
					<Grid x:Name="PinsArea" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
						<local:PinoutDrawing x:Name="PinoutPicture"
											 Grid.Column="0"
											 Margin="0,0,16,0"
											 VerticalAlignment="Top"
											 IsVisible="False" />
						<!-- A leaded part drawn as it looks, each lead labelled (owner request, 2026-11-09;
						     PartPicture decides) - in the case's place for the parts it draws. -->
						<local:PartPictureDrawing x:Name="PinoutPartDrawing"
												  Grid.Column="0"
												  Margin="0,0,16,0"
												  VerticalAlignment="Top"
												  IsVisible="False" />
						<!-- A single resistor drawn with its color bands, its value and the bands' colors in words (owner request,
						     2026-11-09: "the image/drawing of the resistor should be in the pinout instead"; ResistorPicture) - UNDER
						     the pins, across the page (owner request, 2026-11-09: "I want the pinout table to be shown first and then
						     the image and explanation afterwards"); the drawings' column stays empty, so the pins take the width. -->
						<local:ResistorPicture x:Name="PinoutResistorPicture"
											   Grid.Row="1"
											   Grid.Column="0"
											   Grid.ColumnSpan="2"
											   Margin="0,12,0,0"
											   HorizontalAlignment="Left"
											   VerticalAlignment="Top" />

						<!-- The headings' button column as wide as the rows' (a shared size group). -->
						<StackPanel Grid.Column="1" Spacing="4" Grid.IsSharedSizeScope="True">
							<TextBlock x:Name="NoPinsText"
									   Classes="EmptyLine"
									   Text="No pins yet. Pick the case above and add its pins, or add them one by one." />

							<Grid x:Name="PinsHeading">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="70" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="140" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="PinNets" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="PinButtons" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Pin" />
								<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Signal name" />
								<TextBlock Grid.Column="4" Classes="FieldLabel" Text="Direction" />
								<!-- The net of each pin on this board, from its KiCad data - shown, never stored. -->
								<TextBlock x:Name="PinNetHeading"
										   Grid.Column="6"
										   Classes="FieldLabel"
										   Margin="0,0,8,0"
										   Text="Net name"
										   IsVisible="False" />
							</Grid>

							<ItemsControl x:Name="PinsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ComponentPanePinRow">
										<Grid Margin="0,0,0,4" RowDefinitions="Auto,Auto">
											<!-- 70, not under the 64 a text box takes at least - the box hung over both edges
											     of a narrower column, its left border clipped (owner report, 2026-11-01). -->
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="70" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="PinNets" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="PinButtons" />
											</Grid.ColumnDefinitions>
											<TextBox Grid.Column="0" Text="{Binding Pin, Mode=TwoWay}" Classes.Missing="{Binding PinOutside}" />
											<TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" Watermark="VCC, A0, ~RESET" />
											<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" Classes="Required" Text="{Binding PinProblem}" IsVisible="{Binding PinOutside}" />
											<ComboBox Grid.Column="4"
													  HorizontalAlignment="Stretch"
													  ItemsSource="{Binding DirectionChoices}"
													  SelectedItem="{Binding Direction, Mode=TwoWay}"
													  PlaceholderText="Direction" />
											<TextBlock Grid.Column="6"
													   Text="{Binding Net}"
													   IsVisible="{Binding HasNet}"
													   MaxWidth="180"
													   Margin="0,0,8,0"
													   VerticalAlignment="Center"
													   FontSize="11"
													   Opacity="0.75"
													   TextTrimming="CharacterEllipsis"
													   ToolTip.Tip="{Binding Net}" />
											<Button Grid.Column="7"
													Classes="Danger"
													Content="Remove"
													Tag="{Binding}"
													ToolTip.Tip="Remove this pin"
													Click="OnRemovePinClick" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Button x:Name="AddPinButton"
									Classes="Accept"
									Content="Add pin"
									HorizontalAlignment="Left"
									Click="OnAddPinClick" />
						</StackPanel>
					</Grid>
				</StackPanel>

				<!-- ==== Oscilloscope baselines (slice 3b) ==== -->
				<StackPanel x:Name="BaselinesSection" Spacing="4">
					<TextBlock Classes="PaneIntro"
							   Text="What a working board shows on the oscilloscope at each pin - the image and how the oscilloscope was set, so the next person can compare theirs." />

					<!-- How the board's baselines were measured: its "Scope measurements" files (owner decision,
					     2026-10-26 - ScopeMeasurementFiles), each a link that opens it. -->
					<StackPanel x:Name="MeasuringNotesPanel" Spacing="2" Margin="0,0,0,6">
						<TextBlock x:Name="MeasuringNotesIntro" Classes="EmptyLine" />
						<ItemsControl x:Name="MeasuringNotesItemsControl">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="data:BoardLocalFileEntry">
									<Button Classes="PaneLink"
											Tag="{Binding}"
											Margin="0,0,14,0"
											ToolTip.Tip="Open this file of the board"
											Click="OnMeasuringNoteClick">
										<TextBlock Text="{Binding Name}"
												   FontSize="12"
												   Foreground="{DynamicResource Link_Fg}"
												   TextDecorations="Underline" />
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<TextBlock x:Name="NoBaselinesText" Classes="EmptyLine" Text="No oscilloscope baselines yet." />

					<ItemsControl x:Name="BaselinesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneBaselineRow">
								<Border Classes="PaneEntry">
									<Grid ColumnDefinitions="168,12,*">
										<Border Grid.Column="0"
												Width="168"
												Height="112"
												VerticalAlignment="Top"
												Background="{DynamicResource Card_Bg}">
											<Image Source="{Binding Thumbnail}" Stretch="Uniform" />
										</Border>

										<StackPanel Grid.Column="2">
											<Grid ColumnDefinitions="70,8,*,8,*">
												<StackPanel Grid.Column="0">
													<TextBlock Classes="FieldLabel" Text="Pin" />
													<TextBox Text="{Binding Pin, Mode=TwoWay}" Classes.Missing="{Binding PinOutside}" />
												</StackPanel>
												<StackPanel Grid.Column="2">
													<TextBlock Classes="FieldLabel" Text="Signal name" />
													<TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="PA3, ~IRQ, PHI2" />
												</StackPanel>
												<StackPanel Grid.Column="4">
													<TextBlock Classes="FieldLabel" Text="Expected reading" />
													<TextBox Text="{Binding ExpectedReading, Mode=TwoWay}" Watermark="Pulsing, high, 1 MHz clock" />
												</StackPanel>
											</Grid>
											<TextBlock Classes="Required" Text="{Binding PinProblem}" IsVisible="{Binding PinOutside}" />
											<Grid ColumnDefinitions="*,8,*,8,*">
												<StackPanel Grid.Column="0">
													<TextBlock Classes="FieldLabel" Text="T/DIV" />
													<AutoCompleteBox ItemsSource="{x:Static data:ComponentVocabulary.TimeDivisions}"
																	 Text="{Binding TimeDiv, Mode=TwoWay}"
																	 FilterMode="StartsWith"
																	 MinimumPrefixLength="0"
																	 IsTextCompletionEnabled="False"
																	 PlaceholderText="50us"
																	 HorizontalAlignment="Stretch" />
												</StackPanel>
												<StackPanel Grid.Column="2">
													<TextBlock Classes="FieldLabel" Text="V/DIV" />
													<AutoCompleteBox ItemsSource="{x:Static data:ComponentVocabulary.VoltDivisions}"
																	 Text="{Binding VoltsDiv, Mode=TwoWay}"
																	 FilterMode="StartsWith"
																	 MinimumPrefixLength="0"
																	 IsTextCompletionEnabled="False"
																	 PlaceholderText="1V"
																	 HorizontalAlignment="Stretch" />
												</StackPanel>
												<StackPanel Grid.Column="4">
													<TextBlock Classes="FieldLabel" Text="Trigger level" />
													<TextBox Text="{Binding TriggerLevel, Mode=TwoWay}" Watermark="1.5V" />
												</StackPanel>
											</Grid>
											<TextBlock Classes="FieldLabel" Text="Machine state" />
											<TextBox Text="{Binding MachineState, Mode=TwoWay}" Watermark="At the READY prompt, running a game" />
											<TextBlock Classes="FieldLabel" Text="Note" />
											<!-- Several lines, always open as such (owner request, 2026-11-01) - and formatted as typed
											     (owner request, 2026-11-07; RichNoteTextBox, the note stored as its markup). -->
											<local:RichNoteTextBox Markup="{Binding Note, Mode=TwoWay}" MinHeight="80" />

											<!-- What it applies to, on a board with regions - its last field (owner request, 2026-11-01). -->
											<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding ShowsAppliesTo}">
												<TextBlock Classes="FieldLabel" Text="Applies to" VerticalAlignment="Center" Margin="0" />
												<ComboBox MinWidth="130"
														  ItemsSource="{Binding AppliesToChoices}"
														  SelectedItem="{Binding AppliesTo, Mode=TwoWay}" />
											</StackPanel>

											<TextBlock Text="{Binding Problem}"
													   IsVisible="{Binding HasProblem}"
													   Margin="0,4,0,0"
													   Foreground="{DynamicResource Text_Warning_Fg}"
													   TextWrapping="Wrap" />

											<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
												<Button Content="Change image"
														Tag="{Binding}"
														ToolTip.Tip="Pick another image for this baseline"
														Click="OnChangeBaselineScreenshotClick" />
												<!-- Owner request, 2026-11-07. -->
												<Button Content="Reveal"
														Tag="{Binding}"
														ToolTip.Tip="Show this file selected in your file manager (Explorer, Finder or your Linux file manager). A file kept in your draft carries a name made of its checksum there."
														Click="OnRevealFileClick" />
												<Button Classes="Danger"
														Content="Remove"
														Tag="{Binding}"
														ToolTip.Tip="Remove this oscilloscope baseline"
														Click="OnRemoveBaselineClick" />
											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- A new baseline, held here until it can be one - its pin, its signal name and an image
					     (owner request, 2026-11-02: the scope settings may stay empty). -->
					<Border x:Name="NewBaselinePanel"
							Classes="PaneEntry"
							IsVisible="False">
						<StackPanel Spacing="4">
							<TextBlock Classes="PaneHeading" FontSize="12" Text="New oscilloscope baseline" />
							<Grid ColumnDefinitions="168,12,*">
								<Border Grid.Column="0"
										Width="168"
										Height="112"
										VerticalAlignment="Top"
										Background="{DynamicResource Card_Bg}">
									<Image x:Name="NewBaselineThumbnail" Stretch="Uniform" />
								</Border>
								<StackPanel Grid.Column="2">
									<Grid ColumnDefinitions="70,8,*">
										<StackPanel Grid.Column="0">
											<TextBlock Classes="FieldLabel" Text="Pin" />
											<TextBox x:Name="NewBaselinePinBox" />
										</StackPanel>
										<StackPanel Grid.Column="2">
											<TextBlock Classes="FieldLabel" Text="Signal name" />
											<TextBox x:Name="NewBaselineNameBox" Watermark="PA3, ~IRQ, PHI2" />
										</StackPanel>
									</Grid>
									<Grid ColumnDefinitions="*,8,*,8,*">
										<StackPanel Grid.Column="0">
											<TextBlock Classes="FieldLabel" Text="T/DIV" />
											<AutoCompleteBox x:Name="NewBaselineTimeDivBox"
															 FilterMode="StartsWith"
															 MinimumPrefixLength="0"
															 IsTextCompletionEnabled="False"
															 PlaceholderText="50us"
															 HorizontalAlignment="Stretch" />
										</StackPanel>
										<StackPanel Grid.Column="2">
											<TextBlock Classes="FieldLabel" Text="V/DIV" />
											<AutoCompleteBox x:Name="NewBaselineVoltsDivBox"
															 FilterMode="StartsWith"
															 MinimumPrefixLength="0"
															 IsTextCompletionEnabled="False"
															 PlaceholderText="1V"
															 HorizontalAlignment="Stretch" />
										</StackPanel>
										<StackPanel Grid.Column="4">
											<TextBlock Classes="FieldLabel" Text="Trigger level" />
											<TextBox x:Name="NewBaselineTriggerBox" Watermark="1.5V" />
										</StackPanel>
									</Grid>
									<!-- What it applies to, on a board with regions: the region shown, to start with. -->
									<StackPanel x:Name="NewBaselineRegionPanel" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="False">
										<TextBlock Classes="FieldLabel" Text="Applies to" VerticalAlignment="Center" Margin="0" />
										<ComboBox x:Name="NewBaselineRegionBox" MinWidth="130" />
									</StackPanel>
									<TextBlock x:Name="NewBaselineProblemText"
											   Margin="0,4,0,0"
											   Foreground="{DynamicResource Text_Warning_Fg}"
											   TextWrapping="Wrap" />
									<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
										<Button x:Name="NewBaselineChooseButton"
												Content="Choose image"
												ToolTip.Tip="Pick the image from a file"
												Click="OnChooseNewBaselineScreenshotClick" />
										<Button x:Name="NewBaselineCaptureButton"
												Content="Capture from my oscilloscope"
												IsVisible="False"
												ToolTip.Tip="Take the image from the oscilloscope connected on the &quot;Oscilloscope&quot; tab"
												Click="OnCaptureNewBaselineClick" />
										<Button x:Name="AddNewBaselineButton"
												Classes="Accept"
												Content="Add oscilloscope image"
												IsEnabled="False"
												Click="OnAddNewBaselineClick" />
										<Button x:Name="CancelNewBaselineButton"
												Content="Cancel"
												Click="OnCancelNewBaselineClick" />
									</StackPanel>
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>

					<StackPanel x:Name="AddBaselineButtons" Orientation="Horizontal" Spacing="6">
						<Button x:Name="AddBaselineButton"
								Classes="Accept"
								Content="Add oscilloscope image"
								Click="OnAddBaselineClick" />
						<Button x:Name="CaptureBaselineButton"
								Content="Capture from my oscilloscope"
								IsVisible="False"
								ToolTip.Tip="Start a new baseline with the screen of the oscilloscope connected on the &quot;Oscilloscope&quot; tab"
								Click="OnCaptureBaselineClick" />
					</StackPanel>
				</StackPanel>

				<!-- ==== Pictures (slice 3b) ==== -->
				<StackPanel x:Name="PicturesSection" Spacing="4">
					<TextBlock Classes="PaneIntro"
							   Text="Photos and drawings of the component - its markings, its pinout, where it sits on the board." />

					<TextBlock x:Name="NoPicturesText" Classes="EmptyLine" Text="No pictures yet." />

					<ItemsControl x:Name="PicturesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPanePictureRow">
								<Border Classes="PaneEntry">
									<Grid ColumnDefinitions="168,12,*">
										<Border Grid.Column="0"
												Width="168"
												Height="112"
												VerticalAlignment="Top"
												Background="{DynamicResource Card_Bg}">
											<Image Source="{Binding Thumbnail}" Stretch="Uniform" />
										</Border>
										<StackPanel Grid.Column="2">
											<TextBlock Classes="FieldLabel" Text="Name" />
											<TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Top, Pinout, Markings" />
											<TextBlock Classes="FieldLabel" Text="Note" />
											<!-- Several lines, open as such while empty too (owner request, 2026-11-01) - and formatted
											     as typed (owner request, 2026-11-07; RichNoteTextBox, the note stored as its markup). -->
											<local:RichNoteTextBox Markup="{Binding Note, Mode=TwoWay}" MinHeight="80" />
											<!-- What it applies to, on a board with regions - its last field (owner request, 2026-11-01). -->
											<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding ShowsAppliesTo}">
												<TextBlock Classes="FieldLabel" Text="Applies to" VerticalAlignment="Center" Margin="0" />
												<ComboBox MinWidth="130"
														  ItemsSource="{Binding AppliesToChoices}"
														  SelectedItem="{Binding AppliesTo, Mode=TwoWay}" />
											</StackPanel>
											<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
												<!-- Its place among the component's pictures, as a schematic image's (owner request, 2026-11-02). -->
												<Button Content="Move up"
														Tag="{Binding}"
														IsEnabled="{Binding CanMoveUp}"
														ToolTip.Tip="Move this picture up - the order the component's popup shows them in"
														Click="OnMoveComponentPictureUpClick" />
												<Button Content="Move down"
														Tag="{Binding}"
														IsEnabled="{Binding CanMoveDown}"
														ToolTip.Tip="Move this picture down - the order the component's popup shows them in"
														Click="OnMoveComponentPictureDownClick" />
												<Button Content="Change picture"
														Tag="{Binding}"
														ToolTip.Tip="Pick another file for this picture"
														Click="OnChangePictureClick" />
												<!-- Owner request, 2026-11-07. -->
												<Button Content="Reveal"
														Tag="{Binding}"
														ToolTip.Tip="Show this file selected in your file manager (Explorer, Finder or your Linux file manager). A file kept in your draft carries a name made of its checksum there."
														Click="OnRevealFileClick" />
												<Button Classes="Danger"
														Content="Remove"
														Tag="{Binding}"
														ToolTip.Tip="Remove this picture"
														Click="OnRemovePictureClick" />
											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddPictureButton"
							Classes="Accept"
							Content="Add picture"
							HorizontalAlignment="Left"
							Click="OnAddPictureClick" />
				</StackPanel>

				<!-- ==== Replacement parts ==== -->
				<StackPanel x:Name="ReplacementsSection" Spacing="4">
					<TextBlock Classes="PaneIntro"
							   Text="Parts that can stand in for this one - and what has to change for one that does not simply drop in." />

					<TextBlock x:Name="NoReplacementsText" Classes="EmptyLine" Text="No replacement parts yet." />

					<ItemsControl x:Name="ReplacementsItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneReplacementRow">
								<Border Classes="PaneEntry">
									<Grid ColumnDefinitions="*,8,160,8,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
										<!-- "Replacement part", not "Part number" (owner request, 2026-11-06): it may as well be a
										     technical number or a friendly name. The stored column keeps its name. -->
										<TextBlock Grid.Row="0" Grid.Column="0" Classes="FieldLabel" Text="Replacement part" />
										<TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PartNumber, Mode=TwoWay}" />
										<TextBlock Grid.Row="0" Grid.Column="2" Classes="FieldLabel" Text="Kind" />
										<ComboBox Grid.Row="1" Grid.Column="2"
												  HorizontalAlignment="Stretch"
												  ItemsSource="{Binding KindChoices}"
												  SelectedItem="{Binding Kind, Mode=TwoWay}"
												  PlaceholderText="Kind" />
										<Button Grid.Row="1" Grid.Column="4"
												Classes="Danger"
												Content="Remove"
												Tag="{Binding}"
												ToolTip.Tip="Remove this replacement part"
												Click="OnRemoveReplacementClick" />
										<!-- One note of several lines (owner request, 2026-11-01), open as such while empty. -->
										<TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Classes="FieldLabel" Text="Note" />
										<TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5"
												 Text="{Binding Note, Mode=TwoWay}"
												 AcceptsReturn="True"
												 TextWrapping="Wrap"
												 MinHeight="80"
												 Watermark="What has to change for it to fit, and where that advice comes from" />
										<!-- What it applies to, on a board with regions (owner decision, 2026-11-01). -->
										<StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding ShowsAppliesTo}">
											<TextBlock Classes="FieldLabel" Text="Applies to" VerticalAlignment="Center" Margin="0" />
											<ComboBox MinWidth="130"
													  ItemsSource="{Binding AppliesToChoices}"
													  SelectedItem="{Binding AppliesTo, Mode=TwoWay}" />
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddReplacementButton"
							Classes="Accept"
							Content="Add replacement part"
							HorizontalAlignment="Left"
							Click="OnAddReplacementClick" />
				</StackPanel>

				<!-- ==== Files (slice 3b) ==== -->
				<StackPanel x:Name="FilesSection" Spacing="4" Grid.IsSharedSizeScope="True">
					<TextBlock Classes="PaneIntro"
							   Text="Documents kept with the board about this component - a datasheet, a service note, a ROM dump. Drag a file by its handle to move it up or down." />

					<TextBlock x:Name="NoFilesText" Classes="EmptyLine" Text="No files yet." />

					<!-- No "File" column (owner request, 2026-11-07: "there is no need to see this path") - "Open file"
					     and "Reveal" show the file itself. -->
					<Grid x:Name="FilesHeading" Classes="MovableRowHeadings">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="FileRegion" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="FileButtons" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Name" />
						<TextBlock x:Name="FilesAppliesToHeading" Grid.Column="2" Classes="FieldLabel" Text="Applies to" IsVisible="False" />
					</Grid>

					<ItemsControl x:Name="FilesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneFileRow">
								<Grid>
									<!-- While the row is dragged: a dashed slot its height, where a drop will land (ListRowDrag). -->
									<Panel IsVisible="{Binding IsDropPlaceholder}" Height="{Binding PlaceholderHeight}">
										<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
												StrokeThickness="2"
												StrokeDashArray="4,3"
												RadiusX="3"
												RadiusY="3"
												Margin="0,0,0,6"
												Fill="{DynamicResource Bg}" />
										<TextBlock Text="Move the file up/down and release mouse button for new location"
												FontSize="11"
												Opacity="0.7"
												TextAlignment="Center"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0,0,0,6" />
									</Panel>
									<Border Classes="MovableRow" IsVisible="{Binding IsNotDropPlaceholder}">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="FileRegion" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="FileButtons" />
											</Grid.ColumnDefinitions>
											<TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Watermark="Datasheet" />
											<!-- What it applies to, on a board with regions (owner request, 2026-11-02). -->
											<ComboBox Grid.Column="2"
													  MinWidth="130"
													  IsVisible="{Binding ShowsAppliesTo}"
													  ItemsSource="{Binding AppliesToChoices}"
													  SelectedItem="{Binding AppliesTo, Mode=TwoWay}" />
											<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
												<!-- As on "Board: Files" (owner request, 2026-11-07). -->
												<Button Content="Open file"
														Tag="{Binding}"
														IsEnabled="{Binding HasFile}"
														ToolTip.Tip="Open this file to look at it"
														Click="OnOpenComponentFileClick" />
												<Button Content="Reveal"
														Tag="{Binding}"
														IsEnabled="{Binding HasFile}"
														ToolTip.Tip="Show this file selected in your file manager (Explorer, Finder or your Linux file manager). A file kept in your draft carries a name made of its checksum there."
														Click="OnRevealFileClick" />
												<Button Content="Change file"
														Tag="{Binding}"
														ToolTip.Tip="Pick another file for this entry"
														Click="OnChangeFileClick" />
												<Button Classes="Danger"
														Content="Remove"
														Tag="{Binding}"
														ToolTip.Tip="Remove this file"
														Click="OnRemoveFileClick" />
												<Border Classes="RowDragHandle"
														PointerPressed="OnFileHandlePressed"
														ToolTip.Tip="Drag to move this file up or down - or Alt+Up and Alt+Down in its box">
													<TextBlock Text="&#xf338;" />
												</Border>
											</StackPanel>
										</Grid>
									</Border>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddFileButton"
							Classes="Accept"
							Content="Add file"
							HorizontalAlignment="Left"
							Click="OnAddFileClick" />
				</StackPanel>

				<!-- ==== Links ==== -->
				<StackPanel x:Name="LinksSection" Spacing="4" Grid.IsSharedSizeScope="True">
					<TextBlock Classes="PaneIntro"
							   Text="Pages about this component - a datasheet online, a forum thread, a video. Drag a link by its handle to move it up or down." />

					<TextBlock x:Name="NoLinksText" Classes="EmptyLine" Text="No links yet." />

					<Grid x:Name="LinksHeading" Classes="MovableRowHeadings">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="LinkRegion" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="LinkButtons" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Name" />
						<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Address" />
						<TextBlock x:Name="LinksAppliesToHeading" Grid.Column="4" Classes="FieldLabel" Text="Applies to" IsVisible="False" />
					</Grid>

					<ItemsControl x:Name="LinksItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneLinkRow">
								<Grid>
									<!-- While the row is dragged: a dashed slot its height, where a drop will land (ListRowDrag). -->
									<Panel IsVisible="{Binding IsDropPlaceholder}" Height="{Binding PlaceholderHeight}">
										<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
												StrokeThickness="2"
												StrokeDashArray="4,3"
												RadiusX="3"
												RadiusY="3"
												Margin="0,0,0,6"
												Fill="{DynamicResource Bg}" />
										<TextBlock Text="Move the link up/down and release mouse button for new location"
												FontSize="11"
												Opacity="0.7"
												TextAlignment="Center"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0,0,0,6" />
									</Panel>
									<Border Classes="MovableRow" IsVisible="{Binding IsNotDropPlaceholder}">
										<Grid RowDefinitions="Auto,Auto">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="2*" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="LinkRegion" />
												<ColumnDefinition Width="8" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="LinkButtons" />
											</Grid.ColumnDefinitions>
											<TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Watermark="Datasheet" />
											<TextBox Grid.Column="2" Text="{Binding Url, Mode=TwoWay}" Watermark="https://" Classes.Missing="{Binding UrlNotWeb}" />
											<TextBlock Grid.Row="1" Grid.Column="2" Classes="Required" Text="{Binding NotWebText}" IsVisible="{Binding UrlNotWeb}" />
											<!-- What it applies to, on a board with regions (owner request, 2026-11-02). -->
											<ComboBox Grid.Column="4"
													  MinWidth="130"
													  IsVisible="{Binding ShowsAppliesTo}"
													  ItemsSource="{Binding AppliesToChoices}"
													  SelectedItem="{Binding AppliesTo, Mode=TwoWay}" />
											<StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
												<!-- As on "Board: Links" (owner request, 2026-11-07). -->
												<Button Content="Open link"
														Tag="{Binding}"
														IsEnabled="{Binding CanOpen}"
														ToolTip.Tip="Open this page in your web browser"
														Click="OnOpenComponentLinkClick" />
												<Button Classes="Danger"
														Content="Remove"
														Tag="{Binding}"
														ToolTip.Tip="Remove this link"
														Click="OnRemoveLinkClick" />
												<Border Classes="RowDragHandle"
														PointerPressed="OnLinkHandlePressed"
														ToolTip.Tip="Drag to move this link up or down - or Alt+Up and Alt+Down in its boxes">
													<TextBlock Text="&#xf338;" />
												</Border>
											</StackPanel>
										</Grid>
									</Border>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button x:Name="AddLinkButton"
							Classes="Accept"
							Content="Add link"
							HorizontalAlignment="Left"
							Click="OnAddLinkClick" />
				</StackPanel>

			</StackPanel>
			</Grid>
		</ScrollViewer>

		<!-- THE BOARD'S OWN LISTS (slice 4a - the plan: "Board > Files and links, grouped by category ...
		     Board > Credits ... Board > Important signals"): one at a time, in place of a component
		     (ComponentPane.Board.cs). Every change goes into the draft as the component's do. -->
		<ScrollViewer Grid.Row="1" x:Name="BoardPartPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MaxWidth="980" />
					<ColumnDefinition Width="0.001*" />
				</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Spacing="18" Margin="4,12,12,12">

				<!-- ==== Board: Regions (owner decisions, 2026-11-01: "PAL and NTSC, or none", stored and
				     published; ComponentPane.RegionsAndCategories.cs) ==== -->
				<StackPanel x:Name="RegionsPart" Spacing="6">
					<TextBlock Classes="PaneIntro"><Run Text="Whether the board comes in a " /><Run Text="PAL" FontWeight="Bold" /><Run Text=" and " /><Run Text="NTSC" FontWeight="Bold" /><Run Text=" version - or in regions of its own, &quot;EU&quot; and &quot;US&quot;, say, or &quot;Japan&quot;, for hardware not told apart by its video standard." /><LineBreak /><LineBreak /><Run Text="When checked, each region's button shows under the component list and on a component's popup, in its color and in the order listed here." /><LineBreak /><Run Text="Also, some component information can differ, depending on region or it can apply to all of them." /></TextBlock>

					<!-- ONE TICK, AND EVERY REGION LISTED WITH ITS COLORS (owner request, 2026-11-09: "have the checkbox state
					     "This board comes with multiple regions" and then list all regions and its colors? It should be possible
					     to reorder the list of regions up/down"; ComponentPane.RegionsAndCategories.cs, BoardRegions). -->
					<CheckBox x:Name="RegionsCheckBox" Click="OnRegionsCheckClick" />
					<TextBlock x:Name="RegionsInUseText" Classes="EmptyLine" IsVisible="False" />

					<StackPanel x:Name="RegionsListPanel" Spacing="4" Margin="0,6,0,0">
						<ItemsControl x:Name="RegionsItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentPaneRegionRow">
									<Grid>
									<!-- While the row is dragged: a dashed slot its height, where a drop will land (ListRowDrag). -->
									<Panel IsVisible="{Binding IsDropPlaceholder}" Height="{Binding PlaceholderHeight}">
										<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
												StrokeThickness="2"
												StrokeDashArray="4,3"
												RadiusX="3"
												RadiusY="3"
												Margin="0,0,0,6"
												Fill="{DynamicResource Bg}" />
										<TextBlock Text="Move the region up/down and release mouse button for new location"
												FontSize="11"
												Opacity="0.7"
												TextAlignment="Center"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0,0,0,6" />
									</Panel>
									<Border Classes="MovableRow" IsVisible="{Binding IsNotDropPlaceholder}">
										<StackPanel Spacing="6">
											<Grid ColumnDefinitions="Auto,12,*,12,Auto,6,28">
												<!-- The region as its button looks: its name in its colors - CRT's, or the board's own
												     (owner request, 2026-11-11), never bold, as the button's is not. -->
												<Panel Grid.Column="0" VerticalAlignment="Center">
													<Border Classes="RegionPill"
															Classes.PAL="{Binding IsPal}"
															Classes.NTSC="{Binding IsNtsc}"
															Classes.Own1="{Binding IsOwn1}"
															Classes.Own2="{Binding IsOwn2}"
															Classes.Own3="{Binding IsOwn3}"
															Classes.Own4="{Binding IsOwn4}"
															IsVisible="{Binding HasCrtColors}">
														<TextBlock Text="{Binding Name}" />
													</Border>
													<Border Classes="RegionPill"
															Background="{Binding BackgroundBrush}"
															BorderBrush="{Binding BackgroundBrush}"
															IsVisible="{Binding HasOwnColors}">
														<TextBlock Text="{Binding Name}" Foreground="{Binding TextBrush}" />
													</Border>
												</Panel>

												<!-- ITS COLORS, ON THE REGION'S OWN LINE (owner requests, 2026-11-11: "I would like to be able to set
												     the background color, and then you should calculate the complementary text color ... However, I
												     would also like to be able to set the text color", then "in the same line as the region itself";
												     RegionColors): the background, the text worked out from it until one is picked, and the way back
												     to each - wrapping under only on a pane too narrow for them. -->
												<WrapPanel Grid.Column="2" ItemSpacing="6" LineSpacing="6" VerticalAlignment="Center">
													<TextBlock Text="Background" VerticalAlignment="Center" />
													<ColorPicker Classes="RegionColor" Color="{Binding BackgroundColor, Mode=TwoWay}"
																 ToolTip.Tip="The region's button and its name over the schematic images in this color - for everybody, once published" />
													<TextBlock Text="Text" VerticalAlignment="Center" Margin="12,0,0,0" />
													<ColorPicker Classes="RegionColor" Color="{Binding TextColor, Mode=TwoWay}"
																 ToolTip.Tip="Worked out from the background as the one that reads best on it, black or white - pick another to set your own" />
													<Button Content="Automatic text color"
															IsVisible="{Binding HasOwnText}"
															Tag="{Binding}"
															Click="OnAutomaticTextColorClick"
															ToolTip.Tip="The text in the color that reads best on the background, black or white" />
													<Button Classes="Danger"
															Content="Reset colors"
															IsVisible="{Binding HasOwnColors}"
															Tag="{Binding}"
															Click="OnResetRegionColorsClick"
															ToolTip.Tip="The colors CRT gives this region" />
												</WrapPanel>

												<Button Grid.Column="4"
														Classes="Danger"
														Content="Delete region"
														IsEnabled="{Binding CanDelete}"
														Tag="{Binding}"
														Click="OnDeleteRegionClick" />
												<!-- It takes the keyboard (code review, 2026-11-09): "Delete region" is off on most rows, the
												     pill takes none, so Alt+Up and Alt+Down had no row to be pressed on. -->
												<Border Grid.Column="6"
														Classes="RowDragHandle"
														Focusable="True"
														PointerPressed="OnRegionHandlePressed"
														ToolTip.Tip="Drag to move this region up or down - its button stands in this order - or Alt+Up and Alt+Down on its row">
													<TextBlock Text="&#xf338;" />
												</Border>
											</Grid>

											<TextBlock theme:BoldRuns.MarkedText="{Binding Why}" IsVisible="{Binding HasWhy}" Classes="EmptyLine" TextWrapping="Wrap" />

											<!-- WHAT IT IS APPLIED ON (owner request, 2026-11-11: "it should be possible to see which component
											     has the region applied, so I can find these and change them") - each component a button opening
											     it in this region; past ComponentsNamedAtMost, "... and N more" and "Show all" ON THE SAME LINE (owner
											     request, the same day), the last item of the very list. -->
											<StackPanel Spacing="4" IsVisible="{Binding HasComponents}">
												<TextBlock Text="Region applied on:" Classes="EmptyLine" />
												<ItemsControl ItemsSource="{Binding ChipsShown}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<WrapPanel ItemSpacing="6" LineSpacing="6" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.DataTemplates>
														<DataTemplate DataType="local:ComponentPaneRegionComponent">
															<Button Content="{Binding Label}"
																	Tag="{Binding}"
																	Padding="8,2"
																	Cursor="Hand"
																	Click="OnRegionComponentClick"
																	ToolTip.Tip="Open this component" />
														</DataTemplate>
														<DataTemplate DataType="local:ComponentPaneRegionMore">
															<StackPanel Orientation="Horizontal" Spacing="6">
																<TextBlock theme:BoldRuns.MarkedText="{Binding Text}" IsVisible="{Binding HasText}" VerticalAlignment="Center" />
																<Button Content="{Binding ShowAllText}"
																		Tag="{Binding Row}"
																		Padding="8,2"
																		Cursor="Hand"
																		Click="OnRegionShowAllClick" />
															</StackPanel>
														</DataTemplate>
													</ItemsControl.DataTemplates>
												</ItemsControl>
											</StackPanel>
											<TextBlock theme:BoldRuns.MarkedText="{Binding BoardRowsText}" IsVisible="{Binding HasBoardRows}" Classes="EmptyLine" TextWrapping="Wrap" />
										</StackPanel>
									</Border>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<StackPanel x:Name="AddRegionPanel" Spacing="4" Margin="0,4,0,0">
							<Grid ColumnDefinitions="*,6,Auto">
								<TextBox x:Name="NewRegionNameBox"
										 Grid.Column="0"
										 Watermark="Name of a region - EU, US, Japan"
										 KeyDown="OnNewRegionNameKeyDown" />
								<Button x:Name="AddRegionButton"
										Grid.Column="2"
										Classes="Accept"
										Content="Add region"
										Click="OnAddRegionClick" />
							</Grid>
							<TextBlock x:Name="NewRegionProblemText"
									   IsVisible="False"
									   Foreground="{DynamicResource Text_Warning_Fg}"
									   TextWrapping="Wrap" />
						</StackPanel>
					</StackPanel>
				</StackPanel>

				<!-- ==== Board: Categories (owner request, 2026-11-01; ComponentPane.RegionsAndCategories.cs) ==== -->
				<StackPanel x:Name="CategoriesPart" Spacing="4">
					<TextBlock Classes="PaneIntro"
							   Text="What the board's components are sorted under - in the list beside the &quot;Schematics&quot; tab and on the &quot;Overview&quot; tab. Rename one and every component in it follows; name it as another and the two become one. Drag one by its handle to set the order they are listed in. A category nothing uses yet is kept until CRT closes." />

					<ItemsControl x:Name="CategoriesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneCategoryRow">
								<Grid>
								<!-- While the row is dragged: a dashed slot its height, where a drop will land (ListRowDrag). -->
								<Panel IsVisible="{Binding IsDropPlaceholder}" Height="{Binding PlaceholderHeight}">
									<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
											StrokeThickness="2"
											StrokeDashArray="4,3"
											RadiusX="3"
											RadiusY="3"
											Margin="0,0,0,6"
											Fill="{DynamicResource Bg}" />
									<TextBlock Text="Move the category up/down and release mouse button for new location"
											FontSize="11"
											Opacity="0.7"
											TextAlignment="Center"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Margin="0,0,0,6" />
								</Panel>
								<Border Classes="MovableRow" IsVisible="{Binding IsNotDropPlaceholder}">
									<StackPanel Spacing="4">
										<Grid ColumnDefinitions="*,12,140,12,70,6,28">
											<TextBox Grid.Column="0"
													 Text="{Binding NameDraft, Mode=TwoWay}"
													 Classes.Missing="{Binding NeedsOne}"
													 Watermark="A category for these components"
													 KeyDown="OnCategoryNameKeyDown"
													 LostFocus="OnCategoryNameLostFocus" />
											<TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Opacity="0.75" />
											<Button Grid.Column="4"
													Classes="Danger"
													Content="Delete"
													Tag="{Binding}"
													IsVisible="{Binding CanDelete}"
													ToolTip.Tip="Delete this category - its components move to another, one step, so &quot;Undo&quot; brings it back"
													Click="OnDeleteCategoryClick" />
											<Border Grid.Column="6"
													Classes="RowDragHandle"
													IsVisible="{Binding CanMove}"
													PointerPressed="OnCategoryHandlePressed"
													ToolTip.Tip="Drag to move this category up or down - or Alt+Up and Alt+Down in its box">
												<TextBlock Text="&#xf338;" />
											</Border>
										</Grid>
										<TextBlock Classes="Required" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />

										<!-- Where its components go: none may be left without a category. -->
										<Border IsVisible="{Binding IsDeleting}"
												BorderBrush="{DynamicResource Form_Border}"
												BorderThickness="1"
												CornerRadius="3"
												Padding="10,8">
											<StackPanel Spacing="6">
												<TextBlock Text="{Binding DeleteQuestion}" TextWrapping="Wrap" />
												<StackPanel Orientation="Horizontal" Spacing="6">
													<ComboBox MinWidth="180"
															  IsVisible="{Binding HasMoveChoices}"
															  ItemsSource="{Binding MoveChoices}"
															  SelectedItem="{Binding MoveTo, Mode=TwoWay}" />
													<Button Classes="Danger"
															Content="Delete category"
															Tag="{Binding}"
															IsEnabled="{Binding CanDeleteNow}"
															Click="OnConfirmDeleteCategoryClick" />
													<Button Content="Cancel"
															Tag="{Binding}"
															Click="OnCancelDeleteCategoryClick" />
												</StackPanel>
											</StackPanel>
										</Border>
									</StackPanel>
								</Border>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Grid ColumnDefinitions="*,6,Auto" Margin="0,6,0,0">
						<TextBox x:Name="NewCategoryNameBox" Grid.Column="0" Watermark="Name of a new category" KeyDown="OnNewCategoryKeyDown" />
						<Button x:Name="AddCategoryButton" Grid.Column="2" Classes="Accept" Content="Add category" Click="OnAddCategoryClick" />
					</Grid>
					<TextBlock x:Name="NewCategoryProblemText"
							   IsVisible="False"
							   Foreground="{DynamicResource Text_Warning_Fg}"
							   TextWrapping="Wrap" />
				</StackPanel>

				<!-- ==== Schematic images (slice 4b; step 3 moved the "Schematic images" window here; "Pictures"
				     on screen until 2026-10-29) - every image of the board: added, named, matched to its KiCad
				     view, ordered, deleted, and how a selected component is drawn on it
				     (ComponentPane.BoardPictures.cs, .BoardPictureList.cs, .PicturePreviews.cs) ==== -->
				<StackPanel x:Name="PicturesPart" Spacing="4">
					<TextBlock Classes="PaneIntro"
							   Text="Images of the board's sides and its schematic sheets - everything else is marked on them. Name each one, say which KiCad view it shows, put them in order, and choose how a selected component is drawn on it. Add images with the button below, or drag the image files onto this page." />
					<Button x:Name="AddPicturesButton"
							Classes="Accept"
							Content="Add schematic image(s)"
							HorizontalAlignment="Left"
							Margin="0,0,0,8"
							ToolTip.Tip="Pick images of the board's sides, or its schematic sheets - each is copied into your draft, your own file left where it is. They can be dragged onto this page too."
							Click="OnAddPicturesClick" />

					<!-- What "Mark all automatically" did, or why it could not (step 3, slice 3c). -->
					<TextBlock x:Name="BoardPicturesNoteText" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="False" />

					<TextBlock x:Name="NoBoardPicturesText" Classes="EmptyLine" Text="No schematic images yet." />

					<ItemsControl x:Name="BoardPicturesItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneBoardPictureRow">
								<!-- Each image in a panel of its own (owner request, 2026-10-29: "bordered with a
								     1px DarkGrey border to clearly see boundaries"). -->
								<Border BorderBrush="DarkGray"
										BorderThickness="1"
										CornerRadius="4"
										Padding="12"
										Margin="0,0,0,12">
									<Grid ColumnDefinitions="*,14,Auto">
										<!-- THE PREVIEWS (2026-10-29), ON THE CARD'S RIGHT (owner request, 2026-11-03): the
										     image with its selected components and, ticked, the other side's traces - it
										     zooms - and under it the image as its thumbnail draws it. As wide as last
										     dragged at the handle beside them, the same on every card
										     (ComponentPane.PicturePreviews.cs). -->
										<StackPanel Grid.Column="2" Width="{Binding PreviewWidth}" Spacing="4" VerticalAlignment="Top">
											<Border Height="{Binding PreviewHeight}" Background="{DynamicResource Card_Bg}">
												<local:PicturePreview Source="{Binding ShownThumbnail}"
																	  ImageSize="{Binding ImageSize}"
																	  Highlights="{Binding Highlights}"
																	  HighlightColor="{Binding HighlightColor}"
																	  HighlightOpacity="{Binding HighlightFraction}"
																	  ThisSideTraces="{Binding ShownThisSideTraces}"
																	  ThisSideTraceColor="{Binding ThisSideTraceColor}"
																	  OtherSideTraces="{Binding ShownOtherSideTraces}"
																	  OtherSideTraceColor="{Binding OppositeTraceColor}"
																	  ThisSideTraceOpacity="{Binding ThisSideTraceFraction}"
																	  OtherSideTraceOpacity="{Binding OppositeTraceFraction}"
																	  IsZoomable="True"
																	  SharperWanted="{Binding WantSharper}" />
											</Border>
											<TextBlock Classes="EmptyLine" TextWrapping="Wrap" Text="Ctrl+scroll to zoom, drag with the right or middle mouse button to move, double-click to see it whole." />

											<TextBlock Classes="FieldLabel" Text="As its thumbnail" />
											<Border Width="160"
													Height="100"
													HorizontalAlignment="Left"
													Background="{DynamicResource Card_Bg}"
													ToolTip.Tip="The image as its thumbnail beside the &quot;Schematics&quot; tab's schematic image shows it, with a component selected">
												<local:PicturePreview Source="{Binding Thumbnail}"
																	  ImageSize="{Binding ImageSize}"
																	  Highlights="{Binding Highlights}"
																	  HighlightColor="{Binding ThumbnailColor}"
																	  HighlightOpacity="{Binding ThumbnailFraction}" />
											</Border>

											<!-- How far the picture is: the components its KiCad view shows and how many are marked
											     on it (owner requests, 2026-11-01: "must be more visible ... with black text - not
											     darkgrey") - told apart by how they were marked once any was marked by hand. -->
											<StackPanel Spacing="1" Margin="0,4,0,0" IsVisible="{Binding ShowsKiCadCounts}">
												<TextBlock Text="Components:" FontWeight="SemiBold" />
												<TextBlock Text="{Binding ComponentsAvailableText}" TextWrapping="Wrap" />
												<TextBlock Text="{Binding ComponentsAutomaticallyMarkedText}" TextWrapping="Wrap" IsVisible="{Binding ShowsAutomaticallyMarked}" />
												<TextBlock Text="{Binding ComponentsManuallyMarkedText}" TextWrapping="Wrap" IsVisible="{Binding ShowsManuallyMarked}" />
												<TextBlock TextWrapping="Wrap"><Run Text="- " /><Run Text="{Binding MarkedComponentsNumber}" FontWeight="Bold" /><Run Text="{Binding MarkedComponentsWords}" /></TextBlock>
											</StackPanel>
										</StackPanel>

										<!-- The previews' width, dragged here - every card's follows. Drawn as every splitter
										     of CRT is: a 4px bar in the GridSplitter colour (owner request, 2026-10-30:
										     "identical to any other splitter ... bulky and visible"). -->
										<Border Grid.Column="1"
												Classes="PreviewHandle"
												Background="Transparent"
												Cursor="SizeWestEast"
												ToolTip.Tip="Drag to make the previews wider or narrower"
												PointerPressed="OnPreviewHandlePressed"
												PointerMoved="OnPreviewHandleMoved"
												PointerReleased="OnPreviewHandleReleased"
												PointerCaptureLost="OnPreviewHandleCaptureLost">
											<Border Width="4"
													HorizontalAlignment="Center"
													Background="{DynamicResource Splitter}" />
										</Border>

										<StackPanel Grid.Column="0" Spacing="6">
											<!-- The name, saved on Enter or leaving the box (Escape puts it back) - said
											     above it what it is (owner request, 2026-10-29). -->
											<StackPanel Spacing="0">
												<TextBlock Classes="FieldLabel" Text="Schematic name" Margin="0,0,0,2" Opacity="0.75" />
												<TextBox Text="{Binding NameDraft, Mode=TwoWay}"
														 FontWeight="Bold"
														 ToolTip.Tip="The image's name - its thumbnail on the &quot;Schematics&quot; tab says it. Enter or leaving the box saves it."
														 KeyDown="OnPictureNameKeyDown"
														 LostFocus="OnPictureNameLostFocus" />
											</StackPanel>
											<TextBlock Text="{Binding File}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />

											<!-- The KiCad view the image shows - once the board's views are read. -->
											<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowsCadNames}">
												<TextBlock Text="Associate KiCad file" VerticalAlignment="Center" />
												<ComboBox ItemsSource="{Binding CadNameChoices}"
														  SelectedItem="{Binding SelectedCadNameChoice, Mode=TwoWay}"
														  MinWidth="220"
														  ToolTip.Tip="Which view of the board's KiCad data this image shows - its traces are drawn on it from that view, and &quot;Align KiCad data&quot; lines them up" />
											</StackPanel>

											<!-- What comes next on a side of the board not aligned yet (owner request, 2026-11-01: "it is
											     not clear that I must first do the Align KiCad, before I can do the Mark all automatically") -
											     App.axaml's notice panel; the alignment's Done then marks every component. -->
											<Border Classes="Notice" IsVisible="{Binding AlignsFirst}">
												<Grid ColumnDefinitions="Auto,*">
													<TextBlock Grid.Column="0" Classes="NoticeIcon" Text="&#xf05a;" />
													<TextBlock Grid.Column="1" Classes="NoticeText" Text="{Binding AlignFirstText}" />
												</Grid>
											</Border>

											<!-- "Schematic image" was "Selected components", "Traces on the other side" "Trace on the other side"
											     and "Traces preview" "Traces on the preview" (owner request, 2026-10-30), when this side's traces
											     got a color and both sides an opacity of their own (TraceColours). THE KiCad ROWS ARE HIDDEN, not
											     greyed out, for an image with no KiCad data (owner request, 2026-10-30: "less disabled elements to
											     relate to") - so each row's space is its elements' top margin, not a spacer row a hidden row
											     would leave behind. -->
											<Grid ColumnDefinitions="Auto,8,Auto,12,*,8,40" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
												<TextBlock Grid.Row="0" Grid.Column="0" Text="Schematic image" VerticalAlignment="Center"
														   ToolTip.Tip="How a selected component is drawn on the image" />
												<!-- Each color's list has the dropper too, to take one already on the screen
												     (owner request, 2026-11-03; ColorPickerDropper). -->
												<ColorPicker Grid.Row="0" Grid.Column="2" Color="{Binding HighlightColor, Mode=TwoWay}" />

												<Slider Grid.Row="0" Grid.Column="4" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
														Value="{Binding HighlightOpacity, Mode=TwoWay}"
														ToolTip.Tip="How strongly a selected component shows on the image" />
												<TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding HighlightOpacityText}" VerticalAlignment="Center" />

												<TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Text="Thumbnail" VerticalAlignment="Center" />
												<ColorPicker Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" Color="{Binding ThumbnailColor, Mode=TwoWay}" />

												<Slider Grid.Row="1" Grid.Column="4" Margin="0,6,0,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
														Value="{Binding ThumbnailOpacity, Mode=TwoWay}"
														ToolTip.Tip="How strongly a selected component shows on the image's thumbnail" />
												<TextBlock Grid.Row="1" Grid.Column="6" Margin="0,6,0,0" Text="{Binding ThumbnailOpacityText}" VerticalAlignment="Center" />

												<!-- Each side's traces: their color and opacity - this side's follow the Schematic image row while
												     they are not picked. -->
												<TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Text="Traces on this side" VerticalAlignment="Center"
														   IsVisible="{Binding HasKiCadData}"
														   ToolTip.Tip="{Binding ThisSideTraceColourTip}" />
												<ColorPicker Grid.Row="2" Grid.Column="2" Margin="0,6,0,0"
															 IsVisible="{Binding HasKiCadData}"
															 Color="{Binding ThisSideTraceColor, Mode=TwoWay}"
															 ToolTip.Tip="{Binding ThisSideTraceColourTip}" />

												<Slider Grid.Row="2" Grid.Column="4" Margin="0,6,0,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
														Value="{Binding ThisSideTraceOpacity, Mode=TwoWay}"
														IsVisible="{Binding HasKiCadData}"
														ToolTip.Tip="{Binding ThisSideTraceOpacityTip}" />
												<TextBlock Grid.Row="2" Grid.Column="6" Margin="0,6,0,0" Text="{Binding ThisSideTraceOpacityText}" VerticalAlignment="Center"
														   IsVisible="{Binding HasKiCadData}" />

												<TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,0,0" Text="Traces on the other side" VerticalAlignment="Center"
														   IsVisible="{Binding HasKiCadData}"
														   ToolTip.Tip="{Binding TraceColourTip}" />
												<ColorPicker Grid.Row="3" Grid.Column="2" Margin="0,6,0,0"
															 IsVisible="{Binding HasKiCadData}"
															 Color="{Binding OppositeTraceColor, Mode=TwoWay}"
															 ToolTip.Tip="{Binding TraceColourTip}" />

												<Slider Grid.Row="3" Grid.Column="4" Margin="0,6,0,0" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
														Value="{Binding OppositeTraceOpacity, Mode=TwoWay}"
														IsVisible="{Binding HasKiCadData}"
														ToolTip.Tip="{Binding OppositeTraceOpacityTip}" />
												<TextBlock Grid.Row="3" Grid.Column="6" Margin="0,6,0,0" Text="{Binding OppositeTraceOpacityText}" VerticalAlignment="Center"
														   IsVisible="{Binding HasKiCadData}" />

												<!-- Each side's traces drawn on the preview (2026-10-29): each in its own color and opacity above -
												     both when both are ticked. Shown with KiCad data; ticked only once KiCad is aligned on the image. -->
												<TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,0,0" Text="Traces preview" VerticalAlignment="Center"
														   IsVisible="{Binding HasKiCadData}"
														   Classes="KiCadOption"
														   Classes.off="{Binding !CanShowTraces}" />
												<StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5" Margin="0,6,0,0" Orientation="Horizontal" Spacing="16"
															IsVisible="{Binding HasKiCadData}">
													<CheckBox Content="This side"
															  IsChecked="{Binding ShowThisSideTraces, Mode=TwoWay}"
															  IsEnabled="{Binding CanShowTraces}"
															  ToolTip.Tip="{Binding ThisSideTracesTip}"
															  ToolTip.ShowOnDisabled="True" />
													<CheckBox Content="Other side"
															  IsChecked="{Binding ShowOtherSideTraces, Mode=TwoWay}"
															  IsEnabled="{Binding CanShowTraces}"
															  ToolTip.Tip="{Binding OtherSideTracesTip}"
															  ToolTip.ShowOnDisabled="True" />
												</StackPanel>
												<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="7"
														   Classes="EmptyLine"
														   Margin="0,4,0,0"
														   Text="{Binding TracesNote}"
														   IsVisible="{Binding HasTracesNote}" />
											</Grid>

											<!-- The picture's tools on the Schematics tab, with a bar and Done (slice 6 - contributor
											     mode went). ALIGNING COMES FIRST, MARKING BY HAND ON A ROW OF ITS OWN (owner request,
											     2026-11-01: "the user most likely will NOT manually mark components when KiCad data is
											     available"). The KiCad tools only for an image with KiCad data (owner request, 2026-10-30) -
											     hidden, not greyed out. -->
											<WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,4,0,0" IsVisible="{Binding HasKiCadData}">
												<Button Content="Align KiCad data"
														Tag="{Binding}"
														ToolTip.Tip="{Binding AlignTip}"
														Click="OnAlignKiCadClick" />
												<!-- Every component's rectangle from its footprint, on a picture aligned with KiCad (step
												     3, slice 3c) - it adds marks, so green. Not on a schematic sheet, where it marks
												     nothing (2026-11-01); an alignment's Done marks a picture with no marks by itself, so
												     this is for marking again later. -->
												<Button Content="Mark all components automatically from KiCad"
														Classes="Accept"
														Tag="{Binding}"
														IsVisible="{Binding ShowsMarkAutomatically}"
														IsEnabled="{Binding CanMarkAutomatically}"
														ToolTip.Tip="{Binding MarkAutomaticallyTip}"
														ToolTip.ShowOnDisabled="True"
														Click="OnMarkAutomaticallyClick" />
											</WrapPanel>
											<WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
												<Button Content="Mark components manually"
														Tag="{Binding}"
														ToolTip.Tip="Opens the &quot;Schematics&quot; tab on this image, to draw a rectangle around each component"
														Click="OnMarkComponentsClick" />
											</WrapPanel>

											<!-- Right under "Mark components manually" (owner request, 2026-11-03). -->
											<Button Classes="Accept"
													Content="Use colors for all schematic images"
													Tag="{Binding}"
													HorizontalAlignment="Left"
													ToolTip.Tip="Give every schematic image of the board these colors"
													Click="OnUseColoursForAllClick" />

											<!-- The image's place among the board's images, and deleting it (step 3 - the
											     "Schematic images" window's, moved here). Deleting since 2026-10-29: the image
											     leaves the board and its file the draft - the contributor's own copy, where it
											     was picked from, stays. -->
											<WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
												<Button Content="Move up"
														Tag="{Binding}"
														IsEnabled="{Binding CanMoveUp}"
														ToolTip.Tip="Move this image up - the order every user of the board sees the schematic images in"
														Click="OnMovePictureUpClick" />
												<Button Content="Move down"
														Tag="{Binding}"
														IsEnabled="{Binding CanMoveDown}"
														ToolTip.Tip="Move this image down - the order every user of the board sees the schematic images in"
														Click="OnMovePictureDownClick" />
												<Button Content="Delete schematic image"
														Classes="Danger"
														Tag="{Binding}"
														ToolTip.Tip="Delete this image from the board in your draft - it asks first when components are marked on it. Your own copy of the file is not touched, and &quot;Undo&quot; brings it back."
														Click="OnRemoveBoardPictureClick" />
											</WrapPanel>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<!-- ==== Files, and Links below - a part each since 2026-10-29 (owner request: an entry each
				     in the Contribute tab's left column) ==== -->
				<!-- The part's name and count are the pane's title above (owner request, 2026-10-29: two
				     headlines for the same thing) - so no heading of its own here, nor on the parts below. -->
				<StackPanel x:Name="BoardFilesPart" Spacing="18" Grid.IsSharedSizeScope="True">
					<StackPanel Spacing="4">
						<TextBlock Classes="PaneIntro"
								   Text="Documents kept with the board - a service manual, a troubleshooting guide, measurements. The &quot;Resources&quot; tab lists them in this order - drag a file by its handle to move it up or down." />

						<TextBlock x:Name="NoBoardFilesText" Classes="EmptyLine" Text="No files yet." />

						<!-- No "File" column (owner request, 2026-11-07: "just remove the "File" coumn, as there is no
						     need for showing that") - "Open file" and "Reveal" show the file. -->
						<Grid x:Name="BoardFilesHeadings" Classes="MovableRowHeadings">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="160" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="Auto" SharedSizeGroup="BoardFileRegion" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="Auto" SharedSizeGroup="BoardFileButtons" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Category" />
							<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Name" />
							<TextBlock x:Name="BoardFilesAppliesToHeading" Grid.Column="4" Classes="FieldLabel" Text="Applies to" IsVisible="False" />
						</Grid>

						<ItemsControl x:Name="BoardFilesItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentPaneBoardFileRow">
									<Grid>
										<!-- While the row is dragged: a dashed slot its height, where a drop will land - the
										     worklog's photos' placeholder (ListRowDrag). -->
										<Panel IsVisible="{Binding IsDropPlaceholder}" Height="{Binding PlaceholderHeight}">
											<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
													StrokeThickness="2"
													StrokeDashArray="4,3"
													RadiusX="3"
													RadiusY="3"
													Margin="0,0,0,6"
													Fill="{DynamicResource Bg}" />
											<TextBlock Text="Move the file up/down and release mouse button for new location"
													FontSize="11"
													Opacity="0.7"
													TextAlignment="Center"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Margin="0,0,0,6" />
										</Panel>
										<Border Classes="MovableRow" IsVisible="{Binding IsNotDropPlaceholder}">
											<StackPanel>
												<Grid RowDefinitions="Auto,Auto,Auto">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="160" />
														<ColumnDefinition Width="8" />
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="8" />
														<ColumnDefinition Width="Auto" SharedSizeGroup="BoardFileRegion" />
														<ColumnDefinition Width="8" />
														<ColumnDefinition Width="Auto" SharedSizeGroup="BoardFileButtons" />
													</Grid.ColumnDefinitions>
													<AutoCompleteBox Grid.Column="0" Classes.Missing="{Binding CategoryMissing}"
																	 Text="{Binding Category, Mode=TwoWay}"
																	 ItemsSource="{Binding CategoryChoices}"
																	 FilterMode="Contains"
																	 MinimumPrefixLength="0"
																	 IsTextCompletionEnabled="False"
																	 PlaceholderText="Resources" />
													<TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" Watermark="Service manual" Classes.Missing="{Binding NameMissing}" />
													<TextBlock Grid.Row="1" Grid.Column="0" Classes="Required" IsVisible="{Binding CategoryMissing}" />
													<TextBlock Grid.Row="1" Grid.Column="2" Classes="Required" IsVisible="{Binding NameMissing}" />
													<!-- With no file column, a row with no file says so under its buttons. -->
													<TextBlock Grid.Row="1" Grid.Column="6" Classes="Required" Text="No file picked - required before submitting" IsVisible="{Binding FileMissing}" />
													<!-- What it applies to, on a board with regions (owner request, 2026-11-02). -->
													<ComboBox Grid.Column="4"
															  MinWidth="130"
															  IsVisible="{Binding ShowsAppliesTo}"
															  ItemsSource="{Binding AppliesToChoices}"
															  SelectedItem="{Binding AppliesTo, Mode=TwoWay}" />
													<StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
														<!-- The file opened with the program the system has for it (owner request,
														     2026-10-29: "a possibility to open the file so I can view it"). -->
														<Button Content="Open file"
																Tag="{Binding}"
																IsEnabled="{Binding HasFile}"
																ToolTip.Tip="Open this file to look at it"
																Click="OnOpenBoardFileClick" />
														<!-- Owner request, 2026-11-07. -->
														<Button Content="Reveal"
																Tag="{Binding}"
																IsEnabled="{Binding HasFile}"
																ToolTip.Tip="Show this file selected in your file manager (Explorer, Finder or your Linux file manager). A file kept in your draft carries a name made of its checksum there."
																Click="OnRevealFileClick" />
														<Button Content="Change file"
																Tag="{Binding}"
																ToolTip.Tip="Pick another file for this entry"
																Click="OnChangeBoardFileClick" />
														<Button Classes="Danger"
																Content="Remove"
																Tag="{Binding}"
																ToolTip.Tip="Remove this file"
																Click="OnRemoveBoardFileClick" />
														<Border Classes="RowDragHandle"
																PointerPressed="OnBoardFileHandlePressed"
																ToolTip.Tip="Drag to move this file up or down - or Alt+Up and Alt+Down in its boxes">
															<TextBlock Text="&#xf338;" />
														</Border>
													</StackPanel>
													<!-- What the file is about, several lines (owner request, 2026-11-06) - the "Resources"
													     tab shows it under the file. -->
													<TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7"
															 Classes="BoardRowNote"
															 Margin="0,4,0,0"
															 Text="{Binding Note, Mode=TwoWay}"
															 AcceptsReturn="True"
															 TextWrapping="Wrap"
															 MinHeight="48"
															 Watermark="Note - what this file is about, shown in the &quot;Resources&quot; tab" />
												</Grid>
											</StackPanel>
										</Border>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
							<Button x:Name="AddBoardFileButton"
									Classes="Accept"
									Content="Add file"
									Click="OnAddBoardFileClick" />
						</StackPanel>
					</StackPanel>
				</StackPanel>

				<!-- ==== Links ==== -->
				<StackPanel x:Name="BoardLinksPart" Spacing="18" Grid.IsSharedSizeScope="True">
					<StackPanel Spacing="4">
						<TextBlock Classes="PaneIntro"
								   Text="Pages about the board - a forum, a wiki, a repair guide, a video. Drag a link by its handle to move it up or down - the &quot;Resources&quot; tab lists them in this order." />

						<TextBlock x:Name="NoBoardLinksText" Classes="EmptyLine" Text="No links yet." />

						<Grid x:Name="BoardLinksHeadings" Classes="MovableRowHeadings">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="160" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="2*" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="Auto" SharedSizeGroup="BoardLinkRegion" />
								<ColumnDefinition Width="8" />
								<ColumnDefinition Width="Auto" SharedSizeGroup="BoardLinkButtons" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Classes="FieldLabel" Text="Category" />
							<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Name" />
							<TextBlock Grid.Column="4" Classes="FieldLabel" Text="Address" />
							<TextBlock x:Name="BoardLinksAppliesToHeading" Grid.Column="6" Classes="FieldLabel" Text="Applies to" IsVisible="False" />
						</Grid>

						<ItemsControl x:Name="BoardLinksItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentPaneBoardLinkRow">
									<Grid>
										<!-- While the row is dragged: a dashed slot its height, where a drop will land - the
										     worklog's photos' placeholder (ListRowDrag). -->
										<Panel IsVisible="{Binding IsDropPlaceholder}" Height="{Binding PlaceholderHeight}">
											<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
													StrokeThickness="2"
													StrokeDashArray="4,3"
													RadiusX="3"
													RadiusY="3"
													Margin="0,0,0,6"
													Fill="{DynamicResource Bg}" />
											<TextBlock Text="Move the link up/down and release mouse button for new location"
													FontSize="11"
													Opacity="0.7"
													TextAlignment="Center"
													HorizontalAlignment="Center"
													VerticalAlignment="Center"
													Margin="0,0,0,6" />
										</Panel>
										<Border Classes="MovableRow" IsVisible="{Binding IsNotDropPlaceholder}">
											<StackPanel>
												<Grid RowDefinitions="Auto,Auto,Auto">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="160" />
														<ColumnDefinition Width="8" />
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="8" />
														<ColumnDefinition Width="2*" />
														<ColumnDefinition Width="8" />
														<ColumnDefinition Width="Auto" SharedSizeGroup="BoardLinkRegion" />
														<ColumnDefinition Width="8" />
														<ColumnDefinition Width="Auto" SharedSizeGroup="BoardLinkButtons" />
													</Grid.ColumnDefinitions>
													<AutoCompleteBox Grid.Column="0" Classes.Missing="{Binding CategoryMissing}"
																	 Text="{Binding Category, Mode=TwoWay}"
																	 ItemsSource="{Binding CategoryChoices}"
																	 FilterMode="Contains"
																	 MinimumPrefixLength="0"
																	 IsTextCompletionEnabled="False"
																	 PlaceholderText="Forums" />
													<TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" Watermark="Lemon64" Classes.Missing="{Binding NameMissing}" />
													<TextBox Grid.Column="4" Text="{Binding Url, Mode=TwoWay}" Watermark="https://" Classes.Missing="{Binding UrlMarked}" />
													<TextBlock Grid.Row="1" Grid.Column="0" Classes="Required" IsVisible="{Binding CategoryMissing}" />
													<TextBlock Grid.Row="1" Grid.Column="2" Classes="Required" IsVisible="{Binding NameMissing}" />
													<TextBlock Grid.Row="1" Grid.Column="4" Classes="Required" IsVisible="{Binding UrlMissing}" />
													<TextBlock Grid.Row="1" Grid.Column="4" Classes="Required" Text="{Binding NotWebText}" IsVisible="{Binding UrlNotWeb}" />
													<!-- What it applies to, on a board with regions (owner request, 2026-11-02). -->
													<ComboBox Grid.Column="6"
															  MinWidth="130"
															  IsVisible="{Binding ShowsAppliesTo}"
															  ItemsSource="{Binding AppliesToChoices}"
															  SelectedItem="{Binding AppliesTo, Mode=TwoWay}" />
													<StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6">
														<!-- The page opened in the browser (owner request, 2026-10-29). -->
														<Button Content="Open link"
																Tag="{Binding}"
																IsEnabled="{Binding CanOpen}"
																ToolTip.Tip="Open this page in your web browser"
																Click="OnOpenBoardLinkClick" />
														<Button Classes="Danger"
																Content="Remove"
																Tag="{Binding}"
																ToolTip.Tip="Remove this link"
																Click="OnRemoveBoardLinkClick" />
														<Border Classes="RowDragHandle"
																PointerPressed="OnBoardLinkHandlePressed"
																ToolTip.Tip="Drag to move this link up or down - or Alt+Up and Alt+Down in its boxes">
															<TextBlock Text="&#xf338;" />
														</Border>
													</StackPanel>
													<!-- What the link is about, several lines (owner request, 2026-11-06) - the "Resources"
													     tab shows it under the link. -->
													<TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7"
															 Classes="BoardRowNote"
															 Margin="0,4,0,0"
															 Text="{Binding Note, Mode=TwoWay}"
															 AcceptsReturn="True"
															 TextWrapping="Wrap"
															 MinHeight="48"
															 Watermark="Note - what this link is about, shown in the &quot;Resources&quot; tab" />
												</Grid>
											</StackPanel>
										</Border>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Button x:Name="AddBoardLinkButton"
								Classes="Accept"
								Content="Add link"
								HorizontalAlignment="Left"
								Click="OnAddBoardLinkClick" />
					</StackPanel>
				</StackPanel>

				<!-- ==== Credits ==== -->
				<StackPanel x:Name="CreditsPart" Spacing="4" Grid.IsSharedSizeScope="True">
					<TextBlock Classes="PaneIntro"
							   Text="Who made the board's data - the schematic images, the labelling, the measurements. The &quot;About&quot; tab shows them; a name or a handle is fine, and the contact is shown to everybody. Drag a credit by its handle to move it up or down - the &quot;About&quot; tab lists them in this order." />

					<TextBlock x:Name="NoCreditsText" Classes="EmptyLine" Text="No credits yet." />

					<Grid x:Name="CreditsHeadings" Classes="MovableRowHeadings">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="CreditButtons" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Classes="FieldLabel" Text="What" />
						<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Which part of it" />
						<TextBlock Grid.Column="4" Classes="FieldLabel" Text="Name or handle" />
						<TextBlock Grid.Column="6" Classes="FieldLabel" Text="Contact" />
					</Grid>

					<ItemsControl x:Name="CreditsItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneCreditRow">
								<Grid>
									<!-- While the row is dragged: a dashed slot its height, where a drop will land - the
									     worklog's photos' placeholder (ListRowDrag). -->
									<Panel IsVisible="{Binding IsDropPlaceholder}" Height="{Binding PlaceholderHeight}">
										<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
												StrokeThickness="2"
												StrokeDashArray="4,3"
												RadiusX="3"
												RadiusY="3"
												Margin="0,0,0,6"
												Fill="{DynamicResource Bg}" />
										<TextBlock Text="Move the credit up/down and release mouse button for new location"
												FontSize="11"
												Opacity="0.7"
												TextAlignment="Center"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0,0,0,6" />
									</Panel>
									<Border Classes="MovableRow" IsVisible="{Binding IsNotDropPlaceholder}">
										<StackPanel>
											<Grid RowDefinitions="Auto,Auto">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="8" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="8" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="8" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="8" />
													<ColumnDefinition Width="Auto" SharedSizeGroup="CreditButtons" />
												</Grid.ColumnDefinitions>
												<AutoCompleteBox Grid.Column="0" Classes.Missing="{Binding CategoryMissing}"
																 Text="{Binding Category, Mode=TwoWay}"
																 ItemsSource="{Binding CategoryChoices}"
																 FilterMode="Contains"
																 MinimumPrefixLength="0"
																 IsTextCompletionEnabled="False"
																 PlaceholderText="Schematic image" />
												<TextBox Grid.Column="2" Text="{Binding SubCategory, Mode=TwoWay}" Watermark="PAL, Top, CPU" />
												<TextBox Grid.Column="4" Text="{Binding NameOrHandle, Mode=TwoWay}" Classes.Missing="{Binding NameOrHandleMissing}" />
												<TextBlock Grid.Row="1" Grid.Column="0" Classes="Required" IsVisible="{Binding CategoryMissing}" />
												<TextBlock Grid.Row="1" Grid.Column="4" Classes="Required" IsVisible="{Binding NameOrHandleMissing}" />
												<TextBox Grid.Column="6" Text="{Binding Contact, Mode=TwoWay}" Watermark="A forum, a Discord, a web page" />
												<StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6">
													<Button Classes="Danger"
															Content="Remove"
															Tag="{Binding}"
															ToolTip.Tip="Remove this credit"
															Click="OnRemoveCreditClick" />
													<Border Classes="RowDragHandle"
															PointerPressed="OnCreditHandlePressed"
															ToolTip.Tip="Drag to move this credit up or down - or Alt+Up and Alt+Down in its boxes">
														<TextBlock Text="&#xf338;" />
													</Border>
												</StackPanel>
											</Grid>
										</StackPanel>
									</Border>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- "Add me" went on 2026-10-29 (owner decision: "Remove the button entirely - there is
					     already the 'Add credit' button, which can be used"). -->
					<Button x:Name="AddCreditButton"
							Classes="Accept"
							Content="Add credit"
							HorizontalAlignment="Left"
							Click="OnAddCreditClick" />
				</StackPanel>

				<!-- ==== Important signals ==== -->
				<StackPanel x:Name="ImportantSignalsPart" Spacing="4" Grid.IsSharedSizeScope="True">
					<TextBlock Classes="PaneIntro"
							   Text="The signals worth checking first on this board. Each highlights its KiCad net on the &quot;Schematics&quot; tab - pick the net from the board's KiCad data, then give it the name people know it by. Drag one by its handle to set the order the &quot;Schematics&quot; tab lists them in." />

					<TextBlock x:Name="KiCadNetsLineText" Classes="EmptyLine" IsVisible="False" />
					<TextBlock x:Name="NoSignalsText" Classes="EmptyLine" Text="No important KiCad signals yet." />

					<!-- The KiCad net FIRST and as text (owner request, 2026-10-29: "Isn't those names what is
					     present in KiCad data, so they should not be editable ... switch the columns"): the net
					     is the KiCad data's, picked below; the name shown is the contributor's own. -->
					<Grid x:Name="SignalsHeadings" Classes="MovableRowHeadings">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="8" />
							<ColumnDefinition Width="Auto" SharedSizeGroup="SignalButtons" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Classes="FieldLabel" Text="KiCad net" />
						<TextBlock Grid.Column="2" Classes="FieldLabel" Text="Important signal name" />
					</Grid>

					<ItemsControl x:Name="SignalsItemsControl">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ComponentPaneSignalRow">
								<Grid>
									<!-- While the row is dragged: a dashed slot its height, where a drop will land - the
									     worklog's photos' placeholder (ListRowDrag). -->
									<Panel IsVisible="{Binding IsDropPlaceholder}" Height="{Binding PlaceholderHeight}">
										<Rectangle Stroke="{DynamicResource Text_Fail_Fg}"
												StrokeThickness="2"
												StrokeDashArray="4,3"
												RadiusX="3"
												RadiusY="3"
												Margin="0,0,0,6"
												Fill="{DynamicResource Bg}" />
										<TextBlock Text="Move the important signal up/down and release mouse button for new location"
												FontSize="11"
												Opacity="0.7"
												TextAlignment="Center"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Margin="0,0,0,6" />
									</Panel>
									<Border Classes="MovableRow" IsVisible="{Binding IsNotDropPlaceholder}">
										<StackPanel>
											<Grid RowDefinitions="Auto,Auto">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="8" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="8" />
													<ColumnDefinition Width="Auto" SharedSizeGroup="SignalButtons" />
												</Grid.ColumnDefinitions>
												<TextBlock Grid.Column="0"
														   Text="{Binding KiCadNetName}"
														   VerticalAlignment="Center"
														   TextTrimming="CharacterEllipsis"
														   ToolTip.Tip="{Binding KiCadNetName}" />
												<TextBox Grid.Column="2" Text="{Binding DisplayName, Mode=TwoWay}" Watermark="Clock, Reset, Video" Classes.Missing="{Binding DisplayNameMissing}" />
												<TextBlock Grid.Row="1" Grid.Column="0" Classes="Required" IsVisible="{Binding NetMissing}" />
												<TextBlock Grid.Row="1" Grid.Column="2" Classes="Required" IsVisible="{Binding DisplayNameMissing}" />
												<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
													<!-- Click-to-light-up: the net lit on the Schematics tab. -->
													<Button Content="Show on board"
															Tag="{Binding}"
															IsEnabled="{Binding CanShowOnBoard}"
															ToolTip.Tip="Highlight this net on the &quot;Schematics&quot; tab"
															ToolTip.ShowOnDisabled="True"
															Click="OnShowSignalOnBoardClick" />
													<Button Classes="Danger"
															Content="Remove"
															Tag="{Binding}"
															ToolTip.Tip="Remove this signal"
															Click="OnRemoveSignalClick" />
													<Border Classes="RowDragHandle"
															PointerPressed="OnSignalHandlePressed"
															ToolTip.Tip="Drag to move this important signal up or down - or Alt+Up and Alt+Down in its boxes">
														<TextBlock Text="&#xf338;" />
													</Border>
												</StackPanel>
											</Grid>
											<TextBlock Text="{Binding Problem}"
													   IsVisible="{Binding HasProblem}"
													   Margin="0,2,0,0"
													   FontSize="11"
													   Foreground="{DynamicResource Text_Warning_Fg}"
													   TextWrapping="Wrap" />
										</StackPanel>
									</Border>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- A new signal: its net picked from the board's nets no row has (ImportantSignalSuggestions
					     .NetsToAdd), named as it would be suggested - the name changed in its row. -->
					<Grid x:Name="NewSignalPanel" ColumnDefinitions="*,8,Auto" HorizontalAlignment="Left" MinWidth="360" Margin="0,4,0,0">
						<AutoCompleteBox x:Name="NewSignalNetBox"
										 Grid.Column="0"
										 FilterMode="Contains"
										 MinimumPrefixLength="0"
										 IsTextCompletionEnabled="False"
										 PlaceholderText="Pick a KiCad net"
										 TextChanged="OnNewSignalNetChanged"
										 KeyDown="OnNewSignalNetKeyDown" />
						<Button x:Name="AddSignalButton"
								Grid.Column="2"
								Classes="Accept"
								Content="Add signal"
								IsEnabled="False"
								ToolTip.ShowOnDisabled="True"
								Click="OnAddSignalClick" />
					</Grid>

					<!-- Signals suggested from the board's KiCad net names (ComponentPane.SignalSuggestions.cs). -->
					<StackPanel x:Name="SignalSuggestionsPanel" Spacing="4" Margin="0,14,0,0" IsVisible="False">
						<TextBlock x:Name="SignalSuggestionsHeading" Classes="PaneHeading" />
						<TextBlock x:Name="SignalSuggestionsIntroText" Classes="PaneIntro" />

						<ItemsControl x:Name="SignalSuggestionsItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentPaneSignalSuggestion">
									<Grid Margin="0,0,0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="SignalButtons" />
										</Grid.ColumnDefinitions>
										<!-- The net first, as the signals above list it. -->
										<TextBlock Grid.Column="0" Text="{Binding KiCadNetName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
										<!-- The name it is added under - the suggested one, changed here first if wanted (owner request, 2026-10-30). -->
										<TextBox Grid.Column="2" Text="{Binding DisplayName, Mode=TwoWay}" Watermark="{Binding SuggestedName}" ToolTip.Tip="The name it is added under - change it first if you want another" />
										<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
											<Button Content="Show on board"
													Tag="{Binding}"
													ToolTip.Tip="Highlight this net on the &quot;Schematics&quot; tab"
													Click="OnShowSuggestionOnBoardClick" />
											<Button Classes="Accept"
													Content="Add"
													Tag="{Binding}"
													ToolTip.Tip="Add this signal"
													Click="OnAddSuggestionClick" />
										</StackPanel>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Button x:Name="AddAllSuggestionsButton"
								Classes="Accept"
								Content="Add all suggestions"
								HorizontalAlignment="Left"
								ToolTip.Tip="Add every suggested signal - one step, so &quot;Undo&quot; takes them all back"
								Click="OnAddAllSuggestionsClick" />
					</StackPanel>

					<!-- Every other net of the board, last (owner requests, 2026-11-01: "so all nets will be visible
					     in here", and "a proposed net name in an input field"). Hundreds on a real board, so
					     virtualized. -->
					<StackPanel x:Name="OtherNetsPanel" Spacing="4" Margin="0,14,0,0" IsVisible="False">
						<TextBlock x:Name="OtherNetsHeading" Classes="PaneHeading" />
						<TextBlock x:Name="OtherNetsIntroText" Classes="PaneIntro" />

						<ItemsControl x:Name="OtherNetsItemsControl">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentPaneOtherNet">
									<Grid Margin="0,0,0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="Auto" SharedSizeGroup="SignalButtons" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="{Binding KiCadNetName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
										<!-- The name it is added under - the one proposed, changed here first if wanted. -->
										<TextBox Grid.Column="2" Text="{Binding DisplayName, Mode=TwoWay}" Watermark="{Binding SuggestedName}" ToolTip.Tip="The name it is added under - change it first if you want another" />
										<StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
											<Button Content="Show on board"
													Tag="{Binding}"
													ToolTip.Tip="Highlight this net on the &quot;Schematics&quot; tab"
													Click="OnShowOtherNetOnBoardClick" />
											<Button Classes="Accept"
													Content="Add"
													Tag="{Binding}"
													ToolTip.Tip="Add this net as an important KiCad signal"
													Click="OnAddOtherNetClick" />
										</StackPanel>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</StackPanel>

			</StackPanel>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>
