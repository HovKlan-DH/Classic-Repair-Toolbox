<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.DiscardDraftWindow"
        Title="Discard draft"
        Width="420"
        MinWidth="380"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">
		<TextBlock x:Name="HeaderText" Text="Discard draft" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

		<TextBlock x:Name="IntroText" TextWrapping="Wrap" Text="This permanently discards your local, unpublished edits to:" />

		<!-- The board's name, on its own line - set from code (Initialize), never a markup
		     default, since it names a real board. -->
		<TextBlock x:Name="BoardNameText"
				   TextWrapping="Wrap"
				   FontWeight="Bold"
				   Margin="0,8,0,8" />

		<TextBlock TextWrapping="Wrap"
				   Text="Everything you have changed locally for this board - components, highlights, files and links - will be lost. The published data is not affected." />

		<!-- WHAT WILL BE LOST, listed (CRT 4.0 step 1's last slice, 2026-10-25 - the plan: "Discard
		     draft - everything, after listing what will be lost"): the draft's summary, as "Review
		     changes" words it, a dozen lines at most. Set from code (Initialize). -->
		<TextBlock x:Name="LostHeading"
				   Text="What will be lost:"
				   FontWeight="Bold"
				   Margin="0,10,0,2"
				   IsVisible="False" />
		<Border x:Name="LostBorder"
				BorderBrush="{DynamicResource Form_Border}"
				BorderThickness="1"
				CornerRadius="3"
				Padding="10,6"
				IsVisible="False">
			<StackPanel x:Name="LostPanel" Spacing="2" />
		</Border>

		<!-- Only when this board was sent for review and that review is not finished (owner request,
		     2026-09-28): says the maintainers are told, and that nothing is withdrawn. Set from code
		     (Initialize). -->
		<TextBlock x:Name="SubmissionNoticeText"
				   TextWrapping="Wrap"
				   Margin="0,8,0,0"
				   IsVisible="False" />

		<TextBlock TextWrapping="Wrap"
				   Margin="0,8,0,0"
				   Text="This cannot be undone!" />

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Cancel" Click="OnCancelClick" />
			<Button x:Name="DiscardButton"
					Classes="Danger"
					Content="Discard draft"
					Click="OnDiscardClick" />
		</StackPanel>
	</StackPanel>
</Window>
