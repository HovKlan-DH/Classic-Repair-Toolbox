<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.DiscardDraftWindow"
        Title="Discard draft"
        Width="420"
        MinWidth="380"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">
		<TextBlock x:Name="HeaderText" Text="Discard draft" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

		<TextBlock x:Name="IntroText" TextWrapping="Wrap" Text="This permanently discards your local, unpublished edits to:" />

		<!-- The system's name, on its own line - set from code (Initialize), never a markup
		     default, since it names a real board. -->
		<TextBlock x:Name="SystemNameText"
				   TextWrapping="Wrap"
				   FontWeight="Bold"
				   Margin="0,8,0,8" />

		<TextBlock TextWrapping="Wrap"
				   Text="Everything you have changed locally for this board - components, highlights, files and links - will be lost. The officially published data is not affected." />

		<TextBlock TextWrapping="Wrap"
				   Margin="0,8,0,0"
				   Text="This cannot be undone!" />

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Cancel" Click="OnCancelClick" />
			<Button x:Name="DiscardButton"
					Content="Discard draft"
					Foreground="{DynamicResource Button_Cancel_Fg}"
					Background="{DynamicResource Button_Cancel_Bg}"
					BorderBrush="{DynamicResource Button_Cancel_Border}"
					Click="OnDiscardClick" />
		</StackPanel>
	</StackPanel>
</Window>
