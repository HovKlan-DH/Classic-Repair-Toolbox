<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             xmlns:data="clr-namespace:Handlers.DataHandling;assembly=CRT.Data"
             x:Class="CRT.TabDrafts">

	<!-- THE CONTRIBUTE TAB (CRT 4.0 step 2, 2026-10-25 - the plan: "One tab instead of Contribute and
	     Drafts"). The class keeps its old name; the tab reads "Contribute". -->
	<UserControl.Resources>
		<!-- The board's draft header (CRT 4.0 step 1's last slice - the plan's header): what the draft
		     holds, its badges and the save state; then what else is to know. NO BOARD NAME (owner request,
		     2026-10-30: it was "the same as visible in the two drop-down fields in top-left corner").
		     Its buttons are the header's toolbar below it (HeaderToolbar, one row), its parts on the left
		     (WorkspaceNav). -->
		<DataTemplate x:Key="DraftRowTemplate" DataType="local:DraftListItem">
			<!-- Nothing to say, no line: the buttons under it move up (owner request, 2026-11-04). -->
			<Border Classes="DraftRow" Padding="8,8,8,4">
				<Border.IsVisible>
					<MultiBinding Converter="{x:Static BoolConverters.Or}">
						<Binding Path="HasHeaderSummary" />
						<Binding Path="HasSubmission" />
						<Binding Path="HasDrift" />
						<Binding Path="HasNote" />
						<Binding Path="Header.IsFailed" />
					</MultiBinding>
				</Border.IsVisible>
				<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
					<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="{Binding HeaderSummary}"
									   IsVisible="{Binding HasHeaderSummary}"
									   FontWeight="SemiBold"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Table_Fg}" />

							<!-- This board's latest submission (owner request, 2026-09-27),
							     in the words and colour "My submissions" gives the same state
							     (DraftListItem). Outlined like the app's other informational
							     pills: a 1px edge and text in the state's own colour. -->
							<Border Classes="SubmissionBadge"
									IsVisible="{Binding HasSubmission}"
									Background="{DynamicResource Form_Bg}"
									BorderBrush="{Binding SubmissionAccentBrush}"
									BorderThickness="1"
									CornerRadius="3"
									Padding="5,1"
									VerticalAlignment="Center"
									ToolTip.Tip="{Binding SubmissionTooltip}">
								<!-- 11px, not 10 (code review, 2026-10-13): the state - "Changes requested" above
								     all - is the line a contributor most needs to read. -->
								<TextBlock Text="{Binding SubmissionStateText}"
										   FontSize="11"
										   Foreground="{Binding SubmissionAccentBrush}" />
							</Border>

							<!-- The draft's errors and warnings are where they are (owner request, 2026-11-04;
							     TabDrafts.Problems.cs): on the left column's entries and over the page open. -->
						</StackPanel>
					</StackPanel>

					<!-- A draft saves itself, so that it did goes without saying (owner request, 2026-11-04: "this is
					     implied - it will always auto-save"; DraftHeaderState). What is said is that a save could
					     NOT be made, with Try again: that is the contributor's to know, and nothing else tells.
					     The open table has its own, beside its cells. -->
					<StackPanel Grid.Row="0" Grid.Column="1"
								Orientation="Horizontal"
								Spacing="8"
								VerticalAlignment="Center"
								HorizontalAlignment="Right">
						<Panel IsVisible="{Binding !IsTableOpen}">
							<TextBlock Classes="DraftSaveState"
									   Classes.failed="{Binding Header.IsFailed}"
									   Text="{Binding Header.SaveStateText}"
									   IsVisible="{Binding Header.IsFailed}"
									   MaxWidth="360"
									   TextWrapping="Wrap"
									   FontSize="11"
									   VerticalAlignment="Center" />
						</Panel>
						<Button Content="Try again"
								IsVisible="{Binding Header.IsFailed}"
								Command="{Binding TryAgainCommand}"
								ToolTip.Tip="Save the draft again" />
					</StackPanel>

					<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2" VerticalAlignment="Center" Margin="0,2,0,0">
						<TextBlock Text="{Binding DriftSummary}"
								   IsVisible="{Binding HasDrift}"
								   FontSize="11"
								   TextWrapping="Wrap"
								   Foreground="{DynamicResource Table_Fg}"
								   Opacity="0.75" />
						<!-- Why Submit is greyed out, or that the draft is finished with - said ON the
						     row, not only in the button's tooltip, which a keyboard or touch user never
						     sees (code review, 2026-10-13). -->
						<TextBlock Text="{Binding NoteText}"
								   IsVisible="{Binding HasNote}"
								   FontSize="11"
								   TextWrapping="Wrap"
								   Foreground="{DynamicResource Table_Fg}"
								   Opacity="0.75" />
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- One draft in the "My drafts" list: which board, what it holds, and its badges. Picking it
		     shows that board (TabDrafts.Workspace.cs). -->
		<DataTemplate x:Key="MyDraftTemplate" DataType="local:DraftListItem">
			<StackPanel Spacing="1" Margin="2,2">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
					<TextBlock Text="{Binding SubmissionStateText}"
							   IsVisible="{Binding HasSubmission}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Foreground="{Binding SubmissionAccentBrush}" />
					<TextBlock Text="{Binding ErrorsText}"
							   IsVisible="{Binding HasErrors}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource Text_Fail_Fg}" />
				</StackPanel>
				<TextBlock Text="{Binding RowSummary}" FontSize="11" Opacity="0.75" />
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Border.DraftRow">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- The header's save state - quiet while all is well, the failure colour when a save could
		     not be made. -->
		<Style Selector="TextBlock.DraftSaveState">
			<Setter Property="Opacity" Value="0.75" />
		</Style>

		<Style Selector="TextBlock.DraftSaveState.failed">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>

		<!-- The left column's entries: a part of the board, or a component - a full-width row that
		     reads as a list, not as a stack of buttons. -->
		<Style Selector="Button.WorkspaceNavItem">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="6,3" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<!-- Under "Board", and under "KiCad" within it (owner request, 2026-11-01: "a disabled 'Board' ...
		     and then indent the things below those"). -->
		<Style Selector="Button.WorkspaceNavItem.Nested">
			<Setter Property="Padding" Value="18,3,6,3" />
		</Style>

		<Style Selector="Button.WorkspaceNavItem.NestedTwice">
			<Setter Property="Padding" Value="30,3,6,3" />
		</Style>

		<Style Selector="TextBlock.WorkspaceNavGroup">
			<Setter Property="Margin" Value="18,3,6,3" />
			<Setter Property="Opacity" Value="0.75" />
		</Style>

		<Style Selector="Button.WorkspaceNavItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Table_RowHover_Bg}" />
		</Style>

		<!-- The entry open on the right reads as selected - a list's selection, as the component list
		     beside the schematics draws it (owner request, 2026-10-29). -->
		<Style Selector="Button.WorkspaceNavItem.selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<Style Selector="Button.WorkspaceNavItem.selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<!-- The left column's panel, with an edge of its own (owner request, 2026-10-29). -->
		<Style Selector="Border.WorkspaceNavPanel">
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="6,8" />
		</Style>

		<!-- The header - the draft's row and its toolbar - on the draft row's ground while there is one. -->
		<Style Selector="Border#HeaderPanel.hasDraft">
			<Setter Property="Background" Value="{DynamicResource Table_Bg}" />
		</Style>

		<Style Selector="TextBlock.WorkspaceNavHeading">
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Margin" Value="6,8,0,4" />
		</Style>

		<!-- A component's page with something on it that stops Submit. -->
		<Style Selector="Button.WorkspaceNavItem TextBlock.error">
			<Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>

		<Style Selector="TextBlock.WorkspaceNavCount">
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>


		<!-- "Board status": a panel per part of the board, its frame and icon saying how far it is (owner
		     request, 2026-11-01: "some coloring and the checkmark icon or a 'missing to do' icon"). The
		     icons differ in shape too, so nothing rests on the color alone. -->
		<Style Selector="Border.StatusPanel">
			<Setter Property="Background" Value="{DynamicResource Card_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Table_BorderRowLine}" />
			<Setter Property="BorderThickness" Value="4,1,1,1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="10,8" />
		</Style>
		<Style Selector="Border.StatusPanel.done">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Success_Fg}" />
		</Style>
		<Style Selector="Border.StatusPanel.todo">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Waiting_Fg}" />
		</Style>
		<Style Selector="Border.StatusPanel.error">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>
		<Style Selector="TextBlock.StatusIcon">
			<Setter Property="FontFamily" Value="{DynamicResource FontAwesomeSolid}" />
			<Setter Property="FontSize" Value="16" />
			<Setter Property="Margin" Value="0,2,0,0" />
		</Style>
		<Style Selector="TextBlock.StatusIcon.done">
			<Setter Property="Foreground" Value="{DynamicResource Text_Success_Fg}" />
		</Style>
		<Style Selector="TextBlock.StatusIcon.todo">
			<Setter Property="Foreground" Value="{DynamicResource Text_Waiting_Fg}" />
		</Style>
		<Style Selector="TextBlock.StatusIcon.error">
			<Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>
		<Style Selector="TextBlock.StatusIcon.optional">
			<Setter Property="Opacity" Value="0.45" />
		</Style>
		<Style Selector="TextBlock.StatusTitle">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<!-- A panel's errors and warnings, in a panel of their own inside it (owner report, 2026-11-04: "the text is
		     kind of mixed with the normal text"): the same edge and icon as the panel over a page, on a ground
		     that stands out from the card around it (TabDrafts.Readiness.cs). -->
		<Style Selector="Border.StatusProblems">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Table_BorderRowLine}" />
			<Setter Property="BorderThickness" Value="4,1,1,1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="10,8" />
			<Setter Property="Margin" Value="0,8,0,2" />
		</Style>
		<Style Selector="Border.StatusProblems.todo">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Waiting_Fg}" />
		</Style>
		<Style Selector="Border.StatusProblems.error">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>
		<Style Selector="TextBlock.StatusExplanation">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.StatusLine">
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.StatusLine.todo">
			<Setter Property="Foreground" Value="{DynamicResource Text_Waiting_Fg}" />
		</Style>
		<Style Selector="TextBlock.StatusLine.error">
			<Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>
		<!-- The suggested matches' words, under Schematic images. -->
		<Style Selector="TextBlock.ReadinessDetail">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.75" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- The tab's own line: what it is for, then "My drafts", "My submissions" and "Add a new board". -->
		<Grid Grid.Row="0" ColumnDefinitions="*,16,Auto" Margin="16,16,16,8">
			<StackPanel Grid.Column="0" Spacing="4">
				<TextBlock Text="Contribute"
						   FontSize="16"
						   FontWeight="Bold" />
				<!-- Names the board shown (ContributeBoardParts.TopLine, ShowHeader). -->
				<TextBlock x:Name="TopLineText" TextWrapping="Wrap" />

				<!-- Why "Table" or "Add a new board" made no draft - set by Main (ShowDraftProblem). -->
				<TextBlock x:Name="DraftProblemText"
						   TextWrapping="Wrap"
						   Foreground="{DynamicResource Text_Fail_Fg}"
						   IsVisible="False" />

				<!-- Shown only when a Discard could not delete the whole draft folder - most
				     often because one of its files is open in another program, which locks it on
				     Windows. Set and cleared by TabDrafts.DiscardAsync. -->
				<TextBlock x:Name="DiscardFailedText"
						   TextWrapping="Wrap"
						   Foreground="{DynamicResource Text_Warning_Fg}"
						   IsVisible="False" />
			</StackPanel>

			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
				<!-- "My drafts" (the plan: "A My drafts list in the header switches between boards"):
				     picking one shows that board, everywhere in CRT. A list that falls back to its
				     placeholder after each pick, so it reads as a menu, never as a second board name. -->
				<ComboBox x:Name="MyDraftsComboBox"
						  MinWidth="160"
						  MaxDropDownHeight="420"
						  ItemTemplate="{StaticResource MyDraftTemplate}"
						  PlaceholderText="My drafts"
						  ToolTip.Tip="Your drafts - pick one to show that board"
						  SelectionChanged="OnMyDraftsSelectionChanged" />

				<!-- Always offered, even with nothing sent yet - its own empty state explains what
				     will appear there. THE BUTTON CARRIES A BADGE when a maintainer has said
				     something that has not been read: contributing needs no account, so this window
				     is the ENTIRE channel back to the person who did the work. A circle, not a
				     lozenge (owner request, 2026-09-23). -->
				<Button x:Name="MySubmissionsButton"
						ToolTip.Tip="See what you have sent from this computer and how each one is getting on"
						Click="OnMySubmissionsClick">
					<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
						<TextBlock Text="My submissions" VerticalAlignment="Center" />
						<Border x:Name="MySubmissionsBadge"
								IsVisible="False"
								Background="IndianRed"
								CornerRadius="11"
								Width="22"
								Height="22"
								MinWidth="22"
								Padding="2,0"
								VerticalAlignment="Center">
							<TextBlock x:Name="MySubmissionsBadgeText"
									   Foreground="White"
									   FontSize="13"
									   FontWeight="SemiBold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center" />
						</Border>
					</StackPanel>
				</Button>

				<!-- NOT gated on a board: creating one is what someone does when the board they want is
				     not in the lists at all. -->
				<Button x:Name="AddNewBoardButton"
						Classes="Accept"
						Content="Add a new board"
						ToolTip.Tip="Create a whole new hardware and board of your own, as a local draft"
						Click="OnAddNewBoardClick" />
			</StackPanel>
		</Grid>

		<!-- The board shown: its draft's header, if it has a draft; then ONE row of
		     buttons (owner request, 2026-10-30: Saved, Undo and Redo on one line with four buttons under
		     them, "not aligned or anything"): "View", "UI" or "Table" on the left (owner request, 2026-11-04:
		     "these UI buttons are more important"), and on the right the draft's history - Undo, Redo - set
		     apart, then what is done with the draft as a whole. The view is there with a draft or without;
		     the rest only with a draft. The toolbar's DataContext is the draft's row (TabDrafts.Workspace.cs,
		     ShowHeader), so its buttons are never made again under a press. -->
		<StackPanel Grid.Row="1" Margin="16,0,16,8" Spacing="8">
			<Border x:Name="HeaderPanel"
					BorderBrush="{DynamicResource Table_BorderRowLine}"
					BorderThickness="0,0,0,1">
				<StackPanel>
					<ContentControl x:Name="CurrentDraftRow"
									ContentTemplate="{StaticResource DraftRowTemplate}"
									IsVisible="False" />

					<!-- No board at all: where to pick one. A board with no draft says nothing here (owner request,
					     2026-11-05: the top line says what a change does). -->
					<TextBlock x:Name="NoBoardText"
							   Margin="8,8,8,4"
							   TextWrapping="Wrap" />

					<Grid x:Name="HeaderToolbar" ColumnDefinitions="Auto,*,Auto" Margin="8,4,8,8">
						<!-- The two views of what the left column picks (owner requests, 2026-11-03 and 2026-11-04: a
						     joined switch with "View" beside it - TabDrafts.Entries.cs). As tall as the buttons
						     beside them: the row is one line of buttons. -->
						<StackPanel x:Name="ViewSwitch" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="View" VerticalAlignment="Center" Margin="0,0,8,0" />
							<Button x:Name="UiViewButton"
									Classes="Segment First Selected"
									Padding="12,5,12,6"
									Content="UI"
									ToolTip.Tip="Show what is picked on the left as its page"
									Click="OnViewClick" />
							<Button x:Name="TableViewButton"
									Classes="Segment Last"
									Padding="12,5,12,6"
									Content="Table"
									ToolTip.Tip="Show what is picked on the left as a table of its rows - every difference from the published data colored in"
									Click="OnViewClick" />
						</StackPanel>

						<StackPanel Grid.Column="2" Orientation="Horizontal">
							<!-- Undo and Redo across every editor - the open table's while it is open, which shows
							     where. Before "Review changes", set apart from the draft's own actions. -->
							<StackPanel x:Name="HistoryButtons" Orientation="Horizontal" Spacing="6" x:DataType="local:DraftListItem">
								<Button Content="Undo"
										IsEnabled="{Binding Header.CanUndo}"
										ToolTip.Tip="{Binding Header.UndoTip}"
										ToolTip.ShowOnDisabled="True"
										Command="{Binding UndoCommand}" />
								<Button Content="Redo"
										IsEnabled="{Binding Header.CanRedo}"
										ToolTip.Tip="{Binding Header.RedoTip}"
										ToolTip.ShowOnDisabled="True"
										Command="{Binding RedoCommand}" />
							</StackPanel>

							<StackPanel x:Name="DraftActions" Orientation="Horizontal" Spacing="6" Margin="28,0,0,0" x:DataType="local:DraftListItem">
								<Button Content="What changed"
										IsVisible="{Binding HasDrift}"
										ToolTip.Tip="See your changes and the published update, and bring your draft up to date"
										Command="{Binding ViewDriftCommand}" />

								<!-- What the draft changes, in words, each component with "Undo changes to" (CRT 4.0
								     step 1's last slice - ReviewChangesWindow). Greyed out while there is nothing
								     to review (owner request, 2026-10-30). -->
								<Button Content="Review changes"
										IsEnabled="{Binding CanReviewChanges}"
										ToolTip.Tip="{Binding ReviewChangesTooltip}"
										ToolTip.ShowOnDisabled="True"
										Command="{Binding ReviewChangesCommand}" />

								<!-- Sends this board for review. Disabled rather than hidden when the
								     draft has nothing in it, so the action stays where the user
								     learned it is and the tooltip can say why it is unavailable. No
								     account is needed; the dialog asks only for an email address, to
								     which the OUTCOME is mailed (SubmissionNotifier) and which "My
								     submissions" follows. Greyed out too while the draft holds exactly
								     what was last sent (2026-10-03). ShowOnDisabled, because the reason
								     it is greyed out is what the tooltip is for. -->
								<Button Classes="Accept"
										Content="Submit"
										IsEnabled="{Binding CanSubmit}"
										ToolTip.Tip="{Binding SubmitTooltip}"
										ToolTip.ShowOnDisabled="True"
										Command="{Binding SubmitCommand}" />

								<!-- "Discard draft" - everything, said on the button (the plan: "Each way of throwing
								     work away says what it covers"); the dialog lists what goes. -->
								<Button Classes="Danger"
										Content="Discard draft"
										ToolTip.Tip="Throw away this whole draft - you are shown what will be lost first"
										Command="{Binding DiscardCommand}" />
							</StackPanel>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>

			<!-- THE DRAFT IS LOCAL (owner request, 2026-10-30: "some highlighted text clearly stating that
			     this is a local draft and that it must be submitted for a board maintainer to review it,
			     before others can see it") - App.axaml's notice panel, shown while the board has a draft. -->
			<Border x:Name="LocalDraftNotice" Classes="Notice" IsVisible="False">
				<Grid ColumnDefinitions="Auto,*">
					<TextBlock Grid.Column="0" Classes="NoticeIcon" Text="&#xf05a;" />
					<TextBlock Grid.Column="1" Classes="NoticeText" x:Name="LocalDraftNoticeText" />
				</Grid>
			</Border>
		</StackPanel>

		<!-- THE WORKSPACE: the board's parts and its components on the left, what is being worked on
		     on the right (the plan's step 2 mock). The table never sits inside a ScrollViewer - it
		     would lay out every row - so the left column scrolls on its own. The column's width is
		     dragged at the splitter beside it, and kept per board (TabDrafts.Splitters.cs). -->
		<Grid Grid.Row="2" x:Name="WorkspaceGrid" ColumnDefinitions="260,4,*" Margin="16,0,16,16">

			<!-- THE LEFT COLUMN (owner decisions, 2026-11-01 and 2026-11-03): "Overview", then "Board" and
			     "Components" and what is under them - a tree, its headings no entries - and "Add component" just
			     below it. The entry open on the right is selected (TabDrafts.Entries.cs, EntryOpen). -->
			<Grid Grid.Column="0" x:Name="WorkspaceNav" RowDefinitions="Auto,Auto,*" Margin="0,0,8,0" SizeChanged="OnWorkspaceNavSizeChanged">

				<Border Grid.Row="0" Classes="WorkspaceNavPanel">
				<!-- Scrolls only on a window too low for it and the list (OnWorkspaceNavSizeChanged). -->
				<ScrollViewer x:Name="BoardNavScroll" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="0">
					<!-- The entries carry no tooltip (owner request, 2026-10-30) - their names say it.

					     "Overview" THE VERY FIRST (owner requests: "must be shown first, as this is the overview for the
					     board", 2026-11-01; "before the 'Board' one", 2026-11-03; "Board status" until 2026-11-01; the
					     start page, owner request, 2026-10-30): how far the board is, and everything it still lacks
					     (TabDrafts.Readiness.cs). Selected whenever nothing else is open on the right; picking it closes
					     what is (TabDrafts.ShowBoardStatusAsync). -->
					<Button x:Name="StatusNavButton" Classes="WorkspaceNavItem"
							Click="OnNavEntryClick">
						<TextBlock Text="Overview" />
					</Button>

					<TextBlock Classes="WorkspaceNavHeading" Text="Board" />

					<!-- The page of its own, TabDrafts.BoardName.cs (owner request, 2026-11-01: "how to edit those
					     details again afterwards"). -->
					<Button x:Name="NameNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<TextBlock Text="Name" />
					</Button>
					<!-- Whether the board comes in PAL and NTSC versions (owner decisions, 2026-11-01). -->
					<Button x:Name="RegionsNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Regions" />
							<TextBlock x:Name="RegionsCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>

					<TextBlock Classes="WorkspaceNavGroup" Text="KiCad" />
					<Button x:Name="KiCadNavButton" Classes="WorkspaceNavItem NestedTwice"
							Click="OnNavEntryClick">
						<!-- How many KiCad files the board has (owner request, 2026-10-30). -->
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Files" />
							<TextBlock x:Name="KiCadCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<!-- Just after the KiCad files (owner request, 2026-11-01) - ComponentPaneWording.ImportantSignals. -->
					<Button x:Name="SignalsNavButton" Classes="WorkspaceNavItem NestedTwice"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Important signals" />
							<TextBlock x:Name="SignalsCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>

					<Button x:Name="PicturesNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Schematic images" />
							<TextBlock x:Name="PicturesCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<!-- What the components are sorted under: renamed, added, deleted (owner request, 2026-11-01). -->
					<Button x:Name="CategoriesNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Categories" />
							<TextBlock x:Name="CategoriesCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="FilesNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Files" />
							<TextBlock x:Name="FilesCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="LinksNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Links" />
							<TextBlock x:Name="LinksCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="CreditsNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Credits" />
							<TextBlock x:Name="CreditsCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>

					<!-- The pages of the component picked in CRT's own list, in place of tabs over the pane (owner
					     request, 2026-11-03). Each says how many it holds - Basics its rows: "1" when the region
					     is not different, "2" if it is - and is red while something on it stops Submit. With none
					     picked its entry says where to pick one (NoComponentPanel). -->
					<TextBlock Classes="WorkspaceNavHeading" Text="Components" />
					<Button x:Name="BasicsNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="BasicsNavLabel" Text="Basics" />
							<TextBlock x:Name="BasicsCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="ReplacementsNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="ReplacementsNavLabel" Text="Replacement parts" />
							<TextBlock x:Name="ReplacementsCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="PinoutNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="PinoutNavLabel" Text="Pinout" />
							<TextBlock x:Name="PinoutCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="ComponentPicturesNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="ComponentPicturesNavLabel" Text="Pictures" />
							<TextBlock x:Name="ComponentPicturesCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="BaselinesNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="BaselinesNavLabel" Text="Oscilloscope baseline" />
							<TextBlock x:Name="BaselinesCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="ComponentFilesNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="ComponentFilesNavLabel" Text="Files" />
							<TextBlock x:Name="ComponentFilesCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="ComponentLinksNavButton" Classes="WorkspaceNavItem Nested"
							Click="OnNavEntryClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock x:Name="ComponentLinksNavLabel" Text="Links" />
							<TextBlock x:Name="ComponentLinksCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
				</StackPanel>
				</ScrollViewer>
				</Border>

				<!-- THE COMPONENTS ARE PICKED IN THE LISTS ON THE FAR LEFT (owner request, 2026-11-03: "why not utilize
				     the existing lists already available in the left-side"; Main.ContributeLists.cs has this tab's
				     there), so all this column has of them is the button that adds one. -->
				<Button Grid.Row="1"
						x:Name="AddComponentButton"
						Classes="Accept"
						Content="Add component"
						Margin="0,8,0,0"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Center"
						ToolTip.Tip="Add a component the board does not have yet"
						Click="OnAddComponentClick" />
			</Grid>

			<!-- The left column's width, dragged (owner request, 2026-10-29) - kept per board. A 4px
			     column in the global GridSplitter style, as the Schematics tab's (owner request,
			     2026-10-30: "bulky and visible" like every other splitter). -->
			<GridSplitter Grid.Column="1"
						  x:Name="WorkspaceSplitter"
						  ResizeDirection="Columns"
						  HorizontalAlignment="Stretch"
						  ToolTip.Tip="Drag to make the column on the left wider or narrower" />

			<Grid Grid.Column="2" x:Name="WorkspaceContent" Margin="8,0,0,0" RowDefinitions="Auto,*">
				<StackPanel Grid.Row="0">
					<!-- "Table" picked, and an entry with no table of its own (TabDrafts.Entries.cs). -->
					<Border x:Name="NoTableNotice" Classes="Notice" IsVisible="False" Margin="4,0,12,8">
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock Grid.Column="0" Classes="NoticeIcon" Text="&#xf05a;" />
							<TextBlock Grid.Column="1" Classes="NoticeText" x:Name="NoTableNoticeText" />
						</Grid>
					</Border>
				</StackPanel>

				<!-- "BOARD STATUS" (owner request, 2026-10-30 - the start page made an entry of the left column,
				     always up to date): what to do here, how far the board is, and everything it lacks - shown
				     while nothing else is open on the right, scrolled when it is long (the ScrollViewer's
				     visibility is the panel's). -->
				<ScrollViewer Grid.Row="1" IsVisible="{Binding #StartPanel.IsVisible}" HorizontalScrollBarVisibility="Disabled">
				<StackPanel x:Name="StartPanel" Spacing="8" Margin="4,0,12,12" MaxWidth="760" HorizontalAlignment="Left">
					<!-- Its headline, as every part's in the pane. -->
					<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
							BorderThickness="0,0,0,1"
							Padding="0,0,0,8"
							Margin="0,0,0,4">
						<TextBlock Text="Overview" FontSize="16" FontWeight="Bold" />
					</Border>
					<!-- What the page is for, and the two ways to work (owner's words, 2026-11-03 and 2026-11-05).
					     Nothing is dragged here: images go on "Schematic images", a KiCad project on "KiCad: Files". -->
					<TextBlock x:Name="StartText" TextWrapping="Wrap"><Run Text="The panels below walk you through every step of adding data to a board. The exact flow depends on whether the board has KiCad data. Where good KiCad data is available we recommend using it: it makes the work much easier, and the community gets more out of the board, for example by being able to follow its traces." /><LineBreak /><LineBreak /><Run Text="There are two ways to manage the data - either through the &quot;UI&quot; or the &quot;Table&quot; view. The UI is for easy management of individual entries, while the table will allow for more bulk-operations in an Excel-like style. Both give the same result, so use whichever you prefer." /></TextBlock>
					<TextBlock x:Name="PublishedOnText"
							   FontSize="11"
							   Opacity="0.75"
							   IsVisible="False" />

					<!-- What the last button here did ("Added 19 components from KiCad - ..."). -->
					<TextBlock x:Name="ReadinessNoteText" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="False" />

					<!-- A panel per part of the board (owner request, 2026-11-01), made once by
					     TabDrafts.Readiness.cs; what each says is BoardStatusPage's. -->
					<StackPanel x:Name="StatusPanelsHost" Spacing="8" Margin="0,6,0,0" IsVisible="False" />
				</StackPanel>
				</ScrollViewer>

				<local:BoardTableEditor Grid.Row="1"
										x:Name="TableEditor"
										IsVisible="False" />

				<!-- A component, edited in place (TabDrafts.Component.cs). -->
				<local:ComponentPane Grid.Row="1"
									 x:Name="ComponentPane"
									 IsVisible="False" />

				<!-- A component's page with no component picked: where to pick one (owner request, 2026-11-03). -->
				<StackPanel Grid.Row="1" x:Name="NoComponentPanel" IsVisible="False" Spacing="8" Margin="4,0,12,12" MaxWidth="760" HorizontalAlignment="Left">
					<Border BorderBrush="{DynamicResource Table_BorderRowLine}"
							BorderThickness="0,0,0,1"
							Padding="0,0,0,8"
							Margin="0,0,0,4">
						<TextBlock x:Name="NoComponentTitle" FontSize="16" FontWeight="Bold" />
					</Border>
					<!-- WHAT THE CHECKS FOUND ON THE PAGE OPEN, UNDER ITS HEADLINE (owner requests, 2026-11-04: "those errors and
					     warnings should be clearly visible in there"; "should come below the headline everywhere"). It is
					     moved to the page open (TabDrafts.Problems.cs): here, or the component pane's ProblemsHost. The
					     frame and icon as "Overview"'s panels have them. Its list scrolls: it must leave room for the page. -->
					<Decorator x:Name="NoComponentProblemsHost">
					<Border x:Name="EntryProblemsPanel" Classes="StatusPanel" IsVisible="False" Margin="4,8,12,0">
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock Grid.Column="0" x:Name="EntryProblemsIcon" Classes="StatusIcon" Margin="0,2,10,0" />
							<StackPanel Grid.Column="1" Spacing="4">
								<TextBlock x:Name="EntryProblemsTitle" Classes="StatusTitle" />
								<TextBlock x:Name="EntryProblemsHelp" Classes="StatusExplanation" />
								<ScrollViewer MaxHeight="170" HorizontalScrollBarVisibility="Disabled">
									<StackPanel Spacing="4" Margin="0,0,12,0">
										<ItemsControl x:Name="EntryProblemsList">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="local:EntryProblemRow">
													<Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
														<Border Grid.Column="0"
																Classes="NavBadge"
																Classes.error="{Binding IsError}"
																Classes.warning="{Binding IsWarning}">
															<TextBlock Text="{Binding Level}" />
														</Border>
														<TextBlock Grid.Column="1"
																   Text="{Binding Message}"
																   TextWrapping="Wrap"
																   VerticalAlignment="Center"
																   Margin="8,0" />
														<Button Grid.Column="2"
																Content="{Binding OpenLabel}"
																IsVisible="{Binding CanOpen}"
																VerticalAlignment="Center"
																Command="{Binding OpenCommand}" />
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<TextBlock x:Name="EntryProblemsMore" Classes="StatusExplanation" IsVisible="False" />
									</StackPanel>
								</ScrollViewer>
							</StackPanel>
						</Grid>
					</Border>
					</Decorator>
					<TextBlock x:Name="NoComponentText" TextWrapping="Wrap" />
				</StackPanel>

				<!-- "KiCad data" (KiCadDataPanel - a window until 2026-10-30), one made for each opening
				     (TabDrafts.KiCad.cs). -->
				<ContentControl Grid.Row="1"
								x:Name="KiCadPanelHost"
								IsVisible="False" />

				<!-- "Board name": the board's names and notes, changed on a new board (TabDrafts.BoardName.cs). -->
				<local:BoardNamePanel Grid.Row="1"
									  x:Name="BoardNamePanel"
									  IsVisible="False" />
			</Grid>
		</Grid>

		<!-- "CRT has to be updated", over the whole tab, when the server turns this version of CRT
		     away from submissions (owner request, 2026-10-09; Main.UpdateRequired.cs). It cannot be
		     closed. LAST, so it lies over everything above. -->
		<local:UpdateRequiredOverlay Grid.Row="0"
									 Grid.RowSpan="3"
									 x:Name="UpdateRequired" />

	</Grid>
</UserControl>
