<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRT"
             xmlns:data="clr-namespace:Handlers.DataHandling;assembly=CRT.Data"
             x:Class="CRT.TabDrafts">

	<!-- THE CONTRIBUTE TAB (CRT 4.0 step 2, 2026-10-25 - the plan: "One tab instead of Contribute and
	     Drafts"). The class keeps its old name; the tab reads "Contribute". -->
	<UserControl.Resources>
		<!-- The board's draft header (CRT 4.0 step 1's last slice - the plan's header): the board and
		     its badges, the save state and Undo/Redo; then what the draft is, with its actions. Its
		     files, table and parts are on the left (WorkspaceNav), not repeated here. -->
		<DataTemplate x:Key="DraftRowTemplate" DataType="local:DraftListItem">
			<Border Classes="DraftRow"
					BorderBrush="{DynamicResource Table_BorderRowLine}"
					BorderThickness="0,0,0,1"
					Padding="8,8">
				<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
					<StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="{Binding DisplayName}"
									   FontWeight="SemiBold"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Table_Fg}" />

							<!-- This board's latest submission (owner request, 2026-09-27),
							     in the words and colour "My submissions" gives the same state
							     (DraftListItem). Outlined like the app's other informational
							     pills: a 1px edge and text in the state's own colour. -->
							<Border Classes="SubmissionBadge"
									IsVisible="{Binding HasSubmission}"
									Background="{DynamicResource Form_Bg}"
									BorderBrush="{Binding SubmissionAccentBrush}"
									BorderThickness="1"
									CornerRadius="3"
									Padding="5,1"
									VerticalAlignment="Center"
									ToolTip.Tip="{Binding SubmissionTooltip}">
								<!-- 11px, not 10 (code review, 2026-10-13): the state - "Changes requested" above
								     all - is the line a contributor most needs to read. -->
								<TextBlock Text="{Binding SubmissionStateText}"
										   FontSize="11"
										   Foreground="{Binding SubmissionAccentBrush}" />
							</Border>

							<!-- The draft's errors and warnings (owner report, 2026-10-02) - the
							     table's own checks, in the colours of its sheet tabs' pills. -->
							<Border Classes="DraftErrors"
									IsVisible="{Binding HasErrors}"
									Background="{DynamicResource BoardTable_Error_Mark}"
									CornerRadius="9"
									Padding="7,0"
									VerticalAlignment="Center"
									ToolTip.Tip="Something the server would refuse. Open the table view to see it - every error has to be fixed before the draft can be submitted.">
								<TextBlock Text="{Binding ErrorsText}"
										   FontSize="10"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource BoardTable_Error_Fg}" />
							</Border>
							<Border Classes="DraftWarnings"
									IsVisible="{Binding HasWarnings}"
									Background="{DynamicResource BoardTable_Warning_Mark}"
									CornerRadius="9"
									Padding="7,0"
									VerticalAlignment="Center"
									ToolTip.Tip="Worth a look, but nothing stops the draft being submitted. Open the table view to see them.">
								<TextBlock Text="{Binding WarningsText}"
										   FontSize="10"
										   FontWeight="SemiBold"
										   Foreground="{DynamicResource BoardTable_Warning_Fg}" />
							</Border>
						</StackPanel>
					</StackPanel>

					<!-- The draft's header (DraftHeaderState): Saved / Saving... / "Could not save - <reason>"
					     with Try again, and Undo and Redo across every editor. The state is the open table's to
					     say while it is open (its own line, beside its cells); Undo and Redo then go to the
					     table, which shows where. -->
					<StackPanel Grid.Row="0" Grid.Column="1"
								Orientation="Horizontal"
								Spacing="8"
								VerticalAlignment="Center"
								HorizontalAlignment="Right">
						<TextBlock Classes="DraftSaveState"
								   Classes.failed="{Binding Header.IsFailed}"
								   Text="{Binding Header.SaveStateText}"
								   IsVisible="{Binding !IsTableOpen}"
								   MaxWidth="360"
								   TextWrapping="Wrap"
								   FontSize="11"
								   VerticalAlignment="Center" />
						<Button Content="Try again"
								IsVisible="{Binding Header.IsFailed}"
								Command="{Binding TryAgainCommand}"
								ToolTip.Tip="Save the draft again" />
						<Button Content="Undo"
								IsEnabled="{Binding Header.CanUndo}"
								ToolTip.Tip="{Binding Header.UndoTip}"
								ToolTip.ShowOnDisabled="True"
								Command="{Binding UndoCommand}" />
						<Button Content="Redo"
								IsEnabled="{Binding Header.CanRedo}"
								ToolTip.Tip="{Binding Header.RedoTip}"
								ToolTip.ShowOnDisabled="True"
								Command="{Binding RedoCommand}" />
					</StackPanel>

					<StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,4,0,0">
						<TextBlock Text="{Binding RowSummary}"
								   FontSize="11"
								   Foreground="{DynamicResource Table_Fg}"
								   Opacity="0.75" />
						<TextBlock Text="{Binding DriftSummary}"
								   IsVisible="{Binding HasDrift}"
								   FontSize="11"
								   TextWrapping="Wrap"
								   Foreground="{DynamicResource Table_Fg}"
								   Opacity="0.75" />
						<!-- Why Submit is greyed out, or that the draft is finished with - said ON the
						     row, not only in the button's tooltip, which a keyboard or touch user never
						     sees (code review, 2026-10-13). -->
						<TextBlock Text="{Binding NoteText}"
								   IsVisible="{Binding HasNote}"
								   FontSize="11"
								   TextWrapping="Wrap"
								   Foreground="{DynamicResource Table_Fg}"
								   Opacity="0.75" />
					</StackPanel>

					<Grid Grid.Row="1" Grid.Column="1"
						  ColumnDefinitions="Auto,Auto,Auto,Auto"
						  VerticalAlignment="Center"
						  HorizontalAlignment="Right"
						  Margin="0,4,0,0">
						<Button Grid.Column="0"
								Content="What changed"
								IsVisible="{Binding HasDrift}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								ToolTip.Tip="See your changes and the published update, and bring your draft up to date"
								Command="{Binding ViewDriftCommand}" />

						<!-- What the draft changes, in words, each component with "Undo changes to" (CRT 4.0
						     step 1's last slice - ReviewChangesWindow). -->
						<Button Grid.Column="1"
								Content="Review changes"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								ToolTip.Tip="See what your draft changes, component by component - and put a component back as it is published"
								Command="{Binding ReviewChangesCommand}" />

						<!-- Sends this board for review. Disabled rather than hidden when the
						     draft has nothing in it, so the action stays where the user
						     learned it is and the tooltip can say why it is unavailable. No
						     account is needed; the dialog asks only for an email address, to
						     which the OUTCOME is mailed (SubmissionNotifier) and which "My
						     submissions" follows. Greyed out too while the draft holds exactly
						     what was last sent (2026-10-03). ShowOnDisabled, because the reason
						     it is greyed out is what the tooltip is for. -->
						<Button Grid.Column="2"
								Classes="Accept"
								Content="Submit"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								IsEnabled="{Binding CanSubmit}"
								ToolTip.Tip="{Binding SubmitTooltip}"
								ToolTip.ShowOnDisabled="True"
								Command="{Binding SubmitCommand}" />

						<!-- "Discard draft" - everything, said on the button (the plan: "Each way of throwing
						     work away says what it covers"); the dialog lists what goes. -->
						<Button Grid.Column="3"
								Classes="Danger"
								Content="Discard draft"
								VerticalAlignment="Center"
								ToolTip.Tip="Throw away this whole draft - you are shown what will be lost first"
								Command="{Binding DiscardCommand}" />
					</Grid>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- One draft in the "My drafts" list: which board, what it holds, and its badges. Picking it
		     shows that board (TabDrafts.Workspace.cs). -->
		<DataTemplate x:Key="MyDraftTemplate" DataType="local:DraftListItem">
			<StackPanel Spacing="1" Margin="2,2">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
					<TextBlock Text="{Binding SubmissionStateText}"
							   IsVisible="{Binding HasSubmission}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Foreground="{Binding SubmissionAccentBrush}" />
					<TextBlock Text="{Binding ErrorsText}"
							   IsVisible="{Binding HasErrors}"
							   FontSize="11"
							   VerticalAlignment="Center"
							   Foreground="{DynamicResource Text_Fail_Fg}" />
				</StackPanel>
				<TextBlock Text="{Binding RowSummary}" FontSize="11" Opacity="0.75" />
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Border.DraftRow">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- The header's save state - quiet while all is well, the failure colour when a save could
		     not be made. -->
		<Style Selector="TextBlock.DraftSaveState">
			<Setter Property="Opacity" Value="0.75" />
		</Style>

		<Style Selector="TextBlock.DraftSaveState.failed">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>

		<!-- The left column's entries: a part of the board, or a component - a full-width row that
		     reads as a list, not as a stack of buttons. -->
		<Style Selector="Button.WorkspaceNavItem">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="6,3" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>

		<Style Selector="Button.WorkspaceNavItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Table_RowHover_Bg}" />
		</Style>

		<Style Selector="TextBlock.WorkspaceNavHeading">
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Margin" Value="6,0,0,4" />
		</Style>

		<Style Selector="TextBlock.WorkspaceNavCount">
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- The tab's own line: what it is for, then "My drafts", "My submissions" and "Add a new board". -->
		<Grid Grid.Row="0" ColumnDefinitions="*,16,Auto" Margin="16,16,16,8">
			<StackPanel Grid.Column="0" Spacing="4">
				<TextBlock Text="Contribute"
						   FontSize="16"
						   FontWeight="Bold" />
				<TextBlock TextWrapping="Wrap"
						   Text="Improve the data of the board shown. Every change is saved at once into your own draft and shows up on the board straight away - nobody else sees it until you submit it." />

				<!-- Why "Table view" or "Add a new board" made no draft - set by Main (ShowDraftProblem). -->
				<TextBlock x:Name="DraftProblemText"
						   TextWrapping="Wrap"
						   Foreground="{DynamicResource Text_Fail_Fg}"
						   IsVisible="False" />

				<!-- Shown only when a Discard could not delete the whole draft folder - most
				     often because one of its files is open in another program, which locks it on
				     Windows. Set and cleared by TabDrafts.DiscardAsync. -->
				<TextBlock x:Name="DiscardFailedText"
						   TextWrapping="Wrap"
						   Foreground="{DynamicResource Text_Warning_Fg}"
						   IsVisible="False" />
			</StackPanel>

			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
				<!-- "My drafts" (the plan: "A My drafts list in the header switches between boards"):
				     picking one shows that board, everywhere in CRT. A list that falls back to its
				     placeholder after each pick, so it reads as a menu, never as a second board name. -->
				<ComboBox x:Name="MyDraftsComboBox"
						  MinWidth="160"
						  MaxDropDownHeight="420"
						  ItemTemplate="{StaticResource MyDraftTemplate}"
						  PlaceholderText="My drafts"
						  ToolTip.Tip="Your drafts - pick one to show that board"
						  SelectionChanged="OnMyDraftsSelectionChanged" />

				<!-- Always offered, even with nothing sent yet - its own empty state explains what
				     will appear there. THE BUTTON CARRIES A BADGE when a maintainer has said
				     something that has not been read: contributing needs no account, so this window
				     is the ENTIRE channel back to the person who did the work. A circle, not a
				     lozenge (owner request, 2026-09-23). -->
				<Button x:Name="MySubmissionsButton"
						ToolTip.Tip="See what you have sent from this computer and how each one is getting on"
						Click="OnMySubmissionsClick">
					<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
						<TextBlock Text="My submissions" VerticalAlignment="Center" />
						<Border x:Name="MySubmissionsBadge"
								IsVisible="False"
								Background="IndianRed"
								CornerRadius="11"
								Width="22"
								Height="22"
								MinWidth="22"
								Padding="2,0"
								VerticalAlignment="Center">
							<TextBlock x:Name="MySubmissionsBadgeText"
									   Foreground="White"
									   FontSize="13"
									   FontWeight="SemiBold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center" />
						</Border>
					</StackPanel>
				</Button>

				<!-- NOT gated on a board: creating one is what someone does when the board they want is
				     not in the lists at all. -->
				<Button x:Name="AddNewBoardButton"
						Classes="Accept"
						Content="Add a new board"
						ToolTip.Tip="Create a whole new hardware and board of your own, as a local draft"
						Click="OnAddNewBoardClick" />
			</StackPanel>
		</Grid>

		<!-- The board shown: its draft's header, or - with no draft yet - what it is. -->
		<Grid Grid.Row="1" Margin="16,0,16,8">
			<ContentControl x:Name="CurrentDraftRow"
							ContentTemplate="{StaticResource DraftRowTemplate}"
							Background="{DynamicResource Table_Bg}"
							IsVisible="False" />

			<Border x:Name="NoDraftPanel"
					BorderBrush="{DynamicResource Table_BorderRowLine}"
					BorderThickness="0,0,0,1"
					Padding="8,8">
				<StackPanel Spacing="2">
					<TextBlock x:Name="NoDraftBoardText"
							   FontWeight="SemiBold"
							   TextWrapping="Wrap" />
					<TextBlock x:Name="NoDraftText"
							   FontSize="11"
							   Opacity="0.75"
							   TextWrapping="Wrap" />
				</StackPanel>
			</Border>
		</Grid>

		<!-- THE WORKSPACE: the board's parts and its components on the left, what is being worked on
		     on the right (the plan's step 2 mock). The table never sits inside a ScrollViewer - it
		     would lay out every row - so the left column scrolls on its own. -->
		<Grid Grid.Row="2" x:Name="WorkspaceGrid" ColumnDefinitions="260,12,*" Margin="16,0,16,16">

			<Grid Grid.Column="0" x:Name="WorkspaceNav" RowDefinitions="Auto,Auto,*,Auto">

				<!-- The board's own parts. Each opens where it is edited today: the board's pictures and
				     KiCad data in their windows, the rest on its sheet of the table view. -->
				<StackPanel Grid.Row="0" Spacing="0" Margin="0,0,0,12">
					<TextBlock Classes="WorkspaceNavHeading" Text="Board" />

					<Button x:Name="PicturesNavButton" Classes="WorkspaceNavItem"
							ToolTip.Tip="The board's pictures - schematics, PCB photos - and their names"
							Click="OnPicturesClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Pictures" />
							<TextBlock x:Name="PicturesCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="KiCadNavButton" Classes="WorkspaceNavItem"
							ToolTip.Tip="The board's KiCad project, and what it lines up with"
							Click="OnKiCadClick">
						<TextBlock Text="KiCad data" />
					</Button>
					<Button x:Name="SignalsNavButton" Classes="WorkspaceNavItem"
							ToolTip.Tip="The signals worth tracing on this board, by their KiCad net"
							Click="OnImportantSignalsClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Important signals" />
							<TextBlock x:Name="SignalsCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="FilesNavButton" Classes="WorkspaceNavItem"
							ToolTip.Tip="The board's own files and links - service manuals, videos, articles"
							Click="OnFilesAndLinksClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Files and links" />
							<TextBlock x:Name="FilesCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
					<Button x:Name="CreditsNavButton" Classes="WorkspaceNavItem"
							ToolTip.Tip="Who made the board's data - schematics, photos, measurements"
							Click="OnCreditsClick">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="Credits" />
							<TextBlock x:Name="CreditsCountText" Grid.Column="1" Classes="WorkspaceNavCount" />
						</Grid>
					</Button>
				</StackPanel>

				<StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,4">
					<TextBlock Classes="WorkspaceNavHeading" Text="Components" />
					<TextBox x:Name="ComponentSearchBox"
							 Watermark="Search components"
							 TextChanged="OnComponentSearchChanged" />
				</StackPanel>

				<ScrollViewer Grid.Row="2" x:Name="ComponentsScrollViewer">
					<StackPanel>
						<ItemsControl x:Name="ComponentsItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="data:ComponentListItem">
									<Button Classes="WorkspaceNavItem"
											Tag="{Binding}"
											ToolTip.Tip="Edit this component"
											Click="OnComponentClick">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />

											<!-- The draft changed it - the same mark the component list on the left of CRT shows. -->
											<TextBlock Grid.Column="1"
													   Text="Changed"
													   Classes="WorkspaceNavCount"
													   Margin="6,0,0,0"
													   IsVisible="{Binding IsDrafted}" />
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- What the list would hold, when it holds nothing. -->
						<TextBlock x:Name="NoComponentsText"
								   Margin="6,4,0,0"
								   FontSize="11"
								   Opacity="0.75"
								   TextWrapping="Wrap"
								   IsVisible="False" />
					</StackPanel>
				</ScrollViewer>

				<StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0">
					<Button x:Name="AddComponentButton"
							Classes="Accept"
							Content="Add component"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							ToolTip.Tip="Add a component the board does not have yet"
							Click="OnAddComponentClick" />

					<!-- The whole draft as sheets - one view of the same draft (the plan). Reads "Close
					     table view" while open. -->
					<Button x:Name="TableViewButton"
							Content="Table view"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							ToolTip.Tip="Show the whole board as sheets and rows - every difference from the published data coloured in"
							Click="OnTableViewClick" />
				</StackPanel>
			</Grid>

			<Grid Grid.Column="2">
				<!-- What to do here, until something is open on the right. -->
				<StackPanel x:Name="StartPanel" Spacing="8" Margin="4,4,0,0">
					<TextBlock x:Name="StartText"
							   TextWrapping="Wrap"
							   Text="Pick a component on the left to correct or add to what it says, or a part of the board. The table view shows the whole board as sheets." />
					<TextBlock x:Name="PublishedOnText"
							   FontSize="11"
							   Opacity="0.75"
							   IsVisible="False" />
				</StackPanel>

				<local:BoardTableEditor x:Name="TableEditor"
										IsVisible="False" />

				<!-- A component, edited in place (TabDrafts.Component.cs). -->
				<local:ComponentPane x:Name="ComponentPane"
									 IsVisible="False" />
			</Grid>
		</Grid>

		<!-- "CRT has to be updated", over the whole tab, when the server turns this version of CRT
		     away from submissions (owner request, 2026-10-09; Main.UpdateRequired.cs). It cannot be
		     closed. LAST, so it lies over everything above. -->
		<local:UpdateRequiredOverlay Grid.Row="0"
									 Grid.RowSpan="3"
									 x:Name="UpdateRequired" />

	</Grid>
</UserControl>
