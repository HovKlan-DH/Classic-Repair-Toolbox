<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.ForgetSubmissionWindow"
        Title="Remove from list"
        Width="440"
        MinWidth="400"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">
		<TextBlock Text="Remove from list" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

		<TextBlock TextWrapping="Wrap" Text="This removes the record of your contribution to:" />

		<TextBlock x:Name="SystemNameText"
				   TextWrapping="Wrap"
				   FontWeight="Bold"
				   Margin="0,8,0,8" />

		<!-- The distinction this whole dialog exists to draw. "Remove" next to a contribution that
		     is waiting for review reads as cancelling it, and it is not that. -->
		<TextBlock TextWrapping="Wrap"
				   Text="Your contribution is NOT withdrawn. It has already been sent and it will still be reviewed - but removing it from this list discards the only record this computer has of it, so the outcome can no longer be shown to you here." />

		<TextBlock TextWrapping="Wrap"
				   Margin="0,8,0,0"
				   Text="What is lost is the ability to check on it from inside CRT on this computer. That cannot be undone." />

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Cancel" Click="OnCancelClick" />
			<Button x:Name="ForgetButton"
					Content="Remove from list"
					Foreground="{DynamicResource Button_Cancel_Fg}"
					Background="{DynamicResource Button_Cancel_Bg}"
					BorderBrush="{DynamicResource Button_Cancel_Border}"
					Click="OnForgetClick" />
		</StackPanel>
	</StackPanel>
</Window>
