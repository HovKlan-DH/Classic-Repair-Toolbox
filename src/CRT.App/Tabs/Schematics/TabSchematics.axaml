<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CRT"
             xmlns:ts="clr-namespace:Tabs.TabSchematics"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CRT.TabSchematics">

	<UserControl.Styles>
		<!-- The "Global settings" popover in the panels' own colours, as the panel it replaced. -->
		<Style Selector="FlyoutPresenter.SchematicsSettings">
			<Setter Property="Background" Value="{DynamicResource Schematics_Panels_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Panels_Border}" />
			<Setter Property="Padding" Value="10,8" />
		</Style>
	</UserControl.Styles>

	<Grid x:Name="SchematicsInnerGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="80" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="*" MinWidth="100" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0"
			x:Name="SchematicsContainer"
			Focusable="True"
			ClipToBounds="True"
			PointerWheelChanged="OnSchematicsZoom"
			PointerPressed="OnSchematicsPointerPressed"
			PointerMoved="OnSchematicsPointerMoved"
			PointerReleased="OnSchematicsPointerReleased"
			Padding="0,0,0,0">
			<Grid>
				<TextBlock x:Name="SchematicsMissingImageText"
                           Text="Missing image - please refresh board after sync finishes..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg}"
                           IsVisible="False" />

				<Image x:Name="SchematicsImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       RenderTransformOrigin="0%,0%"
                       RenderOptions.BitmapInterpolationMode="HighQuality">
					<Image.RenderTransform>
						<MatrixTransform />
					</Image.RenderTransform>
				</Image>

				<ts:SchematicHighlightsOverlay x:Name="SchematicsHighlightsOverlay"
	  IsHitTestVisible="False"
	  RenderTransformOrigin="0%,0%">
					<ts:SchematicHighlightsOverlay.RenderTransform>
						<MatrixTransform />
					</ts:SchematicHighlightsOverlay.RenderTransform>
				</ts:SchematicHighlightsOverlay>

				<ts:SchematicHighlightsOverlay x:Name="SchematicsHoverHighlightsOverlay"
					  IsHitTestVisible="False"
					  RenderTransformOrigin="0%,0%">
					<ts:SchematicHighlightsOverlay.RenderTransform>
						<MatrixTransform />
					</ts:SchematicHighlightsOverlay.RenderTransform>
				</ts:SchematicHighlightsOverlay>

				<Canvas x:Name="SchematicsPolylineCanvas"
								IsHitTestVisible="False"
								RenderTransformOrigin="0%,0%"
								Background="Transparent">
					<Canvas.RenderTransform>
						<MatrixTransform />
					</Canvas.RenderTransform>
				</Canvas>

				<ts:ComponentLabelEditorOverlay x:Name="SchematicsLabelEditorOverlay"
												IsVisible="False"
												IsHitTestVisible="False"
												RenderTransformOrigin="0%,0%">
					<ts:ComponentLabelEditorOverlay.RenderTransform>
						<MatrixTransform />
					</ts:ComponentLabelEditorOverlay.RenderTransform>
				</ts:ComponentLabelEditorOverlay>

				<Canvas x:Name="SchematicsLabelsCanvas"
						IsHitTestVisible="False"
						RenderTransformOrigin="0%,0%"
						Background="Transparent"
						ZIndex="100">
					<Canvas.RenderTransform>
						<MatrixTransform />
					</Canvas.RenderTransform>
				</Canvas>

				<ts:KiCadOverlayRenderControl x:Name="SchematicsKiCadOverlayCanvas"
							  IsHitTestVisible="False"
							  RenderTransformOrigin="0%,0%">
					<ts:KiCadOverlayRenderControl.RenderTransform>
						<MatrixTransform />
					</ts:KiCadOverlayRenderControl.RenderTransform>
				</ts:KiCadOverlayRenderControl>

				<!-- Draft/final rectangle for the worklog "Add entry" area-marking flow. Reuses
				     ComponentLabelEditorOverlay: DraftRectangle while dragging, then Rectangles with
				     SelectedIndex/HoveredIndex set so the corner+side markers render once released. -->
				<ts:ComponentLabelEditorOverlay x:Name="SchematicsWorklogEntryOverlay"
												IsVisible="False"
												IsHitTestVisible="False"
												RenderTransformOrigin="0%,0%">
					<ts:ComponentLabelEditorOverlay.RenderTransform>
						<MatrixTransform />
					</ts:ComponentLabelEditorOverlay.RenderTransform>
				</ts:ComponentLabelEditorOverlay>

				<!-- Entry-number badge anchored at the top-left of a saved worklog entry's marked
				     bounds, so the board keeps showing which entry number a marking belongs to. -->
				<Canvas x:Name="SchematicsWorklogEntryBadgeCanvas"
						IsHitTestVisible="False"
						RenderTransformOrigin="0%,0%"
						Background="Transparent">
					<Canvas.RenderTransform>
						<MatrixTransform />
					</Canvas.RenderTransform>
				</Canvas>

				<!-- "Show worklogs" list view: every saved entry's marked area for the schematic
				     currently on screen, each drawn in its own category color. Toggled by the
				     top-bar "Show worklogs" checkbox - see TabSchematics.Worklog.cs. -->
				<ts:WorklogEntriesOverlay x:Name="SchematicsWorklogEntriesOverlay"
										   IsVisible="False"
										   IsHitTestVisible="False"
										   RenderTransformOrigin="0%,0%">
					<ts:WorklogEntriesOverlay.RenderTransform>
						<MatrixTransform />
					</ts:WorklogEntriesOverlay.RenderTransform>
				</ts:WorklogEntriesOverlay>

				<!-- "#N" badge + category/state pill for each entry shown by the "Show worklogs"
				     list view above. Populated/positioned in TabSchematics.Worklog.cs. Each badge
				     is clickable (opens the full editor), so unlike the other overlay canvases the
				     canvas itself stays hit-test visible; its own Background="Transparent" keeps
				     clicks on empty space from being captured. -->
				<Canvas x:Name="SchematicsWorklogEntriesBadgeCanvas"
						RenderTransformOrigin="0%,0%"
						Background="Transparent">
					<Canvas.RenderTransform>
						<MatrixTransform />
					</Canvas.RenderTransform>
				</Canvas>

				<!-- Parked pills: the "#N" badges of entries whose "Show marked area" is unticked,
				     stacked in the top-right corner. Deliberately NOT the canvas above - that one
				     carries the view matrix so its badges pan and zoom with the board, which is
				     exactly what a parked pill must not do. This canvas is untransformed, so its
				     children sit in the container's own coordinate space and stay pinned to the
				     corner. Positioned in TabSchematics.Worklog.cs; ZIndex keeps them above the
				     board but below the "Netlist names" panel (200) they step aside for.

				     NO Background: in Avalonia a null background is not hit-testable while
				     Transparent IS, so giving this canvas one would make it swallow every press
				     across the whole schematic panel and kill panning. The pills themselves are
				     Borders with their own background, so they stay clickable regardless. -->
				<Canvas x:Name="SchematicsWorklogParkedBadgeCanvas"
						ZIndex="150" />

				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							Margin="10,10,0,0"
							Spacing="8"
							IsHitTestVisible="False">

					<Border x:Name="SchematicsNameBorder"
							IsVisible="False"
							Background="{DynamicResource Schematics_Name_Bg}"
							BorderBrush="{DynamicResource Schematics_Name_Border}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8,4">
						<TextBlock x:Name="SchematicsNameLabel"
						   FontSize="11"
						   FontWeight="Normal"
						   Foreground="{DynamicResource Schematics_Name_Fg}" />
					</Border>

					<Border x:Name="SchematicsRegionBorder"
						IsVisible="False"
						BorderThickness="1"
						CornerRadius="4"
						Padding="8,4">
						<TextBlock x:Name="SchematicsRegionLabel"
					   FontSize="11"
					   FontWeight="Normal" />
					</Border>
				</StackPanel>

				<StackPanel Orientation="Horizontal"
					HorizontalAlignment="Left"
					VerticalAlignment="Top"
					Margin="10,44,0,0"
					Spacing="6"
					IsHitTestVisible="False">
					<Border x:Name="SchematicsHoverLabelBorder"
						IsVisible="False"
						Background="{DynamicResource Schematics_ComponentHover_Bg}"
						BorderBrush="{DynamicResource Schematics_ComponentHover_Border}"
						BorderThickness="1"
						CornerRadius="4"
						Padding="8,4">
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBlock x:Name="SchematicsHoverLabelIdText"
								IsVisible="False"
								FontSize="11"
								FontWeight="Bold"
								VerticalAlignment="Center"
								Foreground="White" />
							<!-- The hovered entry's state: a solid disc of the state colour inside a
							     white ring, matching CreateWorklogEntriesListBadge's on-board badge.
							     No glyph inside - the fill IS the state, and a white glyph would
							     cover the colour it is meant to show. -->
							<Border x:Name="SchematicsHoverLabelIconBorder"
								IsVisible="False"
								Width="16"
								Height="16"
								CornerRadius="8"
								BorderBrush="White"
								BorderThickness="1"
								VerticalAlignment="Center" />
							<TextBlock x:Name="SchematicsHoverLabelText"
								FontSize="11"
										FontWeight="Bold"
										VerticalAlignment="Center"
										Foreground="{DynamicResource Schematics_ComponentHover_Fg}" />
						</StackPanel>
					</Border>
					<Border x:Name="SchematicsHoverPadBorder"
						IsVisible="False"
						Background="{DynamicResource Schematics_ComponentHover_Bg}"
						BorderBrush="{DynamicResource Schematics_ComponentHover_Border}"
						BorderThickness="1"
						CornerRadius="4"
						Padding="8,4">
						<StackPanel Orientation="Horizontal" Spacing="2">
							<TextBlock Text="Pin"
								FontSize="11"
								FontWeight="Normal"
								Foreground="{DynamicResource Schematics_ComponentHover_Fg}" />
							<TextBlock x:Name="SchematicsHoverPadText"
								FontSize="11"
								FontWeight="Bold"
								Foreground="{DynamicResource Schematics_ComponentHover_Fg}" />
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- THE ONE-TIME TIP on moving and zooming (CRT 4.0 step 5 - the plan: "a middle-button
				     drag pans too, with a one-time hint in the corner"): under the picture's name, put
				     away by "Got it" or by the first pan, never shown again. TabSchematics.ViewTools.cs. -->
				<Border x:Name="PanHintBorder"
						IsVisible="False"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						Margin="10,44,10,0"
						ZIndex="210"
						Background="{DynamicResource Schematics_Panels_Bg}"
						BorderBrush="{DynamicResource Schematics_Panels_Border}"
						BorderThickness="1"
						CornerRadius="4"
						Padding="10,6"
						PointerPressed="OnPanHintPointerPressed">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBlock x:Name="PanHintText"
								   FontSize="11"
								   MaxWidth="320"
								   TextWrapping="Wrap"
								   VerticalAlignment="Center"
								   Foreground="{DynamicResource Schematics_Panels_Fg}" />
						<Button x:Name="PanHintGotItButton"
								Content="Got it"
								FontSize="11"
								Padding="8,2"
								VerticalAlignment="Center"
								Click="OnPanHintGotItClick" />
					</StackPanel>
				</Border>

				<!-- BOTTOM LEFT SETTINGS PANELS -->
				<Grid HorizontalAlignment="Left"
					  VerticalAlignment="Bottom"
					  Margin="10,0,0,10"
					  RowDefinitions="Auto"
					  ColumnDefinitions="Auto,Auto,Auto"
					  ColumnSpacing="8"
					  ZIndex="200">

					<!-- GLOBAL SETTINGS: a gear button whose popover holds them (CRT 4.0 step 5 - the plan:
					     "Global settings become a gear button that opens a popover"). The rows are the
					     panel's as they were, wired by name in TabSchematics.Settings.cs; the popover takes
					     the panels' own colours (FlyoutPresenter.SchematicsSettings, above). -->
					<Button x:Name="GlobalSettingsButton"
							IsVisible="False"
							Grid.Row="0"
							Grid.Column="0"
							HorizontalAlignment="Left"
							VerticalAlignment="Bottom"
							Padding="9,6"
							ToolTip.Tip="Global settings">
						<TextBlock Text="&#xf013;"
								   FontFamily="{DynamicResource FontAwesomeSolid}"
								   FontSize="14" />
						<Button.Flyout>
							<Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="SchematicsSettings">
						<StackPanel Spacing="6">

							<TextBlock Text="Global settings"
									   FontSize="11"
									   FontWeight="Bold"
									   Foreground="{DynamicResource Schematics_Panels_Fg}" />

							<StackPanel x:Name="GlobalSettingsListPanel" Spacing="4">

								<StackPanel x:Name="GlobalHoverHighlightsTracesRow"
											Orientation="Horizontal"
											Spacing="6"
											Background="Transparent"
											Cursor="Hand"
											PointerPressed="OnGlobalHoverHighlightsTracesRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckGlobalHoverHighlightsTraces"
												  MinHeight="0"
												  Margin="0"
												  Padding="0"
												  CornerRadius="2"
												  IsChecked="True"
												  IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Highlight trace on hover"
											   FontSize="11"
											   Foreground="{DynamicResource SchematicsPanels_Fg}"
											   VerticalAlignment="Center"
											   IsHitTestVisible="False" />
								</StackPanel>

								<StackPanel x:Name="SchematicsInteractiveCadTraceHoverHoldShiftRow"
										IsVisible="False"
										Orientation="Horizontal"
										Spacing="6"
										Background="Transparent"
										Cursor="Hand"
										PointerPressed="OnSchematicsInteractiveCadTraceHoverHoldShiftRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="SchematicsInteractiveCadTraceHoverHoldShiftCheckBox"
												  MinHeight="0"
												  Margin="0"
												  Padding="0"
												  CornerRadius="2"
												  VerticalAlignment="Center"
												  IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Hold SHIFT to highlight trace on hover"
											   FontSize="11"
											   Foreground="{DynamicResource SchematicsPanels_Fg}"
											   VerticalAlignment="Center"
											   IsHitTestVisible="False" />
								</StackPanel>

								<StackPanel x:Name="GlobalShowTracesOnComponentSelectRow"
									Orientation="Horizontal"
									Spacing="6"
									Background="Transparent"
									Cursor="Hand"
									PointerPressed="OnGlobalShowTracesOnComponentSelectRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckGlobalShowTracesOnComponentSelect"
												  MinHeight="0"
												  Margin="0"
												  Padding="0"
												  CornerRadius="2"
												  IsChecked="True"
												  IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Highlight component traces on select"
											   FontSize="11"
											   Foreground="{DynamicResource SchematicsPanels_Fg}"
											   VerticalAlignment="Center"
											   IsHitTestVisible="False" />
								</StackPanel>

								<StackPanel x:Name="BoardShowTracesOnSelectedComponentRow"
											Orientation="Horizontal"
											Spacing="6"
											Background="Transparent"
											Cursor="Hand"
											PointerPressed="OnBoardShowTracesOnSelectedComponentRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckBoardShowTracesOnSelectedComponent"
												  MinHeight="0"
												  Margin="0"
												  Padding="0"
												  CornerRadius="2"
												  IsChecked="True"
												  IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Highlight component traces on hover"
											   FontSize="11"
											   Foreground="{DynamicResource SchematicsPanels_Fg}"
											   VerticalAlignment="Center"
											   IsHitTestVisible="False" />
								</StackPanel>
								
								<StackPanel x:Name="GlobalShowOppositeSideTracesRow"
											IsVisible="False"
											Orientation="Horizontal"
											Spacing="6"
											Background="Transparent"
											Cursor="Hand"
											PointerPressed="OnGlobalShowOppositeSideTracesRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckGlobalShowOppositeSideTraces"
											  MinHeight="0"
											  Margin="0"
											  Padding="0"
											  CornerRadius="2"
											  IsChecked="True"
											  IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Show traces from opposite side"
											   FontSize="11"
											   Foreground="{DynamicResource SchematicsPanels_Fg}"
											   VerticalAlignment="Center"
											   IsHitTestVisible="False" />
								</StackPanel>

								<StackPanel x:Name="GlobalShowCalibrationTracesAndPadsRow"
										IsVisible="False"
										Orientation="Horizontal"
										Spacing="6"
										Background="Transparent"
										Cursor="Hand"
										PointerPressed="OnGlobalShowCalibrationTracesAndPadsRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckGlobalShowCalibrationTracesAndPads"
												  MinHeight="0"
												  Margin="0"
												  Padding="0"
												  CornerRadius="2"
												  IsChecked="True"
												  IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Show traces and pads"
											   FontSize="11"
											   FontWeight="Bold"
											   Foreground="{DynamicResource Text_Fail_Fg}"
											   VerticalAlignment="Center"
											   IsHitTestVisible="False" />
								</StackPanel>
								
								<StackPanel x:Name="GlobalShowZonesRow"
											IsVisible="False"
											Orientation="Horizontal"
											Spacing="6"
											Background="Transparent"
											Cursor="Hand"
											PointerPressed="OnGlobalShowZonesRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckGlobalShowZones"
												  MinHeight="0"
												  Margin="0"
												  Padding="0"
												  CornerRadius="2"
												  IsChecked="True"
												  IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Show zones"
											   FontSize="11"
											   Foreground="{DynamicResource SchematicsPanels_Fg}"
											   VerticalAlignment="Center"
											   IsHitTestVisible="False" />
								</StackPanel>

								<StackPanel x:Name="BoardMarkPin1OnSelectedComponentRow"
									IsVisible="False"
									Orientation="Horizontal"
									Spacing="6"
									Background="Transparent"
									Cursor="Hand"
									PointerPressed="OnBoardMarkPin1OnSelectedComponentRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckBoardMarkPin1OnSelectedComponent"
												  MinHeight="0"
												  Margin="0"
												  Padding="0"
												  CornerRadius="2"
												  IsChecked="False"
												  IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Mark first pin on component"
											   FontSize="11"
											   Foreground="{DynamicResource SchematicsPanels_Fg}"
											   VerticalAlignment="Center"
											   IsHitTestVisible="False"/>
								</StackPanel>

							</StackPanel>
						</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>

					<!-- LABELS VISIBLE PANEL -->
					<Border x:Name="LabelsPanel"
							Grid.Row="0"
							Grid.Column="1"
							HorizontalAlignment="Left"
							VerticalAlignment="Bottom"
							Background="{DynamicResource Schematics_Panels_Bg}"
							BorderBrush="{DynamicResource Schematics_Panels_Border}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8,8">
						<StackPanel Spacing="6">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
								<TextBlock Grid.Column="0"
										   Text="Labels visible"
										   FontSize="11"
										   VerticalAlignment="Center"
										   FontWeight="Bold"
										   Foreground="{DynamicResource Schematics_Panels_Fg}" />
								<Button x:Name="ToggleLabelsPanelButton"
										Grid.Column="1"
										Content="Collapse"
										FontSize="9"
										Padding="6,2"
										HorizontalAlignment="Right"
										VerticalAlignment="Top" />
							</Grid>

							<StackPanel x:Name="LabelsListPanel" Spacing="4">
								<StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" Cursor="Hand" PointerPressed="OnLabelBoardRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckLabelBoard" MinHeight="0" Margin="0" Padding="0" CornerRadius="2" IsChecked="False" IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Board label" FontSize="11" Foreground="{DynamicResource SchematicsPanels_Fg}" VerticalAlignment="Center" IsHitTestVisible="False"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" Cursor="Hand" PointerPressed="OnLabelTechnicalRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckLabelTechnical" MinHeight="0" Margin="0" Padding="0" CornerRadius="2" IsChecked="False" IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Technical name" FontSize="11" Foreground="{DynamicResource SchematicsPanels_Fg}" VerticalAlignment="Center" IsHitTestVisible="False"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" Cursor="Hand" PointerPressed="OnLabelFriendlyRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckLabelFriendly" MinHeight="0" Margin="0" Padding="0" CornerRadius="2" IsChecked="False" IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Friendly name" FontSize="11" Foreground="{DynamicResource SchematicsPanels_Fg}" VerticalAlignment="Center" IsHitTestVisible="False"/>
								</StackPanel>

								<StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" Cursor="Hand" PointerPressed="OnLabelSelectedOnlyRowClicked">
									<Viewbox Width="20" Height="20" IsHitTestVisible="False">
										<CheckBox x:Name="CheckLabelSelectedOnly" MinHeight="0" Margin="0" Padding="0" CornerRadius="2" IsChecked="False" IsHitTestVisible="False" />
									</Viewbox>
									<TextBlock Text="Selected components only" FontSize="11" Foreground="{DynamicResource SchematicsPanels_Fg}" VerticalAlignment="Center" IsHitTestVisible="False"/>
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</Border>

					<!-- IMPORTANT SIGNALS PANEL -->
					<Border x:Name="ImportantSignalsPanel"
							Grid.Row="0"
							Grid.Column="2"
							HorizontalAlignment="Left"
							VerticalAlignment="Bottom"
							Background="{DynamicResource Schematics_Panels_Bg}"
							BorderBrush="{DynamicResource Schematics_Panels_Border}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8,8"
							IsVisible="False">
						<StackPanel Spacing="6">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
								<TextBlock x:Name="ImportantSignalsHeaderTextBlock"
									   Grid.Column="0"
									   Text="Important signals"
									   FontSize="11"
									   VerticalAlignment="Center"
									   FontWeight="Bold"
									   Foreground="{DynamicResource Schematics_Panels_Fg}" />
								<Button x:Name="ToggleImportantSignalsPanelButton"
										Grid.Column="1"
										Content="Collapse"
										FontSize="9"
										Padding="6,2"
										HorizontalAlignment="Right"
										VerticalAlignment="Top" />
							</Grid>

							<StackPanel x:Name="ImportantSignalsListPanel" Spacing="6">
								<ListBox x:Name="ImportantSignalsListBox"
										 SelectionMode="Multiple,Toggle"
										 MinWidth="180"
										 MaxHeight="180"
										 BorderThickness="1"
										 CornerRadius="4"
										 ClipToBounds="True"
										 Padding="0"
										 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{ReflectionBinding DisplayName}"
													   ToolTip.Tip="{ReflectionBinding ToolTipText}"
													   TextWrapping="Wrap" />
										</DataTemplate>
									</ListBox.ItemTemplate>

									<ListBox.Styles>
										<Style Selector="ListBox /template/ Border">
											<Setter Property="CornerRadius" Value="3" />
											<Setter Property="ClipToBounds" Value="True" />
										</Style>
										<Style Selector="ListBox /template/ ScrollViewer">
											<Setter Property="CornerRadius" Value="3" />
											<Setter Property="ClipToBounds" Value="True" />
										</Style>
										<Style Selector="ListBoxItem">
											<Setter Property="Padding" Value="8,3" />
											<Setter Property="MinHeight" Value="0" />
											<Setter Property="FontSize" Value="11" />
										</Style>
									</ListBox.Styles>
								</ListBox>
							</StackPanel>

							<Button x:Name="ClearImportantSignalsButton"
								Content="Clear All"
								FontSize="9"
								Padding="6,2"
								Margin="0,8,0,0"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								IsVisible="True"
								IsEnabled="False" />
						</StackPanel>
					</Border>
				</Grid>

				<!-- BOTTOM-RIGHT OVERLAY STACK -->
				<StackPanel x:Name="SchematicsBottomRightOverlayStack"
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Margin="0,0,10,10"
							Spacing="8"
							ZIndex="200">

					<!-- KICAD DATA INITIALIZING INDICATOR -->
					<Border x:Name="KiCadInitializingIndicator"
							IsVisible="False"
							IsHitTestVisible="False"
							HorizontalAlignment="Right"
							Background="{DynamicResource Schematics_Name_Bg}"
							BorderBrush="{DynamicResource Schematics_Name_Border}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8,4">
						<TextBlock x:Name="KiCadInitializingIndicatorText"
								   Text="KiCad data initializing..."
								   FontSize="11"
								   FontWeight="Normal"
								   Foreground="{DynamicResource Schematics_Name_Fg}" />
					</Border>

					<!-- "DRAW TRACE" (CRT 4.0 step 5 - the plan: "Traces are drawn only with Draw trace"):
					     traces are drawn and changed only while it is on; "Done drawing" or Escape stops.
					     Shown with a picture. TabSchematics.ViewTools.cs. -->
					<Button x:Name="DrawTraceButton"
							IsVisible="False"
							HorizontalAlignment="Right"
							Content="Draw trace"
							FontSize="11"
							Padding="8,4"
							Click="OnDrawTraceClick" />

					<!-- DYNAMIC POLYLINE TRACES LIST PANEL -->
					<Border x:Name="TracesPanel"
							IsVisible="False"
							HorizontalAlignment="Right"
							Background="{DynamicResource Schematics_Panels_Bg}"
							BorderBrush="{DynamicResource Schematics_Panels_Border}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8,8">
						<StackPanel Spacing="6">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="Traces visible"
										   FontSize="11"
										   VerticalAlignment="Center"
										   FontWeight="Bold"
										   Foreground="{DynamicResource SchematicsPanels_Fg}" />
								<Button x:Name="ClearTracesButton"
										Classes="Danger"
										Content="Clear All"
										FontSize="9"
										Padding="6,2"
										VerticalAlignment="Center" />
							</StackPanel>
							<StackPanel x:Name="TracesListPanel" Spacing="4" />

							<Button x:Name="UndoDeletedTraceButton"
									Content="Undo deletion"
									FontSize="9"
									Padding="6,2"
									HorizontalAlignment="Stretch"
									HorizontalContentAlignment="Center"
									IsVisible="False" />
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- CONTEXTUAL FLOATING TRACE PALETTE -->
				<Border x:Name="TraceFloatingPalette"
						IsVisible="False"
						HorizontalAlignment="Left"
						VerticalAlignment="Top"
						ZIndex="300"
						Background="{DynamicResource Schematics_Panels_Bg}"
						BorderBrush="{DynamicResource Schematics_Panels_Border}"
						BorderThickness="1"
						CornerRadius="8"
						Padding="8,6"
						BoxShadow="0 4 10 0 #40000000">
					<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

						<StackPanel x:Name="DynamicPaletteColorsPanel" Orientation="Horizontal" Spacing="10" />

						<Border Width="1" Height="18" Background="{DynamicResource Schematics_Panels_Fg}" Margin="2,0"/>

						<Button x:Name="CustomColorButton"
								Width="18" Height="18"
								CornerRadius="9"
								Padding="0"
								Cursor="Hand"
								Background="White"
								BorderBrush="White"
								BorderThickness="1">
							<Button.Flyout>
								<Flyout Placement="BottomEdgeAlignedLeft">
									<ColorView x:Name="TraceColorPicker"
											   Color="White"
											   PropertyChanged="OnTraceColorPickerPropertyChanged" />
								</Flyout>
							</Button.Flyout>
						</Button>

						<Border Width="1" Height="18" Background="{DynamicResource SchematicsPanels_Fg}" Margin="2,0"/>

						<TextBlock Text="🗑"
								   FontSize="16"
								   Cursor="Hand"
								   PointerPressed="OnPaletteDeleteClicked"
								   VerticalAlignment="Center"
								   Margin="2,0"/>
					</StackPanel>
				</Border>

				<!-- KICAD NET CONNECTIONS PANEL -->
				<Border x:Name="KiCadNetConnectionsPanel"
						IsVisible="False"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="10,10,10,10"
						ZIndex="200"
						Background="{DynamicResource Schematics_Panels_Bg}"
						BorderBrush="{DynamicResource Schematics_Panels_Border}"
						BorderThickness="1"
						CornerRadius="4"
						Padding="8,8"
						MinWidth="120"
						MaxWidth="250">

					<StackPanel Spacing="6">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
							<TextBlock x:Name="KiCadNetConnectionsHeaderTextBlock"
								   Grid.Column="0"
								   Text="Netlist names"
								   FontSize="11"
								   VerticalAlignment="Center"
								   FontWeight="Bold"
								   Foreground="{DynamicResource Schematics_Panels_Fg}" />
							<Button x:Name="ToggleKiCadNetConnectionsPanelButton"
									Grid.Column="1"
									Content="Collapse"
									FontSize="9"
									Padding="6,2"
									HorizontalAlignment="Right"
									VerticalAlignment="Top" />
						</Grid>

						<StackPanel x:Name="KiCadNetConnectionsContentPanel" Spacing="4">
							<TextBlock x:Name="KiCadNetConnectionsNetNameText"
									   FontSize="11"
									   Foreground="{DynamicResource Schematics_Panels_Fg}"
									   TextWrapping="Wrap"
									   Margin="8,0,0,4" />

							<TextBlock Text="Connected to:"
									   FontSize="11"
									   FontWeight="Bold"
									   Foreground="{DynamicResource Schematics_Panels_Fg}" />

							<ScrollViewer HorizontalScrollBarVisibility="Disabled"
										  Margin="0,4,0,0"
										  MaxHeight="260">
								<ItemsControl x:Name="KiCadNetConnectionsList">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding}"
													   FontSize="11"
													   Foreground="{DynamicResource Schematics_Panels_Fg}"
													   Margin="8,2,0,0"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</StackPanel>

						<Button x:Name="ClearKiCadTraceSelectionButton"
								Content="Clear All"
								FontSize="9"
								Padding="6,2"
								Margin="0,8,0,0"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								IsVisible="False"
								IsEnabled="False" />
					</StackPanel>
				</Border>

			</Grid>
		</Border>

		<GridSplitter x:Name="SchematicsSplitter"
                      Grid.Column="1"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch" />

		<!-- The thumbnail panel: the SAME auto-fit gallery the detached thumbnails window shows
		     (owner request, 2026-10-15) - every thumbnail at once, as large as the column allows,
		     in several columns once it is wide enough, never scrolled. Wired in the constructor. -->
		<local:SchematicsThumbnailGallery x:Name="InlineThumbnailGallery"
		                                  Grid.Column="2" />

		<!-- Right-click menu over the inline thumbnail panel - a quick way to detach thumbnails to
		     their own window without going to the Configuration tab. Same visual style as
		     SchematicsMenuBorder below (Schematics_Panels_Bg/Border, CornerRadius 6),
		     but a separate control: that menu is contributor-mode/label-editor/calibration specific
		     and lives over the schematic image, not the thumbnail column. -->
		<!-- Spans ALL THREE columns (no Grid.Column), deliberately. Confined to the thumbnail
		     column it could never be wider than that column, which is routinely ~170px - the text
		     then wrapped down to one character per line. It opens to the LEFT of the cursor
		     instead (see OnThumbnailsPanelPointerPressedForContextMenu), growing over the schematic
		     image where there is room, so it stays one readable line whatever the splitter is set
		     to. Its own Width keeps that line from being re-wrapped by the measure pass. -->
		<Border x:Name="SchematicsThumbnailsContextMenuBorder"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				IsVisible="False"
				ZIndex="5000"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Width="260"
				Background="{DynamicResource Schematics_Panels_Bg}"
				BorderBrush="{DynamicResource Schematics_Panels_Border}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="10,8">
			<StackPanel Spacing="8">
				<Button x:Name="DetachThumbnailsContextMenuButton"
						HorizontalAlignment="Stretch"
						Click="OnDetachThumbnailsContextMenuButtonClick">
					<TextBlock Text="Detach thumbnails into their own window"
							   TextWrapping="Wrap" />
				</Button>
			</StackPanel>
		</Border>

		<Border x:Name="SchematicsMenuBorder"
				IsVisible="False"
				ZIndex="5000"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Background="{DynamicResource Schematics_Panels_Bg}"
				BorderBrush="{DynamicResource Schematics_Panels_Border}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="10,8">
			<!-- THE MENU A RIGHT-CLICK ON A COMPONENT OPENS, for everyone (CRT 4.0 step 2, slice 6 - the
			     plan: "Right-clicking a component offers Edit this component to everyone"). It was
			     contributor mode's menu over an empty spot; the two tools it offered now start from the
			     Contribute tab's Pictures, with the bar below (TabSchematics.PictureTools.cs). -->
			<StackPanel x:Name="SchematicsMenuPanel"
						Spacing="8"
						Width="235">
				<TextBlock x:Name="SchematicsMenuTitleText"
						   FontSize="11"
						   FontWeight="Bold"
						   TextWrapping="Wrap"
						   Foreground="{DynamicResource Schematics_Panels_Fg}" />

				<Button x:Name="MenuHighlightButton"
						HorizontalAlignment="Stretch" />

				<Button x:Name="MenuEditComponentButton"
						Content="Edit this component"
						HorizontalAlignment="Stretch" />
			</StackPanel>
		</Border>

		<!-- THE PICTURE TOOL'S BAR (slice 6 - the plan: "Mark components and Align KiCad open the
		     Schematics tab in that tool, with a bar and a Done button"): what the tool is on, how it
		     is used, and Done (saves into the draft) and Cancel - or, when the tool cannot start on
		     the picture, why, and Close. Over the top of the picture, in its column. -->
		<Border x:Name="PictureToolBarBorder"
				IsVisible="False"
				ZIndex="4999"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				MaxWidth="720"
				Margin="12,8,12,0"
				Background="{DynamicResource Schematics_Panels_Bg}"
				BorderBrush="{DynamicResource Schematics_Panels_Border}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="12,8">
			<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
				<StackPanel Spacing="2" VerticalAlignment="Center">
					<TextBlock x:Name="PictureToolTitleText"
							   FontWeight="Bold"
							   TextWrapping="Wrap"
							   Foreground="{DynamicResource Schematics_Panels_Fg}" />
					<TextBlock x:Name="PictureToolHelpText"
							   FontSize="12"
							   TextWrapping="Wrap"
							   Foreground="{DynamicResource Schematics_Panels_Fg}" />
				</StackPanel>
				<StackPanel Grid.Column="1"
							Orientation="Horizontal"
							Spacing="8"
							VerticalAlignment="Center">
					<Button x:Name="PictureToolCancelButton"
							Content="Cancel" />
					<Button x:Name="PictureToolDoneButton"
							Classes="Accept"
							Content="Done" />
					<!-- While aligning, with another picture to align (step 3, slice 3d - the plan: "Align:
					     opens calibration on the Schematics tab with a Done - next picture button"). -->
					<Button x:Name="PictureToolDoneNextButton"
							Classes="Accept"
							Content="Done - next picture"
							IsVisible="False" />
				</StackPanel>

				<!-- THE COMPONENTS NOT MARKED ON THIS PICTURE YET (step 3, slice 3c - the plan: "Photos
				     and scanned schematics use the label editor as today, with the unmarked components
				     listed beside it"): while the label editor is on, in the bar - never over the
				     picture's corners, which hold the settings and the traces. Pick one, draw its
				     rectangle, and it is named - no question asked (TabSchematics.LabelEditor.Unmarked.cs). -->
				<Border x:Name="UnmarkedPanelBorder"
						Grid.Row="1"
						Grid.ColumnSpan="2"
						IsVisible="False"
						Margin="0,8,0,0"
						Padding="0,8,0,0"
						BorderBrush="{DynamicResource Schematics_Panels_Border}"
						BorderThickness="0,1,0,0">
					<StackPanel Spacing="4">
						<TextBlock x:Name="UnmarkedHeadingText"
								   FontWeight="Bold"
								   Foreground="{DynamicResource Schematics_Panels_Fg}" />
						<TextBlock x:Name="UnmarkedHelpText"
								   FontSize="12"
								   TextWrapping="Wrap"
								   Foreground="{DynamicResource Schematics_Panels_Fg}" />
						<ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
							<WrapPanel x:Name="UnmarkedButtonsPanel" />
						</ScrollViewer>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<Border x:Name="SchematicsNewLabelPromptBorder"
				IsVisible="False"
				ZIndex="5001"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Background="{DynamicResource Schematics_Panels_Bg}"
				BorderBrush="{DynamicResource Schematics_Panels_Border}"
				BorderThickness="1"
				CornerRadius="6"
				Padding="10,8">
			<StackPanel Spacing="8"
						Width="260">
				<TextBlock Text="New component label"
						   FontSize="11"
						   FontWeight="Bold"
						   Foreground="{DynamicResource Schematics_Panels_Fg}" />

				<TextBlock Text="Board label"
						   FontSize="11"
						   Foreground="{DynamicResource Schematics_Panels_Fg}" />

				<TextBox x:Name="NewLabelEditorBoardLabelTextBox" />

				<TextBlock Text="Category"
						   FontSize="11"
						   Foreground="{DynamicResource Schematics_Panels_Fg}" />

				<ComboBox x:Name="NewLabelEditorCategoryComboBox"
						  HorizontalAlignment="Stretch" />

				<StackPanel Orientation="Horizontal"
							Spacing="8"
							HorizontalAlignment="Right">
					<Button x:Name="CancelNewLabelEditorBoardLabelButton"
							Content="Cancel"
							MinWidth="72" />
					<Button x:Name="ConfirmNewLabelEditorBoardLabelButton"
							Classes="Accept"
							Content="OK"
							MinWidth="72" />
				</StackPanel>
			</StackPanel>
		</Border>

	</Grid>
</UserControl>