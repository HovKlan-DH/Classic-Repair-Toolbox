<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CRT"
             mc:Ignorable="d"
             x:Class="CRT.SchematicsFullscreenPlaceholder">

	<Grid x:Name="RootGrid">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="80" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="*" MinWidth="100" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0">
			<TextBlock Text="Fullscreen mode active..."
					   HorizontalAlignment="Center"
					   VerticalAlignment="Center"
					   FontSize="14"
					   FontWeight="SemiBold"
					   Foreground="{DynamicResource Fg}" />
		</Border>

		<!-- Splitter shown when showing fullscreen image -->
		<Border Grid.Column="1"
				Background="{DynamicResource Splitter}" />

		<!-- The same auto-fit gallery the tab's own thumbnail column and the detached window show. -->
		<local:SchematicsThumbnailGallery x:Name="ThumbnailGalleryPlaceholder"
		                                  Grid.Column="2" />
	</Grid>
</UserControl>