<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRT"
        xmlns:data="clr-namespace:Handlers.DataHandling"
        x:Class="CRT.ComponentInfoWindow"
        Title="Component Information"
        Width="680"
        Height="420"
        MinWidth="420"
        MinHeight="260">

	<Window.Styles>
		<!-- Region toggle buttons -->
		<Style Selector="Button.RegionToggle.active">
			<Setter Property="BorderThickness" Value="2" />
		</Style>

		<!-- PAL active -->
		<Style Selector="Button#PalRegionButton.RegionToggle.active">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_PAL_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>
		<Style Selector="Button#PalRegionButton.RegionToggle.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_PAL_Bg}" />
		</Style>

		<!-- NTSC active -->
		<Style Selector="Button#NtscRegionButton.RegionToggle.active">
			<Setter Property="Foreground" Value="{DynamicResource Schematics_Region_NTSC_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>
		<Style Selector="Button#NtscRegionButton.RegionToggle.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Schematics_Region_NTSC_Bg}" />
		</Style>

		<Style Selector="Button.ComponentResourceLinkButton">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource Link_Fg}" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="VerticalContentAlignment" Value="Top" />
			<Setter Property="MinHeight" Value="0" />
		</Style>

		<Style Selector="Button.ComponentResourceLinkButton /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Button.ComponentResourceLinkButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Button.ComponentResourceLinkButton:pointerover TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource LinkHover_Fg}" />
		</Style>

		<Style Selector="Button.ComponentResourceLinkButton:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<!-- "Circle-question" (fa-regular fa-circle-question) help icon that links to an external help page.
		     Sized/clipped the same way as DataSyncStatusIconTextBlock in Main.axaml (fixed box noticeably
		     larger than the font size, explicit ClipToBounds) since that is the proven-working icon-font
		     recipe already used elsewhere in this app. -->
		<Style Selector="Button.HelpIconButton">
			<Setter Property="Width" Value="22" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="ClipToBounds" Value="True" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="Black" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<Style Selector="Button.HelpIconButton /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="ClipToBounds" Value="True" />
		</Style>

		<Style Selector="Button.HelpIconButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Button.HelpIconButton:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Border.ComponentResourceRow">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Border.ComponentResourceRow:pointerover">
			<Setter Property="Background" Value="{DynamicResource Table_RowHover_Bg}" />
		</Style>

		<Style Selector="TextBlock.ComponentResourceHeaderText">
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource Fg}" />
		</Style>
		
	</Window.Styles>

	<Grid x:Name="RootGrid" ColumnDefinitions="*,4,*" Focusable="True">

		<!-- Left panel: top image + horizontal splitter + bottom thumbnail gallery -->
		<Grid x:Name="LeftPanelGrid"
			  Grid.Column="0"
			  Background="Transparent"
			  RowDefinitions="*,4,100">

			<!-- Top: primary component image -->
			<Border x:Name="MainImageClickArea"
					Grid.Row="0"
					ClipToBounds="True"
					Background="Transparent">
				<Grid>
					<TextBlock x:Name="NoImageText"
							   Text="No image available"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   FontSize="12"
							   Foreground="{DynamicResource Fg}" />

					<!-- Wrap the Image in a Border to apply the background tightly to the image bounds -->
					<Border x:Name="MainImageContainer"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Background="{DynamicResource ComponentPopup_ImageTransparent_Bg}"
							CornerRadius="2"
							RenderTransformOrigin="0,0">
						<Border.RenderTransform>
							<MatrixTransform />
						</Border.RenderTransform>
						<Image x:Name="MainComponentImage"
							   Stretch="Uniform" />
					</Border>

					<!-- Top-left info overlay: pin/name, name, oscilloscope reading, region -->
					<StackPanel VerticalAlignment="Top"
								HorizontalAlignment="Left"
								Orientation="Horizontal"
								Margin="6,6,0,0"
								Spacing="4">
						<Border x:Name="InfoPinBorder"
                                Background="{DynamicResource ComponentPopup_Name_Bg}"
                                BorderBrush="{DynamicResource ComponentPopup_Name_Border}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="5,2"
                                IsVisible="False">
							<TextBlock x:Name="InfoPinText"
						               FontSize="11"
						               Foreground="{DynamicResource ComponentPopup_Name_Fg}" />
						</Border>
						<Border x:Name="InfoNameBorder"
								Background="{DynamicResource ComponentPopup_Pin_Bg}"
								BorderBrush="{DynamicResource ComponentPopup_Pin_Border}"
								BorderThickness="1"
								CornerRadius="2"
								Padding="5,2"
								IsVisible="False">
							<TextBlock x:Name="InfoNameText"
						               FontSize="11"
						               Foreground="{DynamicResource ComponentPopup_Pin_Fg}" />
						</Border>
						<Border x:Name="InfoOscBorder"
								Background="{DynamicResource ComponentPopup_OscilloscopeExpected_Bg}"
								BorderBrush="{DynamicResource ComponentPopup_OscilloscopeExpected_Border}"
								BorderThickness="1"
								CornerRadius="2"
								Padding="5,2"
								IsVisible="False">
							<TextBlock x:Name="InfoOscText"
						               FontSize="11"
						               Foreground="{DynamicResource ComponentPopup_OscilloscopeExpected_Fg}" />
						</Border>
						<Border x:Name="InfoRegionBorder"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="5,2"
                                IsVisible="False">
							<TextBlock x:Name="InfoRegionText"
                                       FontSize="11" />
						</Border>
					</StackPanel>

					<!-- Top-right oscilloscope settings overlay -->
					<StackPanel VerticalAlignment="Top"
								HorizontalAlignment="Right"
								Orientation="Horizontal"
								Margin="0,6,6,0"
								Spacing="4">
						<Border x:Name="InfoScopeTimeDivBorder"
								Background="{DynamicResource ComponentPopup_OscilloscopeSyncData_Bg}"
								BorderBrush="{DynamicResource ComponentPopup_OscilloscopeSyncData_Border}"
								BorderThickness="1"
								CornerRadius="2"
								Padding="5,2"
								IsVisible="False">
							<StackPanel Orientation="Horizontal"
										Spacing="0">
								<TextBlock x:Name="InfoScopeTimeDivPrefixText"
										   FontSize="11"
										   Foreground="{DynamicResource ComponentPopup_OscilloscopeSyncData_Fg}" />
								<TextBlock x:Name="InfoScopeTimeDivValueText"
										   FontSize="11"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ComponentPopup_OscilloscopeSyncData_Fg}" />
							</StackPanel>
						</Border>

						<Border x:Name="InfoScopeVoltsDivBorder"
								Background="{DynamicResource ComponentPopup_OscilloscopeSyncData_Bg}"
								BorderBrush="{DynamicResource ComponentPopup_OscilloscopeSyncData_Border}"
								BorderThickness="1"
								CornerRadius="2"
								Padding="5,2"
								IsVisible="False">
							<StackPanel Orientation="Horizontal"
										Spacing="0">
								<TextBlock x:Name="InfoScopeVoltsDivPrefixText"
										   FontSize="11"
										   Foreground="{DynamicResource ComponentPopup_OscilloscopeSyncData_Fg}" />
								<TextBlock x:Name="InfoScopeVoltsDivValueText"
										   FontSize="11"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ComponentPopup_OscilloscopeSyncData_Fg}" />
							</StackPanel>
						</Border>

						<Border x:Name="InfoScopeTriggerBorder"
								Background="{DynamicResource ComponentPopup_OscilloscopeSyncData_Bg}"
								BorderBrush="{DynamicResource ComponentPopup_OscilloscopeSyncData_Border}"
								BorderThickness="1"
								CornerRadius="2"
								Padding="5,2"
								IsVisible="False">
							<StackPanel Orientation="Horizontal"
										Spacing="0">
								<TextBlock x:Name="InfoScopeTriggerPrefixText"
										   FontSize="11"
										   Foreground="{DynamicResource ComponentPopup_OscilloscopeSyncData_Fg}" />
								<TextBlock x:Name="InfoScopeTriggerValueText"
										   FontSize="11"
										   FontWeight="Bold"
										   Foreground="{DynamicResource ComponentPopup_OscilloscopeSyncData_Fg}" />
							</StackPanel>
						</Border>
					</StackPanel>

					<!-- Bottom-right temporary capture overlay -->
					<Border x:Name="CapturedScopeImageBorder"
							VerticalAlignment="Bottom"
							HorizontalAlignment="Right"
							Margin="0,0,6,6"
							Background="{DynamicResource ComponentPopup_OscilloscopeExpected_Bg}"
							BorderBrush="{DynamicResource ComponentPopup_OscilloscopeExpected_Border}"
							BorderThickness="1"
							CornerRadius="2"
							Padding="10,4"
							IsVisible="False">
						<StackPanel Spacing="6">
							<TextBlock x:Name="CapturedScopeImageText"
									   Text="User image"
									   FontSize="22"
									   FontWeight="SemiBold"
									   TextWrapping="Wrap"
									   MaxWidth="260"
									   Foreground="{DynamicResource ComponentPopup_OscilloscopeExpected_Fg}" />

							<!-- Offered on the banner that already appears after every capture, rather
							     than as a mode entered beforehand: the user is at the bench sweeping
							     pin after pin, and a prompt per capture would be intolerable while an
							     ignorable button costs nothing. Hidden entirely when the worklog
							     feature is switched off - see UpdateAttachCapturedImageButton. -->
							<Button x:Name="AttachCapturedImageButton"
									Classes="Accept"
									Content="Attach image to worklog"
									HorizontalAlignment="Center"
									FontSize="12"
									Padding="8,3"
									IsVisible="False"
									Click="OnAttachCapturedImageClick" />
						</StackPanel>
					</Border>

					<!-- Full-image fetch overlay shown while a new oscilloscope image is being captured -->
					<Border x:Name="FetchScopeImageOverlayBorder"
							Background="#CC000000"
							IsVisible="False"
							IsHitTestVisible="False">
						<TextBlock x:Name="FetchScopeImageOverlayText"
								   Text="Querying image - please wait..."
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   TextAlignment="Center"
								   FontSize="28"
								   FontWeight="Bold"
								   Foreground="IndianRed" />
					</Border>

					<!-- Bottom-left image counter overlay -->
					<Border x:Name="ImageCounterBorder"
							VerticalAlignment="Bottom"
							HorizontalAlignment="Left"
							Margin="6,0,0,6"
							Background="{DynamicResource ComponentPopup_ImageXofY_Bg}"
							BorderBrush="{DynamicResource ComponentPopup_ImageXofY_Border}"
							BorderThickness="1"
							CornerRadius="2"
							Padding="5,2"
							IsVisible="False">
						<TextBlock x:Name="ImageCounterText"
								   FontSize="11"
								   Foreground="{DynamicResource ComponentPopup_ImageXofY_Fg}" />
					</Border>

					<!-- Center: pin jump confirmation flash -->
					<Border x:Name="PinFlashBorder"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Background="{DynamicResource ComponentPopup_KeyboardTyping_Bg}"
							BorderBrush="{DynamicResource ComponentPopup_KeyboardTyping_Border}"
							BorderThickness="1"
							CornerRadius="6"
							Padding="20,10"
							IsHitTestVisible="False"
							IsVisible="False">
						<TextBlock x:Name="PinFlashText"
								   FontSize="36"
								   FontWeight="Bold"
								   Foreground="{DynamicResource ComponentPopup_KeyboardTyping_Fg}" />
					</Border>
				</Grid>
			</Border>

			<!-- Horizontal splitter -->
			<GridSplitter Grid.Row="1"
                          ResizeDirection="Rows"
                          HorizontalAlignment="Stretch" />

			<!-- Bottom: horizontally scrollable thumbnail gallery -->
			<Border Grid.Row="2"
                    ClipToBounds="True">
				<ListBox x:Name="ThumbnailList"
                         SelectionMode="Single"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">

					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>

					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Padding" Value="0" />
							<Setter Property="Margin" Value="0" />
						</Style>
						<Style Selector="ListBoxItem /template/ ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
						</Style>
						<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
						</Style>
						<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
						</Style>
						<Style Selector="ListBoxItem Border.ThumbnailItemBorder">
							<Setter Property="BorderBrush" Value="LightGray" />
							<Setter Property="BorderThickness" Value="1" />
						</Style>
						<Style Selector="ListBoxItem:selected Border.ThumbnailItemBorder">
							<Setter Property="BorderBrush" Value="{DynamicResource Thumbnail_BorderSelected}" />
							<Setter Property="BorderThickness" Value="3" />
						</Style>
					</ListBox.Styles>

					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="local:ComponentImageItem">
							<Border Classes="ThumbnailItemBorder"
									Width="110"
									Margin="0"
									CornerRadius="2"
									Background="{DynamicResource Bg}">

								<!-- Single cell: image + label overlay -->
								<Grid MinHeight="40">
									<TextBlock Text="No image"
											   IsVisible="{Binding ImageSource, Converter={x:Static ObjectConverters.IsNull}}"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"
											   FontSize="10"
											   Foreground="{DynamicResource Fg}" />

									<!-- Match the large image behavior exactly: background only, no border -->
									<Border HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Background="{DynamicResource ComponentPopup_ImageTransparent_Bg}"
											CornerRadius="2">
										<Image Source="{Binding ImageSource}"
											   Stretch="Uniform" />
									</Border>

									<!-- Label overlay: top-left, a few pixels inside the border -->
									<Border IsVisible="{Binding LabelVisible}"
											VerticalAlignment="Top"
											HorizontalAlignment="Left"
											Margin="3,3,0,0"
											Background="{DynamicResource ComponentPopup_Name_Bg}"
											BorderBrush="{DynamicResource ComponentPopup_Name_Border}"
											BorderThickness="1"
											CornerRadius="2"
											Padding="3,1">
										<TextBlock Text="{Binding Label}"
												   FontSize="9"
												   Foreground="{DynamicResource ComponentPopup_Name_Fg}" />
									</Border>
								</Grid>

							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>

				</ListBox>
			</Border>

		</Grid>

		<!-- Vertical splitter (full height) -->
		<GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch" />

		<!-- Right panel: component info -->
		<Grid Grid.Column="2"
			  Margin="12"
			  RowDefinitions="Auto,Auto,*,Auto">

			<SelectableTextBlock x:Name="TitleText"
					 Grid.Row="0"
					 FontSize="16"
					 FontWeight="SemiBold"
					 Margin="0,0,0,8" />

			<!-- Category | Part-number (hidden when empty). Kept outside the scrollable/
			     overlaid area — together with TitleText above, this is the "header" that
			     stays visible even while the IC test overlay covers everything below it. -->
			<SelectableTextBlock x:Name="InfoCategoryPartNumber"
								 Grid.Row="1"
								 TextWrapping="Wrap"
								 FontSize="12"
								 Foreground="{DynamicResource Fg}"
								 Margin="0,0,0,8"
								 IsVisible="False" />

			<ScrollViewer Grid.Row="2"
						  HorizontalScrollBarVisibility="Disabled"
						  VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="8">

					<!-- IC test (shown only for ICs with a test-catalogue entry) -->
					<StackPanel x:Name="TestSection" IsVisible="False" Spacing="4" Margin="0,8,0,0">
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<Button x:Name="TestButton" Content="Test IC with MiniPro programmer" HorizontalAlignment="Left" Click="OnTestClick" />
							<Button x:Name="MiniProHelpButton"
									Classes="LearnMore"
									VerticalAlignment="Center"
									ToolTip.Tip="Opens the &quot;MiniPro programmer&quot; page of CRT's Wiki in your web browser"
									Click="OnMiniProHelpClick">
									<TextBlock Text="Learn more"
									           FontSize="11"
									           TextDecorations="Underline" />
							</Button>
						</StackPanel>
					</StackPanel>
					
					<!-- 3. Component one-liner (hidden when empty) -->
					<StackPanel x:Name="OneLinerSection"
								IsVisible="False"
								Spacing="0"
								Margin="0,8,0,0">
						<Grid RowDefinitions="Auto,Auto">
							<TextBlock Grid.Row="0"
									   Text="Component one-liner"
									   FontSize="10"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource Fg}" />
							<TextBox Grid.Row="1"
									 x:Name="InfoDescription"
									 IsReadOnly="True"
									 AcceptsReturn="False"
									 TextWrapping="Wrap"
									 FontSize="12" />
						</Grid>
					</StackPanel>

					<!-- Repair notes (CRT 4.0, hidden when empty) - a link in them can be clicked. -->
					<StackPanel x:Name="RepairNotesSection"
								IsVisible="False"
								Spacing="2"
								Margin="0,8,0,0">
						<TextBlock Text="Repair notes"
								   FontSize="10"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource Fg}" />
						<TextBlock x:Name="InfoRepairNotes"
								   TextWrapping="Wrap"
								   FontSize="12"
								   Foreground="{DynamicResource Fg}" />
					</StackPanel>

					<!-- 4. Image note (hidden when empty or no thumbnail selected) -->
					<StackPanel x:Name="ImageNoteSection"
								IsVisible="False"
								Spacing="0"
								Margin="0,8,0,0">
						<Grid RowDefinitions="Auto,Auto">
							<TextBlock Grid.Row="0"
									   Text="Image note"
									   FontSize="10"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource Fg}" />
							<TextBox Grid.Row="1"
									 x:Name="InfoNote"
									 IsReadOnly="True"
									 AcceptsReturn="False"
									 TextWrapping="Wrap"
									 FontSize="12" />
						</Grid>
					</StackPanel>

					<!-- What the scope baseline shown was measured under (CRT 4.0, hidden when it says nothing). -->
					<StackPanel x:Name="BaselineConditionsSection"
								IsVisible="False"
								Spacing="2"
								Margin="0,8,0,0">
						<TextBlock Text="Scope baseline"
								   FontSize="10"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource Fg}" />
						<SelectableTextBlock x:Name="InfoBaselineConditions"
											 TextWrapping="Wrap"
											 FontSize="12"
											 Foreground="{DynamicResource Fg}" />

						<!-- How the board's baselines were measured: its "Scope measurements" files (2026-10-26). -->
						<TextBlock x:Name="InfoMeasuringNotesLabel"
								   Text="How this board's baselines were measured:"
								   FontSize="11"
								   Opacity="0.75"
								   Margin="0,4,0,0"
								   Foreground="{DynamicResource Fg}" />
						<ItemsControl x:Name="InfoMeasuringNotesItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="local:ComponentLocalFileItem">
									<Button Classes="ComponentResourceLinkButton"
											Margin="0,2,0,2"
											Tag="{Binding}"
											Click="OnLocalFileButtonClick">
										<TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<!-- The pinout (CRT 4.0, hidden without pins): the case drawn when CRT can draw it, and
					     every pin with its signal name and direction. -->
					<StackPanel x:Name="PinoutSection"
								IsVisible="False"
								Spacing="4"
								Margin="0,8,0,0">
						<TextBlock Text="Pinout"
								   FontSize="10"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource Fg}" />
						<local:PinoutDrawing x:Name="InfoPinoutDrawing"
											 HorizontalAlignment="Left"
											 Margin="0,2,0,4"
											 IsVisible="False" />
						<!-- With the board's KiCad data, each pin's net on this board beside its signal name
						     (the plan: "side by side") - the headings say which is which. -->
						<StackPanel Spacing="0" Grid.IsSharedSizeScope="True">
							<!-- The signal name narrows with the popup, never wider than it was before nets. -->
							<Grid x:Name="InfoPinsHeading" IsVisible="False">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="36" />
									<ColumnDefinition Width="*" MaxWidth="140" />
									<ColumnDefinition Width="Auto" SharedSizeGroup="PopupPinNet" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Pin" FontSize="10" Opacity="0.75" Foreground="{DynamicResource Fg}" />
								<TextBlock Grid.Column="1" Text="Signal" FontSize="10" Opacity="0.75" Foreground="{DynamicResource Fg}" />
								<TextBlock Grid.Column="2" Text="Net on this board" Margin="0,0,6,0" FontSize="10" Opacity="0.75" Foreground="{DynamicResource Fg}" />
								<TextBlock Grid.Column="3" Text="Direction" FontSize="10" Opacity="0.75" Foreground="{DynamicResource Fg}" />
							</Grid>
							<ItemsControl x:Name="InfoPinsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="data:ComponentPopupPin">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="36" />
												<ColumnDefinition Width="*" MaxWidth="140" />
												<ColumnDefinition Width="Auto" SharedSizeGroup="PopupPinNet" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="{Binding Pin}" FontSize="11" Foreground="{DynamicResource Fg}" />
											<TextBlock Grid.Column="1" Text="{Binding Name}" Margin="0,0,6,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Fg}" />
											<TextBlock Grid.Column="2"
													   Text="{Binding Net}"
													   IsVisible="{Binding HasNet}"
													   MaxWidth="110"
													   Margin="0,0,6,0"
													   FontSize="11"
													   TextWrapping="Wrap"
													   Foreground="{DynamicResource Fg}" />
											<TextBlock Grid.Column="3" Text="{Binding Direction}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Foreground="{DynamicResource Fg}" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</StackPanel>

					<!-- Replacement parts (CRT 4.0, hidden without any). -->
					<StackPanel x:Name="ReplacementsSection"
								IsVisible="False"
								Spacing="4"
								Margin="0,8,0,0">
						<TextBlock Text="Replacement parts"
								   FontSize="10"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource Fg}" />
						<ItemsControl x:Name="InfoReplacementsItemsControl">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="data:ComponentPopupReplacement">
									<StackPanel Margin="0,0,0,6">
										<TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Fg}" />
										<TextBlock Text="{Binding Changes}" IsVisible="{Binding HasChanges}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Fg}" />
										<TextBlock Text="{Binding Source}" IsVisible="{Binding HasSource}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Foreground="{DynamicResource Fg}" />
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<!-- 5. Component local files (hidden when empty) -->
					<StackPanel x:Name="LocalFilesSection"
								IsVisible="False"
								Spacing="4">

						<Grid RowDefinitions="Auto,*">
							<Border Grid.Row="0"
									Background="{DynamicResource Table_Bg}"
									Padding="0,12,0,0">
								<Grid RowDefinitions="Auto,Auto">
									<TextBlock Grid.Row="0"
											   Classes="ComponentResourceHeaderText"
											   Text="Component local files"
											   Margin="8,0,8,0" />
									<Border Grid.Row="1"
											Height="1"
											Background="{DynamicResource Table_BorderRowLine}"
											Margin="8,4,8,8" />
								</Grid>
							</Border>

							<ItemsControl Grid.Row="1"
										  x:Name="LocalFilesItemsControl"
										  Background="{DynamicResource Table_Bg}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ComponentLocalFileItem">
										<Border Classes="ComponentResourceRow"
												BorderBrush="{DynamicResource Table_BorderRowLine}"
												BorderThickness="0,0,0,1"
												Padding="0,4">
											<Button Classes="ComponentResourceLinkButton"
													Margin="8,4,8,4"
													Tag="{Binding}"
													Click="OnLocalFileButtonClick">
												<TextBlock Text="{Binding Name}"
														   TextWrapping="Wrap" />
											</Button>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</StackPanel>

					<!-- 6. Component links (hidden when empty) -->
					<StackPanel x:Name="LinksSection"
								IsVisible="False"
								Spacing="4">

						<Grid RowDefinitions="Auto,*">
							<Border Grid.Row="0"
									Background="{DynamicResource Table_Bg}"
									Padding="0,12,0,0">
								<Grid RowDefinitions="Auto,Auto">
									<TextBlock Grid.Row="0"
											   Classes="ComponentResourceHeaderText"
											   Text="Component links"
											   Margin="8,0,8,0" />
									<Border Grid.Row="1"
											Height="1"
											Background="{DynamicResource Table_BorderRowLine}"
											Margin="8,4,8,8" />
								</Grid>
							</Border>

							<ItemsControl Grid.Row="1"
										  x:Name="LinksItemsControl"
										  Background="{DynamicResource Table_Bg}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ComponentLinkItem">
										<Border Classes="ComponentResourceRow"
												BorderBrush="{DynamicResource Table_BorderRowLine}"
												BorderThickness="0,0,0,1"
												Padding="0,4">
											<Button Classes="ComponentResourceLinkButton"
													Margin="8,4,8,4"
													Tag="{Binding}"
													Click="OnLinkButtonClick">
												<TextBlock Text="{Binding Name}"
														   TextWrapping="Wrap" />
											</Button>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</StackPanel>

				</StackPanel>
			</ScrollViewer>

			<!-- Footer controls: local region, mousewheel behavior, keyboard handling, close -->
			<Border x:Name="RegionControlsBorder"
					Grid.Row="3"
					BorderBrush="{DynamicResource Splitter}"
					BorderThickness="0,1,0,0"
					Padding="0,6,0,0"
					Margin="0,6,0,0">
				<Grid ColumnDefinitions="Auto,10,Auto,*,Auto"
					  RowDefinitions="28,4,28,4,28">

					<Button x:Name="PalRegionButton"
							Classes="RegionToggle"
							Grid.Column="0"
							Grid.Row="2"
							Content="PAL (0)"
							Width="70"
							Height="24"
							MinHeight="24"
							FontSize="11"
							Padding="6,2"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							VerticalAlignment="Bottom"
							Click="OnPalRegionClick" />

					<Button x:Name="NtscRegionButton"
							Classes="RegionToggle"
							Grid.Column="0"
							Grid.Row="4"
							Content="NTSC (0)"
							Width="70"
							Height="24"
							MinHeight="24"
							FontSize="11"
							Padding="6,2"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							VerticalAlignment="Bottom"
							Click="OnNtscRegionClick" />

					<Grid x:Name="SyncOscilloscopeRow"
						  Grid.Column="2"
						  Grid.Row="0"
						  Height="28"
						  ColumnDefinitions="Auto,4,Auto"
						  VerticalAlignment="Center">
						<CheckBox Grid.Column="0"
								  x:Name="SyncOscilloscopeCheckBox"
								  Content="Synchronize oscilloscope"
								  IsChecked="True"
								  FontSize="11"
								  VerticalAlignment="Center" />
						<Button x:Name="SyncOscilloscopeHelpButton"
								Grid.Column="2"
								Classes="LearnMore"
								VerticalAlignment="Center"
								ToolTip.Tip="Opens the &quot;Synchronize oscilloscope&quot; page of CRT's Wiki in your web browser"
								Click="OnSyncOscilloscopeHelpClick">
								<TextBlock Text="Learn more"
								           FontSize="11"
								           TextDecorations="Underline" />
						</Button>
					</Grid>

					<Grid x:Name="NumpadOscilloscopeRow"
						  Grid.Column="2"
						  Grid.Row="2"
						  Height="28"
						  ColumnDefinitions="Auto,4,Auto"
						  VerticalAlignment="Center">
						<CheckBox Grid.Column="0"
								  x:Name="NumpadOscilloscopeSwitch"
								  Content="Numpad controls oscilloscope"
								  FontSize="11"
								  VerticalAlignment="Center" />
						<Button x:Name="NumpadOscilloscopeHelpButton"
								Grid.Column="2"
								Classes="LearnMore"
								VerticalAlignment="Center"
								ToolTip.Tip="Opens the &quot;Controlling oscilloscope with keyboard&quot; page of CRT's Wiki in your web browser"
								Click="OnNumpadOscilloscopeHelpClick">
								<TextBlock Text="Learn more"
								           FontSize="11"
								           TextDecorations="Underline" />
						</Button>
					</Grid>

					<Grid Grid.Column="2"
						  Grid.Row="4"
						  Height="28"
						  ColumnDefinitions="Auto,4,Auto"
						  VerticalAlignment="Center">
						<CheckBox x:Name="MousewheelZoomCheckBox"
								  Content="Mousewheel will zoom image"
								  FontSize="11"
								  VerticalAlignment="Center" />
					</Grid>

				</Grid>
			</Border>

			<!-- IC test overlay: covers everything below the title/category-part-number
			     header (the scrollable info content + footer), leaving that header and the
			     left-hand pinout/thumbnails untouched. Hidden by default. -->
			<local:IcTestPanel x:Name="IcTestPanel"
								Grid.Row="2"
								Grid.RowSpan="2"
								IsVisible="False" />

		</Grid>

	</Grid>

</Window>