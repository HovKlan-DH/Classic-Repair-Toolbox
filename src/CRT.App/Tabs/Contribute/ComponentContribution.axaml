<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CRT"
        x:Class="CRT.ComponentContributionWindow"
        Title="Component contribution"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<Window.Styles>
		<Style Selector="Expander">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Background" Value="{DynamicResource Bg}" />
		</Style>

		<!-- Content area stays on the normal window background -->
		<Style Selector="Expander /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Bg}" />
		</Style>

		<!-- Only the top expand/collapse header gets the alternate background -->
		<Style Selector="Expander /template/ ToggleButton">
			<Setter Property="Background" Value="{DynamicResource Table_Header_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Table_Header_Fg}" />
		</Style>

		<Style Selector="Expander /template/ Border">
			<Setter Property="Background" Value="{DynamicResource Bg}" />
		</Style>

		<Style Selector="Button.HighlightAddRowButton">
			<Setter Property="Background" Value="{DynamicResource Button_Highlighted_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Highlighted_Fg}" />
			<Setter Property="Padding" Value="14,8" />
		</Style>

		<!-- The same highlight the "Send contribution update" button wears, so the two controls
		     that act on the whole contribution look like each other rather than like the green
		     "add row" buttons. Button_Highlighted_* is the theme's red, in both light and dark. -->
		<Style Selector="Button.DeleteComponentButton">
			<Setter Property="Background" Value="{DynamicResource Button_Highlighted_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Button_Highlighted_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Button_Highlighted_Border}" />
			<Setter Property="Padding" Value="14,8" />
		</Style>

		<!-- A required box that validation found empty. This has to target the template part, not
		     the TextBox: the Fluent theme repaints PART_BorderElement directly on :focus and
		     :pointerover, which beats the TemplateBinding carrying the TextBox's own BorderBrush -
		     and revealing the box focuses it, so a mark set on the TextBox would last one frame. -->
		<Style Selector="TextBox.HasError /template/ Border#PART_BorderElement">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
			<Setter Property="BorderThickness" Value="3" />
		</Style>

		<!-- A component image row, and the same row once validation has marked it as unusable.
		     Both borders are styles rather than local values, because a local BorderBrush on the
		     element would outrank the style that has to override it. -->
		<Style Selector="Border.ComponentImageRow">
			<Setter Property="BorderBrush" Value="{DynamicResource Panel_Border}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style Selector="Border.ComponentImageRow.HasFileError">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
			<Setter Property="BorderThickness" Value="3" />
		</Style>

		<!-- The red frame a required field of the component row wears once validation has found it
		     empty. It is a frame AROUND the control rather than the control's own border, because one
		     of the two is an AutoCompleteBox whose visible border belongs to a TextBox nested inside
		     its template - out of reach of a style - and because the Fluent theme repaints a TextBox
		     border on focus, which would drop the mark the moment the user clicked in to fix it.
		     The thickness is always 3, transparent when there is nothing wrong, so marking a field
		     never moves the layout. -->
		<Style Selector="Border.ErrorFrame">
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="3" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="1" />
		</Style>

		<Style Selector="Border.ErrorFrame.HasError">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>

		<!-- The "File location" box of a row whose newly picked file has no folder, or one outside
		     this board and the shared folders - "Save to draft" refuses it (ValidateNewFileLocations).
		     Only the colour changes, never the thickness, so marking a row never moves the layout. -->
		<Style Selector="ComboBox.LocationError">
			<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
		</Style>

		<!-- Compact "browse" button sitting beside a read-only file box -->
		<Style Selector="Button.BrowseFileButton">
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

		<Border Grid.Row="0"
		        BorderBrush="{DynamicResource Panel_Border}"
		        BorderThickness="1"
		        CornerRadius="6"
		        Padding="12"
		        Margin="0,0,0,12">
			<Grid ColumnDefinitions="*,24,*">
				<StackPanel Grid.Column="0" Spacing="4">
					<TextBlock Text="Component contribution editor"
					           FontSize="20"
					           FontWeight="Bold" />
					<TextBlock x:Name="ComponentTitleTextBlock"
					           FontSize="14"
					           FontWeight="SemiBold"
					           Foreground="{DynamicResource Fg}" />
					<TextBlock x:Name="HardwareContextTextBlock"
							   FontSize="12"
							   FontFamily="Consolas,Courier New,monospace"
							   Foreground="{DynamicResource Fg}" />
					<TextBlock x:Name="BoardContextTextBlock"
							   FontSize="12"
							   FontFamily="Consolas,Courier New,monospace"
							   Foreground="{DynamicResource Fg}" />
					<TextBlock x:Name="RegionContextTextBlock"
							   FontSize="12"
							   FontFamily="Consolas,Courier New,monospace"
							   Foreground="{DynamicResource Fg}" />
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer x:Name="MainScrollViewer"
				  Grid.Row="1"
				  VerticalScrollBarVisibility="Auto"
				  HorizontalScrollBarVisibility="Disabled"
				  AllowAutoHide="False">
			<StackPanel Spacing="16">

				<!-- Shown on every contribution, worded for the one being made. The two bodies are
				     separate blocks rather than one with swapped text, because each is split into runs
				     so that "suggestion" can be italic - which is the whole point of the notice:
				     nothing done in this window changes the user's own data. -->
				<Border BorderBrush="{DynamicResource Panel_Border}"
				        BorderThickness="2"
				        CornerRadius="6"
				        Padding="12">
					<StackPanel Spacing="6">
						<TextBlock x:Name="ContributionNoticeHeadingTextBlock"
						           FontSize="15"
						           FontWeight="Bold" />

						<TextBlock x:Name="NewComponentNoticeTextBlock"
						           TextWrapping="Wrap"
						           Foreground="{DynamicResource Fg}">
							<Run Text="The component you add is saved into your own local " />
							<Run Text="draft" FontStyle="Italic" />
							<Run Text=" for this board - it appears here as soon as you save it, but nothing changes for anyone else until you submit your draft and it is reviewed. See the &quot;Drafts&quot; tab for every board you have local changes on." />
						</TextBlock>

						<TextBlock x:Name="ExistingComponentNoticeTextBlock"
						           TextWrapping="Wrap"
						           Foreground="{DynamicResource Fg}">
							<Run Text="The changes you make are saved into your own local " />
							<Run Text="draft" FontStyle="Italic" />
							<Run Text=" for this board - they take effect here as soon as you save, but nothing changes for anyone else until you submit your draft and it is reviewed. See the &quot;Drafts&quot; tab for every board you have local changes on." />
						</TextBlock>

						<!-- The delete button lives inside the "Component" section, which starts
						     collapsed - so an existing component gets a line saying the option is
						     there at all. Hidden for a new component, which has nothing to delete. -->
						<TextBlock x:Name="DeleteComponentHintTextBlock"
						           Text="If this component does not belong on the board at all, open the &quot;Component&quot; section below and use &quot;Delete this component&quot;."
						           TextWrapping="Wrap"
						           Foreground="{DynamicResource Fg}" />

						<!-- Replaces both bodies above once delete mode is on. Its text is built at
						     runtime, since it names the component and counts what goes with it. -->
						<TextBlock x:Name="DeleteComponentNoticeTextBlock"
						           TextWrapping="Wrap"
						           IsVisible="False"
						           Foreground="{DynamicResource Text_Fail_Fg}" />
					</StackPanel>
				</Border>

				<Border BorderBrush="{DynamicResource Panel_Border}"
				        BorderThickness="1"
				        CornerRadius="6"
				        Padding="12">
					<Expander x:Name="ComponentExpander" IsExpanded="False">
						<Expander.Header>
							<TextBlock Text='Component'
							           FontSize="15"
							           FontWeight="Bold" />
						</Expander.Header>

						<StackPanel Spacing="10"
						            Margin="0,10,0,0"
						            HorizontalAlignment="Stretch">

							<!-- The button sits OUTSIDE ComponentSectionFields on purpose. Delete mode
							     disables that container, and a disabled parent disables every child -
							     a button inside it could not be clicked again to leave the mode. -->
							<Button x:Name="DeleteComponentButton"
							        Classes="DeleteComponentButton"
							        Content="Delete this component"
							        HorizontalAlignment="Right"
							        IsVisible="False"
							        ToolTip.Tip="Remove this component, and everything attached to it, in your local draft"
							        Click="OnToggleDeleteComponentClick" />

							<StackPanel x:Name="ComponentSectionFields" Spacing="10">
								<TextBlock Text="Component"
								           FontSize="12"
								           Foreground="{DynamicResource Fg}" />

								<ItemsControl x:Name="ComponentRowsItemsControl">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="local:ContributionComponentRow">
											<Border BorderBrush="{DynamicResource Panel_Border}"
											        BorderThickness="1"
											        CornerRadius="4"
											        Padding="8"
											        Margin="0,0,0,8">
												<Grid ColumnDefinitions="1*,12,1*"
													  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
													  HorizontalAlignment="Stretch">
													<TextBlock Grid.Column="0" Grid.Row="0" Text="Board label" FontSize="11" />
													<StackPanel Grid.Column="0" Grid.Row="1" Spacing="4">
														<Border Classes="ErrorFrame"
														        Classes.HasError="{Binding HasBoardLabelError}">
															<TextBox Text="{Binding BoardLabel}" />
														</Border>
														<TextBlock Text="{Binding BoardLabelErrorText}"
														           IsVisible="{Binding HasBoardLabelError}"
														           Foreground="{DynamicResource Text_Fail_Fg}"
														           FontSize="11"
														           FontWeight="Bold"
														           TextWrapping="Wrap" />
													</StackPanel>

													<TextBlock Grid.Column="2" Grid.Row="0" Text="Category" FontSize="11" />
													<StackPanel Grid.Column="2" Grid.Row="1" Spacing="4">
														<!-- Free text with suggestions: typing "cap" offers the board's
														     "Capacitor", and anything the board has never used is still
														     accepted as typed. MinimumPrefixLength 0 lists the whole set
														     as soon as the field is used, which is the quickest way to
														     see what the board's other components are filed under. -->
														<Border Classes="ErrorFrame"
														        Classes.HasError="{Binding HasCategoryError}">
															<AutoCompleteBox Text="{Binding Category, Mode=TwoWay}"
															                 ItemsSource="{Binding AvailableCategories}"
															                 FilterMode="Contains"
															                 MinimumPrefixLength="0"
															                 IsTextCompletionEnabled="False"
															                 PlaceholderText="Capacitor, IC, Resistor, ..."
															                 HorizontalAlignment="Stretch" />
														</Border>
														<TextBlock Text="{Binding CategoryErrorText}"
														           IsVisible="{Binding HasCategoryError}"
														           Foreground="{DynamicResource Text_Fail_Fg}"
														           FontSize="11"
														           FontWeight="Bold"
														           TextWrapping="Wrap" />
													</StackPanel>

													<TextBlock Grid.Column="0" Grid.Row="2" Text="Friendly name" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="0" Grid.Row="3" Text="{Binding FriendlyName}" />

													<TextBlock Grid.Column="2" Grid.Row="2" Text="Region" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="2" Grid.Row="3" Text="{Binding Region}" />

													<TextBlock Grid.Column="0" Grid.Row="4" Text="Technical name or value" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="0"
															 Grid.Row="5"
															 Text="{Binding TechnicalNameOrValue}"
															 VerticalAlignment="Top" />

													<TextBlock Grid.Column="2" Grid.Row="4" Text="Short description" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="2"
															 Grid.Row="5"
															 Grid.RowSpan="3"
															 Text="{Binding Description}"
															 AcceptsReturn="True"
															 TextWrapping="Wrap"
															 MinHeight="84"
															 VerticalAlignment="Top" />

													<TextBlock Grid.Column="0" Grid.Row="6" Text="Part-number" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="0" Grid.Row="7" Text="{Binding PartNumber}" />
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</StackPanel>
					</Expander>
				</Border>

				<Border x:Name="ComponentImagesSection" BorderBrush="{DynamicResource Panel_Border}"
						BorderThickness="1"
						CornerRadius="6"
						Padding="12">
					<Expander x:Name="ComponentImagesExpander" IsExpanded="False">
						<Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock Text="Component images"
										   FontSize="15"
										   FontWeight="Bold" />
								<TextBlock x:Name="ComponentImagesCountTextBlock"
										   Text="(0)"
										   FontSize="15"
										   FontWeight="Bold" />
							</StackPanel>
						</Expander.Header>

					<StackPanel Spacing="10"
						            Margin="0,10,0,0"
						            HorizontalAlignment="Stretch">
							<Grid ColumnDefinitions="*,Auto"
							      HorizontalAlignment="Stretch"
							      Margin="0,0,0,16">
								<TextBlock x:Name="ComponentImagesRegionTextBlock"
									   FontSize="12"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource Fg}" />
								<Button Grid.Column="1"
								        Classes="HighlightAddRowButton"
								        Content="Add new component image"
								        Click="OnAddComponentImageRowClick" />
							</Grid>

							<ItemsControl x:Name="ComponentImageRowsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ContributionComponentImageRow">
										<Border Classes="ComponentImageRow"
										        Classes.HasFileError="{Binding HasFileError}"
										        CornerRadius="4"
										        Padding="8"
										        Margin="0,0,0,8">
											<Grid ColumnDefinitions="320,16,*">
												<Grid Grid.Column="0"
													  Height="260"
													  Margin="6"
													  ClipToBounds="True"
													  Background="Transparent">
													<Viewbox Stretch="Uniform"
															 HorizontalAlignment="Stretch"
															 VerticalAlignment="Stretch">
														<Border Background="{DynamicResource ComponentPopup_ImageTransparent_Bg}">
															<Image Source="{Binding PreviewImage}"
																   Stretch="None" />
														</Border>
													</Viewbox>
												</Grid>

												<Grid Grid.Column="2"
													  ColumnDefinitions="1*,12,1*,8,1*,8,1*"
													  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
													  HorizontalAlignment="Stretch">
													<TextBlock Grid.Column="0" Grid.Row="0" Text="Board label" FontSize="11" />
													<TextBox Grid.Column="0" Grid.Row="1" Text="{Binding BoardLabel}" MinWidth="0" />

													<TextBlock Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="5" Text="Expected oscilloscope reading" FontSize="11" />
													<TextBox Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding ExpectedOscilloscopeReading}" MinWidth="0" />

													<TextBlock Grid.Column="0" Grid.Row="2" Text="Region" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="0" Grid.Row="3" Text="{Binding Region}" MinWidth="0" />

													<TextBlock Grid.Column="2" Grid.Row="2" Text="Volts/DIV" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="2" Grid.Row="3" Text="{Binding VoltsDiv}" MinWidth="0" />

													<TextBlock Grid.Column="4" Grid.Row="2" Text="Timing/DIV" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="4" Grid.Row="3" Text="{Binding TimeDiv}" MinWidth="0" />

													<TextBlock Grid.Column="6" Grid.Row="2" Text="Trigger Level" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="6" Grid.Row="3" Text="{Binding TriggerLevelVolts}" MinWidth="0" />

													<TextBlock Grid.Column="0" Grid.Row="4" Text="Pin" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="0" Grid.Row="5" Text="{Binding Pin}" MinWidth="0" />

													<TextBlock Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="3" Text="File location" FontSize="11" Margin="0,8,0,0" />
													<ComboBox Grid.Column="2" Grid.Row="5"
																					  Grid.ColumnSpan="3"
																					  ItemsSource="{Binding AvailableFileLocations}"
																					  SelectedItem="{Binding FileLocation, Mode=TwoWay}"
																					  Classes.LocationError="{Binding HasLocationError}"
																					  HorizontalAlignment="Stretch"
																					  MinWidth="0" />

													<TextBlock Grid.Column="6" Grid.Row="4" Text="File" FontSize="11" Margin="0,8,0,0" />
													<Grid Grid.Column="6" Grid.Row="5" ColumnDefinitions="*,4,Auto">
														<TextBox Text="{Binding File}"
														         Tag="{Binding}"
														         IsReadOnly="True"
														         Cursor="Hand"
														         MinWidth="0"
														         PlaceholderText="Click to select a file..."
														         ToolTip.Tip="Click to select the file to contribute"
														         PointerReleased="OnFileTextBoxPointerReleased" />
														<Button Grid.Column="2"
														        Classes="BrowseFileButton"
														        Content="Browse"
														        Tag="{Binding}"
														        ToolTip.Tip="Select the file to contribute"
														        Click="OnBrowseFileClick" />
													</Grid>

													<TextBlock Grid.Column="0" Grid.Row="6" Text="Name" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="0"
															 Grid.Row="7"
															 Text="{Binding Name}"
															 MinWidth="0"
															 VerticalAlignment="Top" />

													<TextBlock Grid.Column="2" Grid.Row="6" Grid.ColumnSpan="5" Text="Note" FontSize="11" Margin="0,8,0,0" />
													<TextBox Grid.Column="2" Grid.Row="7"
															 Grid.ColumnSpan="5"
															 Text="{Binding Note}"
															 AcceptsReturn="True"
															 TextWrapping="Wrap"
															 MinHeight="84"
															 MinWidth="0" />

													<TextBlock Grid.Column="0"
															Grid.Row="8"
															Text="{Binding FileErrorText}"
															IsVisible="{Binding HasFileError}"
															Foreground="{DynamicResource Text_Fail_Fg}"
															FontSize="11"
															FontWeight="Bold"
															TextWrapping="Wrap"
															VerticalAlignment="Center"
															Margin="0,8,0,0" />

													<Button Grid.Column="2"
															Grid.Row="8"
															Grid.ColumnSpan="5"
															Content="Remove image"
															HorizontalAlignment="Right"
															Tag="{Binding}"
															Click="OnRemoveComponentImageRowClick"
															Margin="0,8,0,0" />
												</Grid>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Expander>
				</Border>

				<Border x:Name="ComponentLocalFilesSection" BorderBrush="{DynamicResource Panel_Border}"
		BorderThickness="1"
		CornerRadius="6"
		Padding="12">
					<Expander x:Name="ComponentLocalFilesExpander" IsExpanded="False">
						<Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock Text="Component local files"
										   FontSize="15"
										   FontWeight="Bold" />
								<TextBlock x:Name="ComponentLocalFilesCountTextBlock"
										   Text="(0)"
										   FontSize="15"
										   FontWeight="Bold" />
							</StackPanel>
						</Expander.Header>

						<StackPanel Spacing="10"
									Margin="0,10,0,0"
									HorizontalAlignment="Stretch">
							<Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
								<StackPanel Grid.Column="0" Spacing="2">
									<TextBlock Text="Describe all files specifically for this component."
											   FontSize="12"
											   Foreground="{DynamicResource Fg}" />
									<TextBlock Text="This could e.g. be datasheets, technical instructions, manuals or whatever is relevant specifically for this component."
											   FontSize="12"
											   TextWrapping="Wrap"
											   Foreground="{DynamicResource Fg}" />
								</StackPanel>
								<Button Grid.Column="1"
										Classes="HighlightAddRowButton"
										Content="Add new component file"
										Click="OnAddComponentLocalFileRowClick" />
							</Grid>

							<Grid ColumnDefinitions="180,12,280,12,390,12,*,12,Auto"
								  Margin="0,0,0,6"
								  HorizontalAlignment="Stretch">
								<TextBlock Text="Board label" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="2" Text="Name" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="4" Text="File location" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="6" Text="File" FontSize="11" FontWeight="Bold" />
							</Grid>

							<ItemsControl x:Name="ComponentLocalFileRowsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ContributionComponentLocalFileRow">
										<Border BorderThickness="0"
												Background="Transparent"
												Padding="0,4">
											<Grid ColumnDefinitions="180,12,280,12,390,12,*,12,Auto"
												  HorizontalAlignment="Stretch">
												<TextBox Text="{Binding BoardLabel}" />
												<TextBox Grid.Column="2" Text="{Binding Name}" />
												<ComboBox Grid.Column="4"
														  ItemsSource="{Binding AvailableFileLocations}"
														  SelectedItem="{Binding FileLocation, Mode=TwoWay}"
														  Classes.LocationError="{Binding HasLocationError}"
														  HorizontalAlignment="Stretch"
														  MinWidth="0" />
												<Grid Grid.Column="6" ColumnDefinitions="*,4,Auto">
													<TextBox Text="{Binding File}"
													         Tag="{Binding}"
													         IsReadOnly="True"
													         Cursor="Hand"
													         MinWidth="0"
													         PlaceholderText="Click to select a file..."
													         ToolTip.Tip="Click to select the file to contribute"
													         PointerReleased="OnFileTextBoxPointerReleased" />
													<Button Grid.Column="2"
													        Classes="BrowseFileButton"
													        Content="Browse"
													        Tag="{Binding}"
													        ToolTip.Tip="Select the file to contribute"
													        Click="OnBrowseFileClick" />
												</Grid>
												<Button Grid.Column="8"
														Content="Remove"
														Tag="{Binding}"
														Click="OnRemoveComponentLocalFileRowClick" />
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Expander>
				</Border>

				<Border x:Name="ComponentLinksSection" BorderBrush="{DynamicResource Panel_Border}"
						BorderThickness="1"
						CornerRadius="6"
						Padding="12">
					<Expander IsExpanded="False">
						<Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock Text="Component links"
										   FontSize="15"
										   FontWeight="Bold" />
								<TextBlock x:Name="ComponentLinksCountTextBlock"
										   Text="(0)"
										   FontSize="15"
										   FontWeight="Bold" />
							</StackPanel>
						</Expander.Header>

						<StackPanel Spacing="10"
						            Margin="0,10,0,0"
						            HorizontalAlignment="Stretch">
							<Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
								<StackPanel Grid.Column="0" Spacing="2">
									<TextBlock Text="Describe all links specifically for this component."
											   FontSize="12"
											   Foreground="{DynamicResource Fg}" />
									<TextBlock Text="This could links for technical instructions or basically any link relevant specifically for this component."
											   FontSize="12"
											   TextWrapping="Wrap"
											   Foreground="{DynamicResource Fg}" />
								</StackPanel>
								<Button Grid.Column="1"
										Classes="HighlightAddRowButton"
										Content="Add new component link"
										Click="OnAddComponentLinkRowClick" />
							</Grid>

							<Grid ColumnDefinitions="180,12,360,12,*,12,Auto"
								  Margin="0,0,0,6"
								  HorizontalAlignment="Stretch">
								<TextBlock Text="Board label" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="2" Text="Name" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="4" Text="URL" FontSize="11" FontWeight="Bold" />
							</Grid>

							<ItemsControl x:Name="ComponentLinkRowsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ContributionComponentLinkRow">
										<Border BorderThickness="0"
										        Background="Transparent"
										        Padding="0,4">
											<Grid ColumnDefinitions="180,12,360,12,*,12,Auto"
												HorizontalAlignment="Stretch">
												<TextBox Text="{Binding BoardLabel}" />
												<TextBox Grid.Column="2" Text="{Binding Name}" />
												<TextBox Grid.Column="4" Text="{Binding Url}" />
												<Button Grid.Column="6"
												        Content="Remove"
												        Tag="{Binding}"
												        Click="OnRemoveComponentLinkRowClick" />
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Expander>
				</Border>

				<Border x:Name="BoardLocalFilesSection" BorderBrush="{DynamicResource Panel_Border}"
		BorderThickness="1"
		CornerRadius="6"
		Padding="12">
					<Expander x:Name="BoardLocalFilesExpander" IsExpanded="False">
						<Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock Text="Board local files"
										   FontSize="15"
										   FontWeight="Bold" />
								<TextBlock x:Name="BoardLocalFilesCountTextBlock"
										   Text="(0)"
										   FontSize="15"
										   FontWeight="Bold" />
							</StackPanel>
						</Expander.Header>

						<StackPanel Spacing="10"
									Margin="0,10,0,0"
									HorizontalAlignment="Stretch">
							<Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
								<StackPanel Grid.Column="0" Spacing="2">
									<TextBlock Text="Describe all files specifically for the board."
											   FontSize="12"
											   Foreground="{DynamicResource Fg}" />
									<TextBlock Text="These files are more generic and cover e.g. service or troubleshooting manuals, that can be used for the entire board."
											   FontSize="12"
											   TextWrapping="Wrap"
											   Foreground="{DynamicResource Fg}" />
								</StackPanel>
								<Button Grid.Column="1"
										Classes="HighlightAddRowButton"
										Content="Add new board file"
										Click="OnAddBoardLocalFileRowClick" />
							</Grid>

							<Grid ColumnDefinitions="180,12,280,12,390,12,*,12,Auto"
								  Margin="0,0,0,6"
								  HorizontalAlignment="Stretch">
								<TextBlock Text="Category" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="2" Text="Name" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="4" Text="File location" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="6" Text="File" FontSize="11" FontWeight="Bold" />
							</Grid>

							<ItemsControl x:Name="BoardLocalFileRowsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ContributionBoardLocalFileRow">
										<Border BorderThickness="0"
												Background="Transparent"
												Padding="0,4">
											<Grid ColumnDefinitions="180,12,280,12,390,12,*,12,Auto"
												  HorizontalAlignment="Stretch">
												<TextBox Text="{Binding Category}" />
												<TextBox Grid.Column="2" Text="{Binding Name}" />
												<ComboBox Grid.Column="4"
														  ItemsSource="{Binding AvailableFileLocations}"
														  SelectedItem="{Binding FileLocation, Mode=TwoWay}"
														  Classes.LocationError="{Binding HasLocationError}"
														  HorizontalAlignment="Stretch"
														  MinWidth="0" />
												<Grid Grid.Column="6" ColumnDefinitions="*,4,Auto">
													<TextBox Text="{Binding File}"
													         Tag="{Binding}"
													         IsReadOnly="True"
													         Cursor="Hand"
													         MinWidth="0"
													         PlaceholderText="Click to select a file..."
													         ToolTip.Tip="Click to select the file to contribute"
													         PointerReleased="OnFileTextBoxPointerReleased" />
													<Button Grid.Column="2"
													        Classes="BrowseFileButton"
													        Content="Browse"
													        Tag="{Binding}"
													        ToolTip.Tip="Select the file to contribute"
													        Click="OnBrowseFileClick" />
												</Grid>
												<Button Grid.Column="8"
														Content="Remove"
														Tag="{Binding}"
														Click="OnRemoveBoardLocalFileRowClick" />
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Expander>
				</Border>

				<Border x:Name="BoardLinksSection" BorderBrush="{DynamicResource Panel_Border}"
						BorderThickness="1"
						CornerRadius="6"
						Padding="12">
					<Expander IsExpanded="False">
						<Expander.Header>
							<StackPanel Orientation="Horizontal" Spacing="4">
								<TextBlock Text="Board links"
										   FontSize="15"
										   FontWeight="Bold" />
								<TextBlock x:Name="BoardLinksCountTextBlock"
										   Text="(0)"
										   FontSize="15"
										   FontWeight="Bold" />
							</StackPanel>
						</Expander.Header>

						<StackPanel Spacing="10"
						            Margin="0,10,0,0"
						            HorizontalAlignment="Stretch">
							<Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
								<StackPanel Grid.Column="0" Spacing="2">
									<TextBlock Text="Describe all links specifically for the board."
											   FontSize="12"
											   Foreground="{DynamicResource Fg}" />
									<TextBlock Text="These links could typically be for content covering this board, e.g. board repairing histories or YouTube videos specifically for this board."
											   FontSize="12"
											   TextWrapping="Wrap"
											   Foreground="{DynamicResource Fg}" />
								</StackPanel>
								<Button Grid.Column="1"
										Classes="HighlightAddRowButton"
										Content="Add new board link"
										Click="OnAddBoardLinkRowClick" />
							</Grid>

							<Grid ColumnDefinitions="180,12,360,12,*,12,Auto"
									  Margin="0,0,0,6"
									  HorizontalAlignment="Stretch">
								<TextBlock Text="Category" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="2" Text="Name" FontSize="11" FontWeight="Bold" />
								<TextBlock Grid.Column="4" Text="URL" FontSize="11" FontWeight="Bold" />
							</Grid>

							<ItemsControl x:Name="BoardLinkRowsItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:ContributionBoardLinkRow">
										<Border BorderThickness="0"
										        Background="Transparent"
										        Padding="0,4">
											<Grid ColumnDefinitions="180,12,360,12,*,12,Auto"
												HorizontalAlignment="Stretch">
												<TextBox Text="{Binding Category}" />
												<TextBox Grid.Column="2" Text="{Binding Name}" />
												<TextBox Grid.Column="4" Text="{Binding Url}" />
												<Button Grid.Column="6"
												        Content="Remove"
												        Tag="{Binding}"
												        Click="OnRemoveBoardLinkRowClick" />
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Expander>
				</Border>

				<Border BorderBrush="{DynamicResource Panel_Border}"
				        BorderThickness="1"
				        CornerRadius="6"
				        Padding="12"
				        Margin="0,0,0,4">
					<StackPanel Spacing="6">
						<TextBlock Text="Note (optional)"
						           FontSize="15"
						           FontWeight="Bold" />
						<TextBlock Text="Describe what you have changed, what was wrong or missing, and anything worth remembering when you come back to this draft or submit it later."
						           FontSize="11"
						           Foreground="{DynamicResource Fg}"
						           TextWrapping="Wrap" />

						<Grid RowDefinitions="Auto,Auto">
							<TextBlock Grid.Row="0"
							           Text="Worth documenting your specific board revision here, if the board has more than one."
							           FontSize="11"
							           Foreground="{DynamicResource Fg}"
							           TextWrapping="Wrap" />
							<TextBox Grid.Row="1"
							         x:Name="MandatoryCommentTextBox"
							         AcceptsReturn="True"
							         TextWrapping="Wrap"
							         MinHeight="180"
							         Background="{DynamicResource Form_Bg}"
							         Foreground="{DynamicResource Form_Fg}" />
						</Grid>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- Everything the window has to say about a save - refusal, success - gets its own
		     full-width row rather than what happens to be left between the buttons. The messages
		     name the field at fault and say what happens next, so a line that is cut off in the
		     middle is a line that has not been delivered. The row is Auto-sized and the text wraps,
		     so it grows to as many lines as the message needs. -->
		<Border x:Name="StatusPanel"
		        Grid.Row="2"
		        BorderThickness="2"
		        CornerRadius="6"
		        Padding="10,8"
		        Margin="0,12,0,0"
		        IsVisible="False">
			<Border.Styles>
				<Style Selector="Border.success">
					<Setter Property="BorderBrush" Value="{DynamicResource Text_Success_Fg}" />
				</Style>
				<Style Selector="Border.error">
					<Setter Property="BorderBrush" Value="{DynamicResource Text_Fail_Fg}" />
				</Style>
			</Border.Styles>

			<TextBlock x:Name="StatusTextBlock"
					   TextWrapping="Wrap"
					   FontWeight="Bold">
				<TextBlock.Styles>
					<Style Selector="TextBlock.success">
						<Setter Property="Foreground" Value="{DynamicResource Text_Success_Fg}" />
					</Style>
					<Style Selector="TextBlock.error">
						<Setter Property="Foreground" Value="{DynamicResource Text_Fail_Fg}" />
					</Style>
				</TextBlock.Styles>
			</TextBlock>
		</Border>

		<Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
			<StackPanel Grid.Column="1"
						Orientation="Horizontal"
						Spacing="8">
				<Button Content="▲"
						Click="OnScrollToTopClick" />
				<Button Content="▼"
						Click="OnScrollToBottomClick" />
				<Button Content="Cancel"
						Click="OnCancelClick" />
				<Button x:Name="SubmitButton"
						Content="Save to draft"
						Background="{DynamicResource Button_Highlighted_Bg}"
						Foreground="{DynamicResource Button_Highlighted_Fg}"
						BorderBrush="{DynamicResource Button_Highlighted_Border}"
						Click="OnSubmitClick" />
			</StackPanel>
		</Grid>

		<!-- "Please wait" over this window while a save runs (2026-09-28) - see
		     BusyOverlay. The -16 margin covers the grid's own margin. -->
		<local:BusyOverlay Grid.RowSpan="4" Margin="-16" />
	</Grid>
</Window>