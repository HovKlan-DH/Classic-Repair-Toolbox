<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.ToursAgainWindow"
        Width="440"
        MinWidth="400"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<!-- What "Take the introduction tours again" did, and where to go next (owner request, 2026-11-15: "a modal that the
	     use now should navigate to any tab to get started on the intro. Only button is "OK""). Its words are TourWording's. -->
	<StackPanel Margin="18" Spacing="4">
		<TextBlock x:Name="HeadingText" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

		<TextBlock x:Name="BodyText" TextWrapping="Wrap" />

		<Button x:Name="OkButton"
				Content="OK"
				MinWidth="80"
				HorizontalContentAlignment="Center"
				HorizontalAlignment="Right"
				Margin="0,16,0,0"
				Click="OnOkClick" />
	</StackPanel>
</Window>
