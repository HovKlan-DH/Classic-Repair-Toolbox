<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CRT"
             xmlns:data="clr-namespace:Handlers.DataHandling;assembly=CRT.Data"
             x:Class="CRT.TabConfiguration">

	<UserControl.Resources>
		<local:BooleanToFontAwesomeSyncIconConverter x:Key="BooleanToFontAwesomeSyncIconConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="ComboBox">
			<Setter Property="Background" Value="{DynamicResource Form_Bg}" />
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
		</Style>

		<Style Selector="ComboBoxItem">
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
		</Style>

		<Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>

		<Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Bg}" />
		</Style>

		<Style Selector="ComboBoxItem:selected">
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Form_Selected_Hover_Bg}" />
		</Style>

		<Style Selector="ComboBoxItem:selected:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource Form_Selected_Fg}" />
		</Style>

		<!-- A SECTION HEADING, AND THE LINE THAT SEPARATES IT FROM THE SECTION ABOVE (owner request,
		     2026-10-01: "a horisontal divider between each of the "topics" ... so they are grouped
		     together and by then maybe more clear").

		     The heading and its line are ONE control: a Border carrying the heading as its content
		     and a 1px top edge. Spacing alone had to carry the grouping before, and with twelve
		     sections of chequerboard check boxes that reads as one long list. A separate Separator
		     per heading would be a second element to keep beside each one, and the StackPanel's
		     Spacing would then sit between the line and the words it belongs to.

		     The FIRST heading drops the line (Classes="SectionHeading First"): a rule above the top
		     item separates it from the tab's own edge, not from a section. -->
		<Style Selector="Border.SectionHeading">
			<Setter Property="BorderBrush" Value="{DynamicResource Form_Border}" />
			<Setter Property="BorderThickness" Value="0,1,0,0" />
			<Setter Property="Margin" Value="0,12,0,0" />
			<Setter Property="Padding" Value="0,12,0,0" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>

		<Style Selector="Border.SectionHeading.First">
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="0" />
		</Style>

		<Style Selector="Border.SectionHeading > TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>

		<!-- "Circle-question" (fa-regular fa-circle-question) help icon that links to an external help
		     page. Same fixed-box + ClipToBounds icon-font recipe as ComponentInfoWindow's button of the
		     same name, except the foreground follows the theme rather than being hardcoded black:
		     this tab sits on the themed window background, where a black glyph vanishes in dark mode. -->
		<Style Selector="Button.HelpIconButton">
			<Setter Property="Width" Value="22" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="ClipToBounds" Value="True" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource Form_Fg}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<Style Selector="Button.HelpIconButton /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="ClipToBounds" Value="True" />
		</Style>

		<Style Selector="Button.HelpIconButton:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>

		<Style Selector="Button.HelpIconButton:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</UserControl.Styles>

	<Grid x:Name="RootSplitGrid"
          Margin="16">

		<!--
		The two MinWidths plus the splitter have to FIT inside the narrowest this tab can get,
		or the catalogue panel is simply clipped: nothing here scrolls horizontally, and the
		window's own MinWidth="800" leaves this tab about 530 DIP once Main's 200 DIP sidebar,
		its splitter and this Grid's own 16 DIP margins are taken off. 300 + 4 + 200 fits that
		with room to spare; 360 + 4 + 260 did not. 300 still clears the widest fixed content on
		the left (the three 260-wide folder buttons), and every other row wraps.
		-->
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="300" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="320" MinWidth="200" />
		</Grid.ColumnDefinitions>

		<Grid Grid.Column="0"
              RowDefinitions="*,Auto">

		<ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      AllowAutoHide="False">

		<StackPanel Spacing="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

			<Border Classes="SectionHeading First">
				<TextBlock Text="Appearance" />
			</Border>

			<TextBlock Text="Theme" />

			<ComboBox x:Name="ThemeVariantComboBox"
                      MinWidth="180">
				<ComboBoxItem Content="Light" />
				<ComboBoxItem Content="Dark" />
				<ComboBoxItem Content="User preference" />
			</ComboBox>

			<Button x:Name="ReloadUserPreferenceThemeButton"
                    Content="Reload user preference colors"
                    HorizontalAlignment="Left"
                    Click="OnReloadUserPreferenceThemeClick" />

			<Border Classes="SectionHeading">
				<TextBlock Text="Behaviour" />
			</Border>

			<CheckBox x:Name="MultipleInstancesForComponentPopupCheckBox"
					  Content="Open multiple component info windows" />

			<CheckBox x:Name="DetachSchematicsThumbnailsCheckBox"
					  Content="Detach thumbnails into their own window" />

			<CheckBox x:Name="RememberThumbnailWindowSettingsPerBoardCheckBox"
					  Content="Remember thumbnail window settings per board"
					  IsEnabled="False" />

			<Border Classes="SectionHeading">
				<TextBlock Text="Application and data updates" />
			</Border>

			<CheckBox x:Name="CheckDataOnLaunchCheckBox"
                      Content="{x:Static data:ConfigurationWording.CheckDataOnLaunchCheckBox}" />

			<!-- No warning text and no red any more (owner request, 2026-10-01). It read as an error
			     rather than as a choice, and the tooltip says what BETA data is for. -->
			<CheckBox x:Name="DownloadDataFromTestSourceCheckBox"
					  Content="{x:Static data:ConfigurationWording.BetaSourceCheckBox}"
					  ToolTip.Tip="BETA data is newly approved data that has not been released to everybody yet. Tick this to check your own submission after a maintainer has approved it, then untick it to go back to the stable source" />

			<CheckBox x:Name="AllowDeletionOfOrphanAndNonUsedFilesCheckBox"
					  Content="Delete orphan and non-used files"
					  IsEnabled="False" />

			<CheckBox x:Name="CheckVersionOnLaunchCheckBox"
                      Content="Check for new version at application launch" />

			<StackPanel Orientation="Horizontal"
						Spacing="4"
						HorizontalAlignment="Left">
				<CheckBox x:Name="ShowDevelopmentVersionNotificationCheckBox"
						  Content="Allow notification for BETA versions"
						  VerticalAlignment="Center" />
				<Button x:Name="ShowDevelopmentVersionNotificationHelpButton"
						Classes="HelpIconButton"
						VerticalAlignment="Center"
						ToolTip.Tip="A BETA version is when development has reached a mature level, and everything should work as intended. However, it is for TEST purposes only, and should only be used in agreement with the developer.">
					<TextBlock Text="&#xf059;"
							   Width="22"
							   Height="22"
							   FontFamily="{StaticResource FontAwesomeRegular}"
							   FontSize="18"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />
				</Button>
			</StackPanel>

			<StackPanel Orientation="Horizontal"
						Spacing="4"
						HorizontalAlignment="Left">
				<CheckBox x:Name="AllowAlphaVersionNotificationCheckBox"
						  Content="Allow notification for ALPHA versions"
						  VerticalAlignment="Center" />
				<Button x:Name="AllowAlphaVersionNotificationHelpButton"
						Classes="HelpIconButton"
						VerticalAlignment="Center"
						ToolTip.Tip="An ALPHA version is a development version, meaning almost anything could be broken. Do not download it unless agreed with the developer.">
					<TextBlock Text="&#xf059;"
							   Width="22"
							   Height="22"
							   FontFamily="{StaticResource FontAwesomeRegular}"
							   FontSize="18"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />
				</Button>
			</StackPanel>

			<Border Classes="SectionHeading">
				<TextBlock Text="External tooling availability" />
			</Border>

			<CheckBox x:Name="EnableNetworkConnectedOscilloscopeTabCheckBox"
                      Content="Enable network connected oscilloscope tab" />

			<StackPanel Orientation="Horizontal"
						Spacing="4"
						HorizontalAlignment="Left">
				<CheckBox x:Name="EnableMiniproExperimentalModeCheckBox"
						  Content="Enable MiniPro programmer functionality"
						  VerticalAlignment="Center" />
				<Button x:Name="EnableMiniproExperimentalModeHelpButton"
						Classes="HelpIconButton"
						VerticalAlignment="Center"
						ToolTip.Tip="Open help page for MiniPro programmer"
						Click="OnEnableMiniproExperimentalModeHelpClick">
					<TextBlock Text="&#xf059;"
							   Width="22"
							   Height="22"
							   FontFamily="{StaticResource FontAwesomeRegular}"
							   FontSize="18"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />
				</Button>
			</StackPanel>

			<CheckBox x:Name="EnableMiniproExperimentalDemoModeCheckBox"
                      Content="Enable MiniPro programmer simulated demo mode (only required for CRT development)" />

			<Border Classes="SectionHeading">
				<TextBlock Text="Workbooks" />
			</Border>

			<StackPanel Orientation="Horizontal"
						Spacing="4"
						HorizontalAlignment="Left">
				<CheckBox x:Name="EnableWorklogCheckBox"
						  Content="Enable Workbooks tab"
						  VerticalAlignment="Center" />
				<Button x:Name="EnableWorklogHelpButton"
						Classes="HelpIconButton"
						VerticalAlignment="Center"
						ToolTip.Tip="Open help page for Workbooks"
						Click="OnEnableWorklogHelpClick">
					<TextBlock Text="&#xf059;"
							   Width="22"
							   Height="22"
							   FontFamily="{StaticResource FontAwesomeRegular}"
							   FontSize="18"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />
				</Button>
			</StackPanel>

			<TextBlock Text="Scope in Workbooks tab:"
                       Margin="0,8,0,0" />

			<!-- Not indented (owner request, 2026-10-02): the radio buttons line up with the label
			     above them and with every check box in this section. -->
			<StackPanel Orientation="Vertical"
						Spacing="4"
						Margin="0,4,0,0">
				<RadioButton x:Name="WorkbooksScopeAllBoardsRadioButton"
							 GroupName="WorkbooksScope"
							 Content="Show all workbooks" />
				<RadioButton x:Name="WorkbooksScopeCurrentBoardRadioButton"
							 GroupName="WorkbooksScope"
							 Content="Show only workbooks for selected board" />
			</StackPanel>

			<TextBlock Text="Currency used for worklog costs:"
                       Margin="0,12,0,0" />

			<ComboBox x:Name="WorklogCurrencyComboBox"
                      MinWidth="280"
                      HorizontalAlignment="Left"
                      Margin="0,4,0,0"
                      ToolTip.Tip="Pick the country you live in; its currency is shown beside every cost in a workbook, and in exported PDF and ZIP documents" />

			<!-- DRAFTS AND THE MAINTAINER TAB ARE ONE SECTION (owner request, 2026-10-01: "I think
			     that the "Draft" checkbox and the maintainer things belongs together"). Both are
			     about contributing data rather than about repairing a board with it: one decides
			     whether you see your own unpublished work, the other whether you can review other
			     people's. Neither means anything to a user who only reads the data. -->
			<Border Classes="SectionHeading">
				<TextBlock Text="Contributing and maintaining data" />
			</Border>

			<!-- Renamed, and given its own help page (owner request, 2026-10-02): "officially
			     published" did not say WHERE the board then comes from. -->
			<StackPanel Orientation="Horizontal"
						Spacing="4"
						HorizontalAlignment="Left">
				<CheckBox x:Name="ViewOfficialPublishedOnlyCheckBox"
						  Content="View boards as officially coming from online source (hide my local draft changes)"
						  VerticalAlignment="Center"
						  ToolTip.Tip="With this ticked, every board shows exactly what every other user sees, even on a system where you have unpublished local edits" />
				<Button x:Name="ViewOfficialPublishedOnlyHelpButton"
						Classes="HelpIconButton"
						VerticalAlignment="Center"
						ToolTip.Tip="Open help page for viewing boards as they come from the online source"
						Click="OnViewOfficialPublishedOnlyHelpClick">
					<TextBlock Text="&#xf059;"
							   Width="22"
							   Height="22"
							   FontFamily="{StaticResource FontAwesomeRegular}"
							   FontSize="18"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />
				</Button>
			</StackPanel>

			<StackPanel Orientation="Horizontal"
						Spacing="4"
						HorizontalAlignment="Left">
				<CheckBox x:Name="EnableMaintainerTabCheckBox"
						  Content="Enable Maintainer tab"
						  VerticalAlignment="Center" />
				<Button x:Name="EnableMaintainerTabHelpButton"
						Classes="HelpIconButton"
						VerticalAlignment="Center"
						ToolTip.Tip="Open help page for the Maintainer tab"
						Click="OnEnableMaintainerTabHelpClick">
					<TextBlock Text="&#xf059;"
							   Width="22"
							   Height="22"
							   FontFamily="{StaticResource FontAwesomeRegular}"
							   FontSize="18"
							   TextAlignment="Center"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center" />
				</Button>
			</StackPanel>

			<!-- Hides the tab again while nothing is waiting (owner request, 2026-10-01). Directly
			     under "Enable Maintainer tab" and ABOVE the explanatory line, and NOT indented
			     (owner request, same day) - the two check boxes read as one pair, with the sentence
			     that explains them both below. The rule, including why a tab being looked at is
			     never taken away mid-review, is MaintainerModes.TabIsShown. -->
			<CheckBox x:Name="ShowMaintainerTabOnlyWhenWorkWaitingCheckBox"
					  Content="Hide the Maintainer tab while no work is waiting for me"
					  ToolTip.Tip="The tab appears only while its badge shows a number - a submission to review, or a system waiting to go from BETA to stable. A tab you are already on stays until you leave it" />

			<TextBlock Text="The Maintainer tab requires a maintainer account, given by the administrator through an invitation."
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       Margin="0,2,0,0" />

			<!-- A topic of its own, so it gets its own divider and heading like the rest (owner
			     request, 2026-10-01). Without one these three buttons read as belonging to the
			     Maintainer settings above them, which they have nothing to do with. -->
			<Border Classes="SectionHeading">
				<TextBlock Text="Application related files" />
			</Border>

			<!-- Three separate buttons rather than one, because these are three different folders
			     and two of them can be moved elsewhere by the data-root and workbooks-root
			     command-line switches. Each opens the path the app is ACTUALLY using, so a
			     relocated folder still opens where it really is. Equal Width so they read as one
			     group rather than a ragged stack. -->
			<Button x:Name="OpenDataFolderButton"
                    Content="Open data folder"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    Width="260"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="The hardware reference data - schematics, component images and board files"
                    Click="OnOpenDataFolderClick" />

			<Button x:Name="OpenWorkbooksFolderButton"
                    Content="Open workbooks folder"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Width="260"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="Your own workbooks - worklogs, photos and attached files"
                    Click="OnOpenWorkbooksFolderClick" />

			<Button x:Name="OpenLogsFolderButton"
                    Content="Open logs and settings folder"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Width="260"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="The log file, the crash log and your settings file - the files to attach when reporting a problem"
                    Click="OnOpenLogsFolderClick" />
		</StackPanel>

		</ScrollViewer>

		</Grid>

		<GridSplitter x:Name="CatalogueSplitter"
                      Grid.Column="1" />

		<Border x:Name="CataloguePanelBorder"
                Grid.Column="2"
                Background="{DynamicResource Form_Bg}"
                BorderBrush="{DynamicResource Form_Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12">

			<Grid RowDefinitions="Auto,Auto,*">

				<TextBlock Grid.Row="0"
                           Text="Visible hardware, boards and schematics"
                           FontSize="12"
                           FontWeight="SemiBold" />

				<TextBlock Grid.Row="1"
                           Text="Uncheck anything you want hidden from the hardware, board and schematic selections."
                           TextWrapping="Wrap"
                           Opacity="0.75"
                           FontSize="11"
                           Margin="0,4,0,10" />

				<ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              AllowAutoHide="False">

					<StackPanel x:Name="CatalogueTreePanel"
                                Spacing="0" />

				</ScrollViewer>

			</Grid>

		</Border>

	</Grid>
</UserControl>