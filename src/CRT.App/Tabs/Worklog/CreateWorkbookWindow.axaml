<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.CreateWorkbookWindow"
        Title="Create new workbook"
        Width="480"
        MinWidth="420"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">

		<StackPanel Orientation="Horizontal"
					Spacing="8"
					Margin="0,0,0,10">
			<TextBlock Text="Workbook"
					   FontSize="16"
					   FontWeight="Bold" />
			<TextBlock x:Name="WorkbookIdPreviewText"
					   FontSize="16"
					   FontWeight="Bold" />
		</StackPanel>

		<TextBlock Text="Description" />
		<TextBox x:Name="TitleTextBox" TextChanged="OnTitleTextChanged" />
		<TextBlock x:Name="TitleValidationText"
				   Text="A description is required."
				   Foreground="{DynamicResource Text_Fail_Fg}"
				   FontSize="11"
				   Margin="0,2,0,0"
				   IsVisible="False" />

		<TextBlock Text="Note"
				   Margin="0,10,0,0" />
		<TextBox x:Name="NoteTextBox"
				 AcceptsReturn="True"
				 TextWrapping="Wrap"
				 Height="100"
				 VerticalContentAlignment="Top" />
		<TextBlock Text="Ctrl+Enter to save" FontSize="10" Opacity="0.6" Margin="0,2,0,0" />

		<StackPanel Orientation="Horizontal"
					Spacing="8"
					HorizontalAlignment="Right"
					Margin="0,16,0,0">
			<Button x:Name="CancelButton"
					Content="Cancel"
					Click="OnCancelClick" />
			<Button x:Name="CreateButton"
					Content="Create workbook"
					Foreground="{DynamicResource Button_Ok_Fg}"
					Background="{DynamicResource Button_Ok_Bg}"
					BorderBrush="{DynamicResource Button_Ok_Border}"
					Click="OnCreateClick" />
		</StackPanel>
	</StackPanel>
</Window>
