<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.WorklogAddLinkWindow"
        Title="Add link"
        Width="440"
        MinWidth="380"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">
		<TextBlock x:Name="HeaderText" Text="Add link" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

		<TextBlock Text="Headline" />
		<TextBox x:Name="HeadlineTextBox" />
		<TextBlock x:Name="HeadlineValidationText"
				   Text="A headline is required."
				   Foreground="{DynamicResource Text_Fail_Fg}"
				   FontSize="11"
				   Margin="0,2,0,0"
				   IsVisible="False" />

		<TextBlock Text="URL" Margin="0,10,0,0" />
		<TextBox x:Name="UrlTextBox" />
		<TextBlock x:Name="UrlValidationText"
				   Text="A URL is required."
				   Foreground="{DynamicResource Text_Fail_Fg}"
				   FontSize="11"
				   Margin="0,2,0,0"
				   IsVisible="False" />

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Cancel" Click="OnCancelClick" />
			<Button x:Name="AddButton"
					Content="Add link"
					Foreground="{DynamicResource Button_Ok_Fg}"
					Background="{DynamicResource Button_Ok_Bg}"
					BorderBrush="{DynamicResource Button_Ok_Border}"
					Click="OnAddClick" />
		</StackPanel>
	</StackPanel>
</Window>
