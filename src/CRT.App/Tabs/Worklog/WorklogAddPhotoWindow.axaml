<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.WorklogAddPhotoWindow"
        Title="Add photo"
        Width="460"
        MinWidth="380"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">
		<TextBlock x:Name="HeaderText" Text="Add photo" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

		<TextBlock x:Name="SectionLabelText" Text="Image" />

		<!-- Drop target and picker in one. The border is the drop surface; DragOver/Drop are wired
		     in code-behind so an unsupported file shows the same refusal a picked one would. -->
		<Border x:Name="ImageDropBorder"
				Background="{DynamicResource Form_Bg}"
				BorderBrush="{DynamicResource Form_Border}"
				BorderThickness="1"
				CornerRadius="3"
				Padding="10"
				MinHeight="96">
			<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">

				<Image x:Name="ImagePreview"
					   Grid.Row="0"
					   Grid.RowSpan="3"
					   Grid.Column="0"
					   Width="72"
					   Height="72"
					   Margin="0,0,10,0"
					   Stretch="Uniform"
					   VerticalAlignment="Top"
					   IsVisible="False" />

				<TextBlock x:Name="SelectedFileText"
						   Grid.Row="0"
						   Grid.Column="1"
						   Text="Drag an image here, or use Browse"
						   FontSize="12"
						   Opacity="0.75"
						   TextWrapping="Wrap"
						   VerticalAlignment="Center" />

				<TextBlock x:Name="SelectedFilePathText"
						   Grid.Row="1"
						   Grid.Column="1"
						   FontSize="10"
						   Opacity="0.6"
						   TextTrimming="CharacterEllipsis"
						   IsVisible="False"
						   Margin="0,2,0,0" />

				<StackPanel Grid.Row="2"
							Grid.Column="1"
							Orientation="Horizontal"
							Spacing="8"
							Margin="0,8,0,0">
					<Button x:Name="BrowseButton" Content="Browse..." FontSize="11" Padding="8,3" Click="OnBrowseClick" />
					<Button x:Name="ClearButton" Content="Clear" FontSize="11" Padding="8,3" Click="OnClearClick" IsVisible="False" />
				</StackPanel>
			</Grid>
		</Border>

		<TextBlock x:Name="AcceptedTypesText" Text="PNG, JPG, GIF, BMP or WEBP" FontSize="10" Opacity="0.6" Margin="0,2,0,0" />

		<TextBlock x:Name="ImageValidationText"
				   Foreground="{DynamicResource Text_Fail_Fg}"
				   FontSize="11"
				   Margin="0,2,0,0"
				   TextWrapping="Wrap"
				   IsVisible="False" />

		<TextBlock Text="Comment" Margin="0,10,0,0" />
		<TextBox x:Name="CommentTextBox"
				 AcceptsReturn="True"
				 TextWrapping="Wrap"
				 Height="70"
				 VerticalContentAlignment="Top" />
		<TextBlock Text="Ctrl+Enter to save" FontSize="10" Opacity="0.6" Margin="0,2,0,0" />

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Cancel" Click="OnCancelClick" />
			<Button x:Name="AddButton"
					Content="Add photo"
					Foreground="{DynamicResource Button_Ok_Fg}"
					Background="{DynamicResource Button_Ok_Bg}"
					BorderBrush="{DynamicResource Button_Ok_Border}"
					Click="OnAddClick" />
		</StackPanel>
	</StackPanel>
</Window>
