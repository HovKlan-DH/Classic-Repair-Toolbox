<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<Title>Classic Repair Toolbox</Title>
		<Product>Classic Repair Toolbox</Product>
		<AssemblyTitle>Classic Repair Toolbox</AssemblyTitle>
		<Authors>Dennis Helligsø</Authors>
		<Copyright>©2025-2026</Copyright>
		<AssemblyName>Classic-Repair-Toolbox</AssemblyName>
		<AssemblyVersion>3.0.0</AssemblyVersion>
		<!--
		<InformationalVersion>$(AssemblyVersion)</InformationalVersion>
		-->
		<InformationalVersion>3.0.0-beta.4</InformationalVersion>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<RollForward>LatestMajor</RollForward>
        <Nullable>enable</Nullable>
        <!--
        Warnings are considered errors in Release - the configuration CI, the release gate
		and the "Stop hook" all build. Debug stays warnings-only so a half-finished edit does
		not break the F5/watch loop.
        -->
        <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
        <!--
        SonarAnalyzer.CSharp's own rule IDs (the "S####" diagnostics) are listed in
        WarningsNotAsErrors below, exempting them from TreatWarningsAsErrors. The analyzer was
        added for refactoring visibility (cognitive complexity, code smells), and its first run
        against this codebase surfaced ~180 pre-existing findings across ~38 distinct rules.
        Promoting all of those straight to build-breaking errors on day one, in a project where
        CI/the release gate/the Stop hook all build with warnings-as-errors, would have blocked
        every build immediately. This keeps every finding visible (IDE squiggles, build output)
        without gating anything; the CS/CA compiler and analyzer warnings this project already had
        at zero are untouched and still fail Release/the Stop hook as before.

        There is no wildcard for "every SonarAnalyzer diagnostic" - MSBuild's WarningsNotAsErrors
        only takes literal IDs, and the legacy CodeAnalysisTreatWarningsAsErrors property does not
        apply to Roslyn analyzers shipped as a NuGet package (both were tried and both still left
        every S#### diagnostic as an error). So the list below is enumerated from the rules the
        analyzer actually raised against this codebase; a rule not yet seen would still build as
        an error the first time it fires - add its ID here (or fix the finding) when that happens.
        Do NOT bulk-remove this list to "simplify" it; that reintroduces the original problem.

        Confirmed to need re-checking on every SonarAnalyzer.CSharp version bump, not just the
        first install: going from 9.32.0.97167 to 10.33.0.1635 immediately broke the build with 61
        new S6444 errors (plus S1313/S4036/S8949/S8969, caught by forcing a full rebuild rather
        than trusting the incremental one), because a major version can add rules the exemption
        list has never seen. A few IDs from the 9.32 list (S1121, S2583, S2589, S6602, S6603) no
        longer fire under 10.33 - left in place rather than pruned, since an unused ID here is
        harmless and re-deriving the list from scratch on every bump is more error-prone than
        appending to it.
        -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);S108;S125;S1066;S1075;S1118;S1121;S1125;S1144;S1172;S1244;S1313;S1450;S1481;S1854;S1871;S1905;S1940;S2292;S2325;S2365;S2486;S2583;S2589;S2737;S2953;S2971;S3168;S3267;S3358;S3604;S3963;S4036;S4136;S4158;S4487;S6444;S6602;S6603;S6605;S6608;S6966;S8949;S8969</WarningsNotAsErrors>
        <ApplicationManifest>Main\app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <!--
        Ahead-of-time compile the app and the self-contained .NET runtime at publish time.
        Without this every framework method on the way to the first pixel is JIT-compiled while the
        user stares at nothing - and none of that time was even visible in the log, because logging
        only starts once Avalonia is already up (see StartupTimeline).

        Conditioned on RuntimeIdentifier because ReadyToRun requires a target RID; a bare
        "dotnet publish" with no -r would otherwise fail. Every publish in
        .github/workflows/build-and-release.yml passes -r, so all four shipped builds get it.
        It trades install size for launch time, which is the right way round for an app that
        already ships ~1 GB of hardware data.
        -->
        <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
        <PackageProjectUrl>https://github.com/HovKlan-DH/Classic-Repair-Toolbox</PackageProjectUrl>
        <PackageIcon>CRT_icon.png</PackageIcon>
        <ApplicationIcon>..\..\Assets\CRT_icon.ico</ApplicationIcon>
        <FileVersion>$(AssemblyVersion)</FileVersion>
        <Version>$(InformationalVersion)</Version>
        <Description>A utility tool for classic and retro hardware repairing, troubleshooting and diagnosing.</Description>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
	<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageReference Include="EPPlus" Version="8.7.1" />
    <PackageReference Include="ProDataGrid" Version="12.1.0.4" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <!--
    DPAPI, for the Maintainer tab's remembered sign-in (Handlers/Maintainer/ReviewSessionProtection,
    moved here with the maintainer application on 2026-09-29). Windows-only by nature: the package
    restores and builds everywhere and throws PlatformNotSupportedException if called off Windows -
    which is why every call is guarded by OperatingSystem.IsWindows() and CRT simply declines to
    remember a maintainer session on other platforms rather than storing one in the clear.
    -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" PrivateAssets="all" />
  </ItemGroup>

  <!--
  CRT.Data holds the Avalonia-free board-data layer (BoardData/Reader/Writer, board JSON
  highlights, DataValidator, plus a few pure text helpers) shared with the Maintainer tab and, from
  Phase 3, the server. See src/CRT.Data/CRT.Data.csproj's own header for what deliberately stayed
  behind in this project instead.
  -->
  <ItemGroup>
    <ProjectReference Include="..\CRT.Data\CRT.Data.csproj" />
  </ItemGroup>

  <!--
  There is no separate CRT.UI library any more (2026-09-30). It held the controls the Drafts tab
  and the separate CRT Maintainer application both showed - the table editor, BusyOverlay,
  ListRowDrag - and once that application became CRT's Maintainer tab (2026-09-29) both users
  were in this one project, so it was folded in: Controls/ for the controls, Handlers/ for its pure
  parts (RowDragSlots, ThemeResources, and WaitLimit/WaitWording in Handlers/Waiting/). A test,
  SharedControlsIndependenceTests, keeps Controls/ from reaching into Main, DataManager,
  UserSettings or Logger - the wall the separate library used to be. The table's RULES still live in
  CRT.Data, which the server shares.
  -->

  <!--
  Repository layout since the Phase 0 restructure: this project lives at src/CRT.App/, with
  Assets/ two levels up at the repository root, entirely outside this project's own directory
  tree. The SDK's default "**/*.cs" glob only ever walks DOWN from the project file, so it cannot
  reach anything under Assets/, and the exclude that used to be needed for it is gone - there is
  nothing left to exclude.
  Likewise the test project now lives as a sibling under tests/CRT.App.Tests/, not inside this
  project's folder, so the old "Tests/**" exclude is gone too.
  -->

  <!-- Much of Handlers/ is internal (KiCad loaders, board JSON storage, Excel reader/writer).
       The test project needs to see it; nothing else does. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CRT.App.Tests" />
  </ItemGroup>

    <ItemGroup>
        <Compile Update="Tabs/Feedback/TabFeedback.axaml.cs">
            <DependentUpon>TabFeedback.axaml</DependentUpon>
        </Compile>
        <Compile Update="Main/Main.axaml.cs">
            <DependentUpon>Main.axaml</DependentUpon>
        </Compile>
        <Compile Update="Tabs/Oscilloscope/TabOscilloscope.axaml.cs">
            <DependentUpon>TabOscilloscope.axaml</DependentUpon>
        </Compile>
        <Compile Update="Tabs/Overview/TabOverview.axaml.cs">
            <DependentUpon>TabOverview.axaml</DependentUpon>
        </Compile>
        <Compile Update="Properties/Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
        <Compile Update="Main/Splash.axaml.cs">
            <DependentUpon>Splash.axaml</DependentUpon>
        </Compile>
    </ItemGroup>

    <!--
    Link pins the LOGICAL resource path (what "avares://Classic-Repair-Toolbox/Assets/..." resolves
    against) to stay "Assets/..." regardless of where the physical file lives on disk. Without it,
    Avalonia derives the logical path from the item's project-relative Include path - which is now
    "../../Assets/..." since Assets/ sits two levels above this project - and every hardcoded
    avares:// URI in the app (Splash.axaml, TabAbout.axaml, App.axaml, WorkbookPdfExporter.cs) would
    silently stop resolving. This is what "FileNotFoundException: the resource avares://.../Assets/
    CRT_icon.png could not be found" looks like when it happens.
    -->
    <ItemGroup>
	    <AvaloniaResource Include="../../Assets/CRT_icon.png" Link="Assets/CRT_icon.png" />
	    <AvaloniaResource Include="../../Assets/Fonts/*.otf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="../../Assets/CRT_icon.ico" />
    </ItemGroup>

	<!--
	Bundled MiniPro, per-RID, flattened next to the EXE (so "MiniproProcessRunner.ResolveBinary" finds
	it via "AppContext.BaseDirectory"). A RID-targeted publish uses the RID as-is; a plain dev build
	(no RID) falls back to the host OS's natural RID so the committed "minipro.exe" is staged automatically.
	-->
	<PropertyGroup>
		<MiniproRid>$(RuntimeIdentifier)</MiniproRid>
		<MiniproRid Condition="'$(MiniproRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</MiniproRid>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
	  <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>
	<ItemGroup Condition="'$(MiniproRid)' != '' And Exists('../../Assets/MiniPro/$(MiniproRid)') And !$(MiniproRid.StartsWith('linux'))">
		<Content Include="../../Assets/MiniPro/$(MiniproRid)/**/*">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties/Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

    <ItemGroup>
	    <AvaloniaResource Update="../../Assets/CRT_icon.png">
		    <Pack>True</Pack>
		    <PackagePath>\</PackagePath>
	    </AvaloniaResource>
    </ItemGroup>

</Project>
