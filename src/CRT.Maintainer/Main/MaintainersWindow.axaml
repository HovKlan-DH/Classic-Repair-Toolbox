<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.Maintainer.MaintainersWindow"
        Width="900" Height="560"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Title="Maintainers">

    <!--
    WHO REVIEWS WHAT (Phase 6 roles, 2026-09-25). Administrator only - the server refuses everyone
    else, and the main window only offers the button to an administrator.

    Systems on the left, the selected system's maintainers on the right with a Remove beside each,
    and an "add" row underneath choosing from every account. Nothing here is a control; it is a
    rendering of what the server said and a way to ask it for a change.
    -->
    <Grid Margin="12" ColumnDefinitions="*,4,*" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Systems"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <ListBox Grid.Row="1" Grid.Column="0"
                 x:Name="SystemsList"
                 SelectionChanged="OnSystemSelectionChanged" />

        <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

        <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="12,0,0,0">

            <TextBlock DockPanel.Dock="Top"
                       x:Name="SelectedSystemText"
                       Text="Select a system."
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!--
            THE ADD ROW, docked to the bottom so it stays put however long the maintainer list gets.
            The list of accounts is every account the server knows; the ones that cannot be
            granted say why in the list itself (MaintainerAssignmentDisplay.AccountChoice), so the
            refusal is read before the button is pressed.
            -->
            <Grid DockPanel.Dock="Bottom"
                  ColumnDefinitions="*,Auto"
                  Margin="0,8,0,0">

                <ComboBox Grid.Column="0"
                          x:Name="AccountsCombo"
                          PlaceholderText="Choose an account"
                          HorizontalAlignment="Stretch" />

                <Button Grid.Column="1"
                        x:Name="AddButton"
                        Content="Add as maintainer"
                        Margin="8,0,0,0"
                        Click="OnAddClick" />
            </Grid>

            <TextBlock DockPanel.Dock="Bottom"
                       x:Name="MessageText"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Margin="0,8,0,0" />

            <ScrollViewer>
                <StackPanel x:Name="MaintainersPanel" Spacing="4" />
            </ScrollViewer>
        </DockPanel>

        <!--
        The way out, and nothing destructive near it. Removing a maintainer is not destructive
        either - it changes who may act, not any data - so no confirmation dialog is asked for.
        -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
            <Button x:Name="CloseButton" Content="Close" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
