<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CRT;assembly=CRT.UI"
        x:Class="CRT.Maintainer.MaintainerMain"
        Width="1100" Height="720"
        MinWidth="820" MinHeight="520"
        Title="CRT Maintainer">

    <Window.Styles>
        <!-- THE QUEUE, GROUPED BY BOARD (2026-09-26, MaintainerMain.QueueItems.cs). -->

        <!-- "New system" on a board's heading - the one badge left: a published system is the
             ordinary case. Colours from MaintainerApp.axaml, per theme. -->
        <Style Selector="Border.Badge">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Badge_NewSystem_Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Badge_NewSystem_Border}" />
        </Style>

        <Style Selector="Border.Badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Badge_NewSystem_Fg}" />
        </Style>

        <!-- A board's heading: a disabled item, so it cannot be selected - drawn in the ordinary
             text colour rather than the theme's greyed-out one, since it is a heading, not an
             option that is off. -->
        <Style Selector="ListBoxItem.QueueHeading">
            <Setter Property="Padding" Value="10,8,10,2" />
        </Style>

        <Style Selector="ListBoxItem.QueueHeading:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <!-- The line above every heading but the first, keeping the boards apart. -->
        <Style Selector="Border.QueueDivider">
            <Setter Property="BorderBrush" Value="{DynamicResource Queue_Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,8,0,0" />
        </Style>

        <!-- A submission under its board's heading, indented beneath it. -->
        <Style Selector="ListBoxItem.QueueEntry">
            <Setter Property="Padding" Value="22,5,10,6" />
        </Style>
    </Window.Styles>

    <!--
    TWO PANELS, ONE AT A TIME: sign in, then the queue.

    The sign-in panel is a PANEL rather than a modal dialog, deliberately. A modal would have to be
    dismissed and re-shown on every expiry and every "not permitted" answer, and a maintainer whose
    session lapsed mid-session would get a dialog over a window still showing stale rows. Swapping
    the whole surface means what is on screen is always the thing that is actually true.
    -->
    <Grid Margin="12">

        <!-- ================= Sign in ================= -->
        <StackPanel x:Name="SignInPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360"
                    Spacing="8">

            <TextBlock Text="CRT Maintainer"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <!--
            *** WHAT THIS APP IS, said before anything is asked of the reader. ***

            This is not the application most people mean by "Classic Repair Toolbox", and somebody
            who installed it expecting that finds a sign-in screen for an account they do not have
            and cannot create. Saying so here costs four lines and saves that person guessing.

            It sits ABOVE the fields rather than below them, because an explanation under a form is
            read after the reader has already decided they are in the wrong place.
            -->
            <Border Background="#20808080"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,4,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="For maintainers of the hardware data only."
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock TextWrapping="Wrap"
                               Opacity="0.85"
                               Text="This tool reviews and publishes contributions to the shared hardware data. It needs a maintainer account, assigned by the administrator, and does nothing without one." />

                    <TextBlock TextWrapping="Wrap"
                               Opacity="0.85"
                               Text="If you are here to repair a machine, use the ordinary Classic Repair Toolbox application instead - this is not it." />
                </StackPanel>
            </Border>

            <!--
            NO SERVER FIELD. The maintainer app talks to exactly one service and always will, so asking
            for it on every launch was a question whose answer never changes - and one that broke
            the moment somebody typed a trailing slash or omitted the scheme. The address is
            ReviewApiRoutes.DefaultBaseAddress.
            -->

            <TextBlock Text="Email"
                       Opacity="0.7"
                       Margin="0,4,0,0" />
            <TextBox x:Name="EmailTextBox" />

            <TextBlock Text="Password"
                       Opacity="0.7"
                       Margin="0,4,0,0" />
            <!--
            PasswordChar, so a shoulder-surfer at a bench cannot read a maintainer credential -
            this account can publish to every user of a system.
            -->
            <TextBox x:Name="PasswordTextBox"
                     PasswordChar="*"
                     KeyDown="OnPasswordKeyDown" />

            <Button x:Name="SignInButton"
                    Content="Sign in"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0"
                    Click="OnSignInClick" />

            <!--
            FORGOT PASSWORD. A plain text button rather than a second screen: the whole interaction
            is one request and one sentence, and a maintainer locked out of the only tool that can
            publish should not have to go looking for how to get back in.
            -->
            <Button x:Name="ForgotPasswordButton"
                    Content="I forgot my password"
                    HorizontalAlignment="Left"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="SteelBlue"
                    Click="OnForgotPasswordClick" />

            <!--
            The failure message. Its own block rather than a dialog, so a wrong password does not
            cost a click to dismiss before trying again.

            NOT always red: the password-reset answer is good news, and colouring it as an error
            would read as a failure to somebody who has just asked for help.
            -->
            <TextBlock x:Name="SignInMessageText"
                       Foreground="IndianRed"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <!--
            ================= Completing a password reset =================

            HIDDEN UNTIL A CODE HAS BEEN ASKED FOR, so the ordinary sign-in screen stays two
            fields and a button. It is revealed by "I forgot my password" - the moment the code
            is on its way and the next thing the person needs is somewhere to put it.

            *** THE MAIL CARRIES A CODE, NOT A LINK, AND THIS PANEL IS WHY. *** Completing a reset
            needs the new PASSWORD, so it cannot be a click: the URL the mail used to print
            ("/api/accounts/reset?token=...") was mapped to nothing and 404'd for every user who
            clicked it. A pasted code is also the safer shape, since a prefetching mail client
            cannot burn a single-use token by following a link.
            -->
            <StackPanel x:Name="ResetPanel"
                        IsVisible="False"
                        Spacing="4"
                        Margin="0,12,0,0">

                <Border Background="#1F4F7FBF"
                        BorderBrush="#4F7FBF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Check your email for a reset code"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock TextWrapping="Wrap"
                                   Opacity="0.85"
                                   Text="Paste the code below and choose the password you want. The code works for 2 hours and can only be used once." />
                    </StackPanel>
                </Border>

                <TextBlock Text="Reset code"
                           Opacity="0.7"
                           Margin="0,4,0,0" />
                <TextBox x:Name="ResetCodeTextBox" />

                <TextBlock Text="New password"
                           Opacity="0.7"
                           Margin="0,4,0,0" />
                <TextBox x:Name="NewPasswordTextBox"
                         PasswordChar="*"
                         KeyDown="OnNewPasswordKeyDown" />

                <Button x:Name="SetPasswordButton"
                        Content="Set password"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,8,0,0"
                        Click="OnSetPasswordClick" />
            </StackPanel>
        </StackPanel>

        <!-- ================= The queue ================= -->
        <Grid x:Name="QueuePanel"
              IsVisible="False"
              ColumnDefinitions="340,4,*">

            <DockPanel Grid.Column="0">
                <!--
                THE QUEUE'S HEADER: the title, and the other screens on a line of their own that WRAPS
                (2026-09-26). All in one row of Auto columns were wider than this 340px column, so for
                an administrator the buttons ran out of it and over the submission's headline
                (reported, with a screenshot). No Refresh button: the queue keeps itself up to date
                (MaintainerMain.QueueRefresh.cs).
                -->
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="Queue"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <WrapPanel x:Name="QueueToolsPanel" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                        <!--
                        BETA to production (2026-09-25). For everyone who reaches the queue: a maintainer
                        publishes their own systems to production, the administrator any. The window
                        lists only what the SERVER says this account may publish.
                        -->
                        <Button x:Name="ProductionButton"
                                Content="Production"
                                Click="OnProductionClick" />

                        <!--
                        Who reviews what - ADMINISTRATOR ONLY, and hidden for everyone else because the
                        server would refuse them anyway. The server said whether to show it
                        (isAdministrator in the queue answer); this window never works it out itself.
                        -->
                        <Button x:Name="MaintainersButton"
                                Content="Maintainers"
                                IsVisible="False"
                                Click="OnMaintainersClick" />

                        <!--
                        Files nothing uses, per data tree (2026-09-25) - ADMINISTRATOR ONLY, shown and
                        hidden with Maintainers for the same reason.
                        -->
                        <Button x:Name="UnusedFilesButton"
                                Content="Unused files"
                                IsVisible="False"
                                Click="OnUnusedFilesClick" />
                    </WrapPanel>
                </StackPanel>

                <!--
                Who is signed in, and the way out.

                SIGN OUT IS A REAL BUTTON RATHER THAN A MENU ITEM because it is the only way to
                clear a remembered session deliberately, and the project owner named it as the thing
                that must forget the login. A credential that can be stored but not cleared from
                the UI would be the wrong half of the feature.

                It sits at the BOTTOM of the queue panel, well away from the decision buttons:
                nothing here is destructive, but a maintainer reaching for "Reject" must never find
                this under the pointer instead.
                -->
                <Grid DockPanel.Dock="Bottom"
                      ColumnDefinitions="*,Auto"
                      Margin="0,8,0,0">

                    <TextBlock x:Name="SignedInAsText"
                               Opacity="0.6"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            x:Name="SignOutButton"
                            Content="Sign out"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="OnSignOutClick" />
                </Grid>

                <!--
                The empty/error state sits ABOVE the list rather than below it, because an empty
                list leaves the bottom of the panel far from where the maintainer is looking.
                -->
                <TextBlock DockPanel.Dock="Top"
                           x:Name="QueueMessageText"
                           TextWrapping="Wrap"
                           IsVisible="False"
                           Margin="0,0,0,8" />

                <!-- Each row is several lines (MaintainerMain.QueueItems.cs), and wraps to the
                     column rather than scrolling sideways. -->
                <ListBox x:Name="QueueList"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnQueueSelectionChanged" />
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

            <DockPanel Grid.Column="2" Margin="12,0,0,0">
                <!--
                Said until a submission is chosen. The submission's details - badges, system, what
                the contributor wrote - are in its queue row (MaintainerMain.QueueItems.cs), not
                repeated here, so the table gets the room (owner request, 2026-09-26).
                -->
                <TextBlock DockPanel.Dock="Top"
                           x:Name="NoSubmissionText"
                           Text="Select a submission"
                           FontSize="16"
                           Opacity="0.7"
                           Margin="0,0,0,10" />

                <!--
                THE DECISION BAR (task 5), docked to the BOTTOM so it cannot scroll away. A
                maintainer scrolls through the changes and then decides; a bar that scrolled with
                them would mean scrolling back to a button whose context they have just left.

                The COMMENT box comes first and is always visible, because it is required for two
                of the three outcomes and a box that appeared only after pressing a button would
                make the maintainer press, read a refusal, type, and press again.
                -->
                <StackPanel DockPanel.Dock="Bottom"
                            x:Name="DecisionPanel"
                            IsVisible="False"
                            Spacing="6"
                            Margin="0,12,0,0">

                    <TextBlock x:Name="DecisionMessageText"
                               TextWrapping="Wrap"
                               IsVisible="False" />

                    <!--
                    WHO MUST APPROVE (2026-09-25): shown only for a submission that changes a shared
                    file, which needs the board's maintainer AND the administrator. Written by
                    ApprovalWording from the server's ApprovalStatus.
                    -->
                    <TextBlock x:Name="ApprovalStatusText"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               IsVisible="False" />

                    <!--
                    WHAT APPROVING REMOVES (2026-09-25): files the board stops citing that nothing
                    else uses are removed by the publish. Said here, beside the button, as well as
                    in the file list - "It must be, so it is clear what will happen".
                    -->
                    <TextBlock x:Name="RemovalStatusText"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="IndianRed"
                               IsVisible="False" />

                    <!--
                    CHANGED IN THE TABLE (2026-09-25): who last changed this submission in "View in
                    table format", so a second maintainer - or the administrator giving the second
                    approval - knows it is not exactly what the contributor sent.
                    -->
                    <TextBlock x:Name="AmendmentText"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               IsVisible="False" />

                    <TextBox x:Name="DecisionCommentTextBox"
                             AcceptsReturn="True"
                             MinHeight="60"
                             MaxHeight="120"
                             TextWrapping="Wrap"
                             PlaceholderText="Why? The contributor sees this - it is the only message they get." />

                    <!--
                    APPROVE IS LAST AND SEPARATED - at the far RIGHT (owner request, 2026-09-26), the
                    other two at the left. It is the only irreversible action on this screen: it
                    publishes, and with no retained revision the only way back is a correction.
                    Putting it first, where a reflexive click lands, would be the wrong default for
                    the one button that cannot be undone.

                    The three in CRT's own red (owner request, 2026-09-26) - the colours of the
                    table's "Save changes", from the Button_Cancel_* keys. Greyed by the theme while
                    off.
                    -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                x:Name="ApproveButton"
                                Content="Approve and publish to BETA"
                                Foreground="{DynamicResource Button_Cancel_Fg}"
                                Background="{DynamicResource Button_Cancel_Bg}"
                                BorderBrush="{DynamicResource Button_Cancel_Border}"
                                Click="OnApproveClick" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RequestChangesButton"
                                Content="Request changes"
                                Foreground="{DynamicResource Button_Cancel_Fg}"
                                Background="{DynamicResource Button_Cancel_Bg}"
                                BorderBrush="{DynamicResource Button_Cancel_Border}"
                                Click="OnRequestChangesClick" />

                        <Button x:Name="RejectButton"
                                Content="Reject"
                                Foreground="{DynamicResource Button_Cancel_Fg}"
                                Background="{DynamicResource Button_Cancel_Bg}"
                                BorderBrush="{DynamicResource Button_Cancel_Border}"
                                Click="OnRejectClick" />
                    </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!--
                THE TABLE IS THE SUBMISSION (owner request, 2026-09-26: "make the table the default
                first view, as this is the most helpful one ... just scrap that information" - the
                change summary that used to fill this panel). It opens with the submission; there is
                no other view. See MaintainerMain.Table.cs.

                Above it, only when there is something to say, what the table CANNOT show:
                highlights, calibration points, the automatic checks' warnings (ReviewNotInTable).

                *** THE TABLE IS NEVER INSIDE A SCROLLVIEWER. *** A grid measured with unlimited
                height realises every row - the Drafts tab's rule, for the same grid.
                -->
                <DockPanel x:Name="TablePanel" IsVisible="False">
                    <TextBlock DockPanel.Dock="Top"
                               x:Name="TableLoadMessageText"
                               TextWrapping="Wrap"
                               IsVisible="False"
                               Margin="0,0,0,8" />

                    <!-- Who sent it, and how their other submissions went (ReviewContributorLine,
                         owner request 2026-09-26). -->
                    <TextBlock DockPanel.Dock="Top"
                               x:Name="ContributorText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="False"
                               Margin="0,0,0,4" />

                    <StackPanel DockPanel.Dock="Top"
                                x:Name="NotInTablePanel"
                                Spacing="2"
                                IsVisible="False"
                                Margin="0,0,0,8" />

                    <ui:BoardTableEditor x:Name="SubmissionTable" />
                </DockPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
