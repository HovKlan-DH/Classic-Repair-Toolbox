<Project Sdk="Microsoft.NET.Sdk">

    <!--
    CRT.UI - Avalonia controls shared by the desktop app (CRT.App) and the review application
    (CRT.Review).

    It exists for the TABLE EDITOR (maintainer request, 2026-09-25): the Drafts tab's "Edit in table
    format" and the review application's table are the same control, so a fix or a colour change
    reaches both. Its rules are in CRT.Data (BoardTableDocument and friends); this library only
    paints them.

    Rules for what may live here: a control that BOTH applications show, which touches nothing of
    either application (no Main, no DataManager, no UserSettings, no Logger - CRT.Data's CrtLog is
    the logging seam). Anything that needs one of those stays in its application.

    Its colours are its own (BoardTable/BoardTableColors.axaml), merged by both applications, so the
    two cannot drift apart; the few general theme keys it borrows (Bg, Table_Bg, the Cancel button's
    colours, Text_Fail_Fg) each application defines itself.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="ProDataGrid" Version="12.1.0.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CRT.Data\CRT.Data.csproj" />
    </ItemGroup>

    <!--
    The applications reach the editor's internal members (the Drafts tab asks whether the draft is
    held open elsewhere, for instance), and the test projects reach its ...ForTests seams, exactly as
    they did while it lived in CRT.App.
    -->
    <ItemGroup>
        <InternalsVisibleTo Include="Classic-Repair-Toolbox" />
        <InternalsVisibleTo Include="Classic-Repair-Toolbox-Review" />
        <InternalsVisibleTo Include="CRT.App.Tests" />
        <InternalsVisibleTo Include="CRT.Review.Tests" />
    </ItemGroup>

</Project>
