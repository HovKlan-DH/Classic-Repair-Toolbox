<!--
CRT's headless UI tests - the tabs, windows and Main itself built on Avalonia's headless platform -
but the Contribute tab's, which are CRT.App.ContributeUiTests' (owner request, 2026-11-08: "yes, do
this", to running the App tests in parallel). One Avalonia session serves every test of a process on
ONE dispatcher thread, so the UI tests of one project run one at a time whatever happens: in three
processes - this, the Contribute tab's, and CRT.App.Tests - they run side by side on the other cores,
and the wall clock is the slowest of them, not their sum. The two UI projects are about as long as
each other; a new UI test goes where its tab's are. The harness itself (UiTest, TestAppBuilder) is
in Shared/, compiled into both.

TreatAsLocalProperty lets this project override SelfContained even when it arrives as a
command-line (global) property - see the comment on SelfContained in CRT.App.Tests.csproj.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="SelfContained;PublishSelfContained">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>false</PublishSelfContained>
    <IsPublishable>false</IsPublishable>
    <!-- The test host's runtime, measured: see CRT.App.Tests.csproj. -->
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>Classic_Repair_Toolbox.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- xUnit1051 is off in all four test projects alike - CRT.App.Tests.csproj says why. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Headless only. The Avalonia.Headless.XUnit adapter (12.1.3) is built against
         xunit v3's 3.2 extensibility API, which xunit 4.0 changed, and it has not been tried
         against 4.x - so UiTest drives the headless session directly instead, depending on no
         test framework at all.

         xunit.v3.mtp-OFF, not plain xunit.v3: from 4.0 the plain package runs on Microsoft
         Testing Platform v2, where coverlet.collector (the "XPlat Code Coverage" CI collects)
         does not work. The mtp-off package is the same framework on VSTest, which is what
         `dotnet test`, CI, the release gate and the Stop hook all use. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CRT.App\CRT.App.csproj" />
  </ItemGroup>

  <!--
  The helpers both App test projects use (a temporary folder, cached workbooks, a main file, ...) live
  in CRT.App.Tests/Shared and are compiled into each - a library of their own would need the app's
  internals opened to one more assembly for no gain.
  -->
  <ItemGroup>
    <Compile Include="..\CRT.App.Tests\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
