<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ts="clr-namespace:Tabs.TabSchematics"
             x:Class="CRT.SchematicsThumbnailGallery">

	<ListBox x:Name="GalleryListBox"
             Background="Transparent"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Disabled">

		<ListBox.ItemsPanel>
			<ItemsPanelTemplate>
				<ts:ThumbnailGalleryPanel Spacing="8" MarginPadding="8" />
			</ItemsPanelTemplate>
		</ListBox.ItemsPanel>

		<ListBox.Styles>
			<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
				<Setter Property="Background" Value="Transparent" />
			</Style>
			<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
				<Setter Property="Background" Value="Transparent" />
			</Style>

			<Style Selector="ListBoxItem:pointerover">
				<Setter Property="Cursor" Value="Hand" />
			</Style>

			<Style Selector="ListBoxItem">
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="VerticalContentAlignment" Value="Stretch" />
			</Style>

			<Style Selector="ListBoxItem Border.ThumbnailBorder">
				<Setter Property="BorderBrush" Value="{DynamicResource Thumbnail_Border}" />
				<Setter Property="BorderThickness" Value="1" />
			</Style>

			<Style Selector="ListBoxItem:selected Border.ThumbnailBorder">
				<Setter Property="BorderBrush" Value="{DynamicResource Thumbnail_BorderSelected}" />
				<Setter Property="BorderThickness" Value="3" />
			</Style>
		</ListBox.Styles>

		<ListBox.ItemTemplate>
			<DataTemplate x:DataType="ts:SchematicThumbnail">
				<Border Classes="ThumbnailBorder"
                        Margin="2"
                        CornerRadius="0"
                        ClipToBounds="True"
                        Opacity="{Binding VisualOpacity}"
                        DragDrop.AllowDrop="True"
                        PointerPressed="OnGalleryTilePointerPressed">
					<Grid>
						<!-- The drop placeholder: the gap the dragged tile will land in. Same 2px
						     red outline and translucent red wash the inline thumbnail list uses,
						     but stretched to fill its grid cell rather than sized in pixels -
						     every cell here is already the auto-fit size. -->
						<Border IsVisible="{Binding IsDropPlaceholder}"
								BorderBrush="{DynamicResource Thumbnail_BorderSelected}"
								BorderThickness="2"
								Background="#10FF0000" />

						<Grid IsVisible="{Binding !IsDropPlaceholder}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<Border Grid.Row="0"
                                Background="{DynamicResource Thumbnail_Bg}"
                                BorderBrush="{DynamicResource Thumbnail_Border}"
                                BorderThickness="0,0,0,1">
							<Grid>
								<Border Background="{DynamicResource Thumbnail_Selection_Bg}"
                                        Opacity="1.0"
                                        IsVisible="{Binding IsMatchForSelection}" />
								<TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource Thumbnail_Fg}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           FontSize="11"
                                           Padding="4,3"
                                           IsVisible="{Binding !IsMatchForSelection}" />
								<TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource Thumbnail_Selection_Fg}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Left"
                                           FontSize="11"
                                           Padding="4,3"
                                           IsVisible="{Binding IsMatchForSelection}" />
							</Grid>
						</Border>

						<Grid Grid.Row="1">
							<TextBlock Text="Missing Image"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg}"
                                       FontSize="11"
                                       Padding="8,16"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ImageSource, Converter={x:Static ObjectConverters.IsNull}}" />

							<Image Source="{Binding ImageSource}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />

							<ts:ThumbnailWorklogPillsOverlay BitmapPixelSize="{Binding OriginalPixelSize}"
                                                              Pills="{Binding WorklogPills}"
                                                              IsHitTestVisible="False" />
						</Grid>
						</Grid>
					</Grid>
				</Border>
			</DataTemplate>
		</ListBox.ItemTemplate>
	</ListBox>
</UserControl>
