<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CRT.WorklogAddWorkDoneWindow"
        Title="Add work done"
        Width="440"
        MinWidth="380"
        CanResize="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Fg}">

	<StackPanel Margin="18" Spacing="4">
		<TextBlock x:Name="HeaderText" Text="Add work done" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

		<TextBlock Text="Description" />
		<TextBox x:Name="DescriptionTextBox"
				 AcceptsReturn="True"
				 TextWrapping="Wrap"
				 Height="80"
				 VerticalContentAlignment="Top" />
		<TextBlock Text="Ctrl+Enter to save" FontSize="10" Opacity="0.6" Margin="0,2,0,0" />
		<TextBlock x:Name="DescriptionValidationText"
				   Text="A description is required."
				   Foreground="{DynamicResource Text_Fail_Fg}"
				   FontSize="11"
				   Margin="0,2,0,0"
				   IsVisible="False" />

		<Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
			<StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
				<TextBlock Text="Time spent (hours)" />
				<!-- Maximum matches WorklogDurationFormatter.MaximumHours. Without one a
					 NumericUpDown accepts up to decimal.MaxValue, and a pasted 1e20 overflowed the
					 formatter's hours-to-minutes cast - which is unchecked in C#, so the readback
					 came back either empty or as a nonsense figure that then flowed into the
					 summary strip and the exported PDF. A century of hours is far past any real
					 repair, so nothing legitimate is refused. -->
				<NumericUpDown x:Name="HoursNumericUpDown"
								Minimum="0"
								Maximum="876000"
								Increment="0.25"
								FormatString="0.##"
								ValueChanged="OnHoursValueChanged" />
				<!-- Reads the decimal hours above back as hours and minutes, live as they are
					 typed. Its runs are built in code (the numbers bold, the words not), so it
					 carries no Text here. Collapsed when there is nothing to say - see
					 UpdateHoursReadback. -->
				<TextBlock x:Name="HoursReadbackText"
						   FontSize="11"
						   Opacity="0.75"
						   TextWrapping="Wrap"
						   Margin="0,2,0,0"
						   IsVisible="False" />
			</StackPanel>
			<StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
				<TextBlock x:Name="CostLabelText" Text="Cost" />
				<NumericUpDown x:Name="CostNumericUpDown"
								Minimum="0"
								Increment="1"
								FormatString="0.##" />
			</StackPanel>
		</Grid>

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Cancel" Click="OnCancelClick" />
			<Button x:Name="AddButton"
					Content="Add work"
					Foreground="{DynamicResource Button_Ok_Fg}"
					Background="{DynamicResource Button_Ok_Bg}"
					BorderBrush="{DynamicResource Button_Ok_Border}"
					Click="OnAddClick" />
		</StackPanel>
	</StackPanel>
</Window>
